+// hillclimb-275 r7r (queue 285) XA: #1154 alignment stays inside an exactness
+// level. A frontier committed under a level's tagged identity (xm::NumericsTag
+// appended by XmTagPromptContext) is offered only to a request passing that
+// level's tagged context; an untagged (strict) frontier only to nullptr.
+void FrontierAlignmentStaysWithinItsLevel() {
+  static const std::map<TextRunnerToken, std::string> pieces{
+      {40, "."}, {41, ".\n\n"}, {42, "\n\n"}, {50, "<|im_end|>"}};
+  class TextRunner final : public Runner {
+  public:
+    std::vector<TextRunnerToken> Tokenize(
+        std::string_view text) const override {
+      for (const auto& [token, piece] : pieces)
+        if (piece == text)
+          return {token};
+      return {};
+    }
+    std::string Decode(std::span<const TextRunnerToken> tokens) const override {
+      std::string text;
+      for (const auto token : tokens) {
+        const auto found = pieces.find(token);
+        text += found != pieces.end() ? found->second
+                                      : "<" + std::to_string(token) + ">";
+      }
+      return text;
+    }
+  };
+  auto runner = std::make_shared<TextRunner>();
+  using Tokens = std::vector<TextRunnerToken>;
+  const auto tagged = [](xm::ExactnessLevel level) {
+    auto c = std::make_shared<TextPromptContext>();
+    const auto tag = xm::NumericsTag(level);
+    c->cache_identity.assign(tag.begin(), tag.end());
+    return std::shared_ptr<const TextPromptContext>(c);
+  };
+  const auto relaxed = tagged(xm::ExactnessLevel::kRelaxed);
+  const auto approximate = tagged(xm::ExactnessLevel::kApproximate);
+  Expect(!relaxed->cache_identity.empty() &&
+             relaxed->cache_identity != approximate->cache_identity,
+         "XA: level tags differ and are non-empty");
+  // The model sampled "." "\n\n"; the next prompt replays it as ".\n\n"-less
+  // text before <|im_end|> (the template trimmed the whitespace).
+  const Tokens frontier{1, 40, 42};
+  const Tokens next{1, 40, 50, 6};
+  const Tokens aligned{1, 40, 42, 50, 6};
+  // frontier committed at `committed`'s level, request aligning at `request`'s
+  // level: the aligned prompt, or nothing; an aligned prompt must then hit the
+  // frontier through the request level's own cache identity.
+  const auto align =
+      [&](const std::shared_ptr<const TextPromptContext>& committed,
+          const std::shared_ptr<const TextPromptContext>& request)
+      -> std::optional<Tokens> {
+    ComponentTextCache cache(runner, 1, 0, {}, false, 0, false);
+    {
+      const Tokens prompt(frontier.begin(), frontier.begin() + 1);
+      auto lease = cache.Acquire(prompt, {}, committed, true, 0, true);
+      auto& state = dynamic_cast<State&>(lease->state());
+      lease->PreparePrefill(prompt.size());
+      runner->adapter->Append(state.slot, frontier, frontier);
+      (void)lease->Commit({}, {}, frontier);
+    }
+    Tokens prompt = next;
+    std::size_t stable = 0;
+    if (!cache.AlignToLiveFrontier(prompt, stable, 4096, true, nullptr,
+                                   request.get())) {
+      Expect(prompt == next && stable == 0, "XA: refused alignment is a no-op");
+      return std::nullopt;
+    }
+    auto lease = cache.Acquire(prompt, {}, request, true, 0, true);
+    Expect(lease->cache_hit() && lease->cached_tokens() == frontier.size(),
+           "XA: an aligned prompt continues the frontier of its own level");
+    lease->Invalidate();
+    return prompt;
+  };
+  // strict (untagged) with strict: R7Q behaviour, aligns.
+  Expect(align(nullptr, nullptr) == aligned, "XA: strict aligns to strict");
+  // relaxed request never aligns to a strict frontier.
+  Expect(!align(nullptr, relaxed), "XA: relaxed never aligns to strict");
+  // strict request never aligns to a relaxed frontier (also R7Q's behaviour,
+  // which is why relaxed lost its own frontiers).
+  Expect(!align(relaxed, nullptr), "XA: strict never aligns to relaxed");
+  // relaxed with relaxed: aligns (the fix).
+  Expect(align(relaxed, relaxed) == aligned, "XA: relaxed aligns to relaxed");
+  // approximate and relaxed never cross.
+  Expect(!align(relaxed, approximate) && !align(approximate, relaxed),
+         "XA: approximate and relaxed never cross");
+  Expect(align(approximate, approximate) == aligned,
+         "XA: approximate aligns to approximate");
+  std::cout << "FrontierAlignmentStaysWithinItsLevel PASS\n";
+}
