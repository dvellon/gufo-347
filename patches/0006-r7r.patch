+#ifndef GUFO_MODELS_QWEN38_FLASH_NEXT_NT_ACCEPT_HPP_
+#define GUFO_MODELS_QWEN38_FLASH_NEXT_NT_ACCEPT_HPP_
+
+// hillclimb-275 relaxed round 7 (queue 285): port of wave3 R3-06
+// (ntacc-140) to R7. Lossy acceptance at target near-ties. Greedy
+// verification normally accepts draft token d at a verified row only when d
+// is the row's argmax. With this rule a NON-strict request also accepts d
+// when the row's top-1 logit minus d's logit is <= eps:
+//
+//     gap(d) = L[top1] - L[d] <= eps          (logits of the verified row)
+//
+// Units: a difference of two logits of the same row = the difference of
+// their log-probabilities (nats at temperature 1). The relaxed quality gate
+// (amendment-R14-01/lineage_relaxed_gate.py EPS = 0.10; run_xm
+// xm_eval gap = top1 - top2 of the reference row) uses the same unit. For
+// d != top1, L[d] <= L[top2], hence top1 - top2 <= gap(d) <= eps: every
+// lossy acceptance starts at a near-tie in the gate's sense.
+//
+// Knobs (read once; unset, empty, "0" or invalid = off):
+//   GUFO_NT_ACCEPT_EPS         eps for RELAXED requests, at most
+//                              kNtRelaxedMaxEps (0.10); a larger value is
+//                              REFUSED for relaxed (event=nt_config
+//                              relaxed_refused=1, relaxed eps 0).
+//   GUFO_NT_ACCEPT_EPS_APPROX  eps for APPROXIMATE requests (<= kNtMaxEps);
+//                              unset = the relaxed eps; "0" = off.
+// STRICT requests never use the rule (eps 0 by construction). Sampled and
+// penalized requests never reach it (the engine applies it only on the GPU
+// greedy verification path with penalties off and the draft grammar-legal),
+// and A1-screened passes return no draft logits (the rule is skipped there).
+//
+// The comparison is done in float against NtEpsFloat(eps) = the largest
+// float whose value is <= eps (0.1f itself is 0.1000000015 > 0.1).
+// Header-only, no HIP: compiled by the Dell CPU test as is.
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <limits>
+#include <optional>
+
+#include "src/core/exactness.hpp"
+
+namespace gufo::models::qwen38_flash_next {
+
+inline constexpr double kNtRelaxedMaxEps = 0.10;  ///< relaxed gate epsilon
+inline constexpr double kNtMaxEps = 1.0;          ///< any level
+
+/// A decimal eps in (0, kNtMaxEps]; nullopt for unset/empty/"0"/invalid.
+[[nodiscard]] inline std::optional<double> NtParseEps(const char* text) noexcept {
+  if (text == nullptr || *text == '\0')
+    return std::nullopt;
+  char* end = nullptr;
+  const double v = std::strtod(text, &end);
+  if (end == text || *end != '\0' || !std::isfinite(v) || v <= 0.0 ||
+      v > kNtMaxEps)
+    return std::nullopt;
+  return v;
+}
+
+/// The largest float f with double(f) <= eps (0 for eps <= 0).
+[[nodiscard]] inline float NtEpsFloat(double eps) noexcept {
+  if (!(eps > 0.0))
+    return 0.0F;
+  float f = static_cast<float>(eps);
+  while (f > 0.0F && static_cast<double>(f) > eps)
+    f = std::nextafter(f, 0.0F);
+  return f;
+}
+
+struct NtConfig {
+  double relaxed_eps{0.0};   ///< applied to relaxed requests (<= 0.10)
+  double approx_eps{0.0};    ///< applied to approximate requests
+  float relaxed_eps_f{0.0F};
+  float approx_eps_f{0.0F};
+  bool relaxed_refused{false};  ///< GUFO_NT_ACCEPT_EPS > 0.10 was given
+  bool relaxed_invalid{false};  ///< set but not a valid eps (treated as off)
+  bool approx_invalid{false};
+};
+
+[[nodiscard]] inline NtConfig NtConfigFrom(const char* relaxed,
+                                           const char* approx) noexcept {
+  NtConfig c;
+  const auto r = NtParseEps(relaxed);
+  const bool r_set = relaxed != nullptr && *relaxed != '\0' &&
+                     !(relaxed[0] == '0' && relaxed[1] == '\0');
+  c.relaxed_invalid = r_set && !r;
+  if (r && *r > kNtRelaxedMaxEps) {
+    c.relaxed_refused = true;
+  } else if (r) {
+    c.relaxed_eps = *r;
+  }
+  const bool a_set = approx != nullptr && *approx != '\0';
+  const auto a = NtParseEps(approx);
+  c.approx_invalid = a_set && !a && !(approx[0] == '0' && approx[1] == '\0');
+  c.approx_eps = a_set ? (a ? *a : 0.0) : c.relaxed_eps;
+  c.relaxed_eps_f = NtEpsFloat(c.relaxed_eps);
+  c.approx_eps_f = NtEpsFloat(c.approx_eps);
+  return c;
+}
+
+/// The float threshold for a request at `level` (0 = the rule is off).
+[[nodiscard]] inline float NtEpsFor(const NtConfig& c,
+                                    xm::ExactnessLevel level) noexcept {
+  switch (level) {
+    case xm::ExactnessLevel::kStrict:
+      return 0.0F;
+    case xm::ExactnessLevel::kRelaxed:
+      return c.relaxed_eps_f;
+    case xm::ExactnessLevel::kApproximate:
+      return c.approx_eps_f;
+  }
+  return 0.0F;
+}
+
+/// The acceptance rule on one verified row: `top` = the row's argmax logit,
+/// `draft` = the logit of the draft token at that row. Gaps in [0, eps_f]
+/// accept; non-finite values or a draft above the argmax refuse.
+[[nodiscard]] inline bool NtAccept(float top, float draft, float eps_f) noexcept {
+  if (!(eps_f > 0.0F) || !std::isfinite(top) || !std::isfinite(draft))
+    return false;
+  const float gap = top - draft;
+  return gap >= 0.0F && gap <= eps_f;
+}
+
+}  // namespace gufo::models::qwen38_flash_next
+
+#endif  // GUFO_MODELS_QWEN38_FLASH_NEXT_NT_ACCEPT_HPP_
