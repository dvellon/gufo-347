+#ifndef GUFO_CORE_W3C82_GROUP_HPP_
+#define GUFO_CORE_W3C82_GROUP_HPP_
+
+// hillclimb-275 R7J (C8-2): cross-request batched prefill, DEFAULT OFF (GUFO_C82).
+// New header of the R7J overlay only; included by two TUs that link into one binary (executor.cpp,
+// text_generation_scheduler.cpp). Production gufo has no such header.
+//
+// The scheduler runs the prefill steps of 2..max_way requests as one "group": each step runs the
+// unchanged runner -> backend -> engine call chain on its own worker thread, but only ONE thread runs
+// at a time (a baton handed over under `Group`'s mutex), so every host and GPU action of the chain is
+// serialized exactly as on the single serving thread. The scheduler thread waits (join) meanwhile.
+// When a step reaches Executor::Forward(kPrefill) the executor may register that pass and PARK the
+// thread instead of running it; when no thread can run any more, the baton holder executes every
+// parked pass as ONE batched pass (Executor::C82Pass) and the parked threads resume, in member order,
+// as if their own Forward had returned. A lone parked pass is released and runs solo (Forward's own
+// statements). GUFO_C82 unset: no group is ever formed, `member` stays null on every thread.
+//
+// Knobs (read once, printed once at executor load as event=w3c82_config):
+//   GUFO_C82=1 | check (or 2)   on / on + in-pass check (first GUFO_C82_CHECK_PASSES batched passes)
+//   GUFO_C82_MAX_WAY=N          2..8 (default 8) requests per group
+//   GUFO_C82_MIN_ROWS=N         >= 96 (default 96; smaller values are raised to 96): a pass joins a
+//                               batch only with at least this many rows (below 96 the HC mixer and
+//                               combine take other kernels than the batched rows)
+//   GUFO_C82_MAX_ROWS=N         scheduler: a group's estimated rows (each member's chunk rounded up to
+//                               128) stay within N (default 4224 = the executor's prefill rows), so
+//                               one group is one batched pass, not a batched pass plus solo passes
+//   GUFO_C82_IDLE_ONLY=1        scheduler: form groups only when no decoder is runnable (default 0:
+//                               also beside decoders; a group runs unsplit, without #1042 layer groups)
+//   GUFO_C82_CHECK_PASSES=N     check mode: batched passes checked (default 4)
+//   GUFO_C82_STATS_EVERY=N      event=w3c82_stats every N batched passes (default 16)
+
+#include <condition_variable>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <mutex>
+#include <vector>
+
+namespace gufo::w3c82 {
+
+struct Config {
+  int mode{0};  ///< 0 off, 1 on, 2 on + check
+  unsigned max_way{8};
+  unsigned min_rows{96};
+  unsigned max_rows{4224};
+  bool idle_only{false};
+  unsigned check_passes{4};
+  unsigned stats_every{16};
+  bool invalid{false};  ///< GUFO_C82 set to something else (treated as off)
+};
+
+inline unsigned ParseUnsigned(const char* name, unsigned fallback,
+                              unsigned low, unsigned high) {
+  const char* v = std::getenv(name);
+  if (v == nullptr || *v == '\0')
+    return fallback;
+  char* end = nullptr;
+  const unsigned long parsed = std::strtoul(v, &end, 10);
+  if (end == v || *end != '\0')
+    return fallback;
+  if (parsed < low)
+    return low;
+  if (parsed > high)
+    return high;
+  return static_cast<unsigned>(parsed);
+}
+
+inline const Config& Get() {
+  static const Config config = [] {
+    Config c;
+    const char* v = std::getenv("GUFO_C82");
+    if (v != nullptr && *v != '\0') {
+      if (std::strcmp(v, "1") == 0)
+        c.mode = 1;
+      else if (std::strcmp(v, "check") == 0 || std::strcmp(v, "2") == 0)
+        c.mode = 2;
+      else
+        c.invalid = true;
+    }
+    c.max_way = ParseUnsigned("GUFO_C82_MAX_WAY", 8, 2, 8);
+    c.min_rows = ParseUnsigned("GUFO_C82_MIN_ROWS", 96, 96, 1U << 20);
+    c.max_rows = ParseUnsigned("GUFO_C82_MAX_ROWS", 4224, 192, 1U << 20);
+    c.idle_only = ParseUnsigned("GUFO_C82_IDLE_ONLY", 0, 0, 1) == 1;
+    c.check_passes = ParseUnsigned("GUFO_C82_CHECK_PASSES", 4, 1, 1000000);
+    c.stats_every = ParseUnsigned("GUFO_C82_STATS_EVERY", 16, 1, 1000000);
+    std::fprintf(stderr,
+                 "event=w3c82_config on=%d check=%d max_way=%u min_rows=%u "
+                 "max_rows=%u idle_only=%d check_passes=%u stats_every=%u "
+                 "invalid=%d\n",
+                 c.mode != 0 ? 1 : 0, c.mode == 2 ? 1 : 0, c.max_way,
+                 c.min_rows, c.max_rows, c.idle_only ? 1 : 0, c.check_passes,
+                 c.stats_every, c.invalid ? 1 : 0);
+    std::fflush(stderr);
+    return c;
+  }();
+  return config;
+}
+
+/// One group of prefill steps. Exactly one member thread holds the baton at a time; every state change
+/// happens under `mutex_` by the baton holder, so the threads' work is serialized with full ordering.
+class Group {
+public:
+  explicit Group(std::size_t members)
+      : state_(members, kRunnable), solo_(members, 0) {}
+  Group(const Group&) = delete;
+  Group& operator=(const Group&) = delete;
+
+  [[nodiscard]] std::size_t size() const noexcept { return state_.size(); }
+
+  /// Member `i`'s thread: waits for the baton (member 0 holds it first).
+  void Acquire(std::size_t i) {
+    std::unique_lock lock(mutex_);
+    cv_.wait(lock, [&] { return active_ == i; });
+  }
+
+  /// Baton holder `i` (inside Executor::Forward, after registering its pass): parks until its pass ran.
+  /// `run` executes every parked pass as one batch; it is invoked by whichever baton holder finds no
+  /// runnable member left with two or more passes parked. Returns true when i's pass ran in a batch,
+  /// false when it was released to run solo.
+  bool Park(std::size_t i, std::function<void()> run) {
+    std::unique_lock lock(mutex_);
+    state_[i] = kParked;
+    solo_[i] = 0;
+    run_ = std::move(run);
+    Advance(lock);
+    cv_.wait(lock, [&] { return active_ == i && state_[i] != kParked; });
+    return solo_[i] == 0;
+  }
+
+  /// Baton holder `i` finished its step (or never ran: a member whose thread could not start).
+  void Leave(std::size_t i) {
+    std::unique_lock lock(mutex_);
+    state_[i] = kDone;
+    if (active_ == i)
+      Advance(lock);
+  }
+
+  /// Called once, by the baton holder, after every member is done (the executor's release).
+  void OnEnd(std::function<void()> end) {
+    const std::lock_guard lock(mutex_);
+    end_ = std::move(end);
+  }
+
+private:
+  enum State : unsigned char { kRunnable, kParked, kDone };
+  static constexpr std::size_t kNone = static_cast<std::size_t>(-1);
+
+  // Baton holder, lock held: hand the baton to the lowest runnable member; with none, run the parked
+  // passes (two or more) here, or release a lone parked pass to run solo, or end the group.
+  void Advance(std::unique_lock<std::mutex>& lock) {
+    for (;;) {
+      for (std::size_t j = 0; j < state_.size(); ++j) {
+        if (state_[j] == kRunnable) {
+          active_ = j;
+          cv_.notify_all();
+          return;
+        }
+      }
+      std::size_t parked = 0;
+      std::size_t last = kNone;
+      for (std::size_t j = 0; j < state_.size(); ++j) {
+        if (state_[j] == kParked) {
+          ++parked;
+          last = j;
+        }
+      }
+      if (parked == 0) {
+        active_ = kNone;
+        auto end = std::move(end_);
+        end_ = {};
+        if (end) {
+          lock.unlock();
+          end();
+          lock.lock();
+        }
+        cv_.notify_all();
+        return;
+      }
+      if (parked == 1) {
+        state_[last] = kRunnable;
+        solo_[last] = 1;
+        continue;
+      }
+      // Every other member is parked or done: nothing else can run while the batch does.
+      auto run = run_;
+      lock.unlock();
+      try {
+        if (run)
+          run();
+      } catch (...) {
+        // The executor records per-pass failures itself; nothing escapes a batch.
+      }
+      lock.lock();
+      for (auto& s : state_) {
+        if (s == kParked)
+          s = kRunnable;
+      }
+    }
+  }
+
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  std::vector<State> state_;
+  std::vector<unsigned char> solo_;
+  std::size_t active_{0};
+  std::function<void()> run_;
+  std::function<void()> end_;
+};
+
+/// The calling thread's membership while it runs one step of a group; null outside a group.
+struct Member {
+  Group* group{nullptr};
+  std::size_t index{0};
+  bool used{false};        ///< the step's first prefill pass was offered (later passes run solo)
+  bool force_solo{false};  ///< a remapped checkpoint slot could not be allocated: run solo
+};
+inline thread_local Member* member = nullptr;
+
+}  // namespace gufo::w3c82
+
+#endif  // GUFO_CORE_W3C82_GROUP_HPP_
