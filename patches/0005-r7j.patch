+// hillclimb-275 R7J (C8-2, GUFO_C82): cross-request batched prefill.
+// Design and exactness argument: hillclimb-275/BUILD-NOTES-R7J.txt.
+// Group protocol: src/core/w3c82_group.hpp. Every function below runs only on
+// a group member's thread (or the batch runner) while it holds the group's
+// baton; GUFO_C82 unset never reaches any of them.
+//
+// One batched pass = the passes of 2..8 sessions, rows concatenated at
+// 128-row aligned offsets. Per segment, on that segment's scratch rows and
+// its own session state, the calls ForwardBody makes for a solo pass of the
+// same chunk (same n, start, checkpoints): PLE, the attention-side HC mix,
+// GDN / attention with their output projections, in-pass checkpoint rows and
+// logits, kept hidden rows, the head; after the pass the MTP kv-only
+// catch-up. Once over all rows: embedding and each layer's FFN half
+// (combine, FFN HC mix, router, shared and routed experts, fused MoE
+// combine): prefill-phase kernels whose every output row depends only on its
+// own input row, in an order independent of the row count and the row's
+// place in the pass (C7 audit; upstream v0.34.0 #714/#875/#877 qualify
+// prefill rows independent of the pass width). Padding rows only pass
+// through the FFN half; nothing reads them.
+// ===========================================================================
+
+namespace {
+void C82PrintStats(const char* why, std::uint64_t passes, std::uint64_t ways,
+                   std::uint64_t rows, std::uint64_t real_rows,
+                   std::size_t last_ways, std::uint32_t last_rows,
+                   std::uint64_t solo_rows, std::uint64_t solo_capacity,
+                   std::uint64_t solo_shape, std::uint64_t lone,
+                   std::uint64_t failed, std::uint64_t checked,
+                   std::uint64_t mismatch, const std::string& first_bad) {
+  std::fprintf(stderr,
+               "event=w3c82_stats why=%s passes=%llu ways=%llu rows=%llu "
+               "real_rows=%llu last_ways=%zu last_rows=%u solo_rows=%llu "
+               "solo_capacity=%llu solo_shape=%llu lone=%llu failed=%llu "
+               "checked=%llu check_mismatch_rows=%llu first_bad=%s\n",
+               why, static_cast<unsigned long long>(passes),
+               static_cast<unsigned long long>(ways),
+               static_cast<unsigned long long>(rows),
+               static_cast<unsigned long long>(real_rows), last_ways,
+               last_rows, static_cast<unsigned long long>(solo_rows),
+               static_cast<unsigned long long>(solo_capacity),
+               static_cast<unsigned long long>(solo_shape),
+               static_cast<unsigned long long>(lone),
+               static_cast<unsigned long long>(failed),
+               static_cast<unsigned long long>(checked),
+               static_cast<unsigned long long>(mismatch), first_bad.c_str());
+  std::fflush(stderr);
+}
+}  // namespace
+
+int Executor::C82TryBatch(Session& session,
+                          std::span<const std::int32_t> tokens,
+                          std::uint32_t n_logits, float* logits,
+                          std::span<PrefillCheckpoint* const> checkpoints,
+                          std::string* error_msg) const {
+  auto* m = gufo::w3c82::member;
+  if (m == nullptr || m->group == nullptr || m->used)
+    return -1;
+  // Only a step's first prefill pass is offered; its later passes run solo.
+  m->used = true;
+  const auto& cfg = gufo::w3c82::Get();
+  const Config& c = config();
+  const auto n = static_cast<std::uint32_t>(tokens.size());
+  if (cfg.mode == 0 || m->force_solo || m->index >= kC82MaxWay) {
+    ++c82_stats_.solo_shape;
+    return -1;
+  }
+  if (n < cfg.min_rows) {
+    ++c82_stats_.solo_rows;
+    return -1;
+  }
+  // The shapes the batched pass reproduces statement for statement: a text
+  // MTP prefill with one logits row, no layer split, no deferred GDN plan, no
+  // AS_EARLY hook, no timers. Anything else (and every invalid request: the
+  // solo Forward reports its own error) runs solo.
+  bool shape =
+      n <= options_.max_batch && n_logits == 1 && logits != nullptr &&
+      session.owner_ == this && session.mtp_enabled_ &&
+      session.position_ + n <= session.max_context_ &&
+      session.VisionLayout().images.empty() &&
+      session.mtp_.position == session.position_ && !hook_ && wide_mixer_ &&
+      (c.ple_layer < 0 || ngram_ != nullptr) &&
+      checkpoints.size() <= kMaxPassCheckpoints &&
+      gufo::w3as::armed == nullptr && !w3p4::Timing() &&
+      w3rb::PlanPass(w3rb::Knob().mode, false, n, session.gdn_defer_keep_)
+              .kind == w3rb::kGdnProd;
+  for (auto t : tokens)
+    shape = shape && t >= 0 && static_cast<std::uint32_t>(t) < c.vocab_size;
+  for (std::size_t i = 0; shape && i < checkpoints.size(); ++i) {
+    const auto* cp = checkpoints[i];
+    shape = cp != nullptr && cp->source == &session && cp->tokens <= n &&
+            (i == 0 || cp->tokens > checkpoints[i - 1]->tokens) &&
+            cp->state->position_ == session.position_ + cp->tokens;
+  }
+  if (!shape) {
+    ++c82_stats_.solo_shape;
+    return -1;
+  }
+  // Capacity: 128-aligned segments within max_batch rows, one logits row per
+  // segment (logits_host_ rows), at most max_way.
+  std::uint32_t rows = 0;
+  for (const auto& item : c82_items_)
+    rows = (rows + 127U) / 128U * 128U +
+           static_cast<std::uint32_t>(item.tokens.size());
+  rows = (rows + 127U) / 128U * 128U + n;
+  const std::size_t way_cap = std::min<std::size_t>(
+      {static_cast<std::size_t>(cfg.max_way),
+       static_cast<std::size_t>(kC82MaxWay),
+       static_cast<std::size_t>(options_.max_logit_rows)});
+  if (c82_items_.size() + 1 > way_cap || rows > options_.max_batch) {
+    ++c82_stats_.solo_capacity;
+    return -1;
+  }
+  if (!session.CheckCancellation(error_msg))
+    return 0;
+  // Forward drops an unclaimed early n-gram gather the same way (W3P4 4e):
+  // the batched pass reads every segment's rows itself.
+  if (w3p4::early.active) {
+    (void)WaitPle(nullptr);
+    w3p4::early.session->ngram_ = w3p4::early.before;
+    w3p4::early.active = false;
+  }
+  C82Item item;
+  item.session = &session;
+  item.tokens = tokens;
+  item.logits = logits;
+  item.checkpoints.assign(checkpoints.begin(), checkpoints.end());
+  item.member = m->index;
+  c82_items_.push_back(std::move(item));
+  c82_results_[m->index] = {};
+  m->group->OnEnd([this] { C82Release(); });
+  const bool batched = m->group->Park(m->index, [this] { C82RunBatch(); });
+  if (!batched) {
+    // Released alone: Forward's own statements run this pass.
+    const std::size_t self = m->index;
+    std::erase_if(c82_items_,
+                  [self](const C82Item& it) { return it.member == self; });
+    ++c82_stats_.lone;
+    return -1;
+  }
+  const auto& result = c82_results_[m->index];
+  if (!result.ran) {
+    AssignError(error_msg, "C8-2 batched prefill did not run");
+    return 0;
+  }
+  if (!result.ok) {
+    AssignError(error_msg, result.error);
+    return 0;
+  }
+  return 1;
+}
+
+void Executor::C82RunBatch() const noexcept {
+  std::vector<C82Item> items;
+  items.swap(c82_items_);
+  bool ok = false;
+  std::string error;
+  try {
+    ok = C82Pass(items, &error);
+  } catch (const std::exception& e) {
+    try {
+      error = e.what();
+    } catch (...) {
+    }
+    ok = false;
+  } catch (...) {
+    ok = false;
+  }
+  if (!ok) {
+    (void)hipStreamSynchronize(stream_);
+    ++c82_stats_.failed;
+    try {
+      if (error.empty())
+        error = "unknown failure";
+      error = "C8-2 batched prefill failed: " + error;
+    } catch (...) {
+    }
+  }
+  for (const auto& item : items) {
+    auto& r = c82_results_[item.member];
+    r.ran = true;
+    r.ok = ok;
+    try {
+      r.error = ok ? std::string() : error;
+    } catch (...) {
+    }
+  }
+  if (!ok) {
+    try {
+      C82PrintStats("failed", c82_stats_.passes, c82_stats_.ways,
+                    c82_stats_.rows, c82_stats_.real_rows, items.size(), 0,
+                    c82_stats_.solo_rows, c82_stats_.solo_capacity,
+                    c82_stats_.solo_shape, c82_stats_.lone, c82_stats_.failed,
+                    c82_stats_.checked, c82_stats_.check_mismatch_rows,
+                    error);
+    } catch (...) {
+    }
+  }
+}
+
+void Executor::C82Release() const noexcept {
+  for (auto& slot : c82_storage_)
+    slot.reset();
+}
+
+bool Executor::C82CheckFfn(
+    const std::function<bool(std::uint32_t)>& finish_rows,
+    const std::function<void(std::size_t)>& use_segment,
+    std::span<const std::uint32_t> offsets,
+    std::span<const std::uint32_t> lengths, std::uint32_t rows,
+    std::uint32_t layer, std::string* error_msg) const {
+  const Config& c = config();
+  const std::size_t hc = c.HcDim();
+  const std::size_t parts = HcInjectPartsVec4(c.hidden_size);
+  const std::size_t res_bytes = std::size_t{rows} * hc * sizeof(float);
+  const std::size_t out_bytes =
+      std::size_t{rows} * c.hidden_size * sizeof(float);
+  const std::size_t inj_bytes =
+      std::size_t{rows} * c.hc_count * parts * sizeof(float);
+  const std::size_t need = res_bytes + out_bytes + inj_bytes;
+  if (c82_shadow_bytes_ < need) {
+    if (c82_shadow_ != nullptr)
+      (void)hipFree(c82_shadow_);
+    c82_shadow_ = nullptr;
+    c82_shadow_bytes_ = 0;
+    if (!Check(hipMalloc(&c82_shadow_, need), "C8-2 check shadow",
+               error_msg))
+      return false;
+    c82_shadow_bytes_ = need;
+  }
+  const Scratch base = s_;
+  auto* shadow = static_cast<std::uint8_t*>(c82_shadow_);
+  const auto copy = [&](void* dst, const void* src, std::size_t bytes,
+                        hipMemcpyKind kind) {
+    return Check(hipMemcpyAsync(dst, src, bytes, kind, stream_),
+                 "C8-2 check copy", error_msg);
+  };
+  // The FFN half reads the residual, the attention-side output and the
+  // attention mixer's inject partials; everything else it writes first.
+  if (!copy(shadow, base.res, res_bytes, hipMemcpyDeviceToDevice) ||
+      !copy(shadow + res_bytes, base.block_out, out_bytes,
+            hipMemcpyDeviceToDevice) ||
+      !copy(shadow + res_bytes + out_bytes, base.inject, inj_bytes,
+            hipMemcpyDeviceToDevice))
+    return false;
+  const auto before = SavedDispatch();
+  struct Outputs {
+    std::vector<std::uint8_t> res, xn_half, xn, inject, q8t;
+    bool half{false};
+    const float* fused{nullptr};
+    bool deferred{false};
+  };
+  const std::size_t q8_bytes = Q8TiledBytes(rows, hc);
+  const auto fetch = [&](Outputs& o) {
+    o.half = xn_half_;
+    o.fused = inject_fused_;
+    o.deferred = res_deferred_;
+    o.res.resize(res_bytes);
+    o.inject.resize(inj_bytes);
+    if (!Check(hipStreamSynchronize(stream_), "C8-2 check sync", error_msg) ||
+        !copy(o.res.data(), base.res, res_bytes, hipMemcpyDeviceToHost) ||
+        !copy(o.inject.data(), base.inject, inj_bytes, hipMemcpyDeviceToHost))
+      return false;
+    if (o.half) {
+      o.xn_half.resize(std::size_t{rows} * hc * sizeof(__half));
+      o.q8t.resize(q8_bytes);
+      if (!copy(o.xn_half.data(), base.xn_half, o.xn_half.size(),
+                hipMemcpyDeviceToHost) ||
+          !copy(o.q8t.data(), base.xn_q8t, q8_bytes, hipMemcpyDeviceToHost))
+        return false;
+    } else {
+      o.xn.resize(res_bytes);
+      if (!copy(o.xn.data(), base.xn, res_bytes, hipMemcpyDeviceToHost))
+        return false;
+    }
+    return Check(hipStreamSynchronize(stream_), "C8-2 check sync", error_msg);
+  };
+  // (a) the batched statement: all rows at once.
+  Outputs all;
+  if (!finish_rows(rows) || !fetch(all))
+    return false;
+  // (b) the solo statement: the same inputs, segment by segment.
+  if (!copy(base.res, shadow, res_bytes, hipMemcpyDeviceToDevice) ||
+      !copy(base.block_out, shadow + res_bytes, out_bytes,
+            hipMemcpyDeviceToDevice) ||
+      !copy(base.inject, shadow + res_bytes + out_bytes, inj_bytes,
+            hipMemcpyDeviceToDevice))
+    return false;
+  for (std::size_t i = 0; i < offsets.size(); ++i) {
+    use_segment(i);
+    DispatchState() = before;
+    if (!finish_rows(lengths[i]))
+      return false;
+  }
+  const bool seg_half = xn_half_;
+  const float* seg_fused = inject_fused_;
+  const bool seg_deferred = res_deferred_;
+  UseScratch(base);
+  xn_half_ = seg_half;
+  inject_fused_ = seg_fused;
+  res_deferred_ = seg_deferred;
+  Outputs seg;
+  if (!fetch(seg))
+    return false;
+  // The per-segment results stay in place (the solo arithmetic either way).
+  std::uint64_t bad = 0;
+  std::string first;
+  const auto note = [&](const char* what, std::size_t segment,
+                        std::uint32_t row) {
+    ++bad;
+    if (first.empty())
+      first = "layer" + std::to_string(layer) + ":seg" +
+              std::to_string(segment) + ":row" + std::to_string(row) + ":" +
+              what;
+  };
+  if (all.half != seg.half || all.fused != seg.fused ||
+      all.deferred != seg.deferred)
+    note("flags", 0, 0);
+  const std::size_t res_row = hc * sizeof(float);
+  const std::size_t inj_row = c.hc_count * parts * sizeof(float);
+  const std::size_t half_row = hc * sizeof(__half);
+  for (std::size_t i = 0; i < offsets.size(); ++i) {
+    for (std::uint32_t r = offsets[i]; r < offsets[i] + lengths[i]; ++r) {
+      const bool row_bad =
+          std::memcmp(all.res.data() + r * res_row,
+                      seg.res.data() + r * res_row, res_row) != 0 ||
+          std::memcmp(all.inject.data() + r * inj_row,
+                      seg.inject.data() + r * inj_row, inj_row) != 0 ||
+          (all.half && seg.half &&
+           std::memcmp(all.xn_half.data() + r * half_row,
+                       seg.xn_half.data() + r * half_row, half_row) != 0) ||
+          (!all.half && !seg.half &&
+           std::memcmp(all.xn.data() + r * res_row,
+                       seg.xn.data() + r * res_row, res_row) != 0);
+      if (row_bad)
+        note("res|inject|xn", i, r);
+    }
+    if (all.half && seg.half) {
+      // Tiled Q8 norm rows: the segment's 128-row aligned tile range (its
+      // padding rows hold the batched values in both arms).
+      const std::size_t from = Q8TiledBytes(offsets[i], hc);
+      const std::size_t to =
+          std::min(q8_bytes, from + Q8TiledBytes(lengths[i], hc));
+      if (to > from && std::memcmp(all.q8t.data() + from,
+                                   seg.q8t.data() + from, to - from) != 0)
+        note("xn_q8t", i, offsets[i]);
+    }
+  }
+  c82_stats_.check_mismatch_rows += bad;
+  if (bad != 0 && c82_stats_.first_bad == "none")
+    c82_stats_.first_bad = first;
+  return true;
+}
+
+bool Executor::C82Pass(std::span<const C82Item> items,
+                       std::string* error_msg) const {
+  const Config& c = config();
+  const auto& cfg = gufo::w3c82::Get();
+  const std::size_t count = items.size();
+  constexpr std::uint32_t kSegmentAlign = 128;
+  if (count < 2 || count > kC82MaxWay || count > options_.max_logit_rows) {
+    AssignError(error_msg, "batch must hold 2..8 passes");
+    return false;
+  }
+  PrefillPhase phase(true);
+  selected_logits_ = nullptr;
+  // Forward consumes any A1 / audit-#5 arm and clears their pass state; a
+  // prefill pass never screens or stages.
+  a1_.armed = false;
+  a1_.pass = false;
+  a1_.offset = 0;
+  a1_.use = false;
+  af_.armed = false;
+  af_.pass = false;
+  af_.staged = false;
+  af_.offset = 0;
+  af_.use = false;
+  wide_rows_ = 0;
+  DropReadyQ8();
+  std::array<std::uint32_t, kC82MaxWay> offsets{}, lengths{}, starts{},
+      pools{}, completes{}, emb_rows{};
+  std::array<bool, kC82MaxWay> sparse{};
+  std::uint32_t rows = 0;
+  std::uint32_t real_rows = 0;
+  for (std::size_t i = 0; i < count; ++i) {
+    const Session& session = *items[i].session;
+    const auto n = static_cast<std::uint32_t>(items[i].tokens.size());
+    rows = (rows + kSegmentAlign - 1) / kSegmentAlign * kSegmentAlign;
+    offsets[i] = rows;
+    lengths[i] = n;
+    rows += n;
+    emb_rows[i] = real_rows;
+    real_rows += n;
+    // Forward's per-pass values for this session.
+    starts[i] = session.position_;
+    const std::uint32_t end = starts[i] + n;
+    sparse[i] = c.compress_ratio > 0 && end > c.indexer_top_k;
+    completes[i] = c.compress_ratio > 0 ? end / c.compress_ratio : 0;
+    pools[i] = sparse[i] && completes[i] > session.blocks_
+                   ? completes[i] - session.blocks_
+                   : 0;
+  }
+  if (rows > options_.max_batch) {
+    AssignError(error_msg, "batch exceeds the executor's rows");
+    return false;
+  }
+  if (c82_controls_ == nullptr &&
+      !Check(host_allocations_.Allocate(
+                 &c82_controls_, kC82MaxWay * sizeof(Session::Control)),
+             "C8-2 control allocation", error_msg))
+    return false;
+  // Forward's prologue, per session in member order: settle pending GDN rows,
+  // the continuation hook, the n-gram rows, snapshot preservation.
+  for (std::size_t i = 0; i < count; ++i) {
+    Session& session = *items[i].session;
+    if (session.gdn_defer_keep_ != 0 && !session.GdnSettle(error_msg, false))
+      return false;
+  }
+  for (std::size_t i = 0; i < count; ++i) {
+    Session& session = *items[i].session;
+    if (session.continuation_hooks_) {
+      const std::uint32_t end = session.position_ + lengths[i];
+      session.continuation_hooks_->BeforeWrite(
+          false, session.position_, end, session.blocks_,
+          end > c.indexer_top_k ? end / c.compress_ratio : session.blocks_);
+    }
+  }
+  std::vector<NgramHistory> ngram_before;
+  ngram_before.reserve(count);
+  for (std::size_t i = 0; i < count; ++i)
+    ngram_before.push_back(items[i].session->ngram_);
+  const auto restore_ngram = [&] {
+    for (std::size_t i = 0; i < count; ++i)
+      items[i].session->ngram_ = ngram_before[i];
+  };
+  if (c.ple_layer >= 0) {
+    if (ple_pending_ && !WaitPle(error_msg))
+      return false;
+    FinishPrefetch();
+    // One table read for every segment's rows, compact in host_emb_ (as
+    // ForwardBatch); each segment's PLE reads its own rows. Rows are a pure
+    // function of the session's n-gram history and the chunk (PleFetch).
+    ngram_owners_.clear();
+    for (std::size_t i = 0; i < count; ++i) {
+      Session& session = *items[i].session;
+      HashNgramRows(c, session.ngram_, items[i].tokens,
+                    std::span<std::uint32_t>(host_rows_).subspan(
+                        std::size_t{emb_rows[i]} * c.ple_heads,
+                        std::size_t{lengths[i]} * c.ple_heads));
+      ngram_owners_.push_back(
+          {std::size_t{lengths[i]} * c.ple_heads, &session.ngram_counters_});
+    }
+    if (!ngram_->StartRead(
+            std::span<const std::uint32_t>(
+                host_rows_.data(), std::size_t{real_rows} * c.ple_heads),
+            std::span<float>(host_emb_,
+                             std::size_t{real_rows} * c.PleEmbeddingDim()),
+            ngram_owners_)) {
+      restore_ngram();
+      AssignError(error_msg, "batched n-gram read could not start");
+      return false;
+    }
+    ple_pending_ = true;
+  }
+  try {
+    for (std::size_t i = 0; i < count; ++i)
+      items[i].session->PreserveSnapshots(items[i].session->position_,
+                                          items[i].session->mtp_.position);
+  } catch (...) {
+    (void)WaitPle(nullptr);
+    restore_ngram();
+    throw;
+  }
+  for (std::size_t i = 0; i < count; ++i) {
+    Session& session = *items[i].session;
+    ++session.mutation_epoch_;
+    session.spec_base_ = session.position_;
+    session.spec_tokens_ = 0;
+    c82_controls_[i] = {session.position_, session.blocks_,
+                        session.mtp_.position, -1, session.mtp_.blocks};
+  }
+  std::fill_n(tokens_host_, rows, 0);
+  for (std::size_t i = 0; i < count; ++i)
+    std::copy(items[i].tokens.begin(), items[i].tokens.end(),
+              tokens_host_ + offsets[i]);
+  struct PinnedInputGuard {
+    hipStream_t stream;
+    bool completed{false};
+    ~PinnedInputGuard() {
+      if (!completed)
+        (void)hipStreamSynchronize(stream);
+    }
+  } pinned_inputs{stream_};
+
+  const bool checking =
+      cfg.mode == 2 && c82_stats_.checked < cfg.check_passes;
+  const Scratch base = s_;
+  const std::size_t hc_dim = c.HcDim();
+  const std::size_t vocab = c.vocab_size;
+  // The wide route's inject partials: [row][stream][Vec4 part].
+  const std::uint32_t parts = HcInjectPartsVec4(c.hidden_size);
+  const auto view_of = [&](std::size_t i, std::uint32_t row) {
+    auto view = RowScratch(base, row);
+    view.inject = base.inject + std::size_t{row} * c.hc_count * parts;
+    view.xn_q8t =
+        static_cast<std::uint8_t*>(base.xn_q8t) + Q8TiledBytes(row, hc_dim);
+    if (c.ple_layer >= 0)
+      view.ple_emb =
+          base.ple_emb + std::size_t{emb_rows[i]} * c.PleEmbeddingDim();
+    return view;
+  };
+  const auto& layers = model_->layers();
+  const auto body = [&]() -> bool {
+    for (std::size_t i = 0; i < count; ++i) {
+      if (!CopyPinned(c82_controls_ + i, items[i].session->control_,
+                      sizeof(Session::Control), hipMemcpyHostToDevice,
+                      stream_, "control upload", error_msg))
+        return false;
+    }
+    if (!CopyPinned(tokens_host_, base.tokens, rows * sizeof(std::int32_t),
+                    hipMemcpyHostToDevice, stream_, "token upload",
+                    error_msg))
+      return false;
+    EmbedTokens(model_->token_embd().data,
+                SmallType(model_->token_embd().type), base.tokens, base.res,
+                rows, c.hidden_size, c.hc_count, stream_);
+    for (std::size_t i = 0; i < count; ++i)
+      items[i].session->vision_input_.Inject(
+          base.res + std::size_t{offsets[i]} * hc_dim, starts[i], lengths[i],
+          c.hidden_size, c.hc_count, stream_);
+    bool normed = false;
+    // What the last all-row combine handed the next attention-side mixer.
+    bool mixer_xn_half = false;
+    const float* mixer_inject_fused = nullptr;
+    std::uint32_t mixer_inject_parts = inject_parts_;
+    for (std::uint32_t il = 0; il < c.num_layers; ++il) {
+      const DeviceLayer& l = layers[il];
+      if (c.IsPleLayer(il) && !WaitPle(error_msg))
+        return false;
+      for (std::size_t i = 0; i < count; ++i) {
+        Session& session = *items[i].session;
+        const std::uint32_t n = lengths[i];
+        const std::span<PrefillCheckpoint* const> cps(items[i].checkpoints);
+        UseScratch(view_of(i, offsets[i]));
+        xn_half_ = mixer_xn_half;
+        inject_fused_ = mixer_inject_fused;
+        inject_parts_ = mixer_inject_parts;
+        UseYarn(session);
+        if (c.IsPleLayer(il) &&
+            !Ple(l, session, n, s_.res, false, error_msg, true, cps))
+          return false;
+        const bool half_only = WidePrefill(n) && n <= RouteRows() &&
+                               l.linear && DenseF16Route(l.ssm_in, n) &&
+                               l.ssm_alpha_beta.type == GgmlType::kF16 &&
+                               l.ssm_alpha_beta.cols == l.ssm_in.cols;
+        if (!HcMix(l.hc_attn, s_.res, normed, s_.mixed, s_.inject, n,
+                   error_msg, half_only))
+          return false;
+        if (inject_parts_ != parts) {
+          AssignError(error_msg, "unexpected inject layout");
+          return false;
+        }
+        const bool last_attention = WidePrefill(n) && !session.mtp_enabled_ &&
+                                    il + 1 == c.num_layers && cps.empty();
+        if (l.linear) {
+          GdnCheckpoint capture;
+          for (const auto* cp : cps) {
+            capture.state[capture.count] = cp->state->linear_[il].state;
+            capture.history[capture.count] =
+                cp->state->linear_[il].conv_state;
+            capture.tokens[capture.count++] = cp->tokens;
+          }
+          if (!LinearAttention(l, session.linear_[il], s_.mixed, s_.block_out,
+                               n, false, error_msg, false, true, capture))
+            return false;
+        } else {
+          PassCheckpoints pass_rows;
+          for (const auto* cp : cps)
+            pass_rows.tokens[pass_rows.count++] = cp->tokens;
+          if (!Attention(l, session.attention_[il], s_.mixed, s_.block_out, n,
+                         &session.control_->position,
+                         &session.control_->blocks, starts[i], pools[i],
+                         session.max_context_, sparse[i], error_msg,
+                         last_attention, false, true, pass_rows))
+            return false;
+        }
+      }
+      UseScratch(base);
+      inject_parts_ = parts;
+      // Padding rows: no mixer wrote them. Zero output and inject partials
+      // keep their residual finite; nothing reads them.
+      for (std::size_t i = 0; i + 1 < count; ++i) {
+        const std::uint32_t first = offsets[i] + lengths[i];
+        const std::uint32_t pad = offsets[i + 1] - first;
+        if (pad != 0 &&
+            (!Check(hipMemsetAsync(
+                        base.block_out + std::size_t{first} * c.hidden_size,
+                        0, std::size_t{pad} * c.hidden_size * sizeof(float),
+                        stream_),
+                    "padding rows", error_msg) ||
+             !Check(hipMemsetAsync(
+                        base.inject + std::size_t{first} * c.hc_count * parts,
+                        0,
+                        std::size_t{pad} * c.hc_count * parts * sizeof(float),
+                        stream_),
+                    "padding rows", error_msg)))
+          return false;
+      }
+      const float* next_norm =
+          il + 1 < c.num_layers
+              ? (c.IsPleLayer(il + 1) ? nullptr
+                                      : layers[il + 1].hc_attn.norm.f32())
+              : nullptr;
+      const float* next_inject =
+          next_norm != nullptr ? InjectWeights(layers[il + 1].hc_attn)
+                               : nullptr;
+      // ForwardBody's `finish` on the current scratch view (MTP sessions
+      // finish every row of the last layer too: no `skipped` rows).
+      const std::function<bool(std::uint32_t)> finish =
+          [&](std::uint32_t n) {
+            defer_residual_ = WmmaExperts(l, n);
+            const bool no_f32 = prefill_phase && defer_residual_ &&
+                                n <= RouteRows() &&
+                                l.router.type == GgmlType::kF16 &&
+                                l.shexp_gate.type == GgmlType::kQ8_0 &&
+                                l.shexp_up.type == GgmlType::kQ8_0;
+            Combine(s_.res, l.hc_ffn.norm.f32(), n, InjectWeights(l.hc_ffn),
+                    &l.hc_ffn);
+            if (!HcMix(l.hc_ffn, s_.res, true, s_.mixed, s_.inject, n,
+                       error_msg, false, no_f32) ||
+                !Moe(l, s_.mixed, s_.block_out, n, error_msg))
+              return false;
+            Combine(s_.res, next_norm, n, next_inject,
+                    il + 1 < c.num_layers ? &layers[il + 1].hc_attn
+                                          : nullptr);
+            return true;
+          };
+      if (checking) {
+        const std::function<void(std::size_t)> use_segment =
+            [&](std::size_t i) {
+              UseScratch(view_of(i, offsets[i]));
+              // As the batched combine sees them (view_of keeps Vec4 parts).
+              inject_parts_ = parts;
+            };
+        if (!C82CheckFfn(
+                finish, use_segment,
+                std::span<const std::uint32_t>(offsets.data(), count),
+                std::span<const std::uint32_t>(lengths.data(), count), rows,
+                il, error_msg))
+          return false;
+      } else if (!finish(rows)) {
+        return false;
+      }
+      mixer_xn_half = xn_half_;
+      mixer_inject_fused = inject_fused_;
+      mixer_inject_parts = inject_parts_;
+      normed = next_norm != nullptr;
+    }
+    // ForwardBody's tail per segment: each in-pass checkpoint's hidden rows
+    // and logits, the kept hidden rows, then the head over the last row.
+    for (std::size_t i = 0; i < count; ++i) {
+      Session& session = *items[i].session;
+      const std::uint32_t n = lengths[i];
+      const float* segment = base.res + std::size_t{offsets[i]} * hc_dim;
+      for (auto* cp : items[i].checkpoints) {
+        if (cp->hidden_rows != 0 &&
+            !CopyFloats(segment + std::size_t{cp->tokens - cp->hidden_rows} *
+                                      hc_dim,
+                        cp->state->mtp_.target_hidden,
+                        std::size_t{cp->hidden_rows} * hc_dim, stream_,
+                        "checkpoint hidden rows", error_msg))
+          return false;
+        PrefillPhase head_phase(false);
+        if (!HcMix(model_->hc_head(),
+                   segment + std::size_t{cp->tokens - 1} * hc_dim, false,
+                   s_.mixed, nullptr, 1, error_msg) ||
+            !Dense(model_->output(), s_.mixed, s_.logits, 1, error_msg) ||
+            !Check(hipMemcpyAsync(cp->logits.data(), s_.logits,
+                                  vocab * sizeof(float),
+                                  hipMemcpyDeviceToHost, stream_),
+                   "checkpoint logits", error_msg))
+          return false;
+      }
+      const auto& cps = items[i].checkpoints;
+      const auto kept = std::min(
+          !cps.empty() && cps.back()->tokens < n ? n - cps.back()->tokens : n,
+          options_.max_speculative);
+      if (session.mtp_enabled_ &&
+          !CopyFloats(segment + std::size_t{n - kept} * hc_dim,
+                      session.mtp_.target_hidden, std::size_t{kept} * hc_dim,
+                      stream_, "hidden keep", error_msg))
+        return false;
+      PrefillPhase head_phase(false);
+      // One logits row through s_.logits (the solo head's statements), then
+      // its own host row.
+      if (!HcMix(model_->hc_head(), segment + std::size_t{n - 1} * hc_dim,
+                 false, s_.mixed, nullptr, 1, error_msg) ||
+          !Dense(model_->output(), s_.mixed, s_.logits, 1, error_msg) ||
+          !CopyPinned(s_.logits, logits_host_ + i * vocab,
+                      vocab * sizeof(float), hipMemcpyDeviceToHost, stream_,
+                      "logits download", error_msg))
+        return false;
+    }
+    return true;
+  };
+  bool ok = false;
+  try {
+    ok = body();
+  } catch (...) {
+    (void)hipStreamSynchronize(stream_);
+    UseScratch(base);
+    throw;
+  }
+  const auto status = hipStreamSynchronize(stream_);
+  UseScratch(base);
+  defer_residual_ = false;
+  res_deferred_ = false;
+  inject_fused_ = nullptr;
+  if (!ok || !Check(status, "batched prefill", error_msg))
+    return false;
+  // Forward's epilogue per session, in segment order: logits, position and
+  // pooled blocks, then the MTP kv-only catch-up from the segment's final
+  // residual rows. A catch-up reads its hidden rows first (RmsNormRows into
+  // mtp_h) and then writes the residual scratch only below its own row
+  // count (mtp_res aliases res), which ends before the next segment's
+  // offset, so later segments' rows stay intact.
+  for (std::size_t i = 0; i < count; ++i) {
+    Session& session = *items[i].session;
+    const std::uint32_t n = lengths[i];
+    std::copy_n(logits_host_ + i * vocab, vocab, items[i].logits);
+    session.position_ += n;
+    if (sparse[i])
+      session.blocks_ = completes[i];
+    session.gdn_pass_kind_ = w3rb::kGdnProd;
+    if (session.mtp_enabled_ && n > 1) {
+      PrefillPhase draft_phase(false);
+      if (!MtpForward(session, items[i].tokens.subspan(1), 0,
+                      {.kv_only = true}, error_msg,
+                      base.res + std::size_t{offsets[i]} * hc_dim))
+        return false;
+    }
+  }
+  pinned_inputs.completed = true;
+  auto& st = c82_stats_;
+  ++st.passes;
+  st.ways += count;
+  st.rows += rows;
+  st.real_rows += real_rows;
+  if (checking) {
+    ++st.checked;
+    std::fprintf(stderr,
+                 "event=w3c82_check pass=%llu ways=%zu rows=%u real_rows=%u "
+                 "layers=%u mismatched_rows_total=%llu first_bad=%s\n",
+                 static_cast<unsigned long long>(st.passes), count, rows,
+                 real_rows, static_cast<unsigned>(c.num_layers),
+                 static_cast<unsigned long long>(st.check_mismatch_rows),
+                 st.first_bad.c_str());
+    std::fflush(stderr);
+    if (st.checked >= cfg.check_passes && c82_shadow_ != nullptr) {
+      (void)hipFree(c82_shadow_);
+      c82_shadow_ = nullptr;
+      c82_shadow_bytes_ = 0;
+    }
+  }
+  if (st.passes == 1 || st.passes % cfg.stats_every == 0 || checking)
+    C82PrintStats("pass", st.passes, st.ways, st.rows, st.real_rows, count,
+                  rows, st.solo_rows, st.solo_capacity, st.solo_shape,
+                  st.lone, st.failed, st.checked, st.check_mismatch_rows,
+                  st.first_bad);
+  return true;
+}
+
 }  // namespace gufo::models::qwen38_flash_next::rocm
diff --git a/src/models/qwen38_flash_next/kernels/rocm/executor.hpp b/src/models/qwen38_flash_next/kernels/rocm/executor.hpp
--- a/src/models/qwen38_flash_next/kernels/rocm/executor.hpp
+++ b/src/models/qwen38_flash_next/kernels/rocm/executor.hpp
@@ -1288,6 +1288,53 @@ private:
   mutable bool prefetch_deferred_{false};
   bool RunLayerHook(Session& session, std::string* error_msg) const;
   void* hc_fused_state_{nullptr};  ///< HcMixQ8Fused's counters (zeroed)
+
+  // hillclimb-275 R7J (C8-2, GUFO_C82; src/core/w3c82_group.hpp): cross-request batched prefill.
+  // Unset knob: no group exists, w3c82::member is null on every thread and none of this is used.
+  static constexpr std::uint32_t kC82MaxWay = 8;
+  struct C82Item {
+    Session* session{nullptr};
+    std::span<const std::int32_t> tokens;
+    float* logits{nullptr};  ///< host, one row (n_logits == 1)
+    std::vector<PrefillCheckpoint*> checkpoints;
+    std::size_t member{0};
+  };
+  struct C82Result {
+    bool ran{false};
+    bool ok{false};
+    std::string error;
+  };
+  /// Called first in Forward(kPrefill) on a group member's thread: -1 = run this pass solo (Forward's
+  /// own statements follow), 0 = it ran in a batch and failed, 1 = it ran in a batch.
+  int C82TryBatch(Session& session, std::span<const std::int32_t> tokens,
+                  std::uint32_t n_logits, float* logits,
+                  std::span<PrefillCheckpoint* const> checkpoints,
+                  std::string* error_msg) const;
+  /// The group's batch runner: every registered pass as one pass; never throws.
+  void C82RunBatch() const noexcept;
+  bool C82Pass(std::span<const C82Item> items, std::string* error_msg) const;
+  /// Check mode: the FFN half of one layer, all rows vs per segment (kept), compared bitwise.
+  bool C82CheckFfn(const std::function<bool(std::uint32_t)>& finish_rows,
+                   const std::function<void(std::size_t)>& use_segment,
+                   std::span<const std::uint32_t> offsets,
+                   std::span<const std::uint32_t> lengths, std::uint32_t rows,
+                   std::uint32_t layer, std::string* error_msg) const;
+  /// Group end: returns the remapped checkpoint slots to the snapshot pool.
+  void C82Release() const noexcept;
+  mutable std::vector<C82Item> c82_items_;
+  mutable C82Result c82_results_[kC82MaxWay];
+  /// Per-member checkpoint slots of parked passes (member m, slot s at m * kMaxPassCheckpoints + s).
+  mutable std::shared_ptr<void> c82_storage_[kC82MaxWay * kMaxPassCheckpoints];
+  mutable Session::Control* c82_controls_{nullptr};
+  struct C82Stats {
+    std::uint64_t passes{0}, ways{0}, rows{0}, real_rows{0}, failed{0};
+    std::uint64_t solo_rows{0}, solo_capacity{0}, solo_shape{0}, lone{0};
+    std::uint64_t checked{0}, check_mismatch_rows{0};
+    std::string first_bad{"none"};
+  };
+  mutable C82Stats c82_stats_;
+  mutable void* c82_shadow_{nullptr};  ///< check mode: FFN-half inputs (freed after the last check)
+  mutable std::size_t c82_shadow_bytes_{0};
 };
 
