+/// A selection that reads no logit values (a forced reasoning token or a
+/// deferred draw), or one that is exactly the argmax of the full row.
+enum class A1Selection { kContentFree, kArgmax, kNeedsRow };
+A1Selection A1Select(const sampling::SamplerState& sampler) {
+  if (sampler.ForcedToken() || sampler.SaveDrawState().pending)
+    return A1Selection::kContentFree;
+  const auto& config = sampler.config();
+  // rebase-272: generated-token logprobs (#814) read the full row.
+  return config.temperature == 0.0F && !config.penalties_enabled() &&
+                 !config.constraint && !config.logprobs
+             ? A1Selection::kArgmax
+             : A1Selection::kNeedsRow;
+}
+
+/// Requests whose every head-row consumer is a greedy argmax.
+/// a1-tool (GUFO_A1_TOOL, w3a1t_tool.hpp): with the knob on, also greedy
+/// tool-grammar requests, whose anchor SampleAnchor takes through
+/// w3a1t::ScreenedPick. Knob off: ConstraintClause == !config.constraint.
+bool A1Eligible(const sampling::SamplerState& sampler) {
+  const auto& config = sampler.config();
+  return config.temperature == 0.0F && !config.penalties_enabled() &&
+         !config.logprobs &&  // rebase-272: #814 logprobs need the full rows
+         w3a1t::ConstraintClause(config, w3a1t::On(), w3a1t::Closed());
+}
