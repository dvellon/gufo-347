+               static_cast<unsigned long long>(g_xm_relaxed_units.load()),
+               static_cast<unsigned long long>(g_xm_approximate_units.load()),
+               static_cast<unsigned long long>(g_xm_active_units.load()),
+               static_cast<unsigned long long>(g_xm_stub_units.load()));
+  std::fflush(stderr);
+}
+
+/// The contract's stub feature: "allocated" only when the server allows
+/// approximate requests and GUFO_XM_APPROX_STUB=1; reported once.
+bool XmStub() {
+  static const bool on = [] {
+    const char* v = std::getenv("GUFO_XM_APPROX_STUB");
+    const bool requested = v != nullptr && v[0] == '1' && v[1] == '\0';
+    const bool allowed = xm::ApproximateAllowed();
+    std::fprintf(stderr,
+                 "event=xm_approx_stub requested=%d allowed=%d enabled=%d "
+                 "bytes=0\n",
+                 requested ? 1 : 0, allowed ? 1 : 0,
+                 requested && allowed ? 1 : 0);
+    std::fflush(stderr);
+    return requested && allowed;
+  }();
+  return on;
+}
+
+/// One decode/advance work unit at `level`; the forward level is scoped.
+void XmUnit(xm::ExactnessLevel level) {
+  (level == xm::ExactnessLevel::kStrict    ? g_xm_strict_units
+   : level == xm::ExactnessLevel::kRelaxed ? g_xm_relaxed_units
+                                           : g_xm_approximate_units)
+      .fetch_add(1, std::memory_order_relaxed);
+  if (xm::ApproximateActive()) {
+    g_xm_active_units.fetch_add(1, std::memory_order_relaxed);
+    if (XmStub())
+      g_xm_stub_units.fetch_add(1, std::memory_order_relaxed);
+  }
+}
+
+void XmSplit() {
+  if ((g_xm_split_steps.fetch_add(1, std::memory_order_relaxed) + 1) % 32 == 0)
+    XmStats("split");
+}
