+// Wave3 B5 v2 (b5-margin-stop/v2): greedy
+// draft-margin policy for unplanned cycles of a lone request. Drafting only:
+// greedy verification keeps every output identical; only the chain length and
+// the length controller's evidence change. Unset = production.
+//   GUFO_B5=1       enable: floor 1.25, hide inf, drop off, solo gate
+//   GUFO_B5=0       force off
+//   GUFO_B5_FLOOR   gap (top1-top2 logit) at or below which a proposed draft
+//                   ends the chain: 1 or 7 per-depth values (enables B5)
+//   GUFO_B5_DROP    gap at or below which a computed draft of depth >= 2 is
+//                   not proposed: same syntax (enables B5; default off)
+//   GUFO_B5_HIDE    a first rejected draft whose gap is at or below this value
+//                   is censored evidence for the length controller ("inf")
+//   GUFO_B5_GATE=0  also planned batches / occupied steps (v1, comparison only)
+// Planned batches see near-full acceptance with hide and over-draft at C2..C8,
+// so by default B5 applies only when !batch_drafts && occupancy <= 1.
+struct B5MarginPolicy {
+  bool enabled{false};
+  bool gated{true};
+  std::array<float, kMaxMtpDraftTokens> floor{};
+  std::array<float, kMaxMtpDraftTokens> drop{};
+  float hide{-std::numeric_limits<float>::infinity()};
+};
+
+float B5ParseFloat(const char* name, const std::string& text) {
+  char* end = nullptr;
+  const float value = std::strtof(text.c_str(), &end);
+  if (text.empty() || end == text.c_str() || *end != '\0' || std::isnan(value))
+    throw std::invalid_argument(std::string(name) + ": invalid value '" + text +
+                                "'");
+  return value;
+}
+
+bool B5ParseDepths(const char* name,
+                   std::array<float, kMaxMtpDraftTokens>* out) {
+  const char* raw = std::getenv(name);
+  if (raw == nullptr || *raw == '\0')
+    return false;
+  const std::string text(raw);
+  std::array<float, kMaxMtpDraftTokens> values{};
+  std::size_t count = 0, pos = 0;
+  for (;;) {
+    const auto comma = text.find(',', pos);
+    if (count == values.size())
+      throw std::invalid_argument(std::string(name) + ": more than 7 values");
+    values[count++] = B5ParseFloat(
+        name, text.substr(pos, comma == std::string::npos ? std::string::npos
+                                                          : comma - pos));
+    if (comma == std::string::npos)
+      break;
+    pos = comma + 1;
+  }
+  if (count == 1)
+    out->fill(values[0]);
+  else if (count == values.size())
+    *out = values;
+  else
+    throw std::invalid_argument(std::string(name) + ": need 1 or 7 values");
+  return true;
+}
+
+const B5MarginPolicy& B5Policy() {
+  static const B5MarginPolicy policy = [] {
+    B5MarginPolicy p;
+    const char* master = std::getenv("GUFO_B5");
+    const bool forced_off = master && std::string(master) == "0";
+    std::array<float, kMaxMtpDraftTokens> floor{}, drop{};
+    floor.fill(1.25F);
+    drop.fill(-std::numeric_limits<float>::infinity());
+    float hide = std::numeric_limits<float>::infinity();
+    bool knob = B5ParseDepths("GUFO_B5_FLOOR", &floor);
+    knob = B5ParseDepths("GUFO_B5_DROP", &drop) || knob;
+    if (const char* raw = std::getenv("GUFO_B5_HIDE"); raw && *raw) {
+      hide = B5ParseFloat("GUFO_B5_HIDE", raw);
+      knob = true;
+    }
+    // Wave3 XM: unset GUFO_B5 = the relaxed table's default (xm_relaxed_policy.hpp).
+    p.enabled =
+        !forced_off && (XmRelaxedKnob(master, kXmRelaxedDefaults.b5) || knob);
+    const char* gate = std::getenv("GUFO_B5_GATE");
+    p.gated = !(gate && std::string(gate) == "0");
+    if (p.enabled) {
+      p.floor = floor;
+      p.drop = drop;
+      p.hide = hide;
+    } else {
+      p.floor.fill(kGreedyDraftConfidenceFloor);
+      p.drop.fill(-std::numeric_limits<float>::infinity());
+    }
+    std::fprintf(stderr, "event=b5_margin_policy enabled=%d gate=%s floor=",
+                 p.enabled ? 1 : 0, p.gated ? "solo" : "all");
+    for (std::size_t i = 0; i < p.floor.size(); ++i)
+      std::fprintf(stderr, "%s%g", i ? "," : "", p.floor[i]);
+    std::fprintf(stderr, " drop=");
+    for (std::size_t i = 0; i < p.drop.size(); ++i)
+      std::fprintf(stderr, "%s%g", i ? "," : "", p.drop[i]);
+    std::fprintf(stderr, " hide=%g\n", p.hide);
+    std::fflush(stderr);
+    (void)w3gc8::EnvPlannedMode();  // geom-c8: one event=b5_planned line at load
+    return p;
+  }();
+  return policy;
+}
+
+/// Whether a confidence-stop cycle uses the B5 policy: enabled, and (ungated,
+/// or an unplanned cycle of a lone request).
+bool B5Applies(bool planned, std::uint32_t occupancy) {
+  const auto& p = B5Policy();
+  return p.enabled && (!p.gated || (!planned && occupancy <= 1));
+}
+
+/// geom-c8 (GUFO_B5_PLANNED=stop, w3gc8_planned.hpp): B5's stop (floor / drop,
+/// no hide) on a confidence-stop cycle the solo gate refused.
+bool B5PlannedStop(bool planned, std::uint32_t occupancy) {
+  const auto& p = B5Policy();
+  return w3gc8::StopOnly(p.enabled, p.gated, planned, occupancy,
+                         w3gc8::EnvPlannedMode());
+}
+
+/// Top1-top2 logit gap; +inf when undefined (StopGreedyLinearDraft's "no stop"
+/// cases).
+float B5DraftGap(const MtpCandidateLogits& candidates) {
+  if (candidates.size < 2 || candidates.size > kMtpCandidates)
+    return std::numeric_limits<float>::infinity();
+  const float first = candidates.logits[0];
+  const float second = candidates.logits[1];
+  if (!std::isfinite(first) || !std::isfinite(second))
+    return std::numeric_limits<float>::infinity();
+  return first - second;
+}
+
+/// Before AppendDraft: true when the computed draft (chain position
+/// `chain_size`) is not proposed. Never the first draft.
+bool B5DropDraft(const MtpCandidateLogits& candidates, std::size_t chain_size) {
+  if (chain_size < 2 || chain_size > kMaxMtpDraftTokens)
+    return false;
+  return B5DraftGap(candidates) <= B5Policy().drop[chain_size - 1];
+}
+
+/// After AppendDraft: records the newest draft's gap at its chain position and
+/// returns true when the chain ends after it.
+bool B5StopAfterDraft(const MtpCandidateLogits& candidates,
+                      std::size_t chain_size,
+                      std::array<float, kMaxMtpDraftTokens + 1>* gaps) {
+  const float gap = B5DraftGap(candidates);
+  const std::size_t position = chain_size - 1;
+  if (position == 0 || position > kMaxMtpDraftTokens)
+    return gap <= kGreedyDraftConfidenceFloor;
+  (*gaps)[position] = gap;
+  return gap <= B5Policy().floor[position - 1];
