+// Wave3 R12-04 CONTROLLER-PRIOR + R12-09 tool stop (ctl-prior,
+// queue 146). GUFO_MTP_CTL=prod|c1|c2 selects MtpLengthController's prior,
+// decay and probe period; GUFO_TOOL_STOP=0|1 gives greedy grammar-constrained
+// requests the production confidence stop (engine.cpp). Both are read once per
+// process; unset = the production statements. They change how many drafts a
+// cycle proposes and verifies, never which token is emitted: verification
+// emits only target-selected tokens.
+namespace w3ctl {
+
+enum class Mode : std::uint8_t { kProd = 0, kC1 = 1, kC2 = 2 };
+
+struct Params {
+  Mode mode;
+  float prior_successes;
+  float prior_failures;
+  float decay;
+  std::uint32_t probe_period;
+};
+
+inline constexpr Params kProd{Mode::kProd, 1.5F, 0.5F, 0.75F, 16};
+inline constexpr Params kC1{Mode::kC1, 3.0F, 0.25F, 0.97F, 4};
+inline constexpr Params kC2{Mode::kC2, 3.0F, 0.5F, 0.95F, 16};
+
+// MtpLengthController::Restore rejects probe_delay > 16. Observe sets
+// probe_delay only to the mode's period or decrements a nonzero value, so a
+// period in [1, 16] keeps every reachable state restorable. A decay in (0, 1)
+// and positive priors keep successes / failures finite, >= 0, sum > 0.
+[[nodiscard]] constexpr bool Admissible(const Params& p) noexcept {
+  return p.probe_period >= 1 && p.probe_period <= 16 && p.decay > 0.0F &&
+         p.decay < 1.0F && p.prior_successes > 0.0F &&
+         p.prior_failures > 0.0F;
+}
+static_assert(Admissible(kProd) && Admissible(kC1) && Admissible(kC2),
+              "a length-controller mode would make its own snapshots invalid");
+
+struct Knobs {
+  bool valid{true};
+  Params params{kProd};
+  bool tool_stop{false};
+  bool ctl_set{false};
+  bool stop_set{false};
+  char error[48]{};
+};
+
+[[nodiscard]] inline Knobs Parse(const char* ctl, const char* stop) noexcept {
+  Knobs k;
+  if (ctl != nullptr) {
+    k.ctl_set = true;
+    if (std::strcmp(ctl, "prod") == 0) {
+      k.params = kProd;
+    } else if (std::strcmp(ctl, "c1") == 0) {
+      k.params = kC1;
+    } else if (std::strcmp(ctl, "c2") == 0) {
+      k.params = kC2;
+    } else {
+      k.valid = false;
+      std::snprintf(k.error, sizeof(k.error), "GUFO_MTP_CTL=%.24s", ctl);
+    }
+  }
+  if (stop != nullptr) {
+    k.stop_set = true;
+    if (std::strcmp(stop, "1") == 0) {
+      k.tool_stop = true;
+    } else if (std::strcmp(stop, "0") != 0 && k.valid) {
+      k.valid = false;
+      std::snprintf(k.error, sizeof(k.error), "GUFO_TOOL_STOP=%.24s", stop);
+    }
+  }
+  return k;
+}
