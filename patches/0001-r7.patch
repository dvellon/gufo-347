+bool W3q2lSetup(const DeviceTensor& w, const DeviceTensor& draft, bool has_mtp, float* logits,
+                ArgmaxCandidate* argmax_scratch, std::uint32_t* mtp_ids, std::uint32_t* mtp_scratch_ids,
+                float* mtp_scores, hipStream_t stream, std::string* error_msg) {
+  const auto& cfg = w3q2l::Get();
