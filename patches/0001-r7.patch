+void Executor::A1Setup() {
+  // subline-sweep: one knob line per process; GUFO_A1_MAX_ROWS unset (or
+  // invalid) = A1 off: nothing allocated, a1_.available stays false, so
+  // A1Usable is false everywhere and no pass is ever armed (promo-3cg).
+  static const bool a1_logged =
+      (w3sb::LogKnob("GUFO_A1_MAX_ROWS", A1MaxRowsSetting()), true);
+  (void)a1_logged;
+  if (A1MaxRowsSetting() == 0)
+    return;
+  const char* env = std::getenv("GUFO_A1");
+  if (env != nullptr && std::string_view(env) == "0") {
+    A1Log(0, "event=a1_disabled reason=GUFO_A1=0");
+    return;
+  }
+  const auto& w = model_->output();
+  const Config& c = config();
+  if (w.data == nullptr || w.type != GgmlType::kQ8_0 || w.cols != kA1K ||
+      w.rows != c.vocab_size || w.rows < kA1BlockRows ||
+      (w.rows + kA1BlockRows - 1) / kA1BlockRows * kA1TileWinners >
+          kA1MaxWinners ||
+      qfn_mmq_q8_1_bytes(1, static_cast<int>(w.cols)) !=
+          static_cast<std::size_t>(w.cols) / 32 * 36) {
+    A1Log(1, "event=a1_disabled reason=unsupported_head");
+    return;
+  }
+  const auto started = std::chrono::steady_clock::now();
+  const std::size_t vocab = w.rows;
+  const std::size_t blocks = w.cols / 32;
+  const std::size_t tiles = (vocab + kA1BlockRows - 1) / kA1BlockRows;
+  const std::size_t winners = tiles * kA1TileWinners;
+  const std::size_t rows = kA1MaxRows;
+  a1_.row_bytes = qfn_mmq_q8_1_bytes(1, static_cast<int>(w.cols));
+  a1_.stride = static_cast<std::uint32_t>(a1_.row_bytes / 36);
+  std::vector<void*> device;
+  bool ok = true;
+  const auto dev = [&](auto** pointer, std::size_t bytes) {
+    if (!ok)
+      return;
+    void* p = nullptr;
+    if (hip::AllocateDevice(&p, bytes) != hipSuccess ||
+        hipMemset(p, 0, bytes) != hipSuccess) {
+      (void)hipGetLastError();
+      ok = false;
+      return;
+    }
+    device.push_back(p);
+    *pointer = static_cast<std::remove_reference_t<decltype(*pointer)>>(p);
+  };
+  const auto host = [&](auto** pointer, std::size_t bytes,
+                        unsigned flags = ResultHostFlags()) {
+    if (ok && host_allocations_.Allocate(pointer, bytes, flags) != hipSuccess) {
+      (void)hipGetLastError();
+      ok = false;
+    }
+    if (ok)
+      std::memset(*pointer, 0, bytes);
+  };
+  std::uint32_t* stats = nullptr;
+  dev(&a1_.shadow_qs, vocab * blocks * 16);
+  dev(&a1_.shadow_d, vocab * blocks * sizeof(__half));
+  dev(&a1_.bound, vocab * sizeof(float));
+  dev(&a1_.invd, kA1K * sizeof(float));
+  dev(&stats, 4 * sizeof(std::uint32_t));
+  auto& s = a1_.scratch;
+  dev(&s.ub, rows * vocab * sizeof(float));
+  dev(&s.win_ub, rows * winners * sizeof(float));
+  dev(&s.win_id, rows * winners * sizeof(std::int32_t));
+  dev(&s.win_lb, rows * tiles * sizeof(float));
+  dev(&s.norms, rows * 2 * sizeof(float));
+  dev(&s.threshold, rows * 2 * sizeof(double));
+  dev(&s.count, rows * sizeof(std::uint32_t));
+  dev(&s.ticket, rows * sizeof(std::uint32_t));
+  dev(&s.cand, rows * kA1Cap * sizeof(std::uint32_t));
+  dev(&s.partial, rows * kA1GatherBlocks * sizeof(A1Partial));
+  dev(&s.result, rows * sizeof(A1Result));
+  dev(&a1_.x, rows * a1_.row_bytes);
+  dev(&a1_.row, vocab * sizeof(float));
+  dev(&a1_.row_x, a1_.row_bytes);
+  dev(&a1_.draft_logits, vocab * sizeof(float));
+  // The gather kernel reads the nonce in place: mapped on every platform.
+  host(&a1_.nonce_host, 64, hipHostMallocMapped | hipHostMallocCoherent);
+  host(&a1_.result_host, rows * sizeof(A1Result));
+  host(&a1_.check_host, rows * sizeof(A1Result));
+  host(&a1_.x_host, rows * a1_.row_bytes);
+  host(&a1_.upload_host, a1_.row_bytes);
+  host(&a1_.draft_host, sizeof(A1Result));
+  if (ok)
+    ok = hipHostGetDevicePointer(reinterpret_cast<void**>(&a1_.nonce_dev),
+                                 a1_.nonce_host, 0) == hipSuccess;
+  std::array<float, kA1K> invd{};
+  for (std::size_t i = 0; i < kA1K; ++i) {
+    invd[i] = std::bit_cast<float>(kA1InvdBits[i]);
+    ok = ok && std::isfinite(invd[i]) && invd[i] > 0.0F;
+  }
+  ok = ok &&
+       hipMemcpy(a1_.invd, invd.data(), sizeof(invd), hipMemcpyHostToDevice) ==
+           hipSuccess &&
+       A1BuildShadow(w.data, static_cast<std::uint32_t>(vocab), a1_.invd,
+                     a1_.shadow_qs, a1_.shadow_d, a1_.bound, stats, stream_) &&
+       hipStreamSynchronize(stream_) == hipSuccess;
+  std::array<std::uint32_t, 4> words{};
+  ok = ok && hipMemcpy(words.data(), stats, sizeof(words),
+                       hipMemcpyDeviceToHost) == hipSuccess;
+  a1_.wmax = std::bit_cast<float>(words[0]);
+  a1_.smax = std::bit_cast<float>(words[1]);
+  ok = ok && words[2] == 0 && std::isfinite(a1_.wmax) &&
+       std::isfinite(a1_.smax) && a1_.wmax > 0.0F;
+  if (!ok) {
+    (void)hipGetLastError();
+    (void)hipStreamSynchronize(stream_);
+    for (void* p : device)
+      (void)hipFree(p);
+    a1_ = {};
+    A1Log(1, "event=a1_disabled reason=setup_failed");
+    return;
+  }
+  (void)hipFree(stats);
+  device.erase(std::find(device.begin(), device.end(), stats));
+  allocations_.insert(allocations_.end(), device.begin(), device.end());
+  a1_.head = {w.data,   a1_.shadow_qs,
+              a1_.shadow_d, a1_.bound,
+              a1_.invd, static_cast<std::uint32_t>(vocab),
+              a1_.wmax, a1_.smax};
+  a1_.available = true;
+  // Wave3 DH-FULL: the draft screen uses scratch row kA1MaxRows - 1, which a
+  // screened pass never reaches while the width cap is below kA1MaxRows.
+  a1_.draft = A1DraftSetting() && A1MaxRowsSetting() < kA1MaxRows;
+  std::size_t bytes = 0;
+  for (std::size_t b : {vocab * blocks * 16, vocab * blocks * sizeof(__half),
+                        vocab * sizeof(float)})
+    bytes += b;
+  std::size_t scratch = rows * vocab * 4 + rows * winners * 12 +
+                        rows * kA1Cap * 4 + vocab * 4 + rows * a1_.row_bytes;
+  A1Log(0, "event=a1_ready shadow_mb=" + std::to_string(bytes / 1000000) +
+               " scratch_mb=" + std::to_string(scratch / 1000000) +
+               " wmax=" + std::to_string(a1_.wmax) +
+               " smax=" + std::to_string(a1_.smax) + " build_ms=" +
+               std::to_string(std::chrono::duration<double, std::milli>(
+                                  std::chrono::steady_clock::now() - started)
+                                  .count()) +
+               " calibration=" + kA1CalibrationSha256 +
+               " max_rows=" + std::to_string(A1MaxRowsSetting()));
+  A1Log(0, "event=a1_draft_ready enabled=" + std::to_string(a1_.draft ? 1 : 0) +
+               " slot=" + std::to_string(kA1MaxRows - 1));
+  // Wave3 DH-TOP2 (dh-top2): the same slot as DH-FULL (a top-2 call
+  // and a token-only call are different MtpForward calls on one stream; each
+  // reads its result before the next pass). Its buffers exist only when
+  // GUFO_A1_DRAFT2=1: an unset knob allocates exactly what m1sb allocates.
+  a1_.draft2 = A1Draft2Setting() && A1MaxRowsSetting() < kA1MaxRows;
+  if (a1_.draft2) {
+    bool ok2 = true;
+    const auto dev2 = [&](auto** pointer, std::size_t bytes) {
+      if (!ok2)
+        return;
+      void* p = nullptr;
+      if (hip::AllocateDevice(&p, bytes) != hipSuccess ||
+          hipMemset(p, 0, bytes) != hipSuccess) {
+        (void)hipGetLastError();
+        if (p != nullptr)
+          (void)hipFree(p);
+        ok2 = false;
+        return;
+      }
+      allocations_.push_back(p);
+      *pointer = static_cast<std::remove_reference_t<decltype(*pointer)>>(p);
+    };
+    dev2(&a1_.draft2_x, a1_.row_bytes);
+    dev2(&a1_.draft2_partial, kA1T2GatherBlocks * sizeof(A1Top2Partial));
+    dev2(&a1_.draft2_result, sizeof(A1Top2Result));
+    if (ok2 && host_allocations_.Allocate(&a1_.draft2_host,
+                                          sizeof(A1Top2Result),
+                                          ResultHostFlags()) != hipSuccess) {
+      (void)hipGetLastError();
+      ok2 = false;
+    }
+    if (ok2)
+      std::memset(a1_.draft2_host, 0, sizeof(A1Top2Result));
+    if (!ok2) {
+      a1_.draft2 = false;
+      A1Log(1, "event=a1_draft2_disabled reason=setup_failed");
+    }
+  }
+  A1Log(0, "event=a1_draft2_ready enabled=" +
+               std::to_string(a1_.draft2 ? 1 : 0) +
+               " slot=" + std::to_string(kA1MaxRows - 1) +
+               " gather_blocks=" + std::to_string(kA1T2GatherBlocks));
+}
+
+bool Executor::A1Usable(std::uint32_t rows) const noexcept {
+  return a1_.available && !a1_.disabled && rows >= 1 &&
+         rows <= A1MaxRowsSetting();
+}
+
+void Executor::DisableA1(const std::string& reason) const {
+  if (!a1_.disabled)
+    A1Log(2, "event=a1_disabled reason=" + reason + " remedy=restart");
+  a1_.disabled = true;
+}
+
+Executor::A1Stats Executor::A1Statistics() const noexcept {
+  return a1_.stats;
+}
+
+bool Executor::A1Valid(const A1Result& e, std::uint32_t row) const noexcept {
+  return e.nonce == a1_.nonce &&
+         e.check == A1Check(e.value, e.index, e.count, e.nonce, row);
+}
+
+bool Executor::A1DraftReady() const noexcept {
+  return a1_.available && !a1_.disabled && a1_.draft;
+}
+
+// Wave3 DH-FULL: A1Screen over the draft head input s_.mixed (one row) on
+// scratch row kA1MaxRows - 1. Graph-capturable: the gather reads the draft
+// nonce word in place, MtpForward writes it before every launch.
+bool Executor::A1DraftHead(std::string* error_msg) const {
+  const auto& w = model_->output();
+  Q8Input q;
+  if (!Quantize(s_.mixed, 1, w.cols, &q, error_msg))
+    return false;
+  if (q.data == nullptr) {
+    AssignError(error_msg, "A1 draft head input is unavailable");
+    return false;
+  }
+  const std::size_t r = kA1MaxRows - 1;
+  const std::size_t vocab = w.rows;
+  const std::size_t tiles = (vocab + kA1BlockRows - 1) / kA1BlockRows;
+  A1Scratch s = a1_.scratch;
+  s.ub += r * vocab;
+  s.win_ub += r * tiles * kA1TileWinners;
+  s.win_id += r * tiles * kA1TileWinners;
+  s.win_lb += r * tiles;
+  s.norms += 2 * r;
+  s.threshold += 2 * r;
+  s.count += r;
+  s.ticket += r;
+  s.cand += r * kA1Cap;
+  s.partial += r * kA1GatherBlocks;
+  s.result += r;
+  A1Screen(a1_.head, s, q.data, a1_.stride, 1, a1_.draft_logits,
+           a1_.nonce_dev + kA1DraftNonceWord, stream_);
+  if (!CopyPinned(s.result, a1_.draft_host, sizeof(A1Result),
+                  hipMemcpyDeviceToHost, stream_, "A1 draft result",
+                  error_msg))
+    return false;
+  return Check(hipGetLastError(), "A1 draft screening", error_msg);
+}
+
+// After the synchronized MTP pass: the draft token from the checked result,
+// else the production head GEMV + Argmax over the same input (s_.mixed is
+// the pass's last write).
+bool Executor::A1DraftFinish(std::string* error_msg) const {
+  const A1Result e = *a1_.draft_host;
+  const std::uint32_t rows = model_->output().rows;
+  ++a1_.draft_calls;
+  const bool valid = e.nonce == a1_.draft_nonce &&
+                     e.check == A1Check(e.value, e.index, e.count, e.nonce, 0);
+  if (valid) {
+    a1_.draft_candidates += e.count;
+    a1_.draft_max_candidates =
+        std::max<std::uint64_t>(a1_.draft_max_candidates, e.count);
+  } else {
+    ++a1_.draft_invalid;
+    A1Log(1, "event=a1_draft_readback_invalid call=" +
+                 std::to_string(a1_.draft_calls));
+  }
+  if (valid && e.index >= 0 && static_cast<std::uint32_t>(e.index) < rows) {
+    *mtp_token_host_ = e.index;
+  } else {
+    ++a1_.draft_fallbacks;
+    DropReadyQ8();
+    if (!Dense(model_->output(), s_.mixed, s_.logits, 1, error_msg))
+      return false;
+    Argmax(s_.logits, s_.mtp_argmax, s_.mtp_token, 1, rows, stream_);
+    if (!CopyPinned(s_.mtp_token, mtp_token_host_, sizeof(std::int32_t),
+                    hipMemcpyDeviceToHost, stream_, "draft token download",
+                    error_msg) ||
+        !Check(hipStreamSynchronize(stream_), "A1 draft fallback", error_msg))
+      return false;
+  }
+  if ((a1_.draft_calls & 0xFF) == 0)
+    A1DraftLogSummary();
+  return true;
+}
+
+void Executor::A1DraftLogSummary() const {
+  if (a1_.draft_calls == 0)
+    return;
+  A1Log(0, "event=a1_draft_summary calls=" + std::to_string(a1_.draft_calls) +
+               " mean_candidates=" +
+               std::to_string(static_cast<double>(a1_.draft_candidates) /
+                              static_cast<double>(a1_.draft_calls)) +
+               " max_candidates=" + std::to_string(a1_.draft_max_candidates) +
+               " fallbacks=" + std::to_string(a1_.draft_fallbacks) +
+               " readback_invalid=" + std::to_string(a1_.draft_invalid));
+}
+
+bool Executor::A1Draft2Ready() const noexcept {
+  return a1_.available && !a1_.disabled && a1_.draft2;
+}
+
+// Wave3 DH-TOP2 (dh-top2): A1ScreenTop2 over the draft head input
+// s_.mixed (one row) on scratch row kA1MaxRows - 1. The input is the Q8_1 row
+// production's Dense would read (the same Quantize call: HcMix's ready rows or
+// a fresh slot), copied to draft2_x inside the pass, so the fallback GEMV
+// reads the same bytes. Graph-capturable: the gather reads the nonce word in
+// place, MtpForward writes it before every launch.
+bool Executor::A1Draft2Head(std::string* error_msg) const {
+  const auto& w = model_->output();
+  Q8Input q;
+  if (!Quantize(s_.mixed, 1, w.cols, &q, error_msg))
+    return false;
+  if (q.data == nullptr) {
+    AssignError(error_msg, "A1 top-2 draft head input is unavailable");
+    return false;
+  }
+  CopyMapped(q.data, a1_.draft2_x, a1_.row_bytes, stream_);
+  const std::size_t r = kA1MaxRows - 1;
+  const std::size_t vocab = w.rows;
+  const std::size_t tiles = (vocab + kA1BlockRows - 1) / kA1BlockRows;
+  A1Scratch s = a1_.scratch;
+  s.ub += r * vocab;
+  s.win_ub += r * tiles * kA1TileWinners;
+  s.win_id += r * tiles * kA1TileWinners;
+  s.win_lb += r * tiles;
+  s.norms += 2 * r;
+  s.threshold += 2 * r;
+  s.count += r;
+  s.ticket += r;
+  s.cand += r * kA1Cap;
+  s.partial += r * kA1GatherBlocks;
+  s.result += r;
+  A1ScreenTop2(a1_.head, s, a1_.draft2_x, a1_.draft2_partial,
+               a1_.draft2_result, nullptr,
+               a1_.nonce_dev + kA1Draft2NonceWord, stream_);
+  if (!CopyPinned(a1_.draft2_result, a1_.draft2_host, sizeof(A1Top2Result),
+                  hipMemcpyDeviceToHost, stream_, "A1 top-2 draft result",
+                  error_msg))
+    return false;
+  return Check(hipGetLastError(), "A1 top-2 draft screening", error_msg);
+}
+
+// After the synchronized MTP pass: the candidates production's MtpHead would
+// download (MtpTopCandidates<2>: ids[0..1], scores[0..1], size 2) from the
+// checked screen, else production's own statements over the same Q8_1 input
+// (Dense + MtpTopCandidates + the candidates download).
+bool Executor::A1Draft2Finish(std::string* error_msg) const {
+  const A1Top2Result e = *a1_.draft2_host;
+  const std::uint32_t rows = model_->output().rows;
+  ++a1_.draft2_calls;
+  const bool valid =
+      e.nonce == a1_.draft2_nonce && e.check == A1Top2Check(e);
+  if (valid) {
+    a1_.draft2_candidates += e.count;
+    a1_.draft2_max_candidates =
+        std::max<std::uint64_t>(a1_.draft2_max_candidates, e.count);
+  } else {
+    ++a1_.draft2_invalid;
+    A1Log(1, "event=a1_draft2_readback_invalid call=" +
+                 std::to_string(a1_.draft2_calls));
+  }
+  const bool screened =
+      valid && e.status == 0 && e.index[0] >= 0 && e.index[1] >= 0 &&
+      static_cast<std::uint32_t>(e.index[0]) < rows &&
+      static_cast<std::uint32_t>(e.index[1]) < rows &&
+      e.index[0] != e.index[1];
+  if (screened) {
+    mtp_candidates_host_->ids[0] = static_cast<sampling::TokenId>(e.index[0]);
+    mtp_candidates_host_->ids[1] = static_cast<sampling::TokenId>(e.index[1]);
+    mtp_candidates_host_->logits[0] = e.value[0];
+    mtp_candidates_host_->logits[1] = e.value[1];
+    mtp_candidates_host_->size = 2;
+  } else {
+    ++a1_.draft2_fallbacks;
+    const Q8Input q{s_.mixed, a1_.draft2_x, 1, model_->output().cols};
+    if (!Dense(model_->output(), q, s_.logits, error_msg))
+      return false;
+    MtpTopCandidates(s_.logits, s_.mtp_ids, s_.mtp_scratch_ids, s_.mtp_scores,
+                     rows, stream_, 2);
+    const auto bytes = offsetof(MtpCandidateLogits, logits) + 2 * sizeof(float);
+    if (!CopyPinned(s_.mtp_ids, mtp_candidates_host_, bytes,
+                    hipMemcpyDeviceToHost, stream_, "draft candidates download",
+                    error_msg) ||
+        !Check(hipStreamSynchronize(stream_), "A1 top-2 draft fallback",
+               error_msg))
+      return false;
+    mtp_candidates_host_->size = 2;
+  }
+  if ((a1_.draft2_calls & 0xFF) == 0)
+    A1Draft2LogSummary();
+  return true;
+}
+
+void Executor::A1Draft2LogSummary() const {
+  if (a1_.draft2_calls == 0)
+    return;
+  A1Log(0, "event=a1_draft2_summary calls=" +
+               std::to_string(a1_.draft2_calls) + " mean_candidates=" +
+               std::to_string(static_cast<double>(a1_.draft2_candidates) /
+                              static_cast<double>(a1_.draft2_calls)) +
+               " max_candidates=" + std::to_string(a1_.draft2_max_candidates) +
+               " fallbacks=" + std::to_string(a1_.draft2_fallbacks) +
+               " readback_invalid=" + std::to_string(a1_.draft2_invalid));
+}
+
+bool Executor::A1Head(const float* x, std::uint32_t rows, float* out,
+                      std::string* error_msg) const {
+  const auto& w = model_->output();
+  const void* input = nullptr;
+  if (rows <= kVecBatch) {
+    Q8Input q;
+    if (!Quantize(x, rows, w.cols, &q, error_msg))
+      return false;
+    input = q.data;
+  } else {
+    if (!QuantizeBatch(x, rows, w.cols, error_msg))
+      return false;
+    input = s_.x_q8t;
+  }
+  if (input == nullptr || rows > kA1MaxRows) {
+    AssignError(error_msg, "A1 head input is unavailable");
+    return false;
+  }
+  // The pass reads its own copy: fallbacks and frontiers outlive the
+  // alternating activation slots.
+  CopyMapped(input, a1_.x, rows * a1_.row_bytes, stream_);
+  if (++a1_.nonce == 0)
+    a1_.nonce = 1;
+  *a1_.nonce_host = a1_.nonce;
+  A1Screen(a1_.head, a1_.scratch, a1_.x, a1_.stride, rows, out, a1_.nonce_dev,
+           stream_);
+  // Staged with the pass: Rollback and plain decode read their frontier here
+  // without another transfer. GreedyMtpPredictions reads its rows separately.
+  if (!CopyPinned(a1_.scratch.result, a1_.result_host, rows * sizeof(A1Result),
+                  hipMemcpyDeviceToHost, stream_, "A1 result staging",
+                  error_msg) ||
+      !CopyPinned(a1_.x, a1_.x_host, rows * a1_.row_bytes,
+                  hipMemcpyDeviceToHost, stream_, "A1 input staging",
+                  error_msg))
+    return false;
+  a1_.rows = rows;
+  a1_.logits = out;
+  a1_.full = 0;
+  return Check(hipGetLastError(), "A1 head screening", error_msg);
+}
+
+void Executor::A1AfterPass() const {
+  a1_.pass = true;
+  auto& st = a1_.stats;
+  ++st.passes;
+  for (std::uint32_t r = 0; r < a1_.rows; ++r) {
+    const auto& e = a1_.result_host[r];
+    ++st.rows;
+    if (!A1Valid(e, r)) {
+      ++st.readback_invalid;
+      continue;
+    }
+    st.candidates += e.count;
+    st.max_candidates = std::max<std::uint64_t>(st.max_candidates, e.count);
+    if (e.index < 0)
+      ++st.fallback_flagged;
+  }
+  if (std::FILE* dump = A1DumpFile()) {
+    (void)std::fwrite(a1_.x_host, a1_.row_bytes, a1_.rows, dump);
+    (void)std::fflush(dump);
+  }
+  if ((st.passes & 0xFF) == 0)
+    A1LogSummary();
+}
+
+void Executor::A1LogSummary() const {
+  const auto& st = a1_.stats;
+  if (st.passes == 0)
+    return;
+  A1Log(0, "event=a1_summary passes=" + std::to_string(st.passes) +
+               " rows=" + std::to_string(st.rows) + " mean_candidates=" +
+               std::to_string(static_cast<double>(st.candidates) /
+                              std::max<std::uint64_t>(1, st.rows)) +
+               " max_candidates=" + std::to_string(st.max_candidates) +
+               " flagged_rows=" + std::to_string(st.fallback_flagged) +
+               " full_rows=" + std::to_string(st.full_rows) +
+               " materialized=" + std::to_string(st.materialized) +
+               " readback_invalid=" + std::to_string(st.readback_invalid));
+}
+
+bool Executor::A1FullRows(std::uint32_t first, std::uint32_t count,
+                          std::string* error_msg) const {
+  if (!a1_.pass || count == 0)
+    return true;
+  const std::uint32_t global = a1_.offset + first;
+  if (global + count > a1_.rows) {
+    AssignError(error_msg, "A1 rows outside the screened pass");
+    return false;
+  }
+  const std::uint64_t bits =
+      (count >= 64 ? ~std::uint64_t{0} : (std::uint64_t{1} << count) - 1)
+      << global;
+  if ((a1_.full & bits) == bits)
+    return true;
+  // The production head GEMV over the pass's own input rows: per-row
+  // arithmetic is independent of the batch width (mul_mat_vec_q8 /
+  // mul_mat_q8_decode_batch), so these rows equal the full pass's.
+  const auto& w = model_->output();
+  if (qfn_mmq_q8_0_dense_vec_preq(
+          w.data, nullptr, a1_.x + std::size_t{global} * a1_.row_bytes,
+          a1_.logits + std::size_t{global} * w.rows, static_cast<int>(w.rows),
+          static_cast<int>(count), static_cast<int>(w.cols), stream_) != 0) {
+    AssignError(error_msg, "A1 full-head fallback failed");
+    return false;
+  }
+  a1_.full |= bits;
+  a1_.stats.full_rows += count;
+  return Check(hipGetLastError(), "A1 full-head fallback", error_msg);
+}
+
+bool Executor::A1StagedFrontier(std::uint32_t row, A1Frontier* frontier) const {
+  frontier->valid = false;
+  if (!a1_.pass)
+    return false;
+  const std::uint32_t global = a1_.offset + row;
+  if (global >= a1_.rows)
+    return false;
+  const A1Result e = a1_.result_host[global];
+  if (!A1Valid(e, global) || e.index < 0 || !std::isfinite(e.value) ||
+      static_cast<std::uint32_t>(e.index) >= config().vocab_size) {
+    if (!A1Valid(e, global)) {
+      ++a1_.stats.readback_invalid;
+      A1Log(1, "event=a1_readback_invalid site=frontier row=" +
+                   std::to_string(global));
+    }
+    return false;
+  }
+  frontier->valid = true;
+  frontier->index = e.index;
+  frontier->value = e.value;
+  frontier->x.assign(a1_.x_host + std::size_t{global} * a1_.row_bytes,
+                     a1_.x_host + std::size_t{global + 1} * a1_.row_bytes);
+  return true;
+}
+
+bool Executor::A1TakeFrontier(std::uint32_t row, A1Frontier* frontier,
+                              float* logits, std::string* error_msg) const {
+  if (!a1_.pass) {
+    AssignError(error_msg, "A1 frontier without a screened pass");
+    return false;
+  }
+  if (A1StagedFrontier(row, frontier))
+    return true;
+  // The full production row, as a plain decode downloads it.
+  const auto vocab = config().vocab_size;
+  if (!A1FullRows(row, 1, error_msg) ||
+      !CopyPinned(VerificationLogits() + std::size_t{row} * vocab, logits_host_,
+                  vocab * sizeof(float), hipMemcpyDeviceToHost, stream_,
+                  "A1 frontier download", error_msg) ||
+      !Wait("A1 frontier", error_msg))
+    return false;
+  std::copy_n(logits_host_, vocab, logits);
+  return true;
+}
+
+bool Executor::A1MaterializeRow(std::span<const std::uint8_t> x, float* logits,
+                                std::string* error_msg) const {
+  // Audit follow-ups #5/#6: without A1 buffers, an encoded frontier (staged
+  // by an armed verify pass, or restored from a snapshot) is materialized
+  // with the same head GEMV through the w3af buffers. Knobs unset: the
+  // production statements (no A1 buffers -> the error below).
+  if (a1_.row == nullptr && w3af::AnyArgmax())
+    return AfMaterializeRow(x, logits, error_msg);
+  if (a1_.row == nullptr || x.size() != a1_.row_bytes) {
+    AssignError(error_msg, "A1 frontier cannot be materialized");
+    return false;
+  }
+  const auto& w = model_->output();
+  std::memcpy(a1_.upload_host, x.data(), x.size());
+  if (!CopyPinned(a1_.upload_host, a1_.row_x, x.size(), hipMemcpyHostToDevice,
+                  stream_, "A1 frontier input upload", error_msg))
+    return false;
+  if (qfn_mmq_q8_0_dense_vec_preq(w.data, nullptr, a1_.row_x, a1_.row,
+                                  static_cast<int>(w.rows), 1,
+                                  static_cast<int>(w.cols), stream_) != 0) {
+    AssignError(error_msg, "A1 frontier GEMV failed");
+    return false;
+  }
+  if (!Check(hipGetLastError(), "A1 frontier GEMV", error_msg) ||
+      !CopyPinned(a1_.row, logits_host_, w.rows * sizeof(float),
+                  hipMemcpyDeviceToHost, stream_, "A1 frontier download",
+                  error_msg) ||
+      !Wait("A1 frontier", error_msg))
+    return false;
+  std::copy_n(logits_host_, w.rows, logits);
+  ++a1_.stats.materialized;
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// Engine-audit follow-ups #5/#6 (w3af_followups.h; GUFO_AF_VERIFY_ARGMAX for
+// C1 Forward, GUFO_AF_BATCH_ARGMAX for C8 ForwardBatch). An armed verify pass
+// ends, after the production head, with the production GreedyMtpPredictions
+// kernels (LaunchBatchedGPUArgmax + GatherArgmaxCandidates) over every logits
+// row and two mapped copies: the argmax rows and the head's Q8_1 input rows.
+// All of it is queued before the pass's completion flag. The argmax is a pure
+// function of each row (lowest index of the finite maximum, whichever
+// reduction path runs), so rows 0..k-2 equal GreedyMtpPredictions' and row
+// k-1 is the frontier's own SampleGreedy pick. The staged input is the one
+// the production head GEMV read, so AfMaterializeRow recomputes the frontier
+// row bitwise (the head GEMV's per-row arithmetic does not depend on the
+// batch width: the property strict C8 already relies on, and A1's
+// A1FullRows). Unarmed: none of this runs.
+bool Executor::AfUsable(std::uint32_t rows) const noexcept {
+  const auto& w = model_->output();
+  return !af_.disabled && !af_.setup_failed && rows >= 1 &&
+         rows <= kArgmaxParts && s_.mtp_ids != nullptr &&
+         s_.mtp_scratch_ids != nullptr && s_.mtp_argmax != nullptr &&
+         w.data != nullptr && w.type == GgmlType::kQ8_0 &&
+         w.rows == config().vocab_size && UnpaddedQ8(w.cols);
+}
+
+void Executor::AfDisable(const std::string& reason) const {
+  if (!af_.disabled) {
+    std::fprintf(stderr, "[ERROR] [w3af] event=w3af_disabled reason=%s\n",
+                 reason.c_str());
+    std::fflush(stderr);
+  }
+  af_.disabled = true;
+}
+
+bool Executor::AfEnsureStaging(std::string* error_msg) const {
+  if (af_.pred_host != nullptr)
+    return true;
+  const auto& w = model_->output();
+  const std::uint32_t capacity = kArgmaxParts;
+  const std::size_t row_bytes = qfn_mmq_q8_1_bytes(1, static_cast<int>(w.cols));
+  ArgmaxCandidate* pred = nullptr;
+  std::uint8_t* x = nullptr;
+  if (!Check(host_allocations_.Allocate(
+                 &pred, capacity * sizeof(ArgmaxCandidate), ResultHostFlags()),
+             "w3af prediction staging", error_msg) ||
+      !Check(host_allocations_.Allocate(&x, capacity * row_bytes,
+                                        ResultHostFlags()),
+             "w3af head input staging", error_msg)) {
+    af_.setup_failed = true;
+    return false;
+  }
+  // The one-row materialization buffers too, so a later lazy frontier never
+  // allocates device memory mid-serving (AfMaterializeRow keeps a fallback).
+  if (!AfEnsureRowBuffers(error_msg)) {
+    af_.setup_failed = true;
+    return false;
+  }
+  af_.capacity = capacity;
+  af_.row_bytes = row_bytes;
+  af_.x_host = x;
+  af_.pred_host = pred;
+  w3af::ArmStaged(af_.pred_host, af_.capacity);
+  return true;
+}
+
+bool Executor::AfEnsureRowBuffers(std::string* error_msg) const {
+  if (af_.row != nullptr)
+    return true;
+  const auto& w = model_->output();
+  const std::size_t row_bytes = qfn_mmq_q8_1_bytes(1, static_cast<int>(w.cols));
+  void* row = nullptr;
+  void* row_x = nullptr;
+  if (!Check(hip::AllocateDevice(&row, std::size_t{w.rows} * sizeof(float)),
+             "w3af frontier row allocation", error_msg))
+    return false;
+  if (!Check(hip::AllocateDevice(&row_x, row_bytes),
+             "w3af frontier input allocation", error_msg)) {
+    (void)hipFree(row);
+    return false;
+  }
+  std::uint8_t* upload = nullptr;
+  if (!Check(host_allocations_.Allocate(&upload, row_bytes, ResultHostFlags()),
+             "w3af frontier upload staging", error_msg)) {
+    (void)hipFree(row);
+    (void)hipFree(row_x);
+    return false;
+  }
+  auto& owned = const_cast<Executor*>(this)->allocations_;
+  owned.push_back(row);
+  owned.push_back(row_x);
+  af_.row = static_cast<float*>(row);
+  af_.row_x = static_cast<std::uint8_t*>(row_x);
+  af_.upload_host = upload;
+  return true;
+}
+
+bool Executor::AfStageRows(const void* x_q8, const float* logits,
+                           std::uint32_t rows, std::string* error_msg) const {
+  af_.staged = false;
+  if (af_.pred_host == nullptr || rows == 0 || rows > af_.capacity)
+    return true;  // nothing staged: every reader takes the production path
+  // Host first: every slot holds the sentinel until this pass's copy lands.
+  w3af::ArmStaged(af_.pred_host, rows);
+  if (x_q8 == nullptr)
+    return true;  // the head took no Q8_1 rows: production path (fallbacks)
+  const auto vocab = config().vocab_size;
+  gufo::hip::LaunchBatchedGPUArgmax(
+      logits, s_.mtp_ids, rows, vocab,
+      {reinterpret_cast<float*>(s_.mtp_scratch_ids),
+       MtpCandidateWorkspaceSize(vocab)},
+      stream_);
+  GatherArgmaxCandidates(logits, s_.mtp_ids, s_.mtp_argmax, rows, vocab,
+                         stream_);
+  // The head inputs are copied before the predictions on the same stream:
+  // a delivered (non-sentinel) prediction implies its input row landed.
+  af_.staged =
+      Check(hipGetLastError(), "w3af argmax launch", error_msg) &&
+      CopyPinned(x_q8, af_.x_host, rows * af_.row_bytes, hipMemcpyDeviceToHost,
+                 stream_, "w3af input staging", error_msg) &&
+      CopyPinned(s_.mtp_argmax, af_.pred_host, rows * sizeof(ArgmaxCandidate),
+                 hipMemcpyDeviceToHost, stream_, "w3af prediction staging",
+                 error_msg);
+  return af_.staged;
+}
+
+void Executor::AfAfterPass(std::uint32_t rows) const {
+  af_.pass = af_.staged;  // false: nothing staged, production statements
+  af_.staged = false;
+  if (!af_.pass)
+    return;
+  af_.rows = rows;
+  af_.offset = 0;
+  w3afstats::Get().staged_rows.fetch_add(rows, std::memory_order_relaxed);
+  w3afstats::Bump(w3afstats::Get().staged_passes, "staged_pass");
+}
+
+bool Executor::AfTakePredictions(std::uint32_t first,
+                                 std::span<ArgmaxCandidate> out) const {
+  const auto rows = static_cast<std::uint32_t>(out.size());
+  if (!af_.pass || af_.disabled || rows == 0 ||
+      !w3af::SliceInside(af_.offset + first, rows, af_.rows) ||
+      !w3af::StagedValid(af_.pred_host + af_.offset + first, rows,
+                         config().vocab_size)) {
+    w3afstats::Bump(w3afstats::Get().fallbacks, "fallback");
+    return false;
+  }
+  std::copy_n(af_.pred_host + af_.offset + first, rows, out.begin());
+  w3afstats::Bump(w3afstats::Get().taken, "taken");
+  return true;
+}
+
+bool Executor::AfStagedFrontier(std::uint32_t row, A1Frontier* frontier) const {
+  frontier->valid = false;
+  const std::uint32_t global = af_.offset + row;
+  if (!af_.pass || af_.disabled || !w3af::SliceInside(global, 1, af_.rows) ||
+      !w3af::StagedValid(af_.pred_host + global, 1, config().vocab_size))
+    return false;
+  frontier->valid = true;
+  frontier->index = af_.pred_host[global].index;
+  frontier->value = af_.pred_host[global].value;
+  frontier->x.assign(af_.x_host + std::size_t{global} * af_.row_bytes,
+                     af_.x_host + std::size_t{global + 1} * af_.row_bytes);
+  w3afstats::Bump(w3afstats::Get().lazy_frontiers, "lazy_frontier");
+  return true;
+}
+
+bool Executor::AfMaterializeRow(std::span<const std::uint8_t> x, float* logits,
+                                std::string* error_msg) const {
+  const auto& w = model_->output();
+  const std::size_t row_bytes = qfn_mmq_q8_1_bytes(1, static_cast<int>(w.cols));
+  if (w.type != GgmlType::kQ8_0 || x.size() != row_bytes) {
+    AssignError(error_msg, "w3af frontier cannot be materialized");
+    return false;
+  }
+  if (!AfEnsureRowBuffers(error_msg))
+    return false;
+  // A1MaterializeRow's statements over this state's buffers.
+  std::memcpy(af_.upload_host, x.data(), x.size());
+  if (!CopyPinned(af_.upload_host, af_.row_x, x.size(), hipMemcpyHostToDevice,
+                  stream_, "w3af frontier input upload", error_msg))
+    return false;
+  if (qfn_mmq_q8_0_dense_vec_preq(w.data, nullptr, af_.row_x, af_.row,
+                                  static_cast<int>(w.rows), 1,
+                                  static_cast<int>(w.cols), stream_) != 0) {
+    AssignError(error_msg, "w3af frontier GEMV failed");
+    return false;
+  }
+  if (!Check(hipGetLastError(), "w3af frontier GEMV", error_msg) ||
+      !CopyPinned(af_.row, logits_host_, w.rows * sizeof(float),
+                  hipMemcpyDeviceToHost, stream_, "w3af frontier download",
+                  error_msg) ||
+      !Wait("w3af frontier", error_msg))
+    return false;
+  std::copy_n(logits_host_, w.rows, logits);
+  w3afstats::Bump(w3afstats::Get().materialized, "materialized");
+  return true;
+}
+
+bool Executor::AfFinishDeferredRollbacks(std::string* error_msg) const {
+  af_.defer_waits = false;
+  if (!af_.waits.Take())
+    return true;
+  w3afstats::Bump(w3afstats::Get().batch_waits, "batch_wait");
+  return Wait("w3af deferred rollbacks", error_msg);
+}
+
+void Executor::AfNoteCheck(const char* site, bool match,
+                           const std::string& detail) const {
+  w3afstats::Get().checks.fetch_add(1, std::memory_order_relaxed);
+  if (match)
+    return;
+  w3afstats::Bump(w3afstats::Get().check_mismatches, "check_mismatch");
+  std::fprintf(stderr, "[WARN] [w3af] event=w3af_check_mismatch site=%s %s\n",
+               site, detail.c_str());
+  std::fflush(stderr);
+}
