+// Wave3 Q2L 226c (q2live-226, queue 226c; TEST build w3q2l_server only): the device side of the screened TOP-2
+// draft call (w3q2l_top2.hpp), compiled INSIDE kernels.hip.cpp's translation unit, inside namespace
+// gufo::models::qwen38_flash_next::rocm, right after w3q2l_kernels.inc (kThreads is production's definition above).
+//   Q2lTop2Kernel    the best two of the 64 rescored rows + the draft-table rows in production's MtpTopCandidates<2>
+//                    order (MtpCandidateTileKernel: key = non-finite -> -inf, -0 -> +0, descending, stable = lower index
+//                    first among equal keys; score = the logit, -inf when non-finite); one block of kThreads
+//   Q2lCheck2Kernel  check mode only (GUFO_Q2_CHECK=1): counters against production's own MtpTopCandidates<2> + GEMV
+//                    logits, then the commit of the screened top-2 into production's candidate buffers
+namespace w3q2l2k {
+namespace {
+
+struct T2 {
+  float v[2];
+  std::int32_t i[2];
+};
+
+__device__ __forceinline__ float T2Key(float v) { return isfinite(v) ? (v == 0.0F ? 0.0F : v) : -INFINITY; }
+
+__device__ __forceinline__ bool T2Before(float av, std::int32_t ai, float bv, std::int32_t bi) {
+  const float a = T2Key(av), b = T2Key(bv);
+  return a > b || (a == b && ai < bi);
+}
+
+__device__ __forceinline__ void T2Insert(T2& t, float v, std::int32_t i) {
+  if (T2Before(v, i, t.v[0], t.i[0])) {
+    t.v[1] = t.v[0];
+    t.i[1] = t.i[0];
+    t.v[0] = v;
+    t.i[0] = i;
+  } else if (T2Before(v, i, t.v[1], t.i[1])) {
+    t.v[1] = v;
+    t.i[1] = i;
+  }
+}
+
+__global__ __launch_bounds__(256) void Q2lTop2Kernel(const std::uint32_t* __restrict__ ids,
+                                                     const float* __restrict__ resc, std::uint32_t k,
+                                                     const float* __restrict__ table, std::uint32_t table_rows,
+                                                     std::uint32_t prefix, std::uint32_t* __restrict__ out_ids,
+                                                     float* __restrict__ out_scores,
+                                                     std::uint32_t* __restrict__ counters,
+                                                     std::uint32_t* __restrict__ counters2) {
+  __shared__ T2 shared[kThreads];
+  T2 t{{-INFINITY, -INFINITY}, {INT32_MAX, INT32_MAX}};
+  for (std::uint32_t j = threadIdx.x; j < table_rows; j += kThreads)
+    T2Insert(t, table[j], static_cast<std::int32_t>(prefix + j));
+  for (std::uint32_t i = threadIdx.x; i < k; i += kThreads)
+    T2Insert(t, resc[i], static_cast<std::int32_t>(ids[i]));
+  shared[threadIdx.x] = t;
+  __syncthreads();
+  for (unsigned s = kThreads / 2; s > 0; s >>= 1) {
+    if (threadIdx.x < s) {
+      T2 a = shared[threadIdx.x];
+      const T2 b = shared[threadIdx.x + s];
+      T2Insert(a, b.v[0], b.i[0]);
+      T2Insert(a, b.v[1], b.i[1]);
+      shared[threadIdx.x] = a;
+    }
+    __syncthreads();
+  }
+  if (threadIdx.x == 0) {
+    const T2 r = shared[0];
+    bool nonfinite = false;
+    for (int c = 0; c < 2; ++c) {
+      nonfinite |= !isfinite(r.v[c]);
+      out_ids[c] = static_cast<std::uint32_t>(r.i[c]);
+      out_scores[c] = isfinite(r.v[c]) ? r.v[c] : -INFINITY;
+    }
+    atomicAdd(&counters[0], 1u);
+    atomicAdd(&counters2[0], 1u);
+    if (nonfinite)
+      atomicAdd(&counters2[6], 1u);
+  }
+}
+
+// prod_ids / prod_scores = production's MtpTopCandidates<2> output of the same row (ids before RemapDraftIds), logits =
+// production's head GEMV logits of that row (prefix rows first, then the table rows).
+__global__ __launch_bounds__(64) void Q2lCheck2Kernel(std::uint32_t* __restrict__ prod_ids,
+                                                      float* __restrict__ prod_scores,
+                                                      const std::uint32_t* __restrict__ mine_ids,
+                                                      const float* __restrict__ mine_scores,
+                                                      const float* __restrict__ logits,
+                                                      const std::uint32_t* __restrict__ ids,
+                                                      const float* __restrict__ resc, std::uint32_t k,
+                                                      std::uint32_t screened_rows,
+                                                      std::uint32_t* __restrict__ counters2) {
+  __shared__ unsigned in_flags;
+  if (threadIdx.x == 0)
+    in_flags = 0u;
+  __syncthreads();
+  const std::uint32_t p0 = prod_ids[0], p1 = prod_ids[1];
+  std::uint32_t bad = 0;
+  unsigned in = 0u;
+  for (std::uint32_t i = threadIdx.x; i < k; i += blockDim.x) {
+    const std::uint32_t id = ids[i];
+    if (__float_as_uint(resc[i]) != __float_as_uint(logits[id]))
+      ++bad;
+    in |= (id == p0 ? 1u : 0u) | (id == p1 ? 2u : 0u);
+  }
+  if (bad != 0)
+    atomicAdd(&counters2[7], bad);
+  if (in != 0u)
+    atomicOr(&in_flags, in);
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    const bool in0 = p0 >= screened_rows || (in_flags & 1u) != 0u;  // table rows are always exact
+    const bool in1 = p1 >= screened_rows || (in_flags & 2u) != 0u;
+    const bool d0 = mine_ids[0] != p0 || __float_as_uint(mine_scores[0]) != __float_as_uint(prod_scores[0]);
+    const bool d1 = mine_ids[1] != p1 || __float_as_uint(mine_scores[1]) != __float_as_uint(prod_scores[1]);
+    atomicAdd(&counters2[1], 1u);
+    if (d0)
+      atomicAdd(&counters2[2], 1u);
+    if (d1)
+      atomicAdd(&counters2[3], 1u);
+    if (in0 && in1) {
+      atomicAdd(&counters2[4], 1u);
+      if (d0 || d1)
+        atomicAdd(&counters2[5], 1u);
+    }
+    if (p1 < screened_rows) {
+      atomicAdd(&counters2[8], 1u);
+      if ((in_flags & 2u) != 0u)
+        atomicAdd(&counters2[9], 1u);
+    }
+    // the commit: the screened top-2 is the one the call uses
+    for (int c = 0; c < 2; ++c) {
+      prod_ids[c] = mine_ids[c];
+      prod_scores[c] = mine_scores[c];
+    }
+  }
+}
+
+}  // namespace
+}  // namespace w3q2l2k
+
+void Q2lTop2(const std::uint32_t* ids, const float* resc, std::uint32_t k, const float* table, std::uint32_t table_rows,
+             std::uint32_t prefix, std::uint32_t* out_ids, float* out_scores, std::uint32_t* counters,
+             std::uint32_t* counters2, hipStream_t stream) {
+  hipLaunchKernelGGL(w3q2l2k::Q2lTop2Kernel, dim3(1), dim3(kThreads), 0, stream, ids, resc, k, table, table_rows,
+                     prefix, out_ids, out_scores, counters, counters2);
+}
+
+void Q2lCheck2(std::uint32_t* prod_ids, float* prod_scores, const std::uint32_t* mine_ids, const float* mine_scores,
+               const float* logits, const std::uint32_t* ids, const float* resc, std::uint32_t k,
+               std::uint32_t screened_rows, std::uint32_t* counters2, hipStream_t stream) {
+  hipLaunchKernelGGL(w3q2l2k::Q2lCheck2Kernel, dim3(1), dim3(64), 0, stream, prod_ids, prod_scores, mine_ids,
+                     mine_scores, logits, ids, resc, k, screened_rows, counters2);
+}
+
+// Exactly the w3q2l_top2.hpp declarations (an overload would make these address-of pins ambiguous: no compile).
+namespace {
+[[maybe_unused]] constexpr auto kW3q2lPinTop2 = &Q2lTop2;
+[[maybe_unused]] constexpr auto kW3q2lPinCheck2 = &Q2lCheck2;
+}  // namespace
