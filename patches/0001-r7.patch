+++ b/src/cli/serve/pread_hint.hpp
@@ -0,0 +1,84 @@
+#ifndef GUFO_CLI_SERVE_PREAD_HINT_HPP_
+#define GUFO_CLI_SERVE_PREAD_HINT_HPP_
+
+// combo-c4 member `pread` (halogen 0.20.0 item 3): engram (PLE n-gram table) row pre-read on request arrival.
+// GUFO_ENGRAM_PREREAD exactly "1": TextGenerationScheduler::Submit (right after tokenization, before queueing) hands the
+// uncached first-pass tokens to the model runner; a background thread hashes their table rows exactly as the executor
+// will (HashNgramRows) and asks the OS to read those pages of the mapped table (one PrefetchVirtualMemory call). The
+// pages land in the standby list, which NgramTable's cached reads of the same file then find. Read-only: no buffer,
+// table, cache or counter the model reads is written, so outputs are bit-identical. Unset/0: nothing is read or run.
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <span>
+#include <string_view>
+#include <vector>
+
+#include "src/cli/serve/text_model_runner.hpp"
+
+namespace gufo::server {
+
+/// Implemented by runners whose model gathers rows of a disk-resident table during prefill.
+class TextPromptRowHinter {
+public:
+  virtual ~TextPromptRowHinter() = default;
+  /// Never blocks on I/O: copies at most kPrereadMaxTokens tokens from `start` and queues them (or drops them when
+  /// the queue is full). `start` is the prefix the request expects to restore.
+  virtual void HintPromptRows(std::span<const TextRunnerToken> prompt, std::size_t start) const noexcept = 0;
+};
+
+namespace preread {
+
+inline bool On() noexcept {
+  static const bool on = [] {
+    const char* v = std::getenv("GUFO_ENGRAM_PREREAD");
+    return v != nullptr && std::string_view(v) == "1";
+  }();
+  return on;
+}
+
+inline constexpr std::size_t kMaxTokens = 4096;   // first prefill pass at most (later passes are prefetched already)
+inline constexpr std::size_t kMaxPages = 65536;   // <= 256 MiB of 4 KiB pages per request
+inline constexpr std::size_t kMaxQueued = 2;      // pending requests; newer hints are dropped beyond this
+
+/// The executor's NgramHistory before position `start` of `prompt`: newest first, -1 (kNone) before token 0.
+template <std::size_t N>
+inline std::array<std::int32_t, N> HistoryBefore(std::span<const TextRunnerToken> prompt, std::size_t start) {
+  std::array<std::int32_t, N> prev{};
+  for (std::size_t s = 0; s < N; ++s)
+    prev[s] = start > s && start - 1 - s < prompt.size() ? static_cast<std::int32_t>(prompt[start - 1 - s]) : -1;
+  return prev;
+}
+
+/// Page starts (ascending, unique) covering every row in `rows` of a table of `table_rows` rows of `row_bytes`
+/// bytes mapped at `base`. Rows out of range are skipped. At most `max_pages` pages (lowest first).
+inline std::vector<std::uintptr_t> PlanPages(std::span<const std::uint32_t> rows, std::uintptr_t base,
+                                             std::size_t row_bytes, std::uint64_t table_rows, std::size_t page,
+                                             std::size_t max_pages) {
+  std::vector<std::uintptr_t> pages;
+  if (row_bytes == 0 || page == 0 || (page & (page - 1)) != 0)
+    return pages;
+  pages.reserve(rows.size() + rows.size() / 16 + 1);
+  const std::uintptr_t mask = ~static_cast<std::uintptr_t>(page - 1);
+  for (const auto row : rows) {
+    if (row >= table_rows)
+      continue;
+    const std::uintptr_t first = base + static_cast<std::uintptr_t>(row) * row_bytes;
+    const std::uintptr_t last = first + row_bytes - 1;
+    for (std::uintptr_t p = first & mask; p <= (last & mask); p += page)
+      pages.push_back(p);
+  }
+  std::ranges::sort(pages);
+  pages.erase(std::unique(pages.begin(), pages.end()), pages.end());
+  if (pages.size() > max_pages)
+    pages.resize(max_pages);
+  return pages;
+}
+
+}  // namespace preread
