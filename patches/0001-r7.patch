+namespace w3gscan_host {
+constexpr std::uint32_t kMaxRows = 4096;     // the largest prefill chunk (RouteRows); larger calls are not probed
+constexpr std::uint32_t kStateFloats = 48u * 128u * 128u;
+constexpr int kSlots = 2 * (w3gscan::kVariants + 4) + 4 * w3gscan::kSweepCount * (w3gscan::kVariants + 1);
+enum Arm : int { kProdAgain = 0, kProdEpi = w3gscan::kVariants + 1, kProdTail = w3gscan::kVariants + 2 };
+constexpr int kTimed = w3gscan::kVariants + 3;   // prod_again, v1..v10, prod_epi, prod_tail
+struct Totals {
+  unsigned long long calls = 0, rows = 0;
+  double ms[kTimed] = {};
+};
+struct State {
+  int mode = 0;
+  bool dead = false;
+  std::string dump;
+  unsigned dumped = 0;
+  unsigned long long sweep_calls = 0;
+  unsigned long long calls = 0, probed = 0, skipped = 0, sweeps = 0, sweep_rows = 0, compared = 0, mismatch = 0,
+                     det_mismatch = 0, fused_compared = 0, ckpt_compared = 0, uses = 0, fused_uses = 0, use_rows = 0;
+  unsigned long long class_calls[w3gscan::kClasses] = {};
+  unsigned long long var_mismatch[w3gscan::kVariants + 1] = {};
+  Totals tot[w3gscan::kClasses];
+  std::string first_bad = "none";
+  // device probe buffers
+  float* s0 = nullptr;
+  float* s_run = nullptr;
+  float* ck_a = nullptr;
+  float* ck_b = nullptr;
+  float* ck_ref_a = nullptr;
+  float* ck_ref_b = nullptr;
+  float* s_ref = nullptr;
+  float* raw_ref = nullptr;
+  float* raw_var = nullptr;
+  __half* out_ref = nullptr;
+  __half* out_var = nullptr;
+  unsigned long long* cmp = nullptr;
+  std::vector<unsigned long long> cmp_host;
+  hipEvent_t ev[2 * kTimed] = {};
+  bool alloc_ok = false;
+};
+
+inline const char* Name(int v) { return w3gscan::kTable[v].name; }
+
+inline State& Get() {
+  static State* state = [] {
+    auto* s = new State;
+    const char* v = std::getenv("GUFO_GDN_SCAN");
+    const int mode = w3gscan::ParseMode(v);
+    if (mode == w3gscan::kModeOff)
+      return s;
+    if (mode == w3gscan::kModeInvalid) {
+      std::fprintf(stderr, "event=w3gscan_config mode=0 invalid=%s\n", v);
+      std::fflush(stderr);
+      return s;
+    }
+    s->mode = mode;
+    if (mode == w3gscan::kModeProbe) {
+      const char* dump = std::getenv("GUFO_GDN_SCAN_DUMP");
+      s->dump = dump != nullptr ? dump : "";
+      std::fprintf(stderr, "event=w3gscan_config mode=%d variant=probe variants=%d sweep_sizes=%d max_rows=%u dump=%s\n",
+                   mode, w3gscan::kVariants, w3gscan::kSweepCount, kMaxRows, s->dump.empty() ? "none" : s->dump.c_str());
+    } else {
+      const auto& t = w3gscan::kTable[mode];
+      std::fprintf(stderr, "event=w3gscan_config mode=%d variant=%s kind=%s rows=%d waves=%d window=%d ahead=%d fuse=%d\n",
+                   mode, t.name, t.kind == w3gscan::kTile ? "tile" : "lanerow", t.rows, t.waves, t.window, t.ahead,
+                   t.fuse ? 1 : 0);
+    }
+    std::fflush(stderr);
+    return s;
+  }();
+  return *state;
+}
+
+inline bool Ok(hipError_t e) { return e == hipSuccess; }
+
+inline bool Alloc(State& s) {
+  if (s.alloc_ok)
+    return true;
+  if (s.dead)
+    return false;
+  const std::size_t sb = std::size_t{kStateFloats} * sizeof(float);
+  const std::size_t rb = std::size_t{kMaxRows} * 6144u * sizeof(float);
+  const std::size_t hb = std::size_t{kMaxRows} * (6144u + 32u) * sizeof(__half);
+  bool ok = true;
+  for (float** p : {&s.s0, &s.s_run, &s.ck_a, &s.ck_b, &s.ck_ref_a, &s.ck_ref_b, &s.s_ref})
+    ok = ok && Ok(hipMalloc(reinterpret_cast<void**>(p), sb));
+  ok = ok && Ok(hipMalloc(reinterpret_cast<void**>(&s.raw_ref), rb)) &&
+       Ok(hipMalloc(reinterpret_cast<void**>(&s.raw_var), rb)) &&
+       Ok(hipMalloc(reinterpret_cast<void**>(&s.out_ref), hb)) &&
+       Ok(hipMalloc(reinterpret_cast<void**>(&s.out_var), hb)) &&
+       Ok(hipMalloc(reinterpret_cast<void**>(&s.cmp), sizeof(unsigned long long) * 2 * kSlots));
+  for (auto& e : s.ev)
+    ok = ok && Ok(hipEventCreate(&e));
+  // The Arena allocator zeroes on the null stream; these buffers are written before every read, but synchronize
+  // once so no allocation-time work can land after a probe launch (047's reference-zeroing hazard).
+  ok = ok && Ok(hipDeviceSynchronize());
+  s.cmp_host.assign(2 * kSlots, 0);
+  if (!ok) {
+    s.dead = true;
+    std::fprintf(stderr, "event=w3gscan_probe_error what=alloc\n");
+    std::fflush(stderr);
+    return false;
+  }
+  s.alloc_ok = true;
+  return true;
+}
+
+inline const char* ClassName(std::uint32_t n) { return w3gscan::kClassName[w3gscan::RowClass(n)]; }
+
+inline void Report(const State& s, bool force) {
+  if (!force && s.calls % 36 != 0)
+    return;
+  std::string vm;
+  for (int v = 1; v <= w3gscan::kVariants; ++v) {
+    vm += (v > 1 ? "," : "");
+    vm += Name(v);
+    vm += ":";
+    vm += std::to_string(s.var_mismatch[v]);
+  }
+  std::fprintf(stderr,
+               "event=w3gscan_probe calls=%llu probed=%llu skipped=%llu classes=%llu/%llu/%llu/%llu sweeps=%llu "
+               "sweep_rows=%llu compared=%llu mismatch=%llu det_mismatch=%llu fused_compared=%llu ckpt_compared=%llu "
+               "variant_mismatch=%s first_bad=%s\n",
+               s.calls, s.probed, s.skipped, s.class_calls[0], s.class_calls[1], s.class_calls[2], s.class_calls[3],
+               s.sweeps, s.sweep_rows, s.compared, s.mismatch, s.det_mismatch, s.fused_compared, s.ckpt_compared,
+               vm.c_str(), s.first_bad.c_str());
+  for (int c = 0; c < w3gscan::kClasses; ++c) {
+    const Totals& t = s.tot[c];
+    if (t.calls == 0)
+      continue;
+    std::string ms;
+    for (int v = 1; v <= w3gscan::kVariants; ++v) {
+      char b[48];
+      std::snprintf(b, sizeof(b), "%s%s=%.4f", v > 1 ? "," : "", Name(v), t.ms[v]);
+      ms += b;
+    }
+    std::fprintf(stderr, "event=w3gscan_time class=%s calls=%llu rows=%llu prod_ms=%.4f prod_tail_ms=%.4f "
+                 "prod_epi_ms=%.4f variants_ms=%s\n",
+                 w3gscan::kClassName[c], t.calls, t.rows, t.ms[kProdAgain], t.ms[kProdTail], t.ms[kProdEpi],
+                 ms.c_str());
+  }
+  std::fflush(stderr);
+}
+
+inline void Compare(State& s, int& slot, const void* a, const void* b, std::size_t rows, std::size_t cols,
+                    std::size_t sa, std::size_t sb, bool half, hipStream_t stream) {
+  unsigned long long* out = s.cmp + 2 * slot;
+  const std::size_t total = rows * cols;
+  const unsigned blocks = static_cast<unsigned>(std::min<std::size_t>((total + 255) / 256, 2048));
+  if (blocks == 0) {
+    ++slot;
+    return;
+  }
+  if (half)
+    hipLaunchKernelGGL(W3GscanCmpKernel<std::uint16_t>, dim3(blocks), dim3(256), 0, stream,
+                       static_cast<const std::uint16_t*>(a), static_cast<const std::uint16_t*>(b), rows, cols, sa, sb,
+                       out);
+  else
+    hipLaunchKernelGGL(W3GscanCmpKernel<std::uint32_t>, dim3(blocks), dim3(256), 0, stream,
+                       static_cast<const std::uint32_t*>(a), static_cast<const std::uint32_t*>(b), rows, cols, sa, sb,
+                       out);
+  ++slot;
+}
+
+/// Write one raw little-endian file of `bytes` from device `src` (synchronous; probe arm only).
+inline void DumpFile(const std::string& path, const void* src, std::size_t bytes, hipStream_t stream) {
+  std::vector<unsigned char> h(bytes);
+  if (!Ok(hipMemcpyAsync(h.data(), src, bytes, hipMemcpyDeviceToHost, stream)) || !Ok(hipStreamSynchronize(stream)))
+    return;
+  if (FILE* f = std::fopen(path.c_str(), "wb")) {
+    std::fwrite(h.data(), 1, bytes, f);
+    std::fclose(f);
+  }
+}
+inline void DumpRows(const std::string& path, const float* src, std::size_t rows, std::size_t cols, std::size_t stride,
+                     hipStream_t stream) {
+  std::vector<float> h(rows * cols);
+  for (std::size_t r = 0; r < rows; ++r)
+    if (!Ok(hipMemcpyAsync(h.data() + r * cols, src + r * stride, cols * sizeof(float), hipMemcpyDeviceToHost, stream)))
+      return;
+  if (!Ok(hipStreamSynchronize(stream)))
+    return;
+  if (FILE* f = std::fopen(path.c_str(), "wb")) {
+    std::fwrite(h.data(), sizeof(float), h.size(), f);
+    std::fclose(f);
+  }
+}
+}  // namespace w3gscan_host
+
+/// GUFO_GDN_SCAN mode (0 off, 1..kVariants a variant, kModeProbe), read once.
+int W3GscanMode() { return w3gscan_host::Get().mode; }
+
+/// Variant mode: launch the variant in place of GdnRowSplitKernel; true = its fused epilogue ran (the caller then
+/// skips GdnEpilogueKernel). The fused route needs the F16-output epilogue (out_q8 null, out_half set).
+bool W3GscanRun(int mode, const float* conv, const float* scales, const float* ab, float* state, float* raw,
+                std::uint32_t n, std::uint32_t k_heads, std::uint32_t v_heads, GdnCheckpoint ck, const float* z,
+                std::uint32_t z_stride, const float* norm_w, void* out_q8, __half* out_half,
+                std::uint32_t out_half_stride, float eps, hipStream_t stream) {
+  auto& s = w3gscan_host::Get();
+  const bool fused = w3gscan::kTable[mode].fuse && out_q8 == nullptr && out_half != nullptr;
+  W3GscanEpi epi{z, z_stride, norm_w, out_half, out_half_stride, eps};
+  W3GscanLaunch(mode, fused, conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi, stream);
+  ++s.uses;
+  s.fused_uses += fused ? 1 : 0;
+  s.use_rows += n;
+  if (s.uses % 36 == 0) {
+    std::fprintf(stderr, "event=w3gscan_use variant=%s calls=%llu fused_calls=%llu rows=%llu\n", w3gscan_host::Name(mode),
+                 s.uses, s.fused_uses, s.use_rows);
+    std::fflush(stderr);
+  }
+  return fused;
+}
+
+/// Probe mode, before production's GdnRowSplitKernel launch: keep the initial state.
+bool W3GscanProbeBefore(const float* state, std::uint32_t n, std::uint32_t v_heads, hipStream_t stream) {
+  auto& s = w3gscan_host::Get();
+  ++s.calls;
+  ++s.class_calls[w3gscan::RowClass(n)];
+  if (n == 0 || n > w3gscan_host::kMaxRows || v_heads * 128u * 128u > w3gscan_host::kStateFloats ||
+      !w3gscan_host::Alloc(s)) {
+    ++s.skipped;
+    w3gscan_host::Report(s, false);
+    return false;
+  }
+  return w3gscan_host::Ok(hipMemcpyAsync(s.s0, state, std::size_t{v_heads} * 128u * 128u * sizeof(float),
+                                         hipMemcpyDeviceToDevice, stream));
+}
+
+/// Probe mode, after production's epilogue launch: every variant (and production again) on the same inputs from the
+/// saved initial state into probe buffers, compared bitwise with production's raw rows / final state / checkpoint
+/// states / F16 outputs; per-class kernel times (hipEvents); every 47th call with >= 512 rows also sweeps the prefixes
+/// of w3gscan::kSweep. Production's own buffers are only read.
+void W3GscanProbeAfter(const float* conv, const float* scales, const float* ab, const float* state, const float* raw,
+                       std::uint32_t n, std::uint32_t k_heads, std::uint32_t v_heads, GdnCheckpoint ck,
+                       const float* z, std::uint32_t z_stride, const float* norm_w, void* out_q8, const __half* out_half,
+                       std::uint32_t out_half_stride, float eps, hipStream_t stream) {
+  using namespace w3gscan_host;
+  auto& s = Get();
+  const std::size_t sbytes = std::size_t{v_heads} * 128u * 128u * sizeof(float);
+  const std::size_t width = std::size_t{v_heads} * 128u;
+  const bool half_route = out_q8 == nullptr && out_half != nullptr;
+  const std::size_t hstride = out_half_stride != 0 ? out_half_stride : width;
+  int slot = 0;
+  bool ok = hipGetLastError() == hipSuccess;
+  ok = ok && Ok(hipMemsetAsync(s.cmp, 0, sizeof(unsigned long long) * 2 * kSlots, stream));
+  // first-index slots start at UINT64_MAX
+  std::vector<unsigned long long> init(2 * kSlots, 0);
+  for (int i = 0; i < kSlots; ++i)
+    init[2 * i + 1] = ~0ULL;
+  ok = ok && Ok(hipMemcpyAsync(s.cmp, init.data(), init.size() * sizeof(unsigned long long), hipMemcpyHostToDevice,
+                               stream));
+  struct Rec {
+    int slot;
+    int what;  // variant index; 0 prod_again; -1 prod_tail; -2 prod_epi
+    const char* part;
+    std::uint32_t rows;
+  };
+  std::vector<Rec> recs;
+  const auto cmp = [&](int what, const char* part, std::uint32_t rows, const void* a, const void* b, std::size_t r,
+                       std::size_t c, std::size_t sa, std::size_t sb, bool half) {
+    recs.push_back({slot, what, part, rows});
+    Compare(s, slot, a, b, r, c, sa, sb, half, stream);
+  };
+  const auto ck_of = [&](float* a, float* b, std::uint32_t ta, std::uint32_t tb) {
+    GdnCheckpoint c;
+    c.state = a;
+    c.tokens = ta;
+    c.state2 = b;
+    c.tokens2 = tb;
+    return c;
+  };
+  // the real call's checkpoints, redirected into probe buffers; compared only where production writes them
+  // (1 <= tokens <= n: the kernels store a checkpoint after token `tokens`)
+  const bool ck1 = ck.state != nullptr && ck.tokens >= 1 && ck.tokens <= n;
+  const bool ck2 = ck.state2 != nullptr && ck.tokens2 >= 1 && ck.tokens2 <= n;
+  GdnCheckpoint ck_ref = ck_of(ck1 ? s.ck_ref_a : nullptr, ck2 ? s.ck_ref_b : nullptr, ck.tokens, ck.tokens2);
+  GdnCheckpoint ck_var = ck_of(ck1 ? s.ck_a : nullptr, ck2 ? s.ck_b : nullptr, ck.tokens, ck.tokens2);
+  const int cls = w3gscan::RowClass(n);
+  const auto timed = [&](int which, auto&& launch) {
+    hipEventRecord(s.ev[2 * which], stream);
+    launch();
+    hipEventRecord(s.ev[2 * which + 1], stream);
+  };
+  const auto prod_scan = [&](float* st, float* out, std::uint32_t rows, GdnCheckpoint c) {
+    hipLaunchKernelGGL(GdnRowSplitKernel, dim3(kGdnDim / kGdnRowSplitRowsPerBlock, v_heads), dim3(kGdnWaves * 32), 0,
+                       stream, conv, scales, ab, st, out, rows, k_heads, v_heads, c);
+  };
+  const auto prod_epi = [&](const float* rw, __half* out, std::uint32_t rows, std::uint32_t stride) {
+    const unsigned waves = kThreads / 32;
+    hipLaunchKernelGGL(GdnEpilogueKernel<false>, dim3((rows * v_heads + waves - 1) / waves), dim3(kThreads), 0, stream,
+                       rw, z, z_stride, norm_w, nullptr, nullptr, out, rows * v_heads, v_heads, eps, nullptr, 0,
+                       nullptr, stride);
+  };
+  // prod_again: production's kernel once more from the saved state (determinism + probe-setup control)
+  ok = ok && Ok(hipMemcpyAsync(s.s_ref, s.s0, sbytes, hipMemcpyDeviceToDevice, stream));
+  timed(kProdAgain, [&] { prod_scan(s.s_ref, s.raw_ref, n, ck_ref); });
+  cmp(0, "raw", n, s.raw_ref, raw, n, width, width, width, false);
+  cmp(0, "state", n, s.s_ref, state, 1, sbytes / 4, 0, 0, false);
+  if (ck1)
+    cmp(0, "ckpt", n, s.ck_ref_a, ck.state, 1, sbytes / 4, 0, 0, false);
+  if (ck2)
+    cmp(0, "ckpt2", n, s.ck_ref_b, ck.state2, 1, sbytes / 4, 0, 0, false);
+  if (half_route) {
+    timed(kProdEpi, [&] { prod_epi(s.raw_ref, s.out_ref, n, out_half_stride); });
+    cmp(0, "out", n, s.out_ref, out_half, n, width, hstride, hstride, true);
+  }
+  W3GscanEpi epi{z, z_stride, norm_w, s.out_var, out_half_stride, eps};
+  for (int v = 1; v <= w3gscan::kVariants; ++v) {
+    const bool fused = w3gscan::kTable[v].fuse && half_route;
+    ok = ok && Ok(hipMemcpyAsync(s.s_run, s.s0, sbytes, hipMemcpyDeviceToDevice, stream));
+    // poison every output this variant must write, so a missed write cannot inherit the previous variant's bytes
+    ok = ok && Ok(hipMemsetAsync(fused ? static_cast<void*>(s.out_var) : static_cast<void*>(s.raw_var), 0xff,
+                                 fused ? n * hstride * sizeof(__half) : n * width * sizeof(float), stream));
+    if (ck1)
+      ok = ok && Ok(hipMemsetAsync(s.ck_a, 0xff, sbytes, stream));
+    if (ck2)
+      ok = ok && Ok(hipMemsetAsync(s.ck_b, 0xff, sbytes, stream));
+    timed(v, [&] { W3GscanLaunch(v, fused, conv, scales, ab, s.s_run, s.raw_var, n, k_heads, v_heads, ck_var, epi,
+                                 stream); });
+    if (fused)
+      cmp(v, "out", n, s.out_var, out_half, n, width, hstride, hstride, true);
+    else
+      cmp(v, "raw", n, s.raw_var, raw, n, width, width, width, false);
+    cmp(v, "state", n, s.s_run, state, 1, sbytes / 4, 0, 0, false);
+    if (ck1)
+      cmp(v, "ckpt", n, s.ck_a, ck.state, 1, sbytes / 4, 0, 0, false);
+    if (ck2)
+      cmp(v, "ckpt2", n, s.ck_b, ck.state2, 1, sbytes / 4, 0, 0, false);
+  }
+  ok = ok && Ok(hipMemcpyAsync(s.s_ref, s.s0, sbytes, hipMemcpyDeviceToDevice, stream));
+  timed(kProdTail, [&] { prod_scan(s.s_ref, s.raw_ref, n, ck_ref); });
+  cmp(-1, "raw", n, s.raw_ref, raw, n, width, width, width, false);
+  // prefix sweeps (at most 8 calls of >= 512 rows, every 47th probed call): synthetic checkpoints at (r + 1) / 2 and r
+  bool sweep = n >= 512 && (s.probed % 47 == 0) && s.sweep_calls < 8;
+  if (sweep) {
+    ++s.sweep_calls;
+    for (int i = 0; i < w3gscan::kSweepCount; ++i) {
+      const std::uint32_t r = w3gscan::kSweep[i];
+      if (r > n)
+        continue;
+      const std::uint32_t c1 = (r + 1) / 2;
+      const std::uint32_t pstride = r >= 1024 ? static_cast<std::uint32_t>(width + 32) : 0;
+      const std::size_t ps = pstride != 0 ? pstride : width;
+      ok = ok && Ok(hipMemcpyAsync(s.s_ref, s.s0, sbytes, hipMemcpyDeviceToDevice, stream));
+      prod_scan(s.s_ref, s.raw_ref, r, ck_of(s.ck_ref_a, s.ck_ref_b, c1, r));
+      if (half_route)
+        prod_epi(s.raw_ref, s.out_ref, r, pstride);
+      W3GscanEpi pe{z, z_stride, norm_w, s.out_var, pstride, eps};
+      for (int v = 1; v <= w3gscan::kVariants; ++v) {
+        const bool fused = w3gscan::kTable[v].fuse && half_route;
+        ok = ok && Ok(hipMemcpyAsync(s.s_run, s.s0, sbytes, hipMemcpyDeviceToDevice, stream));
+        ok = ok && Ok(hipMemsetAsync(fused ? static_cast<void*>(s.out_var) : static_cast<void*>(s.raw_var), 0xff,
+                                     fused ? r * ps * sizeof(__half) : r * width * sizeof(float), stream)) &&
+             Ok(hipMemsetAsync(s.ck_a, 0xff, sbytes, stream)) && Ok(hipMemsetAsync(s.ck_b, 0xff, sbytes, stream));
+        W3GscanLaunch(v, fused, conv, scales, ab, s.s_run, s.raw_var, r, k_heads, v_heads, ck_of(s.ck_a, s.ck_b, c1, r),
+                      pe, stream);
+        if (fused)
+          cmp(v, "sweep-out", r, s.out_var, s.out_ref, r, width, ps, ps, true);
+        else
+          cmp(v, "sweep-raw", r, s.raw_var, s.raw_ref, r, width, width, width, false);
+        cmp(v, "sweep-state", r, s.s_run, s.s_ref, 1, sbytes / 4, 0, 0, false);
+        cmp(v, "sweep-ckpt", r, s.ck_a, s.ck_ref_a, 1, sbytes / 4, 0, 0, false);
+        cmp(v, "sweep-ckpt2", r, s.ck_b, s.ck_ref_b, 1, sbytes / 4, 0, 0, false);
+      }
+      ++s.sweeps;
+      s.sweep_rows += r;
+    }
+  }
+  ok = ok && hipGetLastError() == hipSuccess;
+  ok = ok && Ok(hipMemcpyAsync(s.cmp_host.data(), s.cmp, sizeof(unsigned long long) * 2 * kSlots,
+                               hipMemcpyDeviceToHost, stream)) && Ok(hipStreamSynchronize(stream));
+  if (!ok) {
+    std::fprintf(stderr, "event=w3gscan_probe_error what=launch call=%llu rows=%u\n", s.calls, n);
+    std::fflush(stderr);
+    if (s.first_bad == "none")
+      s.first_bad = "probe_error:rows=" + std::to_string(n);
+    ++s.mismatch;
+    Report(s, true);
+    return;
+  }
+  ++s.probed;
+  bool bad_now = false;
+  for (const Rec& r : recs) {
+    const unsigned long long count = s.cmp_host[2 * r.slot];
+    ++s.compared;
+    if (r.what > 0 && std::strstr(r.part, "out") != nullptr)
+      ++s.fused_compared;
+    if (std::strstr(r.part, "ckpt") != nullptr)
+      ++s.ckpt_compared;
+    if (count == 0)
+      continue;
+    bad_now = true;
+    if (r.what <= 0)
+      ++s.det_mismatch;
+    else
+      ++s.var_mismatch[r.what];
+    ++s.mismatch;
+    if (s.first_bad == "none") {
+      s.first_bad = std::string(r.what > 0 ? Name(r.what) : r.what == 0 ? "prod_again" : "prod_tail") + ":" + r.part +
+                    ":rows=" + std::to_string(r.rows) + ":n=" + std::to_string(n) + ":words=" + std::to_string(count) +
+                    ":first=" + std::to_string(s.cmp_host[2 * r.slot + 1]);
+    }
+  }
+  float ms = 0.0f;
+  Totals& t = s.tot[cls];
+  ++t.calls;
+  t.rows += n;
+  for (int i = 0; i < kTimed; ++i) {
+    if (i == kProdEpi && !half_route)
+      continue;
+    if (hipEventElapsedTime(&ms, s.ev[2 * i], s.ev[2 * i + 1]) == hipSuccess)
+      t.ms[i] += ms;
+  }
+  // real-input dump for the host CPU replay (first 6 probed calls with 16..600 rows)
+  if (!s.dump.empty() && s.dumped < 6 && n >= 16 && n <= 600) {
+    const std::string base = s.dump + "/call" + std::to_string(s.dumped);
+    const std::size_t channels = 2 * std::size_t{k_heads} * 128u + width;
+    DumpFile(base + "-conv.f32", conv, n * channels * sizeof(float), stream);
+    DumpFile(base + "-scales.f32", scales, std::size_t{n} * k_heads * 3 * sizeof(float), stream);
+    DumpFile(base + "-ab.f32", ab, std::size_t{n} * v_heads * 2 * sizeof(float), stream);
+    DumpFile(base + "-s0.f32", s.s0, sbytes, stream);
+    DumpFile(base + "-raw.f32", raw, n * width * sizeof(float), stream);
+    DumpFile(base + "-state.f32", state, sbytes, stream);
+    if (FILE* f = std::fopen((base + "-meta.json").c_str(), "w")) {
+      std::fprintf(f, "{\"rows\": %u, \"k_heads\": %u, \"v_heads\": %u, \"channels\": %zu, \"checkpoint_tokens\": %u, "
+                   "\"checkpoint2_tokens\": %u, \"half_route\": %d, \"out_half_stride\": %u, \"eps\": %.9g}\n",
+                   n, k_heads, v_heads, channels, ck.state != nullptr ? ck.tokens : 0u,
+                   ck.state2 != nullptr ? ck.tokens2 : 0u, half_route ? 1 : 0, out_half_stride, eps);
+      std::fclose(f);
+    }
+    std::fprintf(stderr, "event=w3gscan_dump call=%u rows=%u dir=%s\n", s.dumped, n, s.dump.c_str());
+    ++s.dumped;
+  }
+  Report(s, bad_now);
+}
+
+}  // namespace
