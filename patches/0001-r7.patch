+/// R3-23: the grid for a request of `level` (0 = production budget).
+[[nodiscard]] inline std::uint32_t ChunkFor(xm::ExactnessLevel level) {
+  return Get().chunk != 0 && AppliesToLevel(level) ? Get().chunk : 0;
+}
+[[nodiscard]] inline bool ChunkGridAbsolute() { return Get().chunk_absolute; }
+/// R3-24 for a request of `level`; only greedy requests (no random sampling).
+[[nodiscard]] inline bool ToolIdsFor(xm::ExactnessLevel level, bool greedy) {
+  return Get().tool_ids && greedy && AppliesToLevel(level);
+}
+
+/// R3-23 budget. `position` = prompt tokens already in model state (restored or
+/// prefilled), `start` = the restore point (cached prompt tokens). The next cut
+/// lies on the grid origin + k * grid (origin = start, or 0 when absolute); a
+/// remainder of <= kGridTail rows joins the chunk that precedes it. A pure
+/// function of (prompt length, restore point): arrival timing, runnable
+/// decoders and waiting peers never move a cut.
+[[nodiscard]] constexpr std::size_t GridBudget(std::size_t prompt,
+                                               std::size_t position,
+                                               std::size_t start,
+                                               std::size_t grid,
+                                               bool absolute) noexcept {
+  if (position >= prompt)
+    return 0;
+  const std::size_t remaining = prompt - position;
+  if (grid == 0)
+    return remaining;
+  const std::size_t origin = absolute ? 0 : (start <= position ? start : position);
+  const std::size_t budget = grid - (position - origin) % grid;
+  return remaining <= budget + kGridTail ? remaining : budget;
+}
+
+/// R3-23 runtime witness (promo-3cg): the first time PrefillBudget takes the
+/// grid budget, one stderr line. The load line proves the call site is linked;
+/// this line proves it ran.
+inline void NoteChunkApplied(std::uint32_t grid, std::size_t prompt,
+                             std::size_t position, std::size_t start,
+                             std::size_t budget) {
+  static std::atomic<bool> noted{false};
+  if (noted.exchange(true, std::memory_order_relaxed))
+    return;
+  const std::string line =
+      "event=dx_chunk_applied chunk=" + std::to_string(grid) +
+      " grid=" + (ChunkGridAbsolute() ? "absolute" : "relative") +
+      " scope=" + (Get().scope_all ? "all" : "strict") +
+      " prompt=" + std::to_string(prompt) + " position=" + std::to_string(position) +
+      " start=" + std::to_string(start) + " budget=" + std::to_string(budget);
+  std::fprintf(stderr, "[dx] schema=gufo-dx-v1 %s\n", line.c_str());
+  std::fflush(stderr);
+}
