+++ b/src/cache/w3canon.hpp
@@ -0,0 +1,93 @@
+#ifndef GUFO_CACHE_W3CANON_HPP_
+#define GUFO_CACHE_W3CANON_HPP_
+
+// Wave3 R18-20 C1 (canon-ledger, queue 165): canonical-bytes checkpoint ledger.
+// GUFO_CACHE_CANON_BYTES=1 makes every retention byte decision count a checkpoint as
+//   state_bytes + row_bytes x (its boundary - the boundary of its deepest retained ancestor)
+// - a function of token counts only, identical with --speculative off and on - against a FIXED cap, before any
+// physical allocation (ComponentTextCache::Lease::Capture -> RetentionPolicy::CanonReserve). Unset or any other
+// value: production behaviour (no call site acts). Read once per process.
+// GUFO_CACHE_CANON_CAP_BYTES (decimal, > 0) overrides the cap; any other value keeps the default (cap_env=2).
+#include <cstddef>
+#include <cstdlib>
+#include <string_view>
+
+namespace gufo::cache::w3canon {
+// 128 MiB / 28 KiB per row >= the spec arm's measured 132.1 MB + 27.46 KB/row (i2-headpin README s1);
+// cap 5.2e9: the CPU policy replay of 156's request sequences (cl_policy_test.cpp) holds 1.055-1.063 x the
+// canonical bytes physically in the spec arm (chunk granularity, tails), ~5.5e9 at this cap, under the smallest C1
+// spec device-heap pool (6.26e9 ledger - 0.13e9 metadata) with ~0.3e9 left for an in-flight capture and ~0.3e9 for
+// segment fragmentation;
+// turnover 9e9 = the agent profile's --cache-ram-bytes 9e9 (RetentionPolicy's reuse window).
+inline constexpr std::size_t kDefaultCapBytes = 5200000000ULL;
+inline constexpr std::size_t kStateBytes = 134217728ULL;
+inline constexpr std::size_t kRowBytes = 28672ULL;
+inline constexpr std::size_t kTurnoverBytes = 9000000000ULL;
+
+struct Config {
+  bool on{false};
+  std::size_t cap_bytes{kDefaultCapBytes};
+  std::size_t state_bytes{kStateBytes};
+  std::size_t row_bytes{kRowBytes};
+  std::size_t turnover_bytes{kTurnoverBytes};
+  int cap_env{0};  // 0 unset, 1 applied, 2 invalid (default kept)
+  bool diag{false};  // Wave3 165c (R1): GUFO_CL_DIAG=1 -> log-only cache diagnostics
+  bool splitseg{false};  // Wave3 165e (R2): GUFO_CL_SPLITSEG=1 -> one copy per host registration
+  bool snap_sync{false};    // Wave3 165e (R3): GUFO_SNAP_RELEASE_SYNC=1 -> device sync before a snapshot block release
+  bool snap_keep{false};    // Wave3 165e (R3): GUFO_SNAP_POOL_KEEP=1 -> snapshot pool keeps freed pages mapped
+  bool transfer_one{false}; // Wave3 165e (R3): GUFO_CL_TRANSFER_ONE=1 -> cache TransferBatch width 1
+};
+
+inline std::size_t ParseBytes(const char* text, bool& ok) {
+  ok = false;
+  if (text == nullptr || *text == '\0')
+    return 0;
+  std::size_t value = 0;
+  for (const char* p = text; *p != '\0'; ++p) {
+    if (*p < '0' || *p > '9')
+      return 0;
+    const auto digit = static_cast<std::size_t>(*p - '0');
+    if (value > (static_cast<std::size_t>(-1) - digit) / 10)
+      return 0;
+    value = value * 10 + digit;
+  }
+  ok = value != 0;
+  return value;
+}
+
+inline const Config& Knobs() {
+  static const Config config = [] {
+    Config c;
+    if (const char* v = std::getenv("GUFO_CACHE_CANON_BYTES"))
+      c.on = std::string_view(v) == "1";
+    if (const char* v = std::getenv("GUFO_CL_DIAG"))
+      c.diag = std::string_view(v) == "1";
+    if (const char* v = std::getenv("GUFO_CL_SPLITSEG"))
+      c.splitseg = std::string_view(v) == "1";
+    if (const char* v = std::getenv("GUFO_SNAP_RELEASE_SYNC"))
+      c.snap_sync = std::string_view(v) == "1";
+    if (const char* v = std::getenv("GUFO_SNAP_POOL_KEEP"))
+      c.snap_keep = std::string_view(v) == "1";
+    if (const char* v = std::getenv("GUFO_CL_TRANSFER_ONE"))
+      c.transfer_one = std::string_view(v) == "1";
+    if (const char* v = std::getenv("GUFO_CACHE_CANON_CAP_BYTES")) {
+      bool ok = false;
+      const auto bytes = ParseBytes(v, ok);
+      if (ok) {
+        c.cap_bytes = bytes;
+        c.cap_env = 1;
+      } else {
+        c.cap_env = 2;
+      }
+    }
+    return c;
+  }();
+  return config;
+}
+
+inline std::size_t Bytes(const Config& c, std::size_t own_rows) {
+  return c.state_bytes + c.row_bytes * own_rows;
+}
+}  // namespace gufo::cache::w3canon
+
+#endif
diff --git a/src/cli/serve/bc_capture.hpp b/src/cli/serve/bc_capture.hpp
new file mode 100644
--- /dev/null
+++ b/src/cli/serve/bc_capture.hpp
@@ -0,0 +1,161 @@
+#ifndef GUFO_CLI_SERVE_BC_CAPTURE_HPP_
+#define GUFO_CLI_SERVE_BC_CAPTURE_HPP_
+
+// Wave3 R14-05 BOUNDARY-CAPTURE WITHOUT A CUT (bndry-cap, queue 153;
+// ideation/FABLE-IDEAS-ROUND14-2026-10-30.md R14-05, dell-sims-018 item D).
+//
+// Under R3-23 (promo-3cg) a strict request's prefill is cut on a grid relative
+// to its restore point (dx::GridBudget). The component cache also plans
+// optional history checkpoints (cache::PlanCaptures) on ABSOLUTE multiples of
+// 2048 rows, and the runner ends a pass at each of them (PrefillPass::Plan:
+// max_input_tokens = checkpoint - offset). The in-pass checkpoint path (P9)
+// never takes them under the grid: it refuses a chunk shorter than the
+// engine's natural chunk (budget < chunk) and an interior boundary that is not
+// a multiple of 128 rows into the chunk. So a warm 6,159-row continuation
+// restored at 1,751 runs 5 passes (2048, 297, 1751, 297, 1766) instead of the
+// grid's 3: queue 138 shows 26 such extra passes per agent-C8 arm
+// (~241 ms of fixed GPU cost each).
+//
+// GUFO_BC_CAPTURE=1 moves each optional checkpoint onto a pass end the grid
+// cuts anyway (the deepest interior pass end at or before it, else the
+// shallowest after it; dropped if the request is one pass). The checkpoint is
+// then captured after an ordinary pass (no in-pass capture: the captured state
+// is the live state at that row), and the cut schedule of a grid request is
+// exactly dx::GridBudget's plus the required boundaries (prompt snapshot
+// target, stable boundary, shared-prefix boundaries, peer-shared points),
+// which this knob does not touch. Unset / "0" = promo-3cg behaviour; "1" =
+// on; anything else = off and logged valid=0 (the queue's knob check refuses).
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <span>
+#include <string>
+#include <vector>
+
+#include "src/core/dx_determinism.hpp"
+
+namespace gufo::server::bc {
+
+struct Knobs {
+  bool on{false};
+  bool valid{true};
+  std::string requested{"unset"};
+};
+
+[[nodiscard]] inline Knobs ParseKnobs(const char* raw) {
+  Knobs k;
+  if (raw == nullptr)
+    return k;
+  k.requested = raw;
+  if (k.requested.empty() || k.requested == "0")
+    return k;
+  if (k.requested == "1") {
+    k.on = true;
+    return k;
+  }
+  k.valid = false;
+  return k;
+}
+
+[[nodiscard]] inline const Knobs& EnvKnobs() {
+  static const Knobs knobs = ParseKnobs(std::getenv("GUFO_BC_CAPTURE"));
+  return knobs;
+}
+
+/// The pass ends R3-23 cuts for a request restored at `start`: dx::GridBudget
+/// iterated exactly as the scheduler's PrefillBudget grants it (start = the
+/// restore point = cached prompt tokens). The last entry is the prompt end.
+[[nodiscard]] inline std::vector<std::size_t> GridPassEnds(std::size_t prompt,
+                                                           std::size_t start,
+                                                           std::size_t grid,
+                                                           bool absolute) {
+  std::vector<std::size_t> ends;
+  std::size_t position = start;
+  while (position < prompt) {
+    const std::size_t budget =
+        dx::GridBudget(prompt, position, start, grid, absolute);
+    if (budget == 0)
+      break;
+    position += budget;
+    ends.push_back(position);
+  }
+  return ends;
+}
+
+/// Each optional checkpoint moves to an interior pass end (one the grid cuts
+/// anyway, never the prompt end): the deepest at or before it, else the
+/// shallowest after it. With no interior pass end (one-pass request) it is
+/// dropped. Results in `exclude` (the prompt snapshot target and the stable
+/// boundary, which keep their own capture path) and duplicates are dropped.
+/// Ascending. Every result is an element of `ends`, so no cut is added.
+[[nodiscard]] inline std::vector<std::size_t> RemapToPassEnds(
+    std::span<const std::size_t> points, std::span<const std::size_t> ends,
+    std::size_t prompt, std::size_t offset,
+    std::span<const std::size_t> exclude) {
+  std::vector<std::size_t> interior;
+  for (const auto end : ends)
+    if (end > offset && end < prompt)
+      interior.push_back(end);
+  std::vector<std::size_t> out;
+  if (interior.empty())
+    return out;
+  for (const auto point : points) {
+    const auto above =
+        std::upper_bound(interior.begin(), interior.end(), point);
+    const std::size_t moved =
+        above == interior.begin() ? *above : *std::prev(above);
+    if (std::find(exclude.begin(), exclude.end(), moved) != exclude.end())
+      continue;
+    if (std::find(out.begin(), out.end(), moved) == out.end())
+      out.push_back(moved);
+  }
+  std::sort(out.begin(), out.end());
+  return out;
+}
+
+[[nodiscard]] inline std::string JoinRows(std::span<const std::size_t> rows) {
+  if (rows.empty())
+    return "-";
+  std::string text;
+  for (const auto row : rows) {
+    if (!text.empty())
+      text += ',';
+    text += std::to_string(row);
+  }
+  return text;
+}
+
+/// One load-time line (the queue's knob check reads it).
+inline void NoteConfig(const Knobs& knobs) {
+  static std::atomic<bool> noted{false};
+  if (noted.exchange(true, std::memory_order_relaxed))
+    return;
+  const std::string line = "[bc] schema=gufo-bc-v1 event=bc_config requested=" +
+                           knobs.requested + " on=" + (knobs.on ? "1" : "0") +
+                           " valid=" + (knobs.valid ? "1" : "0") +
+                           " port=r1405-153";
+  std::fprintf(stderr, "%s\n", line.c_str());
+  std::fflush(stderr);
+}
+
+/// One line per grid request whose plan had optional checkpoints (knob on).
+inline void NoteRemap(std::uint64_t request_id, std::size_t prompt,
+                      std::size_t start, std::uint32_t grid,
+                      std::span<const std::size_t> planned,
+                      std::span<const std::size_t> kept) {
+  const std::string line =
+      "[bc] schema=gufo-bc-v1 event=bc_remap request=" +
+      std::to_string(request_id) + " prompt=" + std::to_string(prompt) +
+      " start=" + std::to_string(start) + " grid=" + std::to_string(grid) +
+      " planned=" + JoinRows(planned) + " kept=" + JoinRows(kept);
+  std::fprintf(stderr, "%s\n", line.c_str());
+  std::fflush(stderr);
+}
+
+}  // namespace gufo::server::bc
+
+#endif  // GUFO_CLI_SERVE_BC_CAPTURE_HPP_
