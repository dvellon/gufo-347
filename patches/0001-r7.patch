+/// One stderr line at load; throws on an invalid knob so a misconfigured arm
+/// never runs (called from the load path, HostSnapshotBudgetBytes).
+inline void ValidateAndLogOnce() {
+  static const bool logged = [] {
+    const auto& c = Get();
+    std::fprintf(stderr, "[dx] schema=gufo-dx-v1 %s\n", ConfigLine(c).c_str());
+    std::fflush(stderr);
