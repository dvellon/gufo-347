+using EnvGetter = const char* (*)(const char*);
+
+/// Unset or empty -> fallback; "0" -> false; "1" -> true; anything else is
+/// invalid (nullopt).
+[[nodiscard]] constexpr std::optional<bool> ParseFlag(const char* v,
+                                                      bool fallback) noexcept {
+  if (v == nullptr || v[0] == '\0')
+    return fallback;
+  if (v[0] == '0' && v[1] == '\0')
+    return false;
+  if (v[0] == '1' && v[1] == '\0')
+    return true;
+  return std::nullopt;
+}
+
+/// Decimal unsigned integer (no sign, no suffix); nullopt otherwise.
+[[nodiscard]] constexpr std::optional<std::uint64_t> ParseUnsigned(
+    const char* v) noexcept {
+  if (v == nullptr || v[0] == '\0')
+    return std::nullopt;
+  std::uint64_t value = 0;
+  for (const char* p = v; *p != '\0'; ++p) {
+    if (*p < '0' || *p > '9')
+      return std::nullopt;
+    const std::uint64_t digit = static_cast<std::uint64_t>(*p - '0');
+    if (value > (UINT64_MAX - digit) / 10)
+      return std::nullopt;
+    value = value * 10 + digit;
+  }
+  return value;
+}
+
+[[nodiscard]] inline Config ParseConfig(EnvGetter get) {
+  Config c;
+  const auto fail = [&](const char* name, const char* value) {
+    if (c.error.empty())
+      c.error = std::string(name) + "=" + (value ? value : "");
+  };
+  const auto flag = [&](const char* name, bool fallback) {
+    const char* v = get(name);
+    const auto parsed = ParseFlag(v, fallback);
+    if (!parsed) {
+      fail(name, v);
+      return false;
+    }
+    return *parsed;
+  };
+  c.master = flag("GUFO_DX", false);
+  c.f0 = flag("GUFO_DX_F0", c.master);
+  c.g2 = flag("GUFO_DX_G2", c.master);
+  c.f3 = flag("GUFO_DX_F3", c.master);
+  // promo-3: R3-20 is ON by default (owner: required for strict; verify chains
+  // that straddle indexer_top_k = 2,048). GUFO_DX_SPARSE_BY_POSITION=0 turns it off.
+  // R7 default-off rule: the compiled-in default holds only on a server started
+  // with an --exactness* flag (xm::TiersEnabled(), set by serve.cpp before the
+  // model loads, i.e. before the first Get()); otherwise unset = off = upstream.
+  c.sparse_by_position =
+      flag("GUFO_DX_SPARSE_BY_POSITION", xm::TiersEnabled());
+  c.rowinv = flag("GUFO_DX_ROWINV", false);
+  c.tool_ids = flag("GUFO_DX_TOOL_IDS", c.master);
+  if (const char* v = get("GUFO_DX_CHUNK"); v != nullptr && v[0] != '\0') {
+    const auto n = ParseUnsigned(v);
+    if (!n || (*n != 0 && (*n < 256 || *n > 8192 || *n % 128 != 0)))
+      fail("GUFO_DX_CHUNK", v);
+    else
+      c.chunk = static_cast<std::uint32_t>(*n);
+  } else {
+    // promo-3cg (queue 103e) compiled R3-23 in at 2048 for strict. R7
+    // (rebase-272): unset = 0 = upstream v0.34.0's prefill cuts (whose rows
+    // no longer depend on the split); kDefaultChunk is what GUFO_DX_CHUNK=2048
+    // restores. DECISION in REBASE-NOTES (SPLIT-INDEPENDENCE ANALYSIS).
+    c.chunk = 0;
+  }
+  if (const char* v = get("GUFO_DX_CHUNK_GRID"); v != nullptr && v[0] != '\0') {
+    const std::string_view s(v);
+    if (s == "absolute")
+      c.chunk_absolute = true;
+    else if (s != "relative")
+      fail("GUFO_DX_CHUNK_GRID", v);
+  }
+  if (const char* v = get("GUFO_DX_SCOPE"); v != nullptr && v[0] != '\0') {
+    const std::string_view s(v);
+    if (s == "all")
+      c.scope_all = true;
+    else if (s != "strict")
+      fail("GUFO_DX_SCOPE", v);
+  }
+  if (const char* v = get("GUFO_DX_F0_SHORT"); v != nullptr && v[0] != '\0') {
+    const std::string_view s(v);
+    if (s == "clamp")
+      c.f0_clamp = true;
+    else if (s != "fail")
+      fail("GUFO_DX_F0_SHORT", v);
+  }
+  const auto bytes = [&](const char* name, std::uint64_t fallback,
+                         std::uint64_t low, std::uint64_t high) {
+    const char* v = get(name);
+    if (v == nullptr || v[0] == '\0')
+      return fallback;
+    const auto n = ParseUnsigned(v);
+    if (!n || *n < low || *n > high) {
+      fail(name, v);
+      return fallback;
+    }
+    return *n;
+  };
+  c.cache_bytes =
+      bytes("GUFO_DX_CACHE_BYTES", kDefaultCacheBytes, kGiB / 2, 64 * kGiB);
+  c.backing_bytes = bytes("GUFO_DX_BACKING_BYTES", kDefaultBackingBytes,
+                          std::uint64_t{256} << 20, 64 * kGiB);
+  c.commit_reserve_bytes =
+      bytes("GUFO_DX_COMMIT_RESERVE_GIB", kDefaultCommitReserveGiB, 0, 256) *
+      kGiB;
+  if (c.error.empty() && c.backing_bytes > c.cache_bytes)
+    fail("GUFO_DX_BACKING_BYTES(>GUFO_DX_CACHE_BYTES)", get("GUFO_DX_BACKING_BYTES"));
+  return c;
+}
