+
+namespace gufo::models::qwen38_flash_next {
+
+/// A 0 / 1 knob: unset, empty or "0" = off, "1" = on, anything else throws.
+[[nodiscard]] inline bool ParseSpecFlag(const char* value, const char* name) {
+  if (value == nullptr || *value == '\0' || std::string_view(value) == "0")
+    return false;
+  if (std::string_view(value) == "1")
+    return true;
+  throw std::invalid_argument(std::string(name) + " must be 0 or 1");
+}
+
+/// GUFO_SPEC_Q_STRICT=1 admits shaped proposals to strict requests (for the
+/// strict gate run). Unset or 0: relaxed and approximate only.
+[[nodiscard]] inline bool SpecShapeStrictAdmitted() {
+  static const bool admitted =
+      ParseSpecFlag(std::getenv("GUFO_SPEC_Q_STRICT"), "GUFO_SPEC_Q_STRICT");
+  return admitted;
+}
+
+/// The load-time knob check on explicit values (testable without the
+/// environment). False with `error` set on an invalid value, or on
+/// GUFO_SPEC_Q_MASK=1, which this port cannot honour.
+[[nodiscard]] inline bool SpecSamplingKnobsCheck(const char* mask,
+                                                 const char* temperature,
+                                                 const char* top_k,
+                                                 const char* strict,
+                                                 std::string* error) {
+  try {
+    const auto shape =
+        speculative::spec_sampling::ParseShape(mask, temperature, top_k);
+    (void)ParseSpecFlag(strict, "GUFO_SPEC_Q_STRICT");
+    if (shape.mask_constraint) {
+      *error =
+          "GUFO_SPEC_Q_MASK=1 is not supported by this build (needs "
+          "SamplerState::ConstraintAllows)";
+      return false;
+    }
+  } catch (const std::exception& exception) {
+    *error = exception.what();
+    return false;
+  }
+  return true;
+}
+
+/// Model::Load: every GUFO_SPEC_Q_* knob, read once. On success the process-wide statics are initialized here, so no
+/// decode call can throw from them later.
+[[nodiscard]] inline bool SpecSamplingKnobsValid(std::string* error) {
+  if (!SpecSamplingKnobsCheck(
+          std::getenv("GUFO_SPEC_Q_MASK"), std::getenv("GUFO_SPEC_Q_TEMP"),
+          std::getenv("GUFO_SPEC_Q_TOPK"), std::getenv("GUFO_SPEC_Q_STRICT"),
+          error))
+    return false;
+  (void)speculative::spec_sampling::EnvShape();
+  (void)SpecShapeStrictAdmitted();
+  return true;
+}
+
+/// One stderr line at the first model load (after SpecSamplingKnobsValid).
+inline void NoteSpecSamplingConfig() {
+  static std::atomic<bool> noted{false};
+  if (noted.exchange(true))
+    return;
+  const auto& shape = speculative::spec_sampling::EnvShape();
+  std::fprintf(stderr,
+               "[INFO] [spec] event=spec_config shaped=%d q_temp=%g q_topk=%u "
+               "mask=%d q_strict=%d port=spec-sampling-qt\n",
+               shape.identity() ? 0 : 1, shape.q_temperature_scale,
+               static_cast<unsigned>(shape.q_top_k),
+               shape.mask_constraint ? 1 : 0, SpecShapeStrictAdmitted() ? 1 : 0);
+  std::fflush(stderr);
+}
+
+struct SpecShapeStats {
+  std::atomic<std::uint64_t> cycles{0};         ///< sampled cycles shaping q
+  std::atomic<std::uint64_t> strict_cycles{0};  ///< of which strict
+  std::atomic<std::uint64_t> drafts{0};         ///< shaped drafts drawn
+};
+inline SpecShapeStats& GetSpecShapeStats() noexcept {
+  static SpecShapeStats s;
+  return s;
+}
+
+/// PrepareDecode: one sampled cycle drafts through SampleShapedMtpProposal.
+inline void NoteSpecShapedCycle(bool strict) noexcept {
+  auto& s = GetSpecShapeStats();
+  s.cycles.fetch_add(1, std::memory_order_relaxed);
+  if (strict)
+    s.strict_cycles.fetch_add(1, std::memory_order_relaxed);
+}
+
+/// AppendDraft: one shaped draft was drawn. Prints on the first and every
+/// 1024th, so a drafts >= 1 line proves q shaping acted.
+inline void NoteSpecShapedDraft() {
+  auto& s = GetSpecShapeStats();
+  const auto drafts = s.drafts.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (drafts % 1024 != 1)
+    return;
+  std::fprintf(stderr,
+               "[INFO] [spec] event=spec_q_stats cycles=%llu strict_cycles=%llu "
+               "drafts=%llu\n",
+               static_cast<unsigned long long>(s.cycles.load()),
+               static_cast<unsigned long long>(s.strict_cycles.load()),
+               static_cast<unsigned long long>(drafts));
+  std::fflush(stderr);
+}
+
+/// `draft_sampler` holds the tentative draft history (anchor and earlier
+/// drafts). In the engine it never carries the request grammar. Always
+/// returns a proposal here (the optional is kept for the masked API of the
+/// cloud branch); a mask on a constrained draft sampler is refused (this
+/// port has no one-token grammar check), and a mask without a constraint is
+/// a no-op, as on the branch.
+inline std::optional<MtpProposal> SampleShapedMtpProposal(
+    const MtpCandidateLogits& candidates,
+    const sampling::SamplerState& draft_sampler,
+    const speculative::spec_sampling::ProposalShape& shape,
+    std::uint64_t* rng) {
+  namespace ss = speculative::spec_sampling;
+  if (candidates.size == 0 || candidates.size > kMtpCandidates)
+    throw std::invalid_argument("invalid MTP candidate count");
+  const bool constrained = draft_sampler.config().constraint != nullptr;
+  if (shape.mask_constraint && constrained)
+    throw std::logic_error(
+        "GUFO_SPEC_Q_MASK is not supported by this build (no "
+        "SamplerState::ConstraintAllows)");
+  if (!shape.reweights()) {
+    if (!constrained)
+      return SampleMtpProposal(candidates, draft_sampler, rng);
+    return SampleMtpProposal(candidates, draft_sampler.WithoutConstraint(),
+                             rng);
+  }
+  const auto ids = std::span(candidates.ids).first(candidates.size);
+  const auto row = std::span(candidates.logits).first(candidates.size);
+  const auto base =
+      constrained ? draft_sampler.WithoutConstraint().Distribution(row, ids)
+                  : draft_sampler.Distribution(row, ids);
+  // Base entry tokens index the shortlist; map them after shaping.
+  auto shaped =
+      ss::Shape(base.entries(), shape.q_temperature_scale, shape.q_top_k);
+  for (auto& entry : shaped)
+    entry.token = candidates.ids[entry.token];
+  const auto q = ss::Quantize(shaped);
+  MtpProposal proposal;
+  proposal.size = q.ids.size();
+  for (std::size_t i = 0; i < proposal.size; ++i) {
+    proposal.ids[i] = q.ids[i];
+    // Exact: mass <= 2^24 is exact in F32 and the divisor is a power of two.
+    proposal.probabilities[i] =
+        static_cast<float>(q.mass[i]) / static_cast<float>(ss::kProposalUnits);
+  }
+  const auto index = ss::DrawIndex(q, sampling::Uniform(rng));
+  proposal.token = proposal.ids[index];
+  proposal.probability = proposal.probabilities[index];
+  return proposal;
+}
+
