+#ifndef GUFO_MODELS_QWEN38_FLASH_NEXT_CHAT_DRAFTING_HPP_
+#define GUFO_MODELS_QWEN38_FLASH_NEXT_CHAT_DRAFTING_HPP_
+
+// Wave3 chat-path (chat-path/README.md):
+// pure drafting helpers of R3-11 and R3-12, used by engine.cpp and the host
+// selftest. None of them touches the target verification: every decision
+// here only chooses which proposals are drafted. The proofs that this keeps
+// the emitted distribution exactly the target sampler's are in the README.
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <span>
+
+#include "src/core/chat_path.hpp"
