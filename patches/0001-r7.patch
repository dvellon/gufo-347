+namespace gufo::chat_path {
+
+enum class Mode : std::uint8_t { kOff = 0, kRelaxed = 1, kStrict = 2 };
+
+[[nodiscard]] constexpr std::string_view ModeName(Mode mode) noexcept {
+  return mode == Mode::kStrict    ? "strict"
+         : mode == Mode::kRelaxed ? "relaxed"
+                                  : "off";
+}
+
+/// unset / "" / "0" = off; "1" or "relaxed" = relaxed; "strict" = strict.
+[[nodiscard]] inline Mode ParseMode(const char* name, const char* value) {
+  if (value == nullptr || *value == '\0')
+    return Mode::kOff;
+  const std::string_view v(value);
+  if (v == "0")
+    return Mode::kOff;
+  if (v == "1" || v == "relaxed")
+    return Mode::kRelaxed;
+  if (v == "strict")
+    return Mode::kStrict;
+  throw std::invalid_argument(std::string(name) + ": expected 0, 1, relaxed or strict, got '" +
+                              std::string(v) + "'");
+}
+
+/// Whether a feature in `mode` applies to a request granted `level`.
+[[nodiscard]] constexpr bool ModeAllows(Mode mode, xm::ExactnessLevel level) noexcept {
+  return mode == Mode::kStrict ||
+         (mode == Mode::kRelaxed && level != xm::ExactnessLevel::kStrict);
+}
+
+/// unset / "" = fallback; "0" = off; anything else = on.
+[[nodiscard]] inline bool ParseFlag(const char* value, bool fallback) noexcept {
+  if (value == nullptr || *value == '\0')
+    return fallback;
+  return !(value[0] == '0' && value[1] == '\0');
+}
+
+[[nodiscard]] inline double ParseNumber(const char* name, std::string_view text) {
+  const std::string s(text);
+  char* end = nullptr;
+  const double value = std::strtod(s.c_str(), &end);
+  if (s.empty() || end == s.c_str() || *end != '\0' || std::isnan(value))
+    throw std::invalid_argument(std::string(name) + ": invalid value '" + s + "'");
+  return value;
+}
+
+inline constexpr std::size_t kDepths = 7;  // kMaxMtpDraftTokens (asserted in engine.cpp)
+using DepthValues = std::array<float, kDepths>;
+
+/// "v" (every depth) or "v1,...,v7". Returns false when unset.
+inline bool ParseDepths(const char* name, const char* raw, DepthValues* out) {
+  if (raw == nullptr || *raw == '\0')
+    return false;
+  const std::string text(raw);
+  DepthValues values{};
+  std::size_t count = 0, pos = 0;
+  for (;;) {
+    const auto comma = text.find(',', pos);
+    if (count == values.size())
+      throw std::invalid_argument(std::string(name) + ": more than 7 values");
+    values[count++] = static_cast<float>(ParseNumber(
+        name, std::string_view(text).substr(
+                  pos, comma == std::string::npos ? std::string::npos : comma - pos)));
+    if (comma == std::string::npos)
+      break;
+    pos = comma + 1;
+  }
+  if (count == 1)
+    out->fill(values[0]);
+  else if (count == values.size())
+    *out = values;
+  else
+    throw std::invalid_argument(std::string(name) + ": need 1 or 7 values");
+  return true;
+}
+
+enum class Render : std::uint8_t { kAuto, kStrip, kKeep };
+enum class SPrice : std::uint8_t { kOff, kOccupancy, kMeasured };
+
+struct Config {
+  // R3-11
+  bool pen_draft{false};
+  bool pen_h1{false};
+  // R3-12
+  bool sstop{false};
+  bool sstop_qdraw{false};
+  bool sstop_solo{true};
+  bool sstop_hide_floor{true};
+  DepthValues sstop_floor{};
+  DepthValues sstop_drop{};
+  float sstop_hide{1.0F};
+  // R3-13
+  bool splan{false};
+  // CH-1
+  SPrice sprice{SPrice::kOff};
+  // R3-33
+  Mode sxf{Mode::kOff};
+  std::size_t sxf_rows{256};
+  // R3-10 / R3-51 / R3-60
+  Mode prewarm{Mode::kOff};
+  std::size_t prewarm_chunk{512};
+  std::size_t prewarm_max_rows{1920};
+  Render prewarm_render{Render::kAuto};
+  bool prewarm_first_keep{false};
+  double prewarm_ttl_s{900.0};
+  bool prewarm_rewarm{true};
+  std::size_t prewarm_conversations{8};
+  bool trace{false};
+};
+
+[[nodiscard]] inline std::size_t ParseSize(const char* name, std::size_t fallback,
+                                           std::size_t lo, std::size_t hi) {
+  const char* raw = std::getenv(name);
+  if (raw == nullptr || *raw == '\0')
+    return fallback;
+  const double v = ParseNumber(name, raw);
+  if (v < static_cast<double>(lo) || v > static_cast<double>(hi) || v != std::floor(v))
+    throw std::invalid_argument(std::string(name) + ": out of range");
+  return static_cast<std::size_t>(v);
+}
+
+/// Parsed once (first use); invalid values throw, as the B5 knobs do.
+[[nodiscard]] inline Config ParseConfig() {
+  Config c;
+  c.pen_draft = ParseFlag(std::getenv("GUFO_CHAT_PEN_DRAFT"), false);
+  c.pen_h1 = c.pen_draft && ParseFlag(std::getenv("GUFO_CHAT_PEN_H1"), true);
+  c.sstop = ParseFlag(std::getenv("GUFO_CHAT_SSTOP"), false);
+  if (const char* s = std::getenv("GUFO_CHAT_SSTOP_SIGNAL"); s && *s) {
+    const std::string_view v(s);
+    if (v != "qtop" && v != "qdraw")
+      throw std::invalid_argument("GUFO_CHAT_SSTOP_SIGNAL: expected qtop or qdraw");
+    c.sstop_qdraw = v == "qdraw";
+  }
+  if (const char* g = std::getenv("GUFO_CHAT_SSTOP_GATE"); g && *g) {
+    const std::string_view v(g);
+    if (v != "solo" && v != "all")
+      throw std::invalid_argument("GUFO_CHAT_SSTOP_GATE: expected solo or all");
+    c.sstop_solo = v == "solo";
+  }
+  // Provisional floor until dell-sims-007's R3-12 calibration lands: stop
+  // after a draft whose q confidence is at most 0.35 (every depth).
+  c.sstop_floor.fill(0.35F);
+  (void)ParseDepths("GUFO_CHAT_SSTOP_FLOOR", std::getenv("GUFO_CHAT_SSTOP_FLOOR"),
+                    &c.sstop_floor);
+  c.sstop_drop.fill(0.0F);  // q >= 0 always: <= 0 never drops a real proposal
+  (void)ParseDepths("GUFO_CHAT_SSTOP_DROP", std::getenv("GUFO_CHAT_SSTOP_DROP"),
+                    &c.sstop_drop);
+  if (const char* h = std::getenv("GUFO_CHAT_SSTOP_HIDE"); h && *h &&
+                                                           std::string_view(h) != "floor") {
+    c.sstop_hide_floor = false;
+    c.sstop_hide = static_cast<float>(ParseNumber("GUFO_CHAT_SSTOP_HIDE", h));
+  }
+  c.splan = ParseFlag(std::getenv("GUFO_CHAT_SPLAN"), false);
+  // promo-3 (make_promo3.py --ch1 occupancy): CH-1 is on by default;
+  // GUFO_CHAT_SPRICE=0 turns it off, =occupancy|measured selects the mode.
+  c.sprice = SPrice::kOccupancy;
+  if (const char* v = std::getenv("GUFO_CHAT_SPRICE"); v && std::string_view(v) == "0")
+    c.sprice = SPrice::kOff;
+  if (const char* v = std::getenv("GUFO_CHAT_SPRICE"); v && *v && std::string_view(v) != "0") {
+    const std::string_view x(v);
+    if (x == "occupancy" || x == "1")
+      c.sprice = SPrice::kOccupancy;
+    else if (x == "measured")
+      c.sprice = SPrice::kMeasured;
+    else
+      throw std::invalid_argument("GUFO_CHAT_SPRICE: expected 0, occupancy or measured");
+  }
+  c.sxf = ParseMode("GUFO_CHAT_SXF", std::getenv("GUFO_CHAT_SXF"));
+  c.sxf_rows = ParseSize("GUFO_CHAT_SXF_ROWS", 256, 1, 4096);
+  c.prewarm = ParseMode("GUFO_CHAT_PREWARM", std::getenv("GUFO_CHAT_PREWARM"));
+  c.prewarm_chunk = ParseSize("GUFO_CHAT_PREWARM_CHUNK", 512, 128, 4096) / 128 * 128;
+  c.prewarm_max_rows = ParseSize("GUFO_CHAT_PREWARM_MAX_ROWS", 1920, 128, 4096);
+  if (const char* r = std::getenv("GUFO_CHAT_PREWARM_RENDER"); r && *r) {
+    const std::string_view v(r);
+    if (v == "auto")
+      c.prewarm_render = Render::kAuto;
+    else if (v == "strip")
+      c.prewarm_render = Render::kStrip;
+    else if (v == "keep")
+      c.prewarm_render = Render::kKeep;
+    else
+      throw std::invalid_argument("GUFO_CHAT_PREWARM_RENDER: expected auto, strip or keep");
+  }
+  if (const char* f = std::getenv("GUFO_CHAT_PREWARM_FIRST"); f && *f) {
+    const std::string_view v(f);
+    if (v != "strip" && v != "keep")
+      throw std::invalid_argument("GUFO_CHAT_PREWARM_FIRST: expected strip or keep");
+    c.prewarm_first_keep = v == "keep";
+  }
+  c.prewarm_ttl_s = static_cast<double>(ParseSize("GUFO_CHAT_PREWARM_TTL_S", 900, 1, 86400));
+  c.prewarm_rewarm = ParseFlag(std::getenv("GUFO_CHAT_PREWARM_REWARM"), true);
+  c.prewarm_conversations = ParseSize("GUFO_CHAT_PREWARM_CONVERSATIONS", 8, 1, 64);
+  c.trace = ParseFlag(std::getenv("GUFO_CHAT_TRACE"), false);
+  return c;
+}
+
+[[nodiscard]] inline const Config& GetConfig() {
+  static const Config config = [] {
+    const Config c = ParseConfig();
+    std::fprintf(stderr,
+                 "event=chat_path_config pen_draft=%d pen_h1=%d sstop=%d signal=%s "
+                 "gate=%s floor=%g drop=%g hide=%s splan=%d sprice=%s sxf=%s sxf_rows=%zu "
+                 "prewarm=%s chunk=%zu max_rows=%zu render=%s first=%s ttl_s=%g "
+                 "rewarm=%d conversations=%zu trace=%d\n",
+                 c.pen_draft ? 1 : 0, c.pen_h1 ? 1 : 0, c.sstop ? 1 : 0,
+                 c.sstop_qdraw ? "qdraw" : "qtop", c.sstop_solo ? "solo" : "all",
+                 static_cast<double>(c.sstop_floor[0]), static_cast<double>(c.sstop_drop[0]),
+                 c.sstop_hide_floor ? "floor" : std::to_string(c.sstop_hide).c_str(),
+                 c.splan ? 1 : 0,
+                 c.sprice == SPrice::kMeasured    ? "measured"
+                 : c.sprice == SPrice::kOccupancy ? "occupancy"
+                                                  : "off",
+                 std::string(ModeName(c.sxf)).c_str(), c.sxf_rows,
+                 std::string(ModeName(c.prewarm)).c_str(), c.prewarm_chunk, c.prewarm_max_rows,
+                 c.prewarm_render == Render::kAuto    ? "auto"
+                 : c.prewarm_render == Render::kStrip ? "strip"
+                                                      : "keep",
+                 c.prewarm_first_keep ? "keep" : "strip", c.prewarm_ttl_s,
+                 c.prewarm_rewarm ? 1 : 0, c.prewarm_conversations, c.trace ? 1 : 0);
+    std::fflush(stderr);
+    return c;
+  }();
+  return config;
+}
+
+/// The censoring threshold of a sampled stop at chain depth d (1-based).
+[[nodiscard]] inline float SStopHide(const Config& c, std::size_t depth) noexcept {
+  if (!c.sstop_hide_floor)
+    return c.sstop_hide;
+  return depth >= 1 && depth <= kDepths ? c.sstop_floor[depth - 1] : -1.0F;
+}
+
+/// R3-10 cut rule. `restore` = the restorable prefix (RAM) of the predicted
+/// next-turn prefix of `length` tokens. The pre-prefill covers [restore, cut)
+/// with cut = restore + 128 k (every pass start of both schedules stays
+/// congruent to `restore` mod 128: the P9 row-class argument), at least one
+/// 128-row block, and only while length - restore <= max_rows (with the
+/// default 1920 the next turn's whole prefill stays below 2048 rows, where no
+/// grid checkpoint can split production's pass). Empty with a reason when
+/// the turn is not eligible.
+struct Cut {
+  std::size_t cut{0};
+  const char* skip{nullptr};
+};
+[[nodiscard]] constexpr Cut PrewarmCut(std::size_t restore, std::size_t length,
+                                       std::size_t max_rows) noexcept {
+  if (restore >= length)
+    return {0, "covered"};
+  if (length - restore > max_rows)
+    return {0, "too_long"};
+  const std::size_t blocks = (length - restore) / 128;
+  if (blocks == 0)
+    return {0, "short"};
+  return {restore + blocks * 128, nullptr};
+}
+
+/// Process-wide counters (GUFO_CHAT_TRACE prints them every 32 requests).
+struct Stats {
+  std::atomic<std::uint64_t> requests{0};
+  std::atomic<std::uint64_t> pen_cycles{0}, pen_reranked{0};
+  std::atomic<std::uint64_t> sstop_cycles{0}, sstop_stops{0}, sstop_drops{0}, sstop_censored{0};
+  std::atomic<std::uint64_t> splan_rounds{0};
+  std::atomic<std::uint64_t> sprice_cycles{0}, sprice_measured{0};
+  std::atomic<std::uint64_t> sxf_promotions{0};
+  std::atomic<std::uint64_t> prewarm_queued{0}, prewarm_started{0}, prewarm_done{0},
+      prewarm_cancelled{0}, prewarm_skipped{0}, prewarm_rows{0}, prewarm_hits{0},
+      prewarm_hits_used{0}, prewarm_hits_strict{0}, prewarm_hits_unsafe{0}, prewarm_lost{0},
+      prewarm_rewarms{0}, prerender_live_match{0};
+};
+
+[[nodiscard]] inline Stats& GetStats() noexcept {
+  static Stats stats;
+  return stats;
+}
+
+inline void PrintStats(const char* why) {
+  auto& s = GetStats();
+  const auto v = [](const std::atomic<std::uint64_t>& a) {
+    return static_cast<unsigned long long>(a.load(std::memory_order_relaxed));
+  };
+  std::fprintf(stderr,
+               "event=chat_path_stats why=%s requests=%llu pen_cycles=%llu pen_reranked=%llu "
+               "sstop_cycles=%llu sstop_stops=%llu sstop_drops=%llu sstop_censored=%llu "
+               "splan_rounds=%llu sprice_cycles=%llu sprice_measured=%llu sxf=%llu "
+               "prewarm_queued=%llu started=%llu done=%llu "
+               "cancelled=%llu skipped=%llu rows=%llu hits=%llu used=%llu strict_hits=%llu "
+               "unsafe_hits=%llu lost=%llu rewarms=%llu live_match=%llu\n",
+               why, v(s.requests), v(s.pen_cycles), v(s.pen_reranked), v(s.sstop_cycles),
+               v(s.sstop_stops), v(s.sstop_drops), v(s.sstop_censored), v(s.splan_rounds),
+               v(s.sprice_cycles), v(s.sprice_measured), v(s.sxf_promotions), v(s.prewarm_queued), v(s.prewarm_started), v(s.prewarm_done),
+               v(s.prewarm_cancelled), v(s.prewarm_skipped), v(s.prewarm_rows), v(s.prewarm_hits),
+               v(s.prewarm_hits_used), v(s.prewarm_hits_strict), v(s.prewarm_hits_unsafe),
+               v(s.prewarm_lost), v(s.prewarm_rewarms), v(s.prerender_live_match));
+  std::fflush(stderr);
+}
+
+/// Called once per new engine request; prints the counters every 32.
+inline void NoteRequest() {
+  const auto n = GetStats().requests.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (GetConfig().trace && n % 32 == 0)
+    PrintStats("periodic");
+}
