+/// Timestamps on the executor stream. The GPU time between two consecutive
+/// marks is booked under the closing mark's label; "begin", "end" and labels
+/// ending in "_pre" close uninstrumented work ("other").
+struct Timer {
+  bool on = false;
+  std::uint32_t rows = 0;
+  std::uint32_t start = 0;
+  std::vector<hipEvent_t> events;
+  std::vector<const char*> labels;
+  std::size_t used = 0;
+  double host_wait_ms = 0;
+  std::uint64_t disk_reads = 0;
+};
+thread_local Timer main_timer;
+thread_local Timer mtp_timer;
+
+void Mark(Timer& t, const char* label, hipStream_t stream) {
+  if (!t.on)
+    return;
+  if (t.used == t.events.size()) {
+    hipEvent_t e = nullptr;
+    if (hipEventCreate(&e) != hipSuccess) {
+      t.on = false;
+      return;
+    }
+    t.events.push_back(e);
+    t.labels.push_back(nullptr);
+  }
+  t.labels[t.used] = label;
+  if (hipEventRecord(t.events[t.used], stream) != hipSuccess) {
+    t.on = false;
+    return;
+  }
+  ++t.used;
+}
+void Record(const char* label, hipStream_t stream) {
+  Mark(main_timer, label, stream);
+}
+void MtpRecord(const char* label, hipStream_t stream) {
+  Mark(mtp_timer, label, stream);
+}
+void Begin(Timer& t, std::uint32_t rows, std::uint32_t start,
+           std::uint64_t disk_reads, hipStream_t stream) {
+  t.on = true;
+  t.used = 0;
+  t.rows = rows;
+  t.start = start;
+  t.host_wait_ms = 0;
+  t.disk_reads = disk_reads;
+  Mark(t, "begin", stream);
+}
+void Finish(Timer& t, const char* kind, std::uint64_t disk_reads_after) {
+  if (!t.on)
+    return;
+  t.on = false;
+  if (t.used < 2 || hipEventSynchronize(t.events[t.used - 1]) != hipSuccess)
+    return;
+  std::vector<std::pair<std::string, double>> sums;
+  double total = 0;
+  for (std::size_t i = 1; i < t.used; ++i) {
+    float ms = 0;
+    if (hipEventElapsedTime(&ms, t.events[i - 1], t.events[i]) != hipSuccess)
+      return;
+    const std::string_view label = t.labels[i];
+    const bool other = label == "begin" || label == "end" ||
+                       (label.size() > 4 &&
+                        label.substr(label.size() - 4) == "_pre");
+    const std::string key = other ? std::string("other") : std::string(label);
+    auto it = std::find_if(sums.begin(), sums.end(),
+                           [&](const auto& s) { return s.first == key; });
+    if (it == sums.end())
+      sums.emplace_back(key, double{ms});
+    else
+      it->second += ms;
+    total += ms;
+  }
+  char head[256];
+  std::snprintf(head, sizeof(head),
+                "event=w3p4_%s rows=%u start=%u total_ms=%.4f", kind, t.rows,
+                t.start, total);
+  std::string line = head;
+  for (const auto& [key, ms] : sums) {
+    char item[96];
+    std::snprintf(item, sizeof(item), " %s_ms=%.4f", key.c_str(), ms);
+    line += item;
+  }
+  char tail[160];
+  std::snprintf(tail, sizeof(tail),
+                " ple_host_wait_ms=%.4f disk_reads=%llu marks=%zu",
+                t.host_wait_ms,
+                static_cast<unsigned long long>(disk_reads_after - t.disk_reads),
+                t.used);
+  line += tail;
+  std::fprintf(stderr, "%s\n", line.c_str());
+  std::fflush(stderr);
+}
