+template<typename IsSpecial>
+[[nodiscard]] inline std::string MtpDraftStaticAppend(
+    const MtpDraftStaticBlock& block, std::uint32_t rows,
+    IsSpecial is_special, std::vector<std::int32_t>* specials) {
