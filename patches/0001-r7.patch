+// ---------------------------------------------------------------------------
+// Wave3 A1 (a1-lmhead): lazy frontier rows.
+// After a screened head pass (Executor::ArmA1) the frontier's full logit row is
+// not computed. logits_ then holds an encoded frontier: a NaN signature, the
+// row's argmax (production's rule: lowest index of the finite maximum), its
+// value, and the row's Q8_1 head input. A reader either takes the argmax where
+// the production selection is exactly that argmax (greedy, no penalties, no
+// constraint), or first materializes the row with the production head GEMV
+// (bitwise the production row). Writing a real row replaces the encoding, so no
+// separate flag can go stale; snapshots and continuation captures carry the
+// encoding as bytes (kSnapshotPayloadVersion keeps them in A1 builds).
+namespace {
+
+constexpr std::array<std::uint32_t, 4> kA1Signature{0x7FC0A101u, 0x7FC0A1F2u,
+                                                    0x7FC0A1E3u, 0x7FC0A1D4u};
+/// Signature, index, value, serial, input bytes, checksum.
+constexpr std::size_t kA1Header = 9;
+std::atomic<std::uint32_t> a1_serial{0};
+
+std::uint32_t A1Bits(float value) {
+  std::uint32_t bits;
+  std::memcpy(&bits, &value, sizeof(bits));
+  return bits;
+}
+float A1Float(std::uint32_t bits) {
+  float value;
+  std::memcpy(&value, &bits, sizeof(value));
+  return value;
+}
+
+struct A1Encoded {
+  std::int32_t index{-1};
+  float value{0.0F};
+  std::uint32_t serial{0};
+  std::span<const std::uint8_t> x;
+};
+
+std::uint32_t A1Checksum(std::span<const float> logits, std::size_t bytes) {
+  std::uint32_t h = 0x811C9DC5u;
+  for (std::size_t i = 4; i < 8; ++i)
+    h = (h ^ A1Bits(logits[i])) * 16777619u;
+  const auto* p = reinterpret_cast<const std::uint8_t*>(logits.data() + kA1Header);
+  for (std::size_t i = 0; i < bytes; ++i)
+    h = (h ^ p[i]) * 16777619u;
+  return h;
+}
+
+bool A1Decode(std::span<const float> logits, A1Encoded* out) {
+  if (logits.size() < kA1Header)
+    return false;
+  for (std::size_t i = 0; i < kA1Signature.size(); ++i)
+    if (A1Bits(logits[i]) != kA1Signature[i])
+      return false;
+  const std::size_t bytes = A1Bits(logits[7]);
+  if (bytes == 0 || bytes % 4 != 0 || kA1Header + bytes / 4 > logits.size() ||
+      A1Bits(logits[8]) != A1Checksum(logits, bytes))
+    return false;
+  out->index = static_cast<std::int32_t>(A1Bits(logits[4]));
+  out->value = logits[5];
+  out->serial = A1Bits(logits[6]);
+  out->x = {reinterpret_cast<const std::uint8_t*>(logits.data() + kA1Header),
+            bytes};
+  return true;
+}
+
+bool A1Encode(std::span<float> logits, std::int32_t index, float value,
+              std::span<const std::uint8_t> x) {
+  if (x.empty() || x.size() % 4 != 0 ||
+      kA1Header + x.size() / 4 > logits.size())
+    return false;
+  for (std::size_t i = 0; i < kA1Signature.size(); ++i)
+    logits[i] = A1Float(kA1Signature[i]);
+  logits[4] = A1Float(static_cast<std::uint32_t>(index));
+  logits[5] = value;
+  logits[6] = A1Float(a1_serial.fetch_add(1, std::memory_order_relaxed) + 1);
+  logits[7] = A1Float(static_cast<std::uint32_t>(x.size()));
+  std::memcpy(logits.data() + kA1Header, x.data(), x.size());
+  logits[8] = A1Float(A1Checksum(logits, x.size()));
+  return true;
+}
