+// Wave3 XM: the request's exactness level on the endpoints parsed here: the
+// body's "exactness" field, else the x-gufo-exactness header (the body wins).
+// Leaves `out` alone when a body parser already set it.
+std::optional<HttpResponse> ReadExactness(
+    const json::Value& body, const HttpRequest& req,
+    std::optional<xm::ExactnessLevel>* out) {
+  if (out->has_value())
+    return std::nullopt;
+  std::string text;
+  std::string source = "'exactness'";
+  if (const auto* value = body.find("exactness");
+      value != nullptr && !value->is_null()) {
+    if (!value->is_string())
+      return InvalidCompatibilityRequest(
+          "'exactness' must be strict, relaxed or approximate");
+    text = value->str();
+  } else {
+    text = req.header(xm::kExactnessHeader);
+    source = "'x-gufo-exactness'";
+    if (text.empty())
+      return std::nullopt;
+  }
+  const auto level = xm::ParseExactnessLevel(text);
+  if (!level)
+    return InvalidCompatibilityRequest(
+        source + " must be strict, relaxed or approximate");
+  *out = level;
+  return std::nullopt;
+}
