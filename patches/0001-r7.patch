--- /dev/null
+++ b/src/models/qwen38_flash_next/kernels/rocm/w3gscan_map.h
@@ -0,0 +1,156 @@
+// Wave3 gdn-scan-retile (queue 176, owner 2026-10-31: the recurrent scan retile first): the variant table,
+// the knob parse and every index map of the GUFO_GDN_SCAN retiles of the wide-prefill GDN recurrence
+// (GdnRowSplitKernel). Pure C++17 (no HIP): included by kernels.hip.cpp (device + host) and by the CPU reference
+// src-gscan/gscan_ref_test.cpp, so the CPU emulation exercises the same maps the kernels use.
+//
+// Strictness contract (README s2): every variant computes, for every state cell / output element, the SAME sequence of
+// IEEE float operations as production's GdnRowSplitKernel: decay multiply; per 32-key segment one sequential FMA chain
+// in ascending key order (first term a plain product); the 4 segment partials combined as (c0 + c1) + (c2 + c3) (the
+// DPP xor-1 / xor-2 tree; + is commutative bitwise, so every lane of a production row holds the same value); delta =
+// fma(-u, inv_k, v) * beta (materialized); update = delta * inv_k; out = fma(kq, update, p) * q_scale; state =
+// fma(update, k, state) per key. Only the assignment of rows to lanes / waves / blocks, the window staging and the
+// source of q / k (LDS or scalar registers) change. Fused variants additionally run production's GdnEpilogueKernel
+// arithmetic (lane l holds raw[r*32 + l], r = 0..3) on the rows in LDS instead of a raw round trip through memory.
+#pragma once
+#include <cstdint>
+
+namespace w3gscan {
+
+constexpr int kD = 128;           // kGdnDim (head dim; the state is kD x kD per value head)
+constexpr int kKeysPerLane = 32;  // production: one lane = one 32-key segment of one state row
+constexpr int kVec = kKeysPerLane / 4;
+constexpr int kLanesPerRow = kD / kKeysPerLane;  // 4 segments
+constexpr int kWave = 32;         // gfx1151 wave32
+
+enum Kind : int { kTile = 0, kLaneRow = 1 };
+
+/// One retile. kRows state rows per lane (tile kind), kWaves waves per block, kW tokens per LDS window, kAhead
+/// windows of loads in flight, kFuse = the GdnEpilogueKernel arithmetic in the scan (needs 128 rows per block).
+/// Lane-row kind: one lane = one whole state row (its 4 segments computed in the lane, combined by the same tree),
+/// q / k read as wave-uniform scalars; kWaves = waves per block (1: 4 blocks per head; 4: one block per head).
+struct Variant {
+  const char* name;
+  int kind;
+  int rows;
+  int waves;
+  int window;
+  int ahead;
+  bool fuse;
+};
+
+// Production GdnRowSplitKernel = tile <2, 4, 4, 3, no fuse>. Index 0 is "off" (production statements, no variant).
+constexpr int kVariants = 10;
+constexpr Variant kTable[kVariants + 1] = {
+    {"off", kTile, 2, 4, 4, 3, false},
+    {"id", kTile, 2, 4, 4, 3, false},     // identity control: the template at production's shape
+    {"r2w2", kTile, 2, 2, 4, 3, false},   // 192 blocks x 2 waves (finer blocks, 2-wave barriers)
+    {"r2k8", kTile, 2, 4, 8, 2, false},   // production shape, 8-token windows (half the barriers / commits)
+    {"r4w2", kTile, 4, 2, 4, 2, false},   // 4 rows per lane: half the LDS bytes per state cell; 96 x 2 waves
+    {"r4w4", kTile, 4, 4, 4, 2, false},   // 4 rows per lane, one block per head (48 x 4 waves)
+    {"r4w1", kTile, 4, 1, 2, 2, false},   // 4 rows per lane, 192 one-wave blocks, 2-token windows
+    {"e4w4", kTile, 4, 4, 4, 2, true},    // r4w4 + fused epilogue (no raw round trip)
+    {"e2w8", kTile, 2, 8, 4, 3, true},    // production rows per lane, one 8-wave block per head + fused epilogue
+    {"ls1", kLaneRow, 1, 1, 4, 1, false}, // lane = row, q / k as scalars, 192 one-wave blocks
+    {"ls4e", kLaneRow, 1, 4, 4, 1, true}, // lane = row, one 4-wave block per head + fused epilogue
+};
+
+constexpr int kModeOff = 0;
+constexpr int kModeProbe = 100;
+constexpr int kModeInvalid = -1;
+
+constexpr bool StrEq(const char* a, const char* b) {
+  while (*a != 0 && *a == *b) {
+    ++a;
+    ++b;
+  }
+  return *a == *b;
+}
+
+/// GUFO_GDN_SCAN: unset / "" / "0" = off (production statements); a variant name = that variant replaces the
+/// production recurrence launch (and, for a fused variant on the F16-output route, the epilogue launch); "probe" =
+/// production used, every variant run into probe buffers and compared bitwise; anything else = invalid (off + one
+/// event=w3gscan_config invalid= line).
+constexpr int ParseMode(const char* v) {
+  if (v == nullptr || *v == 0 || StrEq(v, "0"))
+    return kModeOff;
+  if (StrEq(v, "probe"))
+    return kModeProbe;
+  for (int i = 1; i <= kVariants; ++i)
+    if (StrEq(v, kTable[i].name))
+      return i;
+  return kModeInvalid;
+}
+
+/// Row classes of a call (the 145 pf-suite classes): 0 = < 64 rows (S70 / F35 / tool results), 1 = 64..1023 (S512),
+/// 2 = 1024..3071 (S2K), 3 = >= 3072 (S4K, 4096-row chunks).
+constexpr int kClasses = 4;
+constexpr const char* kClassName[kClasses] = {"lt64", "s512", "s2k", "s4k"};
+constexpr int RowClass(std::uint32_t n) { return n < 64 ? 0 : n < 1024 ? 1 : n < 3072 ? 2 : 3; }
+
+/// Prefix row counts the probe sweeps on a captured wide call (every variant vs the production kernel on the same
+/// prefix and the same initial state; synthetic checkpoints at (r + 1) / 2 and r).
+constexpr int kSweepCount = 30;
+constexpr std::uint32_t kSweep[kSweepCount] = {1,   2,   3,   4,   5,   7,   8,   9,   15,   16,   17,   31,   32,  33, 63,
+                                               64,  65,  127, 128, 129, 255, 256, 257, 511, 513, 1000, 1023, 1024, 1025, 2047};
+
+// ---- tile kind (generalized GdnRowSplitKernel) ---------------------------------------------------------------------------
+template <int kRows, int kWaves, int kW>
+struct Shape {
+  static constexpr int kThreads = kWaves * kWave;
+  static constexpr int kRowsPerWave = (kWave / kLanesPerRow) * kRows;  // 8 row groups x kRows
+  static constexpr int kRowsPerBlock = kRowsPerWave * kWaves;
+  static constexpr int kBlocksPerHead = kD / kRowsPerBlock;
+  static constexpr int kQkChunks = kW * (kD / 4) * 2;  // q and k float4 per window
+  static constexpr int kQkPerThread = kQkChunks / kThreads;
+  static constexpr int kVChunks = kW * kRowsPerBlock;
+  static constexpr int kVPerThread = kVChunks / kThreads;
+  static_assert(kD % kRowsPerBlock == 0, "rows per block must divide the head");
+  static_assert(kQkChunks % kThreads == 0, "q/k chunks per thread");
+  static_assert(kVChunks % kThreads == 0, "v chunks per thread");
+  static_assert(kW * 5 <= kThreads, "scales and decays per window");
+  static_assert(kQkPerThread >= 1 && kQkPerThread <= 8, "named q/k window vectors: 1..8");
+  static_assert(kVPerThread >= 1 && kVPerThread <= 8, "named v window values: 1..8");
+};
+
+/// Row of the block of lane-row slot rr: production's row_local (wave, rr, row group).
+constexpr int RowLocal(int rows_per_wave, int wave, int rr, int row_group) {
+  return wave * rows_per_wave + rr * (kWave / kLanesPerRow) + row_group;
+}
+/// q/k window chunk c (thread tid + j * threads): which plane (0 = q, 1 = k), token in the window, float4 index.
+/// Production (kW = 4): which = c >> 7, token = (c >> 5) & 3, vec = c & 31.
+constexpr int QkWhich(int c, int w) { return c / (w * (kD / 4)); }
+constexpr int QkTokW(int c, int w) { return (c / (kD / 4)) % w; }
+constexpr int QkVecOf(int c) { return c % (kD / 4); }
+/// LDS slot of float4 index v of a token row: stored [i][segment] so a row's 4 segment lanes read adjacent chunks.
+constexpr int QkSlot(int v) { return ((v % kVec) * kLanesPerRow) + (v / kVec); }
+/// float4 index the lane of segment s reads at step i: slot i * 4 + s holds vec s * 8 + i (keys 32 s + 4 i .. + 3).
+constexpr int SlotVec(int slot) { return (slot % kLanesPerRow) * kVec + slot / kLanesPerRow; }
+/// v window chunk e: token, row of the block.
+constexpr int VTok(int e, int rows_per_block) { return e / rows_per_block; }
+constexpr int VRow(int e, int rows_per_block) { return e % rows_per_block; }
+/// misc chunk of thread tid (tid < 5 kW): token, item (0 inv_k, 1 q_scale, 2 kq from scales; 3 decay, 4 beta from ab).
+constexpr int MTok(int tid) { return tid / 5; }
+constexpr int MIdx(int tid) { return tid % 5; }
+
+// ---- lane-row kind --------------------------------------------------------------------------------------------------------
+/// Lane-row: rows of a head are lanes; block b of kWaves waves covers rows [b * 32 * kWaves, +32 * kWaves) of head h.
+template <int kWaves>
+struct LaneRowShape {
+  static constexpr int kThreads = kWaves * kWave;
+  static constexpr int kRowsPerBlock = kThreads;
+  static constexpr int kBlocksPerHead = kD / kRowsPerBlock;
+  static_assert(kD % kRowsPerBlock == 0, "rows per block must divide the head");
+};
+
+// ---- fused epilogue (production GdnEpilogueKernel lane map) --------------------------------------------------------------
+/// Element i of a (token, head) output row is held by lane i % 32 as value r = i / 32 (production: v[r] =
+/// src[r * warpSize + lane], r = 0..3).
+constexpr int EpiLane(int i) { return i % kWave; }
+constexpr int EpiSlot(int i) { return i / kWave; }
+/// F16 output offset of (token t, head h) (production: (row / v_heads) * stride + (row % v_heads) * d with row =
+/// t * v_heads + h, or row * d when stride == 0).
+constexpr std::uint64_t EpiOffset(std::uint64_t t, std::uint64_t h, std::uint64_t v_heads, std::uint64_t stride) {
+  return stride != 0 ? t * stride + h * kD : (t * v_heads + h) * kD;
+}
+
+}  // namespace w3gscan
