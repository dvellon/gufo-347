--- /dev/null
+++ b/src/models/qwen38_flash_next/kernels/rocm/w3fz_plan.h
@@ -0,0 +1,226 @@
+// Queue 214 (fz-214): the sibling-fusion probe's shared plan - model shapes, the merged-launch TASK MAP, the launcher
+// refusal table and the per-site constants of the pre-registered arithmetic. Plain C++17, no HIP: the device kernels
+// (fz_merged.hip.cpp) call Locate() with FZ_HD = __host__ __device__, and the Dell tests (fz_map_test.cpp) run the
+// very same functions on the CPU with g++ (-Wall -Wextra -Werror).
+//
+// TASK MAP. A merged launch has `threads` threads per block and up to three segments, laid out in order:
+//   kWhole  segment: one merged block per parent block (pthreads == threads: the parent body runs with the hardware
+//           thread index unchanged; only blockIdx is mapped). Used for block-level bodies (SmallGemm 4-wave blocks,
+//           RouterTopK, quantize_q8_1, group_moe_slots, PrepareAttention, StoreRows, the norm+rope composite).
+//   kPacked segment: parent blocks are single waves (mul_mat_vec_q8 <<<rows, 32>>>); threads / 32 of them share one
+//           merged block, wave w of merged block b running parent block (b - start) * (threads / 32) + w with
+//           shadow threadIdx.x = hardware lane. Waves past the parent grid are idle (whole waves: these bodies have no
+//           block barrier).
+// Every parent (block, thread) appears exactly once; the Dell test enumerates that bijection for every site and width.
+#pragma once
+#include <cstdint>
+
+#ifndef FZ_HD
+#if defined(__HIPCC__) || defined(__HIP__)
+#define FZ_HD __host__ __device__
+#else
+#define FZ_HD
+#endif
+#endif
+
+namespace fz {
+
+struct Dim3 {
+  unsigned int x, y, z;
+};
+
+// ---- model shapes (compiled constants; fz_probe refuses to run unless fz-shapes.json, written from the production
+// GGUF headers by make_fz_shapes.py, carries exactly these values) ---------------------------------------------------
+constexpr std::uint32_t kHidden = 2560;          // embedding_length
+constexpr std::uint32_t kExperts = 512;          // expert_count
+constexpr std::uint32_t kUsed = 10;              // expert_used_count
+constexpr std::uint32_t kRouterRows = 513;       // ffn_gate_inp (512) + ffn_gate_inp_shexp (1), F32 -> F16 on device
+constexpr std::uint32_t kShexpFf = 640;          // ffn_{gate,up}_shexp Q8_0 [2560 x 640]; ffn_down_shexp Q8_0 [640 x 2560]
+constexpr std::uint32_t kSsmInRows = 16384;      // GDN attn_qkv (10240) + attn_gate (6144) stacked, Q8_0
+constexpr std::uint32_t kAlphaBetaRows = 96;     // ssm_alpha (48) + ssm_beta (48), F32 -> F16 on device
+constexpr std::uint32_t kQkvRows = 13312;        // attention attn_q (12288) + attn_k (512) + attn_v (512), Q8_0
+constexpr std::uint32_t kIdxKRows = 128;         // indexer.k_proj BF16
+constexpr std::uint32_t kIdxQRows = 512;         // indexer.q_proj BF16 (4 heads x 128)
+constexpr std::uint32_t kHeads = 24, kKvHeads = 2, kHeadDim = 256, kRotary = 64;
+constexpr std::uint32_t kIdxHeads = 4, kIdxDim = 128, kRatio = 4, kIdxTopK = 2048;
+constexpr std::uint32_t kContextLength = 262144;  // qwen4exp.context_length -> executor mask_words_
+constexpr std::uint32_t kMaskWords = ((kContextLength + kRatio - 1) / kRatio + 31) / 32;   // 2048
+constexpr std::uint32_t kAttnSplits = 8;          // executor.cpp kAttnSplits
+constexpr std::uint32_t kQDim = kHeads * kHeadDim;              // 6144
+constexpr std::uint32_t kKvRow = kKvHeads * kHeadDim;           // 512
+constexpr std::uint32_t kXStride = 2560 / 32;                    // GGML_PAD(2560, 512) / QK8_1
+constexpr std::uint32_t kShexpXStride = 1024 / 32;               // GGML_PAD(640, 512) / QK8_1
+constexpr std::uint32_t kSmallGemmRows = 4;                      // kernels.hip.cpp
+
+// ---- probe scenario (decode at ~8K context, the ROOFLINE / design operating point) ------------------------------------
+constexpr std::uint32_t kStartPos = 8188;        // rows 8188 .. 8188 + w - 1 (complete blocks 2047 > budget 512)
+constexpr std::uint32_t kSessionContext = 32768; // production agent session context -> score row stride
+constexpr std::uint32_t kScoreBlocks = (kSessionContext / kRatio + 31) / 32 * 32;   // max_blocks 8192
+constexpr std::uint32_t kIndexCapacity = 4096;   // bit_ceil(min(context, top_k + max_chunk))
+constexpr std::uint32_t kKvRows = 8192 + 16;     // KV cache rows allocated by the probe
+
+enum Kind : std::uint32_t { kWhole = 0, kPacked = 1 };
+enum Role : std::uint32_t {
+  kRoleNone = 0, kRouter, kShexpGU, kTopK, kQuant, kSlots, kShexpDown, kSsmIn, kAlphaBeta, kQkv, kIdxK, kIdxQ,
+  kPrep, kStore, kNormRope
+};
+struct Seg {
+  std::uint32_t role, kind, pblocks, pgx, pthreads;
+};
+struct Map {
+  Seg seg[3];
+  std::uint32_t nseg, threads;
+};
+struct Task {
+  std::int32_t seg;
+  std::uint32_t role, pbx, pby, ptid;
+};
+
+FZ_HD inline std::uint32_t SegBlocks(const Seg& s, std::uint32_t threads) {
+  return s.kind == kWhole ? s.pblocks : (s.pblocks + threads / 32 - 1) / (threads / 32);
+}
+FZ_HD inline std::uint32_t MapBlocks(const Map& m) {
+  std::uint32_t n = 0;
+  for (std::uint32_t i = 0; i < m.nseg; ++i) n += SegBlocks(m.seg[i], m.threads);
+  return n;
+}
+// The parent task of merged (block b, thread tid); seg -1 = idle.
+FZ_HD inline Task Locate(const Map& m, std::uint32_t b, std::uint32_t tid) {
+  Task t{-1, kRoleNone, 0, 0, 0};
+  std::uint32_t start = 0;
+  for (std::uint32_t i = 0; i < m.nseg; ++i) {
+    const Seg& s = m.seg[i];
+    const std::uint32_t nb = SegBlocks(s, m.threads);
+    if (b < start + nb) {
+      std::uint32_t pb = 0, ptid = 0;
+      if (s.kind == kWhole) {
+        if (tid >= s.pthreads) return t;
+        pb = b - start;
+        ptid = tid;
+      } else {
+        pb = (b - start) * (m.threads / 32) + tid / 32;
+        ptid = tid % 32;
+        if (pb >= s.pblocks) return t;
+      }
+      t.seg = static_cast<std::int32_t>(i);
+      t.role = s.role;
+      t.pbx = pb % s.pgx;
+      t.pby = pb / s.pgx;
+      t.ptid = ptid;
+      return t;
+    }
+    start += nb;
+  }
+  return t;
+}
+
+// ---- sites --------------------------------------------------------------------------------------------------------
+enum Site : std::uint32_t { kS1 = 0, kS2, kS3, kS4, kS5, kS6a, kS6c, kS6d, kSites };
+// Launches removed by one merged instance, instances per C1 round (verify pass, width 4) - the design's site counts
+// (FUSION-DESIGN s2.1: S1-S3 48, S4 36, S5 24 = 2 x 12, S6 60 = (3 + 1 + 1) x 12).
+constexpr std::uint32_t kRemoved[kSites] = {1, 1, 1, 1, 2, 3, 1, 1};
+constexpr std::uint32_t kInstances[kSites] = {48, 48, 48, 36, 12, 12, 12, 12};
+inline const char* SiteName(std::uint32_t s) {
+  static const char* const k[kSites] = {"S1", "S2", "S3", "S4", "S5", "S6a", "S6c", "S6d"};
+  return s < kSites ? k[s] : "?";
+}
+// Segments of a sibling site (S6c / S6d are single-block composites: 1 / 2 parts, no map).
+constexpr std::uint32_t kSegCount[kSites] = {2, 2, 2, 2, 3, 3, 2, 2};
+
+// Refusal table: the merged route runs only where production would run exactly the parent launches on the decode
+// route (1..8 rows); everything else keeps the production launches.
+FZ_HD constexpr bool Refuse(std::uint32_t site, std::uint32_t n) {
+  if (n < 1 || n > 8 || site >= kSites) return true;
+  if (site == kS3) return n < 2 || n * kUsed > 256;   // width 1 has no group_moe_slots launch (mmvq.hip.cpp:849)
+  return false;
+}
+FZ_HD constexpr std::uint32_t SlotsThreads(std::uint32_t n) { return (n * kUsed + 31) / 32 * 32; }
+FZ_HD constexpr std::uint32_t MarkThreads(std::uint32_t n) { return n <= 4 ? 1024u : 256u; }
+
+// `order` 0 = production launch order, 1 = reversed. `keep` bit i = segment i (in production order) non-empty: the
+// `copy` controls run the merged kernel with all but one segment empty.
+FZ_HD inline Map SiteMap(std::uint32_t site, std::uint32_t n, std::uint32_t order, std::uint32_t keep) {
+  Map m{};
+  Seg s[3] = {};
+  std::uint32_t ns = 2;
+  switch (site) {
+    case kS1:   // router SmallGemm<F16> (4-wave blocks) || shared gate/up mul_mat_vec_q8<n, true> (single waves)
+      m.threads = 128;
+      s[0] = {kRouter, kWhole, (kRouterRows + kSmallGemmRows - 1) / kSmallGemmRows,
+              (kRouterRows + kSmallGemmRows - 1) / kSmallGemmRows, 128};
+      s[1] = {kShexpGU, kPacked, kShexpFf, kShexpFf, 32};
+      break;
+    case kS2:   // RouterTopK<512> (n blocks) || quantize_q8_1 of the shared SwiGLU rows (grid 4 x n)
+      m.threads = 256;
+      s[0] = {kTopK, kWhole, n, n, 256};
+      s[1] = {kQuant, kWhole, 4 * n, 4, 256};
+      break;
+    case kS3:   // group_moe_slots (1 block) || shared down mul_mat_vec_q8<n, false> (2560 single waves)
+      m.threads = SlotsThreads(n);
+      s[0] = {kShexpDown, kPacked, kHidden, kHidden, 32};
+      s[1] = {kSlots, kWhole, 1, 1, SlotsThreads(n)};
+      break;
+    case kS4:   // ssm_in mul_mat_vec_q8 (16384 single waves) || alpha/beta SmallGemm<F16> (24 blocks)
+      m.threads = 128;
+      s[0] = {kSsmIn, kPacked, kSsmInRows, kSsmInRows, 32};
+      s[1] = {kAlphaBeta, kWhole, kAlphaBetaRows / kSmallGemmRows, kAlphaBetaRows / kSmallGemmRows, 128};
+      break;
+    case kS5:   // qkv mul_mat_vec_q8 || indexer_k SmallGemm<BF16> || indexer_q SmallGemm<BF16>
+      m.threads = 128;
+      ns = 3;
+      s[0] = {kQkv, kPacked, kQkvRows, kQkvRows, 32};
+      s[1] = {kIdxK, kWhole, kIdxKRows / kSmallGemmRows, kIdxKRows / kSmallGemmRows, 128};
+      s[2] = {kIdxQ, kWhole, kIdxQRows / kSmallGemmRows, kIdxQRows / kSmallGemmRows, 128};
+      break;
+    case kS6a:  // PrepareAttention<1> (grid n x 26) || StoreRows(ik) (n) || [RmsNorm(iq) x 4 rows; Rope(iq)] (n)
+      m.threads = 256;
+      ns = 3;
+      s[0] = {kPrep, kWhole, n * (kHeads + kKvHeads), n, 256};
+      s[1] = {kStore, kWhole, n, n, 256};
+      s[2] = {kNormRope, kWhole, n, n, 256};
+      break;
+    default:
+      m.threads = 32;
+      ns = 0;
+  }
+  for (std::uint32_t i = 0; i < ns; ++i)
+    if (!((keep >> i) & 1u)) s[i].pblocks = 0;
+  m.nseg = ns;
+  for (std::uint32_t i = 0; i < ns; ++i) m.seg[i] = s[order ? ns - 1 - i : i];
+  return m;
+}
+
+// Digest of every Locate result of every merged map the probe can launch (site, width 1..8, order, keep = all and each
+// single segment, every merged block and thread): the Dell test (g++) and w3fz_probe --map-digest (clang) print it;
+// equal digests = the device runs the Dell-tested map. Host only.
+inline std::uint64_t MapDigest() {
+  std::uint64_t h = 1469598103934665603ull;
+  auto mix = [&h](std::uint64_t v) {
+    for (int i = 0; i < 8; ++i) {
+      h ^= (v >> (8 * i)) & 0xFF;
+      h *= 1099511628211ull;
+    }
+  };
+  const std::uint32_t sites[] = {kS1, kS2, kS3, kS4, kS5, kS6a};
+  for (std::uint32_t site : sites)
+    for (std::uint32_t n = 1; n <= 8; ++n) {
+      if (Refuse(site, n)) continue;
+      for (std::uint32_t order = 0; order < 2; ++order)
+        for (std::uint32_t k = 0; k <= kSegCount[site]; ++k) {
+          const std::uint32_t keep = k == kSegCount[site] ? (1u << kSegCount[site]) - 1 : 1u << k;
+          const Map m = SiteMap(site, n, order, keep);
+          const std::uint32_t blocks = MapBlocks(m);
+          mix((std::uint64_t(site) << 48) ^ (std::uint64_t(n) << 40) ^ (std::uint64_t(order) << 36) ^
+              (std::uint64_t(keep) << 32) ^ blocks);
+          for (std::uint32_t b = 0; b < blocks; ++b)
+            for (std::uint32_t tid = 0; tid < m.threads; ++tid) {
+              const Task t = Locate(m, b, tid);
+              mix((std::uint64_t(std::uint32_t(t.seg + 1)) << 56) ^ (std::uint64_t(t.role) << 48) ^
+                  (std::uint64_t(t.pbx) << 24) ^ (std::uint64_t(t.pby) << 12) ^ t.ptid);
+            }
+        }
+    }
+  return h;
+}
+
+}  // namespace fz
diff --git a/src/models/qwen38_flash_next/kernels/rocm/w3fz_serve.hpp b/src/models/qwen38_flash_next/kernels/rocm/w3fz_serve.hpp
new file mode 100644
--- /dev/null
+++ b/src/models/qwen38_flash_next/kernels/rocm/w3fz_serve.hpp
@@ -0,0 +1,186 @@
+// Queue 224 (fz-e2e-224, FZ-E2E): the 214 sibling-kernel merges wired into the serving forward pass of a
+// TEST build (w3fz_server). Never promoted. Included by executor.cpp (eligibility + knob) and by w3fz_serve.inc (the
+// merged kernels, compiled inside kernels.hip.cpp's translation unit = the production kernels object's flags).
+//
+// Knob GUFO_FZ_SITES, read once per process (function-local static):
+//   unset            off, no log line (the production launches)
+//   "" / "none"      off (mask 0), one fz_config line
+//   "all"            every wired site: S2 S4 S5 S6a S6c S6d
+//   "S2,S5,..."      exactly those sites (comma separated, each at most once)
+//   anything else    off (mask 0) with valid=0 (S1 / S3 are NOT wired: README s2)
+// One stderr line at the first use when the variable is set:
+//   gufo: event=fz_config sites=<list|none> mask=0x<hex> requested=<value|(unprintable)> valid=<0|1> port=fz-e2e-224
+// One witness line per site at its first merged launch:
+//   gufo: event=fz_first site=<S..> rows=<n> port=fz-e2e-224
+// Off (mask 0) = every eligibility test below is false, so every call site takes its production branch unchanged.
+// Widths: only 1, 2, 3, 4 and 8 rows (the widths 214b proved bitwise); everything else runs production.
+#pragma once
+
+#include <hip/hip_fp16.h>
+#include <hip/hip_runtime.h>
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace gufo::models::qwen38_flash_next::rocm::w3fz {
+
+enum Site : unsigned { kS2 = 0, kS4, kS5, kS6a, kS6c, kS6d, kSiteCount };
+constexpr unsigned kAllSites = (1u << kSiteCount) - 1u;
+
+inline const char* SiteName(unsigned s) noexcept {
+  static const char* const k[kSiteCount] = {"S2", "S4", "S5", "S6a", "S6c", "S6d"};
+  return s < kSiteCount ? k[s] : "?";
+}
+
+struct KnobValue {
+  unsigned mask;
+  bool set;
+  bool valid;
+};
+
+/// Pure parser (Dell-tested in dell-check/fz_knob_test.cpp).
+inline KnobValue ParseSites(const char* v) noexcept {
+  if (v == nullptr) return {0u, false, true};
+  if (v[0] == '\0' || std::strcmp(v, "none") == 0) return {0u, true, true};
+  if (std::strcmp(v, "all") == 0) return {kAllSites, true, true};
+  unsigned mask = 0;
+  const char* p = v;
+  while (true) {
+    const char* e = p;
+    while (*e != '\0' && *e != ',') ++e;
+    const std::size_t len = static_cast<std::size_t>(e - p);
+    unsigned hit = kSiteCount;
+    for (unsigned s = 0; s < kSiteCount; ++s) {
+      const char* nm = SiteName(s);
+      if (std::strlen(nm) == len && std::strncmp(nm, p, len) == 0) hit = s;
+    }
+    if (hit == kSiteCount || (mask >> hit) & 1u) return {0u, true, false};
+    mask |= 1u << hit;
+    if (*e == '\0') break;
+    p = e + 1;
+  }
+  return {mask, true, true};
+}
+
+inline bool Printable(const char* v) noexcept {
+  for (const char* p = v; *p != '\0'; ++p) {
+    const char c = *p;
+    if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == ',')) return false;
+  }
+  return std::strlen(v) <= 64;
+}
+
+inline unsigned Mask() {
+  static const unsigned mask = [] {
+    const char* v = std::getenv("GUFO_FZ_SITES");
+    const KnobValue k = ParseSites(v);
+    if (k.set) {
+      char names[64] = {0};
+      std::size_t at = 0;
+      for (unsigned s = 0; s < kSiteCount; ++s) {
+        if (!((k.mask >> s) & 1u)) continue;
+        at += static_cast<std::size_t>(
+            std::snprintf(names + at, sizeof(names) - at, "%s%s", at ? "," : "", SiteName(s)));
+      }
+      std::fprintf(stderr,
+                   "gufo: event=fz_config sites=%s mask=0x%02x requested=%s valid=%d port=fz-e2e-224\n",
+                   k.mask ? names : "none", k.mask, Printable(v) ? (v[0] ? v : "(empty)") : "(unprintable)",
+                   k.valid ? 1 : 0);
+      std::fflush(stderr);
+    }
+    return k.mask;
+  }();
+  return mask;
+}
+
+inline bool On(Site s) { return (Mask() >> s) & 1u; }
+
+/// The widths 214b proved bitwise (1-4 and 8 rows).
+constexpr bool Width(std::uint32_t n) noexcept { return n == 1 || n == 2 || n == 3 || n == 4 || n == 8; }
+
+inline void Fired(Site s, std::uint32_t n) {
+  static std::atomic<unsigned> seen{0};
+  const unsigned bit = 1u << s;
+  if (!(seen.fetch_or(bit) & bit)) {
+    std::fprintf(stderr, "gufo: event=fz_first site=%s rows=%u port=fz-e2e-224\n", SiteName(s), n);
+    std::fflush(stderr);
+  }
+}
