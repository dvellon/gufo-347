+struct Counters {
+  std::atomic<std::uint64_t> spans{0};    // spans C copied as more than one call
+  std::atomic<std::uint64_t> pieces{0};   // calls those spans became
+  std::atomic<std::uint64_t> refused{0};  // pieces with no device alias (HIP's own copy path), or a failed re-check
+};
+inline Counters& Count() {
+  static Counters counters;
+  return counters;
+}
+// SplitCopy nesting on this thread (one counter for every instantiation).
+inline int& SplitDepth() {
+  static thread_local int depth = 0;
+  return depth;
+}
+
+// `alias(const std::byte*)` returns the device alias of one host byte, or nullopt when it has none.
+// True when the byte at `offset` sits where a single linear alias starting at `first` puts it.
+template <class Alias>
+bool Linear(const std::byte* host, std::uintptr_t first, std::size_t offset, Alias& alias) {
+  const auto at = alias(host + offset);
+  return at.has_value() && *at - first == offset;
+}
+
+// True when every probe (one byte per kProbeStride, then the last byte) continues the first byte's alias.
+template <class Alias>
+bool OneRegistration(const std::byte* host, std::uintptr_t first, std::size_t bytes, Alias& alias) {
+  if (bytes < 2)
+    return true;
+  for (std::size_t offset = kProbeStride; offset < bytes - 1; offset += kProbeStride)
+    if (!Linear(host, first, offset, alias))
+      return false;
+  return Linear(host, first, bytes - 1, alias);
+}
+
+// Bytes from `host` whose alias continues the first byte's alias: canon-ledger R2's
+// W3SegContiguousPrefix (continuation_adapter.cpp), bracketed by the stride probes first. For a span shorter
+// than kProbeStride + 1 it is R2's search step for step. `bytes` when `host` has no alias (HIP's own path).
+template <class Alias>
+std::size_t ContiguousPrefix(const std::byte* host, std::size_t bytes, Alias& alias) {
+  if (bytes < 2)
+    return bytes;
+  const auto first = alias(host);
+  if (!first.has_value())
+    return bytes;
+  std::size_t lo = 0, hi = bytes - 1;  // lo continues the first byte, hi does not (once established)
+  for (std::size_t offset = kProbeStride; offset < bytes - 1; offset += kProbeStride) {
+    if (!Linear(host, *first, offset, alias)) {
+      hi = offset;
+      break;
+    }
+    lo = offset;
+  }
+  if (hi == bytes - 1 && Linear(host, *first, hi, alias))
+    return bytes;
+  while (hi - lo > 1) {
+    const auto mid = lo + (hi - lo) / 2;
+    (Linear(host, *first, mid, alias) ? lo : hi) = mid;
+  }
+  return hi;
+}
+
+// C's split: one `copy(offset, n)` per registration-linear piece, in order; `fallback(offset, n)` (HIP's own
+// copy) only when a piece fails its own re-check, which ContiguousPrefix's construction rules out (README s4.3).
+// Counts and (GUFO_CL_DIAG=1) logs the span before the first piece is submitted, like R2's w3cldiag_xseg line.
+template <class Status, class Alias, class Copy, class Fallback>
+Status SplitCopy(const std::byte* host, std::size_t bytes, bool load, Alias& alias, Copy&& copy,
+                 Fallback&& fallback, Status ok) {
+  struct Depth {
+    int& d;
+    explicit Depth(int& value) : d(value) { ++d; }
+    ~Depth() { --d; }
+  } guard(SplitDepth());
+  auto& counters = Count();
+  if (guard.d > 1) {
+    counters.refused.fetch_add(1, std::memory_order_relaxed);
+    return fallback(std::size_t{0}, bytes);
+  }
+  std::vector<std::pair<std::size_t, std::size_t>> pieces;
+  std::size_t unaliased = 0;
+  for (std::size_t offset = 0; offset < bytes;) {
+    const auto n = ContiguousPrefix(host + offset, bytes - offset, alias);
+    if (!alias(host + offset).has_value())
+      ++unaliased;
+    pieces.emplace_back(offset, n);
+    offset += n;
+  }
+  const auto spans = counters.spans.fetch_add(1, std::memory_order_relaxed) + 1;
+  counters.pieces.fetch_add(pieces.size(), std::memory_order_relaxed);
+  const auto refused = counters.refused.fetch_add(unaliased, std::memory_order_relaxed) + unaliased;
+  if (Get().diag)
+    std::fprintf(stderr,
+                 "[INFO] [cache] schema=component-cache-v1 event=w3segfix_alias_split load=%d bytes=%zu "
+                 "pieces=%zu unaliased=%zu first_split_at=%zu spans_total=%llu refused_total=%llu\n",
+                 load ? 1 : 0, bytes, pieces.size(), unaliased,
+                 pieces.size() > 1 ? pieces[1].first : bytes, static_cast<unsigned long long>(spans),
+                 static_cast<unsigned long long>(refused));
+  for (const auto& [offset, n] : pieces)
+    if (const auto status = copy(offset, n); status != ok)
+      return status;
+  return ok;
+}
+
+// ---- r3: the pool segment table (D / E; reached only when Get().seg_split; xseg-fix-r3 README s4) ----
+namespace segtab {
+inline constexpr unsigned kPageShift = 12;
+inline constexpr unsigned kPagesBits = 28;  // <= 2^28 pages (1 TiB) per registration
+inline constexpr std::uint64_t kPagesMask = (std::uint64_t{1} << kPagesBits) - 1;
+inline constexpr std::uint64_t kHostLimit = std::uint64_t{1} << (64 - kPagesBits + kPageShift);  // 2^48
+
+// One registration as one word, so a reader never sees half of an entry: host >> 12 in the high 36 bits, its pages
+// in the low 28. 0 = empty slot, or a range the word cannot hold (not page-aligned, >= 2^48, > 1 TiB).
+inline std::uint64_t Pack(std::uintptr_t host, std::size_t bytes) {
+  const auto h = static_cast<std::uint64_t>(host), n = static_cast<std::uint64_t>(bytes);
+  const std::uint64_t page = (std::uint64_t{1} << kPageShift) - 1;
+  if (h == 0 || n == 0 || ((h | n) & page) != 0 || h >= kHostLimit || (n >> kPageShift) > kPagesMask)
+    return 0;
+  return (h >> kPageShift << kPagesBits) | (n >> kPageShift);
+}
+inline std::uintptr_t Begin(std::uint64_t word) {
+  return static_cast<std::uintptr_t>(word >> kPagesBits << kPageShift);
+}
+inline std::size_t Bytes(std::uint64_t word) {
+  return static_cast<std::size_t>((word & kPagesMask) << kPageShift);
+}
+
+struct Table {
+  std::mutex mu;                                 // writers only (CommitPages / ReleasePages)
+  std::atomic<std::uint64_t> word[kSegSlots];    // a packed registration, 0 = empty
+  std::atomic<std::uintptr_t> alias[kSegSlots];  // E: the device alias of the registration's first byte, 0 = none
+  std::atomic<std::size_t> used{0};              // every non-empty slot lies below `used` (never decreases)
+  std::atomic<bool> incomplete{false};           // a registration was not recorded (D: C's probes for misses)
+  std::atomic<unsigned long long> splits{0}, pieces{0}, unregistered{0}, overflow{0};
+};
+inline Table& T() {
+  static Table table;
+  return table;
+}
+inline bool Incomplete() {
+  return T().incomplete.load(std::memory_order_acquire);
+}
+
+// CommitPages, after hipHostRegister succeeded and before the segment is published (the pool's committed
+// release / acquire then orders these stores before any copy of the segment). False: not recorded (printed).
+inline bool Add(std::uintptr_t host, std::size_t bytes, std::uintptr_t alias) {
+  auto& t = T();
+  const std::uint64_t w = Pack(host, bytes);
+  const std::lock_guard<std::mutex> lock(t.mu);
+  if (w != 0)
+    for (std::size_t i = 0; i < kSegSlots; ++i)
+      if (t.word[i].load(std::memory_order_relaxed) == 0) {
+        t.alias[i].store(alias, std::memory_order_relaxed);
+        t.word[i].store(w, std::memory_order_release);
+        if (t.used.load(std::memory_order_relaxed) <= i)
+          t.used.store(i + 1, std::memory_order_release);
+        return true;
+      }
+  t.incomplete.store(true, std::memory_order_release);
+  const auto total = t.overflow.fetch_add(1, std::memory_order_relaxed) + 1;
+  std::fprintf(stderr,
+               "[INFO] [cache] schema=component-cache-v1 event=w3segtab_overflow host=0x%llx bytes=%zu "
+               "packable=%d slots=%zu overflow_total=%llu\n",
+               static_cast<unsigned long long>(host), bytes, w != 0 ? 1 : 0, kSegSlots, total);
+  return false;
+}
+// ReleasePages, before hipHostUnregister (no copy of the segment can be in flight: its blocks own the pool state).
+inline void Drop(std::uintptr_t host) {
+  auto& t = T();
+  const std::lock_guard<std::mutex> lock(t.mu);
+  const auto n = t.used.load(std::memory_order_relaxed);
+  for (std::size_t i = 0; i < n; ++i) {
+    const auto w = t.word[i].load(std::memory_order_relaxed);
+    if (w != 0 && Begin(w) == host) {
+      t.word[i].store(0, std::memory_order_release);
+      t.alias[i].store(0, std::memory_order_relaxed);
+      return;
+    }
+  }
+}
+
+struct Hit {
+  std::uintptr_t begin{0};
+  std::uintptr_t end{0};    // 0: the byte is in no recorded registration
+  std::uintptr_t alias{0};  // E only: the device alias of `begin` (0 = query HIP)
+  std::uintptr_t next{0};   // on a miss: the lowest recorded registration start above the byte (0 = none)
+  bool Crosses(std::uintptr_t host, std::size_t bytes) const {
+    return end != 0 && bytes > end - host;
+  }
+};
+inline std::size_t& Hint() {
+  static thread_local std::size_t hint = 0;  // this thread's last hit: consecutive copies share a segment
+  return hint;
+}
+// The recorded registration holding `host`: no HIP call, no lock, at most `used` acquire loads (the hint first).
+inline Hit Find(std::uintptr_t host) {
+  auto& t = T();
+  const std::size_t n = t.used.load(std::memory_order_acquire);
+  std::size_t& hint = Hint();
+  Hit miss;
+  for (std::size_t k = 0; k < n; ++k) {
+    const std::size_t i = hint + k < n ? hint + k : hint + k - n;
+    const std::uint64_t w = t.word[i].load(std::memory_order_acquire);
+    if (w == 0)
+      continue;
+    const std::uintptr_t b = Begin(w);
+    if (host - b < Bytes(w)) {
+      hint = i;
+      Hit hit;
+      hit.begin = b;
+      hit.end = b + Bytes(w);
+      hit.alias = t.alias[i].load(std::memory_order_relaxed);
+      return hit;
+    }
+    if (b > host && (miss.next == 0 || b < miss.next))
+      miss.next = b;
+  }
+  return miss;
+}
+
+// The span cut at every recorded registration boundary: (offset, bytes) per piece, in order. A piece whose first
+// byte is in no recorded registration runs to the next recorded start (or the span's end); `unregistered` counts them.
+template <class FindFn>
+std::vector<std::pair<std::size_t, std::size_t>> Pieces(std::uintptr_t host, std::size_t bytes, FindFn& find,
+                                                        std::size_t& unregistered) {
+  std::vector<std::pair<std::size_t, std::size_t>> pieces;
+  for (std::size_t offset = 0; offset < bytes;) {
+    const std::uintptr_t at = host + offset;
+    const Hit h = find(at);
+    const std::size_t rest = bytes - offset;
+    std::size_t n = rest;
+    if (h.end != 0) {
+      n = std::min<std::size_t>(rest, h.end - at);
+    } else {
+      ++unregistered;
+      if (h.next != 0 && h.next - at < rest)
+        n = h.next - at;
+    }
+    pieces.emplace_back(offset, n);
+    offset += n;
+  }
+  return pieces;
+}
+
+// D's split: one `copy(offset, n)` per piece, in order (same bytes, same destination, same stream); `fallback`
+// (HIP's own copy) only when called from inside a split on this thread (a piece that still crossed: impossible
+// while the table holds the live registrations). Counts and (GUFO_CL_DIAG=1) logs the span before its pieces.
+template <class Status, class FindFn, class Copy, class Fallback>
+Status SegSplitCopy(std::uintptr_t host, std::size_t bytes, bool load, FindFn&& find, Copy&& copy,
+                    Fallback&& fallback, Status ok) {
+  struct Depth {
+    int& d;
+    explicit Depth(int& value) : d(value) { ++d; }
+    ~Depth() { --d; }
+  } guard(SplitDepth());
+  auto& counters = Count();
+  if (guard.d > 1) {
+    counters.refused.fetch_add(1, std::memory_order_relaxed);
+    return fallback(std::size_t{0}, bytes);
+  }
+  auto& t = T();
+  std::size_t unregistered = 0;
+  const auto pieces = Pieces(host, bytes, find, unregistered);
+  counters.spans.fetch_add(1, std::memory_order_relaxed);
+  counters.pieces.fetch_add(pieces.size(), std::memory_order_relaxed);
+  const auto splits = t.splits.fetch_add(1, std::memory_order_relaxed) + 1;
+  t.pieces.fetch_add(pieces.size(), std::memory_order_relaxed);
+  const auto unreg = t.unregistered.fetch_add(unregistered, std::memory_order_relaxed) + unregistered;
+  if (Get().diag)
+    std::fprintf(stderr,
+                 "[INFO] [cache] schema=component-cache-v1 event=w3segtab_split load=%d bytes=%zu pieces=%zu "
+                 "first_split_at=%zu unregistered=%zu spans_total=%llu unregistered_total=%llu\n",
+                 load ? 1 : 0, bytes, pieces.size(), pieces.size() > 1 ? pieces[1].first : bytes, unregistered,
+                 splits, unreg);
+  for (const auto& [offset, n] : pieces)
+    if (const auto status = copy(offset, n); status != ok)
+      return status;
+  return ok;
