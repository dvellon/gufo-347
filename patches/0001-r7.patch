+  s.a1_bad += b1;
+  s.a2_bad += b2;
+  Note(s, "small-a1", n, b1);
+  Note(s, "small-a2", n, b2);
+  s.small_seen[n] = true;
+  ++s.small_calls;
+  ++s.calls;
+  Report(s, n, false);
+  return true;
