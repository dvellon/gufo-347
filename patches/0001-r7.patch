+struct SfxProposal {
+  std::int32_t token{0};
+  double p{0.0};
+};
+
+struct SfxCandidate {
+  std::size_t length;
+  int src;
+  std::size_t pos;
+};
+
+struct SfxNext {
+  std::int32_t token;
+  int src;
+  std::size_t pos;
+};
+
+/// Newest occurrences of the context's last 3 tokens in `index`, each
+/// extended backwards against the context (`at`, `c` tokens).
+template <class At>
+void SfxGather(const SfxIndex& index, int src, std::uint64_t key, std::size_t c,
+               const At& at, std::vector<SfxCandidate>& out) {
+  const auto& toks = index.Tokens();
+  std::uint32_t end = index.Head(key);
+  std::size_t count = 0;
+  while (end != kSfxNone && count < kSfxMaxCandidates) {
+    std::size_t length = 3;
+    while (length < kSfxMaxMatch && end > length && c > length + 1 &&
+           toks[end - length - 1] == at(c - length - 1))
+      ++length;
+    out.push_back({length, src, end});
+    ++count;
+    end = index.Prev(end);
+  }
+}
+
+/// Chain for the context (`at`, `c` tokens): walk the deepest node (longest
+/// matches) by majority continuation. Returns the proposal count.
+template <class At>
+std::size_t SfxChain(const SfxIndex& local, const SfxIndex* global, std::size_t c,
+                     const At& at, std::size_t max_tokens, SfxProposal* out,
+                     bool* global_first) {
+  thread_local std::vector<SfxCandidate> cands;
+  thread_local std::vector<SfxCandidate> node;
+  thread_local std::vector<SfxNext> next;
+  struct Count {
+    std::int32_t token;
+    std::size_t count;
+    int first_src;
+  };
+  thread_local std::vector<Count> counts;
+  *global_first = false;
+  if (c < 3 || max_tokens == 0)
+    return 0;
+  const std::uint64_t key = SfxKey(at(c - 3), at(c - 2), at(c - 1));
+  cands.clear();
+  SfxGather(local, 0, key, c, at, cands);
+  if (global != nullptr)
+    SfxGather(*global, 1, key, c, at, cands);
+  if (cands.empty())
+    return 0;
+  std::size_t deepest = 0;
+  for (const auto& x : cands)
+    deepest = std::max(deepest, x.length);
+  node.clear();
+  for (const auto& x : cands)
+    if (x.length == deepest)
+      node.push_back(x);
+  std::size_t length = deepest;
+  std::size_t n = 0;
+  const auto& lbuf = local.Tokens();
+  for (; n < max_tokens; ++n) {
+    next.clear();
+    counts.clear();
+    for (const auto& x : node) {
+      std::int32_t token;
+      if (x.src == 0) {
+        if (x.pos >= lbuf.size())
+          continue;
+        token = lbuf[x.pos];
+      } else {
+        const auto& gbuf = global->Tokens();
+        if (x.pos >= gbuf.size() || gbuf[x.pos] == kSfxBarrier)
+          continue;
+        token = gbuf[x.pos];
+      }
+      next.push_back({token, x.src, x.pos});
+      auto it = std::find_if(counts.begin(), counts.end(),
+                             [&](const Count& k) { return k.token == token; });
+      if (it == counts.end())
+        counts.push_back({token, 1, x.src});
+      else
+        ++it->count;
+    }
+    if (next.empty())
+      break;
+    // Most frequent; ties: first seen locally, then first seen (newest).
+    const Count* best = &counts.front();
+    for (const auto& k : counts)
+      if (k.count > best->count ||
+          (k.count == best->count && k.first_src < best->first_src))
+        best = &k;
+    bool local_agrees = false;
+    node.clear();
+    for (const auto& x : next) {
+      if (x.token != best->token)
+        continue;
+      local_agrees = local_agrees || x.src == 0;
+      node.push_back({0, x.src, x.pos + 1});
+    }
+    const int src = local_agrees ? 0 : 1;
+    if (n == 0)
+      *global_first = src == 1;
+    out[n] = {best->token,
+              SfxProbability(src, length,
+                             static_cast<double>(best->count) /
+                                 static_cast<double>(next.size()),
+                             best->count)};
+    ++length;
+  }
+  return n;
+}
+
+/// Best copy length k: argmax (prefix_e + sum of survival * prod p) / cost
+/// of a `width_now + k` row cycle without further MTP proposals.
+std::size_t SfxBest(const SfxProposal* props, std::size_t n, std::size_t room,
+                    std::size_t width_now, std::size_t context, double prefix_e,
+                    double survival, double* score) {
+  std::size_t best_k = 0;
+  double best = 0.0;
+  double e = prefix_e;
+  double p = survival;
+  for (std::size_t k = 1; k <= std::min(room, n); ++k) {
+    p *= props[k - 1].p;
+    e += p;
+    const double s = e / SfxCycleMs(width_now + k, 0, context);
+    if (k == 1 || s > best) {
+      best = s;
+      best_k = k;
+    }
+  }
+  *score = best;
+  return best_k;
+}
+
+struct SfxGlobalCache {
+  std::uint64_t key{0};
+  std::uint64_t stamp{0};
+  std::vector<std::vector<std::int32_t>> outputs;
+  std::size_t total{0};
+  SfxIndex index;
+
+  void Add(std::span<const std::int32_t> output, std::size_t cap) {
+    std::vector<std::int32_t> o(output.begin(), output.end());
+    o.push_back(kSfxBarrier);
+    total += o.size();
+    outputs.push_back(std::move(o));
+    if (total > cap) {
+      // Keep the newest outputs within 3/4 of the cap and re-index them.
+      std::size_t keep = 0, kept = 0;
+      for (std::size_t i = outputs.size(); i-- > 0;) {
+        if (kept + outputs[i].size() > cap * 3 / 4)
+          break;
+        kept += outputs[i].size();
+        ++keep;
+      }
+      outputs.erase(outputs.begin(),
+                    outputs.begin() + static_cast<std::ptrdiff_t>(outputs.size() - keep));
+      total = kept;
+      index.Clear();
+      for (const auto& x : outputs)
+        for (const auto t : x)
+          index.Push(t);
+    } else {
+      for (const auto t : outputs.back())
+        index.Push(t);
+    }
+  }
+};
+
+struct SfxSession {
+  SfxIndex local;
+  std::uint64_t key{0};
+  std::size_t recorded{0};           ///< history size already recorded
+  std::vector<std::int32_t> output;  ///< this request's tokens (global only)
+};
