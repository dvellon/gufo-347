new file mode 100644
--- /dev/null
+++ b/src/models/qwen38_flash_next/kernels/rocm/w3hcd_route.h
@@ -0,0 +1,110 @@
+// Wave3 hc-down-small (HC-DOWN-SMALL, queue 167; README.md). Shared by the executor overlay, the HIP unit
+// w3hcd_down.hip.cpp and the CPU reference test hcd_ref_test.cpp: the knob parse, the route table and the A1
+// kernel's addressing. Plain constexpr C++17 (clang HIP treats constexpr functions as host + device).
+#ifndef W3HCD_ROUTE_H_
+#define W3HCD_ROUTE_H_
+
+#include <cstddef>
+#include <cstdint>
+
+namespace w3hcd {
+
+// GUFO_HC_DOWN_SMALL: unset / "" / "0" = production; "1" = A1 + B; "2" = A2 + B; "3" = probe; anything else invalid.
+constexpr int kModeInvalid = -1;
+constexpr int kModeOff = 0;
+constexpr int kModeA1 = 1;
+constexpr int kModeA2 = 2;
+constexpr int kModeProbe = 3;
+
+// What one HcMix down projection runs.
+constexpr int kRouteProd = 0;  // the production launch (W8A8Gemm / HcDownF16Gemm)
+constexpr int kRouteA1 = 1;    // rows < 96: W3hcdSmallKernel (one lane per token, the tail kernel's arithmetic)
+constexpr int kRouteA2 = 2;    // rows < 96: W8A8BlockedWmmaGEMMKernel<32, 128, 8, 1, 8>
+constexpr int kRouteB = 3;     // 96 <= rows < 1024: W8A8BlockedWmmaGEMMKernel<32, 128, 8, 1, 8, true> + the tail split
+
+// The mixer down projection: 320 output rows over K = 10,240 (hc_count 4 x hidden 2,560), Q8_0 W8A8.
+constexpr std::uint32_t kRows = 320;
+constexpr std::uint32_t kK = 10240;
+// Production's route boundary (Executor::HcMix fused_projection needs n_tokens >= 96).
+constexpr std::uint32_t kSmallMaxRows = 95;
+constexpr std::uint32_t kFusedMinRows = 96;
+// B stops below this many rows: from 1,024 rows production already runs >= 40 blocks (S2K: 80).
+constexpr std::uint32_t kFusedMaxRows = 1023;
+
+constexpr int ParseMode(const char* v) {
+  if (v == nullptr || v[0] == '\0')
+    return kModeOff;
+  if (v[1] != '\0')
+    return kModeInvalid;
+  return v[0] == '0'   ? kModeOff
+         : v[0] == '1' ? kModeA1
+         : v[0] == '2' ? kModeA2
+         : v[0] == '3' ? kModeProbe
+                       : kModeInvalid;
+}
+
+constexpr bool DownShape(std::uint32_t m, std::uint32_t k) { return m == kRows && k == kK; }
+constexpr bool SmallShape(std::uint32_t n, std::uint32_t m, std::uint32_t k) {
+  return n >= 1 && n <= kSmallMaxRows && DownShape(m, k);
+}
+constexpr bool FusedShape(std::uint32_t n, std::uint32_t m, std::uint32_t k) {
+  return n >= kFusedMinRows && n <= kFusedMaxRows && DownShape(m, k);
+}
+
+/// The route of one call. `fused` = the call site is HcMix's fused projection (HcDownF16Gemm), else the small
+/// route's W8A8Gemm. Probe and off modes always run production.
+constexpr int Route(int mode, std::uint32_t n, std::uint32_t m, std::uint32_t k, bool fused) {
+  if (mode != kModeA1 && mode != kModeA2)
+    return kRouteProd;
+  if (fused)
+    return FusedShape(n, m, k) ? kRouteB : kRouteProd;
+  if (!SmallShape(n, m, k))
+    return kRouteProd;
+  return mode == kModeA1 ? kRouteA1 : kRouteA2;
+}
+
+/// Probe mode compares at every call of the down shape (fused calls of any size: the sweeps need wide inputs).
+constexpr bool ProbeSmall(int mode, std::uint32_t n, std::uint32_t m, std::uint32_t k) {
+  return mode == kModeProbe && SmallShape(n, m, k);
+}
+constexpr bool ProbeFused(int mode, std::uint32_t n, std::uint32_t m, std::uint32_t k) {
+  return mode == kModeProbe && n >= kFusedMinRows && DownShape(m, k);
+}
+
+// ---- A1 (W3hcdSmallKernel) addressing: block = 8 waves, one output row per wave, one token per lane.
+constexpr std::uint32_t kA1Waves = 8;
+constexpr std::uint32_t kA1Lanes = 32;
+// The production activation tile (kernels.hip.cpp kQ8ActTile*): 16 tokens x one 32-wide K block; codes 0..15 of
+// token tl at tl * 16, codes 16..31 at 256 + tl * 16, the fp32 scale at 512 + tl * 4.
+constexpr std::size_t kTileTokens = 16;
+constexpr std::size_t kTileBytes = 576;
+constexpr std::size_t kTileHiOffset = 256;
+constexpr std::size_t kTileScaleOffset = 512;
+
+constexpr std::uint32_t A1GridX(std::uint32_t m) { return (m + kA1Waves - 1) / kA1Waves; }
+constexpr std::uint32_t A1GridY(std::uint32_t n) { return (n + kA1Lanes - 1) / kA1Lanes; }
+constexpr std::uint32_t A1Row(std::uint32_t block_x, std::uint32_t wave) { return block_x * kA1Waves + wave; }
+constexpr std::uint32_t A1Token(std::uint32_t block_y, std::uint32_t lane) { return block_y * kA1Lanes + lane; }
+/// Lanes past the last token load the last token (real data); their results are never stored.
+constexpr std::uint32_t A1LoadToken(std::uint32_t tok, std::uint32_t n) { return tok < n ? tok : n - 1; }
+/// The K block of chain step s: ascending, as the blocked kernel's stage loop and the tail kernel's lane order.
+constexpr std::uint32_t A1Kb(std::uint32_t s, std::uint32_t /*num_kb*/) { return s; }
+/// Byte offset of token tok's K-block-kb tile.
+constexpr std::size_t A1TileOffset(std::uint32_t tok, std::uint32_t kb, std::uint32_t num_kb) {
+  return ((static_cast<std::size_t>(tok / kTileTokens) * num_kb) + kb) * kTileBytes;
+}
+constexpr std::size_t A1LoOffset(std::uint32_t tok) { return (tok % kTileTokens) * 16; }
+constexpr std::size_t A1HiOffset(std::uint32_t tok) { return kTileHiOffset + (tok % kTileTokens) * 16; }
+constexpr std::size_t A1ScaleOffset(std::uint32_t tok) { return kTileScaleOffset + (tok % kTileTokens) * 4; }
+
+// ---- the probe's row-count sweep (captured inputs of a wide pass, every prefix r of its tokens).
+constexpr std::uint32_t kSweepFused[] = {96, 97, 112, 127, 128, 129, 144, 255, 256, 260, 500, 511, 512, 513, 1000, 1023};
+constexpr std::uint32_t kSweepFusedCount = sizeof(kSweepFused) / sizeof(kSweepFused[0]);
+/// Wide fused calls whose captured input is swept (1..95 and kSweepFused up to the call's rows).
+constexpr std::uint32_t kSweepMinRows = 512;
+constexpr std::uint32_t kSweepEvery = 47;   // about 2 of a pass's 94 W8A8-route mixer calls
+constexpr std::uint32_t kSweepMax = 64;     // per process
+
+}  // namespace w3hcd
+
+#endif  // W3HCD_ROUTE_H_
