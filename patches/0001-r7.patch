@@ -0,0 +1,171 @@
+#ifndef GUFO_SERVER_OPTION_SCORING_HPP_
+#define GUFO_SERVER_OPTION_SCORING_HPP_
+
+// [optscore] optscore (queue 244): the options-scoring call
+// ("option_logprobs" on /v1/chat/completions). A decision read from the
+// prompt pass, with no generation: every option's FIRST token is scored with
+// the log-softmax of the frontier row (the full LM head, every row the decode
+// sampler sees) at the last prompt position. Standard library only, so the
+// math and the request validation are CPU-testable on their own.
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <span>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace gufo::server::optscore {
+
+inline constexpr std::size_t kMaxOptions = 64;
+inline constexpr std::size_t kMaxOptionBytes = 256;
+
+/// Log-softmax of a logits row at requested ids.
+struct RowScores {
+  /// One per requested id: logit - logsumexp (-inf for a masked logit).
+  std::vector<double> logprobs;
+  double logsumexp{0.0};
+  /// Lowest-index finite maximum (the greedy selection over the full row).
+  std::size_t top{0};
+  double top_logprob{0.0};
+  /// Row length (the LM head's rows) and its finite entries.
+  std::size_t rows{0};
+  std::size_t finite{0};
+};
+
+/// Same accumulation as the server's xm_eval trace (inference_backend.cpp
+/// XmTraceEval): max over finite entries, then sum(exp(v - max)) in double.
+/// -inf entries are masked (probability 0); NaN or +inf refuse the row.
+inline RowScores LogSoftmaxAt(std::span<const float> logits,
+                              std::span<const std::uint32_t> ids) {
+  if (logits.empty())
+    throw std::runtime_error("option scoring: empty logits row");
+  RowScores out;
+  out.rows = logits.size();
+  std::size_t best = logits.size();
+  float top1 = -std::numeric_limits<float>::infinity();
+  for (std::size_t i = 0; i < logits.size(); ++i) {
+    const float v = logits[i];
+    if (std::isnan(v) || v == std::numeric_limits<float>::infinity())
+      throw std::runtime_error("option scoring: non-finite logit at row " +
+                               std::to_string(i));
+    if (!std::isfinite(v))
+      continue;
+    ++out.finite;
+    if (best == logits.size() || v > top1) {
+      top1 = v;
+      best = i;
+    }
+  }
+  if (best == logits.size())
+    throw std::runtime_error("option scoring: no finite logit in the row");
+  double sum = 0.0;
+  for (const float v : logits)
+    if (std::isfinite(v))
+      sum += std::exp(static_cast<double>(v) - static_cast<double>(top1));
+  out.logsumexp = static_cast<double>(top1) + std::log(sum);
+  out.top = best;
+  out.top_logprob = static_cast<double>(top1) - out.logsumexp;
+  out.logprobs.reserve(ids.size());
+  for (const std::uint32_t id : ids) {
+    if (id >= logits.size())
+      throw std::runtime_error("option scoring: token id " +
+                               std::to_string(id) + " outside the " +
+                               std::to_string(logits.size()) + "-row head");
+    const float v = logits[id];
+    out.logprobs.push_back(std::isfinite(v)
+                               ? static_cast<double>(v) - out.logsumexp
+                               : -std::numeric_limits<double>::infinity());
+  }
+  return out;
+}
+
+/// The options' distribution renormalized over the options alone
+/// (softmax of their logprobs); *mass = sum(exp(logprob)), the full-vocab
+/// probability the options cover. All-masked options give zeros.
+inline std::vector<double> Renormalize(std::span<const double> logprobs,
+                                       double* mass) {
+  double top = -std::numeric_limits<double>::infinity();
+  for (const double v : logprobs)
+    if (v > top)
+      top = v;
+  std::vector<double> out(logprobs.size(), 0.0);
+  double total = 0.0;
+  if (mass != nullptr)
+    *mass = 0.0;
+  if (!std::isfinite(top))
+    return out;
+  for (std::size_t i = 0; i < logprobs.size(); ++i) {
+    out[i] = std::isfinite(logprobs[i]) ? std::exp(logprobs[i] - top) : 0.0;
+    total += out[i];
+    if (mass != nullptr && std::isfinite(logprobs[i]))
+      *mass += std::exp(logprobs[i]);
+  }
+  for (double& v : out)
+    v /= total;
+  return out;
+}
+
+/// The request field: 1..kMaxOptions non-empty, distinct strings of at most
+/// kMaxOptionBytes bytes. Returns the error message, or nullopt.
+inline std::optional<std::string> ValidateOptionStrings(
+    const std::vector<std::string>& options) {
+  if (options.empty())
+    return "'option_logprobs' must list at least one option";
+  if (options.size() > kMaxOptions)
+    return "'option_logprobs' lists " + std::to_string(options.size()) +
+           " options (at most " + std::to_string(kMaxOptions) + ")";
+  std::unordered_map<std::string, std::size_t> seen;
+  for (std::size_t i = 0; i < options.size(); ++i) {
+    const auto& option = options[i];
+    if (option.empty())
+      return "'option_logprobs[" + std::to_string(i) + "]' is empty";
+    if (option.size() > kMaxOptionBytes)
+      return "'option_logprobs[" + std::to_string(i) + "]' is longer than " +
+             std::to_string(kMaxOptionBytes) + " bytes";
+    const auto [it, inserted] = seen.emplace(option, i);
+    if (!inserted)
+      return "'option_logprobs[" + std::to_string(i) + "]' repeats option " +
+             std::to_string(it->second);
+  }
+  return std::nullopt;
+}
+
+/// First-token rule: every option tokenizes to at least one token, the first
+/// tokens are pairwise distinct (else the scores could not tell the options
+/// apart) and inside the vocabulary (when vocab > 0). On success *first holds
+/// one id per option; returns the error message, or nullopt.
+inline std::optional<std::string> FirstTokens(
+    const std::vector<std::string>& options,
+    const std::vector<std::vector<std::uint32_t>>& tokenized,
+    std::uint32_t vocab, std::vector<std::uint32_t>* first) {
+  if (tokenized.size() != options.size())
+    return "option scoring: tokenized option count mismatch";
+  first->clear();
+  std::unordered_map<std::uint32_t, std::size_t> seen;
+  for (std::size_t i = 0; i < options.size(); ++i) {
+    if (tokenized[i].empty())
+      return "option '" + options[i] + "' tokenizes to no token";
+    const std::uint32_t id = tokenized[i].front();
+    if (vocab != 0 && id >= vocab)
+      return "option '" + options[i] + "' starts with token " +
+             std::to_string(id) + " outside the " + std::to_string(vocab) +
+             "-token vocabulary";
+    const auto [it, inserted] = seen.emplace(id, i);
+    if (!inserted)
+      return "options '" + options[it->second] + "' and '" + options[i] +
+             "' share their first token " + std::to_string(id) +
+             "; option_logprobs scores first tokens only, so options must "
+             "start with different tokens";
+    first->push_back(id);
+  }
+  return std::nullopt;
+}
+
+}  // namespace gufo::server::optscore
+
+#endif  // GUFO_SERVER_OPTION_SCORING_HPP_
