--- /dev/null
+++ b/src/models/qwen38_flash_next/kernels/rocm/q2s_plan.h
@@ -0,0 +1,203 @@
+// Queue 225 (q2screen-225): constants, the Q2_0 screen layout and the CPU references shared by the device probe
+// (q2s_kern.hip.cpp / q2s_host.cpp) and the Dell CPU test (q2s_test.cpp). Self-contained C++17; no HIP header.
+//
+// Q2_0 screening copy (dell-sims-054 P2 rule, re-implemented from Lamina's tools/mtp_pack.py description):
+//   64-value blocks of a head row, levels {-1, 0, 1, 2} x d; d = amax * f for the f in linspace(0.5, 1.0, 17) with the
+//   least squared error (first minimum wins), then d rounded to f16 and the codes recomputed with the f16 d.
+//   Device layout (ours; 720 B per row of 2,560):
+//     codes  [V][640] bytes: block j (0..39) = bytes [16 j, 16 j + 16) = four u32 words; element e (0..63) of the block
+//            is the 2-bit code c = q + 1 in word w = e / 16, bits 8 b + 2 s with b = e % 4, s = (e % 16) / 4.
+//            So (word >> 2 s) & 0x03030303 = the four codes of elements 16 w + 4 s + 0..3, i.e. exactly the packed int8
+//            word m = 16 j + 4 w + s of the Q8_1 activation (elements 4 m .. 4 m + 3).
+//     scales [V][40] f16 bits.
+//   Screen score of row v for input x (Q8_1 blocks g = 0..79: d_g, codes xq): sum_j d2_j * (dx_{2j} * (C_{2j} - S_{2j}) +
+//   dx_{2j+1} * (C_{2j+1} - S_{2j+1})), C_g = sum over the sub-block of c * xq (integer), S_g = sum of xq (integer).
+// Selection: exact top-K of the screen keys (key = order-preserving u32 of the f32 score, NaN -> 0), ties by the lowest
+// row id; composite u64 = key << 32 | ~id (larger = better), so the order is total.
+#ifndef Q2S_PLAN_H_
+#define Q2S_PLAN_H_
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+#if defined(__HIPCC__) || defined(__HIP__)
+#define Q2S_HD __host__ __device__
+#else
+#define Q2S_HD
+#endif
+
+namespace q2s {
+
+constexpr std::uint32_t kHidden = 2560;            // head input width (MtpConfig hidden)
+constexpr std::uint32_t kQ8Blocks = kHidden / 32;  // Q8_0 / Q8_1 blocks per row (80)
+constexpr std::uint32_t kQ8RowBytes = kQ8Blocks * 34;  // 2,720
+constexpr std::uint32_t kQ8_1RowBytes = kQ8Blocks * 36;  // 2,880 (production input stride 80 blocks: K % 512 == 0)
+constexpr std::uint32_t kQ2Blocks = kHidden / 64;  // 40
+constexpr std::uint32_t kQ2CodeBytes = kHidden / 4;  // 640 per row
+constexpr std::uint32_t kQ2RowBytes = kQ2CodeBytes + kQ2Blocks * 2;  // 720
+constexpr std::uint32_t kVSmall = 49152;           // draft prefix rows (draft_vocab.hpp; device_model.cpp draft_output_)
+constexpr std::uint32_t kVFull = 248320;           // output.weight rows (GGUF header, shard 2)
+constexpr std::uint32_t kMaxW = 8;                 // vector batch (executor.cpp kVecBatch)
+constexpr std::uint32_t kMaxK = 128;               // largest screened k
+constexpr std::uint32_t kChunk = 4096;             // stage-1 selection chunk (256 threads x 16 keys)
+constexpr std::uint32_t kSel1Threads = 256;
+constexpr std::uint32_t kSel1Per = kChunk / kSel1Threads;  // 16
+constexpr std::uint32_t kSel2Threads = 1024;
+constexpr std::uint32_t kSel2Per = 8;              // 8,192 candidates >= 61 chunks x 128
+constexpr std::uint32_t kEqCap = 1024;             // keys equal to the threshold resolved on chip
+constexpr std::uint32_t kScreenThreads = 256;      // 8 lanes per row, 32 rows per block-iteration
+constexpr std::uint32_t kScreenGrid = 512;
+constexpr std::uint32_t kQ2Candidates = 17;        // linspace(0.5, 1.0, 17)
+// Error counters (device): 0 tie overflow (> kEqCap keys equal to a threshold), 1 count mismatch, 2 bad id.
+constexpr int kErrWords = 4;
+
+constexpr Q2S_HD std::uint32_t Chunks(std::uint32_t v) { return (v + kChunk - 1) / kChunk; }
+static_assert(Chunks(kVSmall) == 12 && Chunks(kVFull) == 61, "chunk counts");
+static_assert(Chunks(kVFull) * kMaxK <= kSel2Threads * kSel2Per, "stage-2 capacity");
+static_assert(kVSmall % 32 == 0 && kVFull % 32 == 0, "screen rows per block-iteration");
+static_assert(kSel1Threads * kSel1Per == kChunk, "stage-1 chunk");
+
+// Order-preserving key of a score (larger score = larger key); NaN -> 0 (w3sl::Key's rule).
+inline Q2S_HD std::uint32_t KeyBits(std::uint32_t b) {
+  if ((b & 0x7FFFFFFFu) > 0x7F800000u) return 0u;
+  return (b & 0x80000000u) != 0u ? ~b : (b | 0x80000000u);
+}
+inline std::uint32_t Key(float v) {
+  std::uint32_t b;
+  std::memcpy(&b, &v, 4);
+  return KeyBits(b);
+}
+inline Q2S_HD std::uint64_t Composite(std::uint32_t key, std::uint32_t id) {
+  return (static_cast<std::uint64_t>(key) << 32) | static_cast<std::uint32_t>(~id);
+}
+inline Q2S_HD std::uint32_t CompositeId(std::uint64_t c) { return ~static_cast<std::uint32_t>(c); }
+inline Q2S_HD std::uint32_t CompositeKey(std::uint64_t c) { return static_cast<std::uint32_t>(c >> 32); }
+
+// Code position of element e (0..63) of a Q2 block: word, bit shift.
+inline Q2S_HD std::uint32_t CodeWord(std::uint32_t e) { return e / 16; }
+inline Q2S_HD std::uint32_t CodeShift(std::uint32_t e) { return 8 * (e % 4) + 2 * ((e % 16) / 4); }
+
+// ---- host references --------------------------------------------------------------------------------------------
+inline std::uint16_t F16Bits(float f) {  // IEEE binary16, round to nearest even
+  std::uint32_t x;
+  std::memcpy(&x, &f, 4);
+  const std::uint32_t sign = (x >> 16) & 0x8000u;
+  const std::uint32_t ax = x & 0x7FFFFFFFu;
+  if (ax > 0x7F800000u) return static_cast<std::uint16_t>(sign | 0x7E00u);
+  if (ax >= 0x477FF000u) return static_cast<std::uint16_t>(sign | 0x7C00u);  // >= 65520 -> inf
+  const int e = static_cast<int>(ax >> 23) - 127 + 15;
+  std::uint32_t m = ax & 0x7FFFFFu;
+  if (e <= 0) {
+    if (e < -10) return static_cast<std::uint16_t>(sign);
+    m |= 0x800000u;
+    const int shift = 14 - e;
+    std::uint32_t h = m >> shift;
+    const std::uint32_t rem = m & ((1u << shift) - 1u), half = 1u << (shift - 1);
+    if (rem > half || (rem == half && (h & 1u))) ++h;
+    return static_cast<std::uint16_t>(sign | h);
+  }
+  std::uint32_t h = (static_cast<std::uint32_t>(e) << 10) | (m >> 13);
+  const std::uint32_t rem = m & 0x1FFFu;
+  if (rem > 0x1000u || (rem == 0x1000u && (h & 1u))) ++h;
+  return static_cast<std::uint16_t>(sign | h);
+}
+inline float F16Float(std::uint16_t h) {
+  const std::uint32_t sign = static_cast<std::uint32_t>(h & 0x8000u) << 16;
+  const std::uint32_t e = (h >> 10) & 0x1Fu, m = h & 0x3FFu;
+  std::uint32_t b;
+  if (e == 0) {
+    if (m == 0) {
+      b = sign;
+    } else {  // subnormal: m * 2^-24
+      float v = static_cast<float>(m) * (1.0f / 16777216.0f);
+      std::memcpy(&b, &v, 4);
+      b |= sign;
+    }
+  } else if (e == 31) {
+    b = sign | 0x7F800000u | (m << 13);
+  } else {
+    b = sign | ((e + 112u) << 23) | (m << 13);
+  }
+  float f;
+  std::memcpy(&f, &b, 4);
+  return f;
+}
+inline float RintEven(float v) {  // round half to even (torch.round), |v| < 2^23
+  const float a = v < 0 ? -v : v;
+  float r = static_cast<float>(static_cast<std::int64_t>(a));
+  const float frac = a - r;
+  if (frac > 0.5f || (frac == 0.5f && (static_cast<std::int64_t>(r) & 1))) r += 1.0f;
+  return v < 0 ? -r : r;
+}
+inline float Q2Level(float x, float inv) {  // clamp(round(x * inv), -1, 2)
+  float q = RintEven(x * inv);
+  return q < -1.0f ? -1.0f : (q > 2.0f ? 2.0f : q);
+}
+// One 64-value block -> f16 scale bits + 16 code bytes (the layout above). Reference for the device Q2Build kernel
+// (same operation order; the device TU is fast-math, so the probe REPORTS the agreement, it does not require it).
+inline void QuantQ2Block(const float* x, std::uint16_t* d16, std::uint8_t* codes) {
+  float amax = 0.0f;
+  for (int e = 0; e < 64; ++e) amax = (x[e] < 0 ? -x[e] : x[e]) > amax ? (x[e] < 0 ? -x[e] : x[e]) : amax;
+  float best_err = 0.0f, best_d = 0.0f;
+  bool have = false;
+  for (std::uint32_t i = 0; i < kQ2Candidates; ++i) {
+    const float f = 0.5f + static_cast<float>(i) * (1.0f / 32.0f);
+    const float d = amax * f;
+    const float inv = d > 0.0f ? 1.0f / d : 0.0f;
+    float err = 0.0f;
+    for (int e = 0; e < 64; ++e) {
+      const float r = Q2Level(x[e], inv) * d - x[e];
+      err += r * r;
+    }
+    if (!have || err < best_err) {
+      best_err = err;
+      best_d = d;
+      have = true;
+    }
+  }
+  *d16 = F16Bits(best_d);
+  const float df = F16Float(*d16);
+  const float inv = df > 0.0f ? 1.0f / df : 0.0f;
+  std::memset(codes, 0, 16);
+  for (std::uint32_t e = 0; e < 64; ++e) {
+    const std::uint32_t c = static_cast<std::uint32_t>(static_cast<int>(Q2Level(x[e], inv)) + 1);
+    std::uint32_t word;
+    std::memcpy(&word, codes + 4 * CodeWord(e), 4);
+    word |= c << CodeShift(e);
+    std::memcpy(codes + 4 * CodeWord(e), &word, 4);
+  }
+}
+// Decoded value of element e of a Q2 block.
+inline float Q2Value(const std::uint8_t* codes, std::uint16_t d16, std::uint32_t e) {
+  std::uint32_t word;
+  std::memcpy(&word, codes + 4 * CodeWord(e), 4);
+  const int c = static_cast<int>((word >> CodeShift(e)) & 3u);
+  return static_cast<float>(c - 1) * F16Float(d16);
+}
+// Screen score of one Q2 row against one Q8_1 activation row (36-byte blocks: f16 d, f16 d * sum, 32 int8), in double
+// (the device sums in f32: the probe compares within a tolerance).
+inline double ScreenRef(const std::uint8_t* codes_row, const std::uint16_t* scales_row, const std::uint8_t* xq_row) {
+  double s = 0.0;
+  for (std::uint32_t j = 0; j < kQ2Blocks; ++j) {
+    for (std::uint32_t e = 0; e < 64; ++e) {
+      const std::uint32_t el = 64 * j + e, g = el / 32;
+      std::uint16_t dxb;
+      std::memcpy(&dxb, xq_row + 36 * g, 2);
+      const auto q = static_cast<std::int8_t>(xq_row[36 * g + 4 + el % 32]);
+      s += static_cast<double>(Q2Value(codes_row + 16 * j, scales_row[j], e)) * F16Float(dxb) * q;
+    }
+  }
+  return s;
+}
+// Reference top-k (k <= n): ids by (key desc, id asc), i.e. composite desc.
+inline void RefTopK(const std::uint32_t* keys, std::uint32_t n, std::uint32_t k, std::uint32_t* out_ids) {
+  std::vector<std::uint64_t> c(n);
+  for (std::uint32_t v = 0; v < n; ++v) c[v] = Composite(keys[v], v);
+  std::partial_sort(c.begin(), c.begin() + k, c.end(), [](std::uint64_t a, std::uint64_t b) { return a > b; });
+  for (std::uint32_t r = 0; r < k; ++r) out_ids[r] = CompositeId(c[r]);
+}
+}  // namespace q2s
+
+#endif  // Q2S_PLAN_H_
diff --git a/src/models/qwen38_flash_next/kernels/rocm/w3af_followups.h b/src/models/qwen38_flash_next/kernels/rocm/w3af_followups.h
