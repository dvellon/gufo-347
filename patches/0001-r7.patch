+// Wave3 Q2L (q2live-226, queue 226; TEST build w3q2l_server only): the device side of the live Q2 screening
+// draft head (w3q2l.hpp), compiled INSIDE kernels.hip.cpp's translation unit, inside namespace
+// gufo::models::qwen38_flash_next::rocm, after the A1 block: production's A1ExactDot / A1Before / Q8_0Block / Q8_1Block /
+// kA1Blocks and BetterCandidate / ArgmaxBlock / ArgmaxCandidate / kThreads are the very definitions above (no copy).
+//   Q2RescoreA1Kernel  queue 225's kernel, VERBATIM (q2s_prod_kern.hip.cpp 2c83eb97, the 225c verdict arm q2a_64's
+//                      rescore: C-BIT 0 differences in every 225c config); make_q2l226.py asserts the text byte for byte
+//   Q2lMergeKernel     NEW: the screened best competes with the draft-table rows by production's Argmax rule
+//                      (BetterCandidate from {-inf, INT32_MAX} + ArgmaxBlock, one block of kThreads)
+//   Q2lCheckKernel     NEW, check mode only (GUFO_Q2_CHECK=1): counters against production's own GEMV + Argmax
+// The Q2 copy / screen / top-k kernels are queue 225's q2s_kern.hip.cpp byte for byte (w3q2l_q2s_kern.inc, appended at
+// the end of kernels.hip.cpp at global scope, launchers q2l::Q2Build / Screen / Select).
+namespace w3q2lk {
+namespace {
+
+// One block per token, 32 waves: wave w rescores screened entries i = w, w + 32, ... < k with A1ExactDot (all 32 lanes
+// call it together), lane 0 keeps the wave's best by A1Before; thread 0 merges the 32 wave bests in wave order.
+__global__ __launch_bounds__(1024) void Q2RescoreA1Kernel(const Q8_0Block* __restrict__ head,
+                                                          const Q8_1Block* __restrict__ xq,
+                                                          const std::uint32_t* __restrict__ ids, std::uint32_t k,
+                                                          float* __restrict__ resc, std::uint32_t* __restrict__ best_id,
+                                                          float* __restrict__ best_val) {
+  __shared__ float wv[32];
+  __shared__ std::int32_t wi[32];
+  const std::uint32_t t = blockIdx.x;
+  const int lane = static_cast<int>(threadIdx.x & 31u);
+  const std::uint32_t wave = threadIdx.x >> 5;
+  const Q8_1Block* x = xq + static_cast<std::size_t>(t) * kA1Blocks;
+  float bv = -INFINITY;
+  std::int32_t bi = INT32_MAX;
+  for (std::uint32_t i = wave; i < k; i += 32) {
+    const std::uint32_t id = ids[static_cast<std::size_t>(t) * q2s::kMaxK + i];
+    const float v = A1ExactDot(head + static_cast<std::size_t>(id) * kA1Blocks, x, lane);
+    if (lane == 0) {
+      resc[static_cast<std::size_t>(t) * q2s::kMaxK + i] = v;
+      if (bi == INT32_MAX || A1Before(v, static_cast<std::int32_t>(id), bv, bi)) {
+        bv = v;
+        bi = static_cast<std::int32_t>(id);
+      }
+    }
+  }
+  if (lane == 0) {
+    wv[wave] = bv;
+    wi[wave] = bi;
+  }
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    float v = wv[0];
+    std::int32_t i0 = wi[0];
+    for (int w = 1; w < 32; ++w)
+      if (wi[w] != INT32_MAX && (i0 == INT32_MAX || A1Before(wv[w], wi[w], v, i0))) {
+        v = wv[w];
+        i0 = wi[w];
+      }
+    best_id[t] = static_cast<std::uint32_t>(i0);
+    best_val[t] = v;
+  }
+}
+
+// Wave3 Q2L: one row. The table rows (prefix + j) reduce exactly as ArgmaxPartialKernel / ArgmaxBlock reduce a row;
+// the screened prefix best (best_val, best_id < prefix <= every table index) then competes by the same rule, so a tie
+// goes to the prefix row, as production's lowest-index rule does. A NaN best emits 0 (production: a NaN row 0 -> 0).
+__global__ __launch_bounds__(256) void Q2lMergeKernel(const std::uint32_t* __restrict__ best_id,
+                                                      const float* __restrict__ best_val,
+                                                      const float* __restrict__ table, std::uint32_t table_rows,
+                                                      std::uint32_t prefix, std::int32_t* __restrict__ out,
+                                                      std::int32_t* __restrict__ merged,
+                                                      std::uint32_t* __restrict__ counters) {
+  __shared__ ArgmaxCandidate shared[kThreads / 32];
+  ArgmaxCandidate best{-INFINITY, INT32_MAX};
+  for (std::uint32_t j = threadIdx.x; j < table_rows; j += kThreads)
+    best = BetterCandidate(best, {table[j], static_cast<std::int32_t>(prefix + j)});
+  best = ArgmaxBlock(best, shared);
+  if (threadIdx.x == 0) {
+    const float v = best_val[0];
+    std::int32_t r = 0;
+    if (isnan(v)) {
+      atomicAdd(&counters[1], 1u);
+    } else {
+      r = BetterCandidate(best, {v, static_cast<std::int32_t>(best_id[0])}).index;
+    }
+    out[0] = r;
+    merged[0] = r;
+    atomicAdd(&counters[0], 1u);
+  }
+}
+
+// Wave3 Q2L check mode (diagnostic arms): prod = production's Argmax index of the same row (pre-remap), logits =
+// production's head GEMV logits of that row (prefix rows first).
+__global__ __launch_bounds__(64) void Q2lCheckKernel(const std::int32_t* __restrict__ prod,
+                                                     const std::int32_t* __restrict__ merged,
+                                                     const float* __restrict__ logits,
+                                                     const std::uint32_t* __restrict__ ids,
+                                                     const float* __restrict__ resc, std::uint32_t k,
+                                                     std::uint32_t* __restrict__ counters) {
+  const std::int32_t p = prod[0];
+  std::uint32_t bad = 0;
+  bool in = false;
+  for (std::uint32_t i = threadIdx.x; i < k; i += blockDim.x) {
+    const std::uint32_t id = ids[i];
+    if (__float_as_uint(resc[i]) != __float_as_uint(logits[id]))
+      ++bad;
+    if (p >= 0 && static_cast<std::uint32_t>(p) == id)
+      in = true;
+  }
+  if (bad != 0)
+    atomicAdd(&counters[4], bad);
+  if (in)
+    atomicAdd(&counters[5], 1u);
+  if (threadIdx.x == 0) {
+    atomicAdd(&counters[2], 1u);
+    if (merged[0] != p)
+      atomicAdd(&counters[3], 1u);
+  }
+}
+
+}  // namespace
+}  // namespace w3q2lk
+
+void Q2lRescore(const void* head, const void* xq, const std::uint32_t* ids, std::uint32_t k, std::uint32_t n,
+                float* resc, std::uint32_t* best_id, float* best_val, hipStream_t stream) {
+  static_assert(kA1K == q2s::kHidden, "A1 row width");
+  hipLaunchKernelGGL(w3q2lk::Q2RescoreA1Kernel, dim3(n), dim3(1024), 0, stream,
+                     static_cast<const Q8_0Block*>(head), static_cast<const Q8_1Block*>(xq), ids, k, resc, best_id,
+                     best_val);
+}
+
+void Q2lMerge(const std::uint32_t* best_id, const float* best_val, const float* table, std::uint32_t table_rows,
+              std::uint32_t prefix, std::int32_t* out, std::int32_t* merged, std::uint32_t* counters,
+              hipStream_t stream) {
+  hipLaunchKernelGGL(w3q2lk::Q2lMergeKernel, dim3(1), dim3(kThreads), 0, stream, best_id, best_val, table,
+                     table_rows, prefix, out, merged, counters);
+}
+
+void Q2lCheck(const std::int32_t* prod, const std::int32_t* merged, const float* logits, const std::uint32_t* ids,
+              const float* resc, std::uint32_t k, std::uint32_t* counters, hipStream_t stream) {
+  hipLaunchKernelGGL(w3q2lk::Q2lCheckKernel, dim3(1), dim3(64), 0, stream, prod, merged, logits, ids, resc, k,
+                     counters);
+}
+
+// Exactly the w3q2l.hpp declarations: a definition with another signature would be an overload, and taking the address
+// of an overloaded name without a target type does not compile.
+namespace {
+[[maybe_unused]] constexpr auto kW3q2lPinRescore = &Q2lRescore;
+[[maybe_unused]] constexpr auto kW3q2lPinMerge = &Q2lMerge;
+[[maybe_unused]] constexpr auto kW3q2lPinCheck = &Q2lCheck;
+}  // namespace
