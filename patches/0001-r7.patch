+// ---------------------------------------------------------------------------
+// Wave3 A1 (a1-lmhead): exact LM-head argmax by
+// bounded screening. The engine arms a pass (ArmA1) only when every consumer of
+// its head rows is a greedy argmax: GreedyMtpPredictions (rows of the chain),
+// Rollback's frontier and a plain decode's frontier. Such a pass computes, per
+// row, the exact logits of the candidate rows only (bitwise the production
+// values) and the production argmax; every other reader of the pass's logit rows
+// first recomputes them with the production head GEMV (A1FullRows), so it sees
+// exactly the production rows. GUFO_A1=0 disables A1 at load.
+// GUFO_A1_MAX_ROWS=N (1..kA1MaxRows, default 4) caps the head rows of a screened
+// pass; wider passes run the production head unchanged (A1Usable is false), so
+// the cap only selects which passes are screened (ENGINE-PROBE-ANALYSIS.md: the
+// screen loses to the full head above about 8 rows).
+namespace {
+
+#include "src/models/qwen38_flash_next/kernels/rocm/a1_calibration.inc"
+
+void A1Log(int level, const std::string& message) {
+  std::fprintf(stderr, "%s [a1] %s\n",
+               level >= 2   ? "[ERROR]"
+               : level == 1 ? "[WARN]"
+                            : "[INFO]",
+               message.c_str());
+  std::fflush(stderr);
+}
+
+std::FILE* A1DumpFile() {
+  static std::FILE* const file = [] {
+    const char* path = std::getenv("GUFO_A1_DUMP");
+    return path != nullptr && *path != '\0' ? std::fopen(path, "ab") : nullptr;
+  }();
+  return file;
+}
+
+// subline-sweep (subline-sweep): unset / invalid GUFO_A1_MAX_ROWS = 0 =
+// A1 off (a1c defaulted to 4); the M1 arms set GUFO_A1_MAX_ROWS=4.
+inline constexpr std::uint32_t kA1DefaultMaxRows = 0;
+
+// Read once per process: every A1Usable call (session eligibility, Forward,
+// ForwardBatch) sees the same cap.
+std::uint32_t A1MaxRowsSetting() {
+  static const std::uint32_t value = [] {
+    const char* env = std::getenv("GUFO_A1_MAX_ROWS");
+    if (env == nullptr || *env == '\0')
+      return kA1DefaultMaxRows;
+    char* end = nullptr;
+    const unsigned long v = std::strtoul(env, &end, 10);
+    if (end == env || *end != '\0' || v < 1 || v > kA1MaxRows) {
+      A1Log(1, std::string("event=a1_max_rows_invalid value=") + env +
+                   " using=" + std::to_string(kA1DefaultMaxRows));
+      return kA1DefaultMaxRows;
+    }
+    return static_cast<std::uint32_t>(v);
+  }();
+  return value;
+}
+
+// Wave3 DH-FULL: GUFO_A1_DRAFT=1 screens token-only full-vocabulary drafts;
+// m1sb (m1sb): UNSET, "0" or anything else keeps the draft head on
+// the production GEMV (125b defaulted to on). Read once.
+bool A1DraftSetting() {
+  static const bool value = [] {
+    const char* env = std::getenv("GUFO_A1_DRAFT");
+    if (env == nullptr || *env == '\0')
+      return false;
+    const std::string_view v(env);
+    if (v == "0" || v == "1")
+      return v == "1";
+    A1Log(1, std::string("event=a1_draft_invalid value=") + env + " using=0");
+    return false;
+  }();
+  return value;
+}
+
+// The draft pass's word of the mapped nonce block (A1Setup: 64 bytes).
+inline constexpr std::uint32_t kA1DraftNonceWord = 8;
+
+// Wave3 DH-TOP2 (dh-top2): GUFO_A1_DRAFT2=1 screens the top-2
+// (confidence-stop) full-head drafts of screen_full_head requests. UNSET, "0"
+// or anything else = off (anything but "0"/"1" is logged invalid). Read once.
+bool A1Draft2Setting() {
+  static const bool value = [] {
+    const char* env = std::getenv("GUFO_A1_DRAFT2");
+    if (env == nullptr || *env == '\0')
+      return false;
+    const std::string_view v(env);
+    if (v == "0" || v == "1")
+      return v == "1";
+    A1Log(1, std::string("event=a1_draft2_invalid value=") + env + " using=0");
+    return false;
+  }();
+  return value;
+}
+
+// The top-2 draft pass's word of the mapped nonce block (A1Setup: 64 bytes).
+inline constexpr std::uint32_t kA1Draft2NonceWord = 9;
