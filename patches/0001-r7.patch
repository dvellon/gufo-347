+/// Load time, before serving: an approximate-only feature registers its tag
+/// (name + version, e.g. "r2v1"). The joined tags are part of approximate
+/// cache identities, so state written under one feature set is never reused
+/// under another (also across restarts through the disk tier).
+inline void RegisterApproximateFeature(std::string_view tag) {
+  auto& tags = detail::FeatureTags();
+  if (!tags.empty())
+    tags += '+';
+  tags.append(tag.data(), tag.size());
+}
+
+[[nodiscard]] inline const std::string& ApproximateFeatures() noexcept {
+  return detail::FeatureTags();
+}
+
+/// Bytes appended to every cache identity (complete and per-prefix) of a
+/// request at `level`. Empty for strict (= production's keys); relaxed and
+/// approximate (+ feature set) get distinct tags, so strict reuses only
+/// strict-produced state, relaxed only relaxed, approximate only approximate
+/// of the same feature set.
+[[nodiscard]] inline std::vector<std::uint8_t> NumericsTag(
+    ExactnessLevel level) {
+  if (level == ExactnessLevel::kStrict)
+    return {};
