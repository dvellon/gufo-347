+// Wave3 step 2 (step2-tokcache/README.md): exact prepare shortcuts for text-only Qwen prompts.
+// Included once by the overlay src/models/qwen/vision/prompt.cpp (make_tc.py), after its includes and before its
+// namespace. Every knob unset = production: Prepare() never enters this file's code.
+//
+//   GUFO_TOKCACHE=1        A: prefix tokenization cache (rendered bytes + ids up to the last message boundary)
+//   GUFO_TOKCACHE_ENTRIES  A: max cached lineages (default 16), LRU-evicted
+//   GUFO_TOKCACHE_MIB      A: max cached bytes, rendered bytes + 4 B/id + cut/span tables (default 64)
+//   GUFO_TOKPAR=N          C: tokenize one long prompt's tail on N threads (pool of N-1 + caller); N <= 1 = serial
+//   GUFO_TOKPAR_MIN_KB     C: tails shorter than this run serial (default 32)
+//   GUFO_TOKCACHE_STATS=1  one `w3tc event=prepare` stderr line per text prompt (render/encode/suffix ms, reuse)
+//
+// Exactness rule (proof in README section 2). Encode() splits the text at every matched special token BEFORE NFC
+// normalisation and the qwen35 split regex, and EncodeRendered() additionally splits at content spans that spell a
+// special token. A position p is a CUT when rendered[p..] starts with "<|im_start|>" and no content span
+// intersects [p, p + 12): that occurrence is framing, and when "<|im_start|>" is ISOLATED in the tokenizer's special
+// list (no other special contains it, and no other special's proper suffix is its proper prefix or vice versa;
+// checked at runtime, else every shortcut is off) it is always the special the scan matches there. Then
+//   EncodeRendered(0, n) == EncodeRendered(0, p) ++ EncodeRendered(p, n)
+// for every cut p. C also cuts long tails at "\n" + ASCII-graphic positions: a qwen35 piece always ends right after
+// the last newline of a whitespace run or of a punctuation run's trailing newlines, NFC never composes across U+000A
+// and an ASCII starter, and no special spells '\n' (checked at runtime), so these are cuts of Encode() too.
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <exception>
+#include <functional>
+#include <list>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <utility>
+
+namespace gufo::models::qwen::vision::w3tc {
+
+using tokenization::ContentSpan;
+using tokenization::TokenId;
+using Clock = std::chrono::steady_clock;
+
+struct Config {
+  bool cache{false};
+  bool stats{false};
+  unsigned tokpar{1};
+  std::size_t tokpar_min_bytes{32 * 1024};
+  std::size_t max_entries{16};
+  std::size_t max_bytes{64ull << 20};
+};
+
+inline std::size_t EnvSize(const char* name, std::size_t fallback) {
+  const char* value = std::getenv(name);
+  if (value == nullptr || *value == '\0')
+    return fallback;
+  char* end = nullptr;
+  const auto parsed = std::strtoull(value, &end, 10);
+  return end != value ? static_cast<std::size_t>(parsed) : fallback;
+}
+
+inline Config ConfigFromEnv() {
+  Config c;
+  c.cache = EnvSize("GUFO_TOKCACHE", 0) == 1;
+  c.stats = EnvSize("GUFO_TOKCACHE_STATS", 0) == 1;
+  c.tokpar = static_cast<unsigned>(std::min<std::size_t>(EnvSize("GUFO_TOKPAR", 1), 64));
+  if (c.tokpar == 0)
+    c.tokpar = 1;
+  c.tokpar_min_bytes = EnvSize("GUFO_TOKPAR_MIN_KB", 32) * 1024;
+  c.max_entries = std::max<std::size_t>(1, EnvSize("GUFO_TOKCACHE_ENTRIES", 16));
+  c.max_bytes = EnvSize("GUFO_TOKCACHE_MIB", 64) << 20;
+  return c;
+}
+
+inline bool AnyKnob(const Config& c) { return c.cache || c.stats || c.tokpar > 1; }
+
+inline std::mutex& ConfigMutex() {
+  static std::mutex m;
+  return m;
+}
+inline Config& ConfigRef() {
+  static Config c = ConfigFromEnv();
+  return c;
+}
+inline std::atomic<bool>& ActiveFlag() {
+  static std::atomic<bool> active{AnyKnob(ConfigFromEnv())};
+  return active;
+}
+inline Config CurrentConfig() {
+  const std::lock_guard<std::mutex> lock(ConfigMutex());
+  return ConfigRef();
+}
+/// Host self-test hook (tc_selftest.cpp); the server never calls it.
+inline void SetConfigForTest(const Config& c) {
+  const std::lock_guard<std::mutex> lock(ConfigMutex());
+  ConfigRef() = c;
+  ActiveFlag().store(AnyKnob(c), std::memory_order_relaxed);
+}
+/// The only call production makes into this file while every knob is unset (one relaxed atomic load).
+inline bool Active() { return ActiveFlag().load(std::memory_order_relaxed); }
+
+// ---------------------------------------------------------------------------------------------- per-call record
+struct CallStats {
+  bool cache_path{false};  ///< false: production algorithm (stats only, or a safety check failed)
+  bool hit{false};
+  unsigned tokpar{1};
+  unsigned chunks{0};
+  std::size_t bytes{0}, tokens{0}, reused_tokens{0}, tail_bytes{0}, lcp_bytes{0};
+  std::size_t entries{0}, cache_bytes{0}, cuts{0};
+  bool suffix_from_cuts{false};
+  double render_ms{0}, lookup_ms{0}, encode_ms{0}, suffix_ms{0}, store_ms{0}, total_ms{0};
+  const char* fallback{""};
+};
+inline CallStats& LastStats() {
+  thread_local CallStats s;
+  return s;
+}
+
+inline double Ms(Clock::time_point a, Clock::time_point b) {
+  return std::chrono::duration<double, std::milli>(b - a).count();
+}
+
+inline std::uint64_t Fnv(std::uint64_t h, const void* data, std::size_t n) {
+  const auto* p = static_cast<const unsigned char*>(data);
+  for (std::size_t i = 0; i < n; ++i) {
+    h ^= p[i];
+    h *= 1099511628211ull;
+  }
+  return h;
+}
+inline std::uint64_t IdsFnv(std::span<const TokenId> ids) {
+  return Fnv(1469598103934665603ull, ids.data(), ids.size_bytes());
+}
+
+// ------------------------------------------------------------------------------------- tokenizer safety facts
+struct Safety {
+  bool im_start_isolated{false};  ///< A and C message-boundary cuts are exact
+  bool newline_free{false};       ///< C "\n" cuts are exact
+  std::uint64_t fingerprint{0};   ///< cache entries are only reused by the same vocabulary
+};
+
+inline bool ProperOverlap(std::string_view left, std::string_view right) {
+  // A proper non-empty suffix of `left` equals a proper prefix of `right`.
+  for (std::size_t k = 1; k < left.size() && k < right.size(); ++k)
+    if (left.substr(left.size() - k) == right.substr(0, k))
+      return true;
+  return false;
+}
+
+inline Safety SafetyFacts(const tokenization::QwenTokenizer& tokenizer) {
+  Safety s;
+  const std::string_view b = tokenization::kImStart;
+  bool found = false, isolated = true, newline_free = true;
+  std::uint64_t specials = 0;
+  for (const auto& [name, id] : tokenizer.SpecialTokens()) {
+    const std::string_view sv = name;
+    if (sv.find('\n') != std::string_view::npos || sv.find('\r') != std::string_view::npos)
+      newline_free = false;
+    std::uint64_t h = Fnv(1469598103934665603ull, sv.data(), sv.size());
+    h = Fnv(h, &id, sizeof(id));
+    specials ^= h * 0x9E3779B97F4A7C15ull;
+    if (sv == b) {
+      found = true;
+      continue;
+    }
+    if (sv.find(b) != std::string_view::npos || ProperOverlap(sv, b) || ProperOverlap(b, sv))
+      isolated = false;
+  }
+  s.im_start_isolated = found && isolated;
+  s.newline_free = newline_free;
+  std::uint64_t fp = Fnv(1469598103934665603ull, &specials, sizeof(specials));
+  const auto vocab = tokenizer.GetVocabSize();
+  fp = Fnv(fp, &vocab, sizeof(vocab));
+  for (std::size_t i = 0; i < vocab && i < 64; ++i) {
+    for (const std::size_t id : {i, vocab - 1 - i}) {
+      const auto piece = tokenizer.DecodeTokenCopy(static_cast<TokenId>(id));
+      fp = Fnv(fp, piece.data(), piece.size());
+    }
+  }
+  s.fingerprint = fp;
+  return s;
+}
+
+// -------------------------------------------------------------------------------------------- cut positions
+/// Message-boundary cuts of one render: "<|im_start|>" occurrences no content span intersects.
+inline std::vector<std::size_t> ImStartCuts(std::string_view rendered, const std::vector<ContentSpan>& sorted) {
+  const std::string_view b = tokenization::kImStart;
+  std::vector<std::size_t> max_end(sorted.size() + 1, 0);
+  for (std::size_t i = 0; i < sorted.size(); ++i)
+    max_end[i + 1] = std::max(max_end[i], sorted[i].offset + sorted[i].size);
+  std::vector<std::size_t> cuts;
+  for (auto p = rendered.find(b); p != std::string_view::npos; p = rendered.find(b, p + 1)) {
+    // spans starting before p + |b|; any of them ending after p intersects the occurrence.
+    const auto k = static_cast<std::size_t>(
+        std::lower_bound(sorted.begin(), sorted.end(), p + b.size(),
+                         [](const ContentSpan& s, std::size_t v) { return s.offset < v; }) -
+        sorted.begin());
+    if (max_end[k] > p)
+      continue;
+    cuts.push_back(p);
+  }
+  return cuts;
+}
+
+inline bool AsciiGraphic(char c) {
+  const auto u = static_cast<unsigned char>(c);
+  return u >= 0x21 && u <= 0x7E;
+}
+
+// ------------------------------------------------------------------------------------------------- the cache
+struct Entry {
+  std::uint64_t fingerprint{0};
+  std::string bytes;                                    ///< rendered[0, last cut + |<|im_start|>|)
+  std::vector<TokenId> ids;                             ///< ids of rendered[0, last cut)
+  std::vector<std::pair<std::size_t, std::size_t>> cuts;  ///< (byte offset, ids before it), ascending
+  std::vector<ContentSpan> spans;                       ///< sorted spans with offset < last cut
+  std::size_t cost{0};
+};
+
+class Cache {
+ public:
+  std::vector<std::shared_ptr<const Entry>> Snapshot() {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    return {entries_.begin(), entries_.end()};
+  }
+  void Store(std::shared_ptr<const Entry> fresh, const std::shared_ptr<const Entry>& extended,
+             const Config& config, std::size_t* entries, std::size_t* bytes) {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    if (extended) {
+      for (auto it = entries_.begin(); it != entries_.end(); ++it) {
+        if (*it == extended) {
+          bytes_ -= (*it)->cost;
+          entries_.erase(it);
+          break;
+        }
+      }
+    }
+    if (fresh && fresh->cost <= config.max_bytes / 2) {
+      bytes_ += fresh->cost;
+      entries_.push_front(std::move(fresh));
+    }
+    while (!entries_.empty() && (entries_.size() > config.max_entries || bytes_ > config.max_bytes)) {
+      bytes_ -= entries_.back()->cost;
+      entries_.pop_back();
+    }
+    *entries = entries_.size();
+    *bytes = bytes_;
+  }
+  void Touch(const std::shared_ptr<const Entry>& used) {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    for (auto it = entries_.begin(); it != entries_.end(); ++it) {
+      if (*it == used) {
+        entries_.splice(entries_.begin(), entries_, it);
+        return;
+      }
+    }
+  }
+  void Clear() {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    entries_.clear();
+    bytes_ = 0;
+  }
+
+ private:
+  std::mutex mutex_;
+  std::list<std::shared_ptr<const Entry>> entries_;  ///< front = most recently used
+  std::size_t bytes_{0};
+};
+
+inline Cache& GlobalCache() {
+  static Cache cache;
+  return cache;
+}
+/// Host self-test hook.
+inline void ClearCacheForTest() { GlobalCache().Clear(); }
+
+// --------------------------------------------------------------------------------------------- C: thread pool
+class Pool {
+ public:
+  explicit Pool(unsigned helpers) {
+    for (unsigned i = 0; i < helpers; ++i)
+      threads_.emplace_back([this] { Run(); });
+  }
+  ~Pool() {
+    {
+      const std::lock_guard<std::mutex> lock(mutex_);
+      stop_ = true;
+    }
+    cv_.notify_all();
+    for (auto& t : threads_)
+      t.join();
+  }
+  unsigned Helpers() const { return static_cast<unsigned>(threads_.size()); }
+  /// Runs fn(0..n-1) on the caller plus up to Helpers() pool threads; returns when all are done. The caller always
+  /// participates, so concurrent callers cannot deadlock on a busy pool.
+  void For(std::size_t n, const std::function<void(std::size_t)>& fn) {
+    struct State {
+      std::atomic<std::size_t> next{0};
+      std::atomic<std::size_t> done{0};
+      std::size_t n{0};
+      const std::function<void(std::size_t)>* fn{nullptr};
+      std::mutex m;
+      std::condition_variable cv;
+    };
+    auto state = std::make_shared<State>();
+    state->n = n;
+    state->fn = &fn;
+    const auto work = [](const std::shared_ptr<State>& s) {
+      for (std::size_t i; (i = s->next.fetch_add(1)) < s->n;) {
+        (*s->fn)(i);
+        if (s->done.fetch_add(1) + 1 == s->n) {
+          const std::lock_guard<std::mutex> lock(s->m);
+          s->cv.notify_all();
+        }
+      }
+    };
+    const auto helpers = std::min<std::size_t>(threads_.size(), n > 0 ? n - 1 : 0);
+    if (helpers) {
+      {
+        const std::lock_guard<std::mutex> lock(mutex_);
+        for (std::size_t i = 0; i < helpers; ++i)
+          tasks_.emplace_back([state, work] { work(state); });
+      }
+      cv_.notify_all();
+    }
+    work(state);
+    std::unique_lock<std::mutex> lock(state->m);
+    state->cv.wait(lock, [&] { return state->done.load() == state->n; });
+  }
+
+ private:
+  void Run() {
+    for (;;) {
+      std::function<void()> task;
+      {
+        std::unique_lock<std::mutex> lock(mutex_);
+        cv_.wait(lock, [&] { return stop_ || !tasks_.empty(); });
+        if (stop_ && tasks_.empty())
+          return;
+        task = std::move(tasks_.front());
+        tasks_.pop_front();
+      }
+      task();
+    }
+  }
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  std::deque<std::function<void()>> tasks_;
+  std::vector<std::thread> threads_;
+  bool stop_{false};
+};
+
+inline Pool& PoolFor(unsigned tokpar) {
+  // One pool per process, sized by the first tokpar seen (the server's is fixed by GUFO_TOKPAR).
+  static std::mutex m;
+  static std::unique_ptr<Pool> pool;
+  const std::lock_guard<std::mutex> lock(m);
+  if (!pool || pool->Helpers() + 1 != tokpar)
+    pool = std::make_unique<Pool>(tokpar - 1);
+  return *pool;
+}
+
+// ------------------------------------------------------------------------------------------------- prepare
+inline void Log(const CallStats& s, std::span<const TokenId> ids, std::size_t stable) {
+  const auto now_us = std::chrono::duration_cast<std::chrono::microseconds>(Clock::now().time_since_epoch()).count();
+  std::fprintf(stderr,
+               "w3tc event=prepare path=%s fallback=%s hit=%d tokpar=%u chunks=%u bytes=%zu tokens=%zu stable=%zu "
+               "reused_tokens=%zu tail_bytes=%zu lcp_bytes=%zu cuts=%zu entries=%zu cache_bytes=%zu "
+               "suffix_from_cuts=%d render_ms=%.3f lookup_ms=%.3f encode_ms=%.3f suffix_ms=%.3f store_ms=%.3f "
+               "prepare_ms=%.3f t_us=%lld ids_fnv=%016llx\n",
+               s.cache_path ? "tc" : "prod", s.fallback, s.hit ? 1 : 0, s.tokpar, s.chunks, s.bytes, s.tokens, stable,
+               s.reused_tokens, s.tail_bytes, s.lcp_bytes, s.cuts, s.entries, s.cache_bytes,
+               s.suffix_from_cuts ? 1 : 0, s.render_ms, s.lookup_ms, s.encode_ms, s.suffix_ms, s.store_ms,
+               s.total_ms, static_cast<long long>(now_us), static_cast<unsigned long long>(IdsFnv(ids)));
+}
+
+inline Prompt PrepareText(const tokenization::QwenTokenizer& tokenizer,
+                          std::span<const tokenization::ChatMessage> messages,
+                          std::span<const tokenization::ChatTool> tools,
+                          const tokenization::ChatTemplateOptions& options, std::uint32_t max_context) {
+  const auto config = CurrentConfig();
+  CallStats st;
+  st.tokpar = config.tokpar;
+  const auto t0 = Clock::now();
+  std::vector<std::size_t> offsets;
+  std::vector<ContentSpan> content_spans;
+  std::size_t stable_prefix_bytes = 0;
+  std::string error;
+  const auto rendered = tokenization::QwenChatTemplate::Render(messages, tools, options, &error, &offsets,
+                                                               &stable_prefix_bytes, &content_spans);
+  if (!rendered)
+    throw std::invalid_argument(error);
+  const auto t1 = Clock::now();
+  st.render_ms = Ms(t0, t1);
+  st.bytes = rendered->size();
+  Prompt prompt;
+  tokenization::TokenizerOptions tok_options;
+  tok_options.add_bos = false;
+  tok_options.add_eos = false;
+  tok_options.parse_special_tokens = true;
+  const auto length_check = [&](std::size_t n) {
+    if (n > max_context) {
+      throw std::length_error("prompt exceeds the " + std::to_string(max_context) +
+                              "-token context; increase --context or shorten the conversation");
+    }
+  };
+  const auto production_suffix = [&] {
+    // Production's own stable-prefix computation and assertion (prompt.cpp, unchanged).
+    const auto suffix = tokenization::QwenChatTemplate::EncodeRendered(
+        tokenizer, *rendered, stable_prefix_bytes, rendered->size(), content_spans, tok_options);
+    if (suffix.size() > prompt.tokens.size() ||
+        !std::ranges::equal(suffix, std::span(prompt.tokens).last(suffix.size())))
+      throw std::logic_error("Qwen stable prefix is not a token boundary");
+    prompt.stable_prefix_tokens = prompt.tokens.size() - suffix.size();
+  };
+
+  const Safety safety = (config.cache || config.tokpar > 1) ? SafetyFacts(tokenizer) : Safety{};
+  const bool shortcut = (config.cache || config.tokpar > 1) && safety.im_start_isolated;
+  if (!shortcut) {
+    // Production algorithm, step for step (stats-only arm, or the isolation check failed).
+    st.fallback = (config.cache || config.tokpar > 1) ? "unsafe-specials" : "";
+    auto tokens = tokenization::QwenChatTemplate::EncodeRendered(tokenizer, *rendered, 0, rendered->size(),
+                                                                 content_spans, tok_options);
+    length_check(tokens.size());
+    prompt.tokens = std::move(tokens);
+    const auto t2 = Clock::now();
+    st.encode_ms = Ms(t1, t2);
+    production_suffix();
+    st.suffix_ms = Ms(t2, Clock::now());
+  } else {
+    st.cache_path = true;
+    std::vector<ContentSpan> sorted = content_spans;
+    std::stable_sort(sorted.begin(), sorted.end(),
+                     [](const ContentSpan& a, const ContentSpan& b) { return a.offset < b.offset; });
+    const auto cuts = ImStartCuts(*rendered, sorted);
+    st.cuts = cuts.size();
+    const std::size_t blen = tokenization::kImStart.size();
+    const auto is_cut = [&](std::size_t p) { return std::binary_search(cuts.begin(), cuts.end(), p); };
+
+    // ---- A: lookup
+    std::shared_ptr<const Entry> used;
+    std::size_t begin = 0, reused = 0;
+    std::vector<std::pair<std::size_t, std::size_t>> cut_counts;  // (offset, ids before it)
+    if (config.cache) {
+      const auto snapshot = GlobalCache().Snapshot();
+      for (const auto& e : snapshot) {
+        if (e->fingerprint != safety.fingerprint)
+          continue;
+        const std::string_view a = *rendered, b = e->bytes;
+        const auto lcp = static_cast<std::size_t>(
+            std::mismatch(a.begin(), a.begin() + std::min(a.size(), b.size()), b.begin()).first - a.begin());
+        // deepest entry cut c with c + |<|im_start|>| <= lcp that is also a cut of this render, with the same
+        // content spans before it
+        auto it = std::upper_bound(e->cuts.begin(), e->cuts.end(), lcp,
+                                   [](std::size_t v, const auto& c) { return v < c.first; });
+        while (it != e->cuts.begin()) {
+          --it;
+          const auto c = it->first;
+          if (c + blen > lcp || !is_cut(c))
+            continue;
+          const auto k_new = static_cast<std::size_t>(
+              std::lower_bound(sorted.begin(), sorted.end(), c,
+                               [](const ContentSpan& s, std::size_t v) { return s.offset < v; }) -
+              sorted.begin());
+          const auto k_old = static_cast<std::size_t>(
+              std::lower_bound(e->spans.begin(), e->spans.end(), c,
+                               [](const ContentSpan& s, std::size_t v) { return s.offset < v; }) -
+              e->spans.begin());
+          if (k_new != k_old ||
+              !std::equal(sorted.begin(), sorted.begin() + static_cast<std::ptrdiff_t>(k_new), e->spans.begin(),
+                          [](const ContentSpan& x, const ContentSpan& y) {
+                            return x.offset == y.offset && x.size == y.size;
+                          }))
+            continue;
+          if (!used || it->second > reused || (it->second == reused && c > begin)) {
+            used = e;
+            begin = c;
+            reused = it->second;
+            st.lcp_bytes = lcp;
+          }
+          break;
+        }
+      }
+      if (used) {
+        st.hit = reused > 0 || begin > 0;
+        prompt.tokens.assign(used->ids.begin(), used->ids.begin() + static_cast<std::ptrdiff_t>(reused));
+        for (const auto& c : used->cuts) {
+          if (c.first > begin)
+            break;
+          cut_counts.push_back(c);
+        }
+        GlobalCache().Touch(used);
+      }
+    }
+    st.reused_tokens = reused;
+    st.tail_bytes = rendered->size() - begin;
+    const auto t2 = Clock::now();
+    st.lookup_ms = Ms(t1, t2);
+
+    // ---- tail [begin, size): atomic segments between message cuts, refined at "\n" cuts for C
+    struct Piece {
+      std::size_t from, to;
+      bool cut_at_from;  ///< `from` is a message cut whose id count is recorded
+    };
+    std::vector<Piece> pieces;
+    {
+      std::size_t from = begin;
+      bool at_cut = is_cut(begin);
+      for (auto it = std::upper_bound(cuts.begin(), cuts.end(), begin); it != cuts.end(); ++it) {
+        if (*it > from)
+          pieces.push_back({from, *it, at_cut});
+        from = *it;
+        at_cut = true;
+      }
+      if (rendered->size() > from || pieces.empty())
+        pieces.push_back({from, rendered->size(), at_cut});
+    }
+    const std::size_t tail = rendered->size() - begin;
+    const bool parallel = config.tokpar > 1 && tail >= config.tokpar_min_bytes && safety.newline_free;
+    if (parallel) {
+      const std::size_t target = std::max<std::size_t>(tail / (std::size_t{config.tokpar} * 2), 4096);
+      std::vector<Piece> refined;
+      for (const auto& p : pieces) {
+        std::size_t from = p.from;
+        bool at_cut = p.cut_at_from;
+        while (p.to - from > target + target / 2) {
+          std::size_t c = from + target;
+          // next "\n" followed by an ASCII graphic byte at or after c
+          std::size_t found = std::string_view::npos;
+          for (std::size_t q = c; q + 1 < p.to; ++q) {
+            if ((*rendered)[q] == '\n' && AsciiGraphic((*rendered)[q + 1])) {
+              found = q + 1;
+              break;
+            }
+          }
+          if (found == std::string_view::npos || p.to - found < target / 4)
+            break;
+          refined.push_back({from, found, at_cut});
+          from = found;
+          at_cut = false;
+        }
+        refined.push_back({from, p.to, at_cut});
+      }
+      pieces = std::move(refined);
+    }
+    std::vector<std::vector<TokenId>> out(pieces.size());
+    const auto encode_piece = [&](std::size_t i) {
+      out[i] = tokenization::QwenChatTemplate::EncodeRendered(tokenizer, *rendered, pieces[i].from, pieces[i].to,
+                                                             content_spans, tok_options);
+    };
+    if (parallel) {
+      // group consecutive pieces into ~2 x tokpar chunks of similar bytes
+      std::vector<std::pair<std::size_t, std::size_t>> chunks;  // [first piece, last piece)
+      const std::size_t per = std::max<std::size_t>(tail / (std::size_t{config.tokpar} * 2), 1);
+      std::size_t first = 0, acc = 0;
+      for (std::size_t i = 0; i < pieces.size(); ++i) {
+        acc += pieces[i].to - pieces[i].from;
+        if (acc >= per || i + 1 == pieces.size()) {
+          chunks.push_back({first, i + 1});
+          first = i + 1;
+          acc = 0;
+        }
+      }
+      st.chunks = static_cast<unsigned>(chunks.size());
+      std::vector<std::exception_ptr> errors(chunks.size());
+      PoolFor(config.tokpar).For(chunks.size(), [&](std::size_t c) {
+        try {
+          for (std::size_t i = chunks[c].first; i < chunks[c].second; ++i)
+            encode_piece(i);
+        } catch (...) {
+          errors[c] = std::current_exception();
+        }
+      });
+      for (const auto& e : errors)  // the first failing chunk in order = the serial exception
+        if (e)
+          std::rethrow_exception(e);
+    } else {
+      st.chunks = static_cast<unsigned>(pieces.size());
+      for (std::size_t i = 0; i < pieces.size(); ++i)
+        encode_piece(i);
+    }
+    std::size_t total = prompt.tokens.size();
+    for (const auto& v : out)
+      total += v.size();
+    length_check(total);
+    prompt.tokens.reserve(total);
+    for (std::size_t i = 0; i < pieces.size(); ++i) {
+      if (pieces[i].cut_at_from && (cut_counts.empty() || cut_counts.back().first != pieces[i].from))
+        cut_counts.push_back({pieces[i].from, prompt.tokens.size()});
+      prompt.tokens.insert(prompt.tokens.end(), out[i].begin(), out[i].end());
+    }
+    const auto t3 = Clock::now();
+    st.encode_ms = Ms(t2, t3);
+
+    // ---- stable prefix: a message cut has a recorded id count; anything else takes production's path
+    if (stable_prefix_bytes >= rendered->size()) {
+      prompt.stable_prefix_tokens = prompt.tokens.size();
+      st.suffix_from_cuts = true;
+    } else {
+      const auto at = std::lower_bound(cut_counts.begin(), cut_counts.end(), stable_prefix_bytes,
+                                       [](const auto& c, std::size_t v) { return c.first < v; });
+      if (at != cut_counts.end() && at->first == stable_prefix_bytes) {
+        prompt.stable_prefix_tokens = at->second;
+        st.suffix_from_cuts = true;
+      } else {
+        production_suffix();
+      }
+    }
+    const auto t4 = Clock::now();
+    st.suffix_ms = Ms(t3, t4);
+
+    // ---- A: store this render up to its last message cut
+    if (config.cache && !cuts.empty()) {
+      const auto last = cuts.back();
+      auto fresh = std::make_shared<Entry>();
+      fresh->fingerprint = safety.fingerprint;
+      fresh->bytes.assign(*rendered, 0, std::min(rendered->size(), last + blen));
+      std::size_t n_last = 0;
+      for (const auto& c : cut_counts) {
+        if (c.first > last)
+          break;
+        fresh->cuts.push_back(c);
+        n_last = c.second;
+      }
+      if (fresh->cuts.empty() || fresh->cuts.back().first != last) {
+        fresh.reset();  // cannot happen: every message cut of the tail is a piece start
+      } else {
+        fresh->ids.assign(prompt.tokens.begin(), prompt.tokens.begin() + static_cast<std::ptrdiff_t>(n_last));
+        for (const auto& s : sorted) {
+          if (s.offset >= last)
+            break;
+          fresh->spans.push_back(s);
+        }
+        fresh->cost = fresh->bytes.size() + fresh->ids.size() * sizeof(TokenId) +
+                      fresh->cuts.size() * sizeof(fresh->cuts[0]) + fresh->spans.size() * sizeof(ContentSpan) + 256;
+      }
+      // the render extends `used` to its end: the same session's next turn replaces it
+      const bool extends = used && st.lcp_bytes >= used->bytes.size();
+      GlobalCache().Store(std::move(fresh), extends ? used : nullptr, config, &st.entries, &st.cache_bytes);
+    }
+    st.store_ms = Ms(t4, Clock::now());
+  }
+  prompt.rope.Validate(max_context);
+  st.tokens = prompt.tokens.size();
+  st.total_ms = Ms(t0, Clock::now());
+  LastStats() = st;
+  if (config.stats)
+    Log(st, prompt.tokens, prompt.stable_prefix_tokens);
+  return prompt;
+}
+
+}  // namespace gufo::models::qwen::vision::w3tc
