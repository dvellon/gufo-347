+// ---------------------------------------------------------------------------
+// Wave3 XM (exactness-mode): per-request
+// exactness level (src/core/exactness.hpp, Session::SetExactness).
+//   strict       production drafting: H1, H1 mask, B5 v2, the PA8 window and
+//                the suffix drafter are off whatever their knobs say.
+//   relaxed      those policies as their knobs configure them.
+//   approximate  relaxed + approximate-only numerics (xm::ApproximateActive).
+// One decode or advance work unit never mixes levels: DecodeBatchImpl and
+// EvaluateBatchImpl run a mixed cohort as one sub-step per level (strict
+// first). Strict sessions therefore share no MTP head round, verification
+// forward, batch draft plan or learned batch policy (MtpBatchController) with
+// relaxed/approximate ones, and the strict sub-step is the step production
+// would run for the strict sessions alone. Cost: a mixed round streams the
+// weights once per level present.
+//   GUFO_XM_STATS=1         event=xm_stats lines (split steps, units by level)
+//   GUFO_XM_APPROX_STUB=1   the contract's stub approximate-only feature: armed
+//                           only when --exactness-max is approximate, counts
+//                           the approximate work units it would act on and
+//                           changes nothing (plumbing test)
+namespace {
+
+constexpr xm::ExactnessLevel kXmOrder[] = {xm::ExactnessLevel::kStrict,
+                                           xm::ExactnessLevel::kRelaxed,
+                                           xm::ExactnessLevel::kApproximate};
+
+/// A drafting feature configured `on` for a request at `level`
+/// (xm_relaxed_policy.hpp: strict only when admitted and R3-20 holds).
+[[nodiscard]] bool XmDrafting(xm::ExactnessLevel level, bool on,
+                              bool strict_admitted) noexcept {
+  return XmDraftingOn(level == xm::ExactnessLevel::kStrict, on,
+                      strict_admitted, xm::PositionOnlySparseRows());
+}
