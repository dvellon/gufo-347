+// ---- R3-24 deterministic tool-call ids --------------------------------------
+[[nodiscard]] constexpr std::uint64_t Fnv1a64(
+    std::string_view text, std::uint64_t seed = 1469598103934665603ULL) noexcept {
+  std::uint64_t h = seed;
+  for (const char ch : text) {
+    h ^= static_cast<std::uint8_t>(ch);
+    h *= 1099511628211ULL;
+  }
+  return h;
+}
+[[nodiscard]] constexpr std::uint64_t Mix64(std::uint64_t x) noexcept {
+  x += 0x9E3779B97F4A7C15ULL;
+  x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ULL;
+  x = (x ^ (x >> 27)) * 0x94D049BB133111EBULL;
+  return x ^ (x >> 31);
+}
+/// 20 characters of [a-z0-9] (RandomId's alphabet and length) from the request
+/// key, the hash of the generated text before the call, and the call index.
+[[nodiscard]] inline std::string ToolCallSuffix(std::uint64_t key,
+                                                std::uint64_t prefix_hash,
+                                                std::size_t index) {
+  static constexpr std::string_view kCharacters =
+      "abcdefghijklmnopqrstuvwxyz0123456789";
+  // Two 64-bit words, ten base-36 digits each (36^10 < 2^64).
+  std::uint64_t a = Mix64(key ^ Mix64(prefix_hash));
+  std::uint64_t b = Mix64(a ^ Mix64(static_cast<std::uint64_t>(index) + 1));
+  a = Mix64(a + static_cast<std::uint64_t>(index));
+  std::string out;
+  out.reserve(20);
+  for (int i = 0; i < 20; ++i) {
+    std::uint64_t& w = i < 10 ? a : b;
+    out.push_back(kCharacters[w % kCharacters.size()]);
+    w /= kCharacters.size();
+  }
+  return out;
+}
