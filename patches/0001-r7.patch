+// Wave3 OOV-PERM (oovperm-192, queue 192): GUFO_DRAFT_PERM's permuted
+// small head: a resident copy of the kMtpDraftVocab prefix rows with each pair's
+// `drop` row replaced by the head row of `src` (one D2D copy + one row copy per
+// pair, at load) and the index -> id map. Unset = nothing allocated or printed.
+static bool W3PermSetup(const DeviceModel& model, std::vector<void*>& a,
+                        const void* owner, std::string* error_msg) {
+  const auto& perm = w3perm::Perm();
+  const auto& prefix = model.draft_output();
+  if (!perm.set || prefix.empty())
+    return true;
+  if (!perm.error.empty() || prefix.rows != kMtpDraftVocab ||
+      perm.map.size() != kMtpDraftVocab ||
+      model.output().rows <= kMtpDraftVocab) {
+    AssignError(error_msg, "GUFO_DRAFT_PERM: invalid block or draft prefix");
+    return false;
+  }
+  const std::size_t row_bytes = model.output_row_bytes();
+  const std::size_t head_bytes = std::size_t{kMtpDraftVocab} * row_bytes;
+  auto* head = Alloc<std::uint8_t>(a, head_bytes, error_msg);
+  auto* map = Alloc<std::int32_t>(a, kMtpDraftVocab, error_msg);
+  if (head == nullptr || map == nullptr)
+    return false;
+  const auto* out = static_cast<const std::uint8_t*>(model.output().data);
+  if (!Check(hipMemcpy(head, prefix.data, head_bytes, hipMemcpyDeviceToDevice),
+             "draft perm prefix", error_msg))
+    return false;
+  for (std::size_t k = 0; k < perm.drop.size(); ++k) {
+    if (!Check(hipMemcpy(head + static_cast<std::size_t>(perm.drop[k]) * row_bytes,
+                         out + static_cast<std::size_t>(perm.src[k]) * row_bytes,
+                         row_bytes, hipMemcpyDeviceToDevice),
+               "draft perm row", error_msg))
+      return false;
   }
+  if (!Check(hipMemcpy(map, perm.map.data(),
+                       std::size_t{kMtpDraftVocab} * sizeof(std::int32_t),
+                       hipMemcpyHostToDevice),
+             "draft perm map", error_msg) ||
+      !Check(hipDeviceSynchronize(), "draft perm", error_msg))
+    return false;
+  if (!w3perm::Claim(w3perm::Device{owner, head, map})) {
+    AssignError(error_msg, "GUFO_DRAFT_PERM: no free permuted-head slot");
+    return false;
+  }
+  std::fprintf(stderr,
+               "event=draft_perm_device rows=%u swapped=%zu head_bytes=%zu\n",
+               kMtpDraftVocab, perm.drop.size(), head_bytes);
+  std::fflush(stderr);
+  return true;
+}
