+  bool set{false};                ///< GUFO_DRAFT_STATIC was non-empty
+  std::vector<std::int32_t> ids;  ///< file order; empty when refused
+  std::vector<bool> bit;          ///< bit[id]: id is one of `ids`
+  std::uint64_t fnv{0};           ///< FNV-1a 64 over the IDs (int32 LE)
