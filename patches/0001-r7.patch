+// Wave3 Q2L 226c (q2live-226, queue 226c; TEST build w3q2l_server only, never production): the Q2 screen on the
+// TOP-2 draft calls production really makes (diagnosis q2live-226/DIAG-226b-INERT.md: every greedy draft of the
+// strict / relaxed profiles is a confidence-stop call with a candidate list of 2, which the 226 token-only hook skipped).
+//
+// A top-2 draft call (candidate_limit 2; A1 / A1_DRAFT2 keep precedence) at a width the knob covers does
+//   Q8_1 input -> Q2 screen -> exact top-64 -> production's A1ExactDot over those rows (all as the 226 token branch) ->
+//   Q2lTop2 = the best two of {the 64 rescored rows} + {the draft-table rows, small head} in production's
+//   MtpTopCandidates<2> order (sort key: non-finite -> -inf, -0 -> +0; larger key first; equal keys by the lower index;
+//   the score written is the logit itself, -inf when non-finite), into s_.mtp_ids / s_.mtp_scores -> RemapDraftIds on the
+//   two ids and the candidates download, as production.
+// It replaces the head GEMV + MtpTopCandidates. The two candidates equal production's whenever production's two best head
+// rows are among the 64 screened rows (table rows are always exact); the strict verifier commits the target's tokens
+// either way (a miss changes drafts / the confidence stop, i.e. speed, never the output).
+//
+// This header is NEW in 226c and leaves w3q2l.hpp (226, Dell-checked) byte for byte: its Note() wrapper counts top-2 calls
+// as screened (w1_small / w1_full / b2 rows of the q2l_stats line) and prints a q2l_stats line on SKIPPED calls too (at
+// w3q2l::Due of the skip count, why=skip), so an inert arm is visible while the server lives (the exit line is lost to the
+// harness's taskkill); every stats line is followed by one q2l_top2 line (the top-2 host + device counters).
+#ifndef GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_W3Q2L_TOP2_HPP_
+#define GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_W3Q2L_TOP2_HPP_
+
+#include <hip/hip_runtime_api.h>
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+#include "src/models/qwen38_flash_next/kernels/rocm/w3q2l.hpp"
+
+namespace w3q2l2 {
+
+// device counters (u32): 0 top-2 merges run, 1 checked top-2 rows (GUFO_Q2_CHECK=1), 2 checked rows whose candidate 0
+// (id or score bits) != production's, 3 ... candidate 1 != production's, 4 checked rows whose production top-2 are both
+// screened or table rows (exactness expected), 5 rows of 4 that still differ (an exactness bug), 6 merges whose top-2
+// holds a non-finite key, 7 rescored logits whose bits != the production GEMV's, 8 checked rows whose production
+// candidate 1 is a head row (not a table row), 9 ... and among the 64 screened rows
+constexpr int kT2Counters = 10;
+
+struct Top2Stats {
+  std::uint64_t w1_small = 0;  // host-counted width-1 top-2 calls screened over the prefix
+  std::uint64_t w1_full = 0;   // ... over the full head
+  std::uint64_t b2_rows = 0;   // top-2 rows of screened 2-row MtpHeads batches (w2)
+};
+
+struct Top2Device {
+  std::uint32_t* counters = nullptr;  // [kT2Counters]
+  std::uint32_t* ids = nullptr;       // [w3q2l::kMaxRows][2] the screened top-2 (check mode: before the commit)
+  float* scores = nullptr;            // [w3q2l::kMaxRows][2]
+  Top2Stats stats;
+};
+
+inline Top2Device& Dev2() {
+  static Top2Device d;
+  return d;
+}
+
+inline std::uint64_t Skips() {
+  const w3q2l::Stats& s = w3q2l::Dev().stats;
+  return s.skip_cand + s.skip_a1 + s.skip_wide;
+}
+
+/// One q2l_top2 line (after a q2l_stats line; outside any capture: the caller's stream is synchronized here).
+inline void LogTop2(hipStream_t stream, const char* why) {
+  const w3q2l::Device& d = w3q2l::Dev();
+  const Top2Device& t = Dev2();
+  if (!d.ready)
+    return;
+  std::uint32_t c[kT2Counters] = {};
+  const bool read = stream != nullptr && t.counters != nullptr &&
+                    hipMemcpyAsync(c, t.counters, sizeof(c), hipMemcpyDeviceToHost, stream) == hipSuccess &&
+                    hipStreamSynchronize(stream) == hipSuccess;
+  std::fprintf(stderr,
+               "gufo: event=q2l_top2 mode=%s check=%d top2_w1_small=%llu top2_w1_full=%llu top2_b2_rows=%llu "
+               "skips=%llu dev_read=%d merges=%u chk=%u cand0_diff=%u cand1_diff=%u both_in=%u diff_in=%u "
+               "nonfinite=%u chk_bit_diff=%u cand1_head=%u cand1_in=%u why=%s port=q2live-226\n",
+               w3q2l::ModeName(d.mode), d.check ? 1 : 0, static_cast<unsigned long long>(t.stats.w1_small),
+               static_cast<unsigned long long>(t.stats.w1_full), static_cast<unsigned long long>(t.stats.b2_rows),
+               static_cast<unsigned long long>(Skips()), read ? 1 : 0, c[0], c[1], c[2], c[3], c[4], c[5], c[6], c[7],
+               c[8], c[9], why);
+  std::fflush(stderr);
+}
+
+/// The 226c Note: `k` as w3q2l::Note (a screened top-2 call is kW1Small / kW1Full / kB2 like a token call),
+/// `top2_rows` = how many of its rows are top-2 rows. After a q2l_stats interval line: one q2l_top2 line. A skipped call
+/// (kSkipCand / kSkipA1 / kSkipWide) prints q2l_stats + q2l_top2 (why=skip) when the skip count hits w3q2l::Due.
+/// Host only, outside captured bodies (MtpForward before Run, MtpHeads before its body).
+inline void Note(w3q2l::Call k, std::uint32_t rows, std::uint32_t top2_rows, hipStream_t stream) {
+  w3q2l::Device& d = w3q2l::Dev();
+  if (!d.ready)
+    return;
+  Top2Stats& t = Dev2().stats;
+  if (top2_rows != 0) {
+    if (k == w3q2l::Call::kW1Small)
+      ++t.w1_small;
+    else if (k == w3q2l::Call::kW1Full)
+      ++t.w1_full;
+    else if (k == w3q2l::Call::kB2)
+      t.b2_rows += top2_rows;
+  }
+  const std::uint64_t before = d.stats.Calls(), skips_before = Skips();
+  w3q2l::Note(k, rows, stream);
+  const std::uint64_t after = d.stats.Calls();
+  for (std::uint64_t n = before + 1; n <= after; ++n) {
+    if (w3q2l::Due(n)) {
+      LogTop2(stream, "interval");  // w3q2l::Note printed its interval line for this n
+      return;
+    }
+  }
+  const std::uint64_t skips = Skips();
+  if (skips != skips_before && w3q2l::Due(skips)) {
+    w3q2l::LogStats(stream, "skip");
+    LogTop2(stream, "skip");
+  }
+}
+
+/// Host mirror of Q2lTop2Kernel (the load-time self-test checks the device kernel against it). Production's
+/// MtpTopCandidates<2> order: SortKey (non-finite -> -inf, -0 -> +0), larger first, equal keys by the lower index; an
+/// empty slot is (-inf, INT32_MAX) and ranks after every entry. Output score = the value, -inf when non-finite.
+struct Top2 {
+  float value[2];
+  std::int32_t index[2];
+};
+
+inline float SortKey(float v) { return std::isfinite(v) ? (v == 0.0F ? 0.0F : v) : -INFINITY; }
+
+inline bool Before(float av, std::int32_t ai, float bv, std::int32_t bi) {
+  const float a = SortKey(av), b = SortKey(bv);
+  return a > b || (a == b && ai < bi);
+}
+
+inline void Insert(Top2& t, float v, std::int32_t i) {
+  if (Before(v, i, t.value[0], t.index[0])) {
+    t.value[1] = t.value[0];
+    t.index[1] = t.index[0];
+    t.value[0] = v;
+    t.index[0] = i;
+  } else if (Before(v, i, t.value[1], t.index[1])) {
+    t.value[1] = v;
+    t.index[1] = i;
+  }
+}
+
+inline Top2 MergeRef2(const std::uint32_t* ids, const float* resc, std::uint32_t k, const float* table,
+                      std::uint32_t table_rows, std::uint32_t prefix) {
+  Top2 t{{-INFINITY, -INFINITY}, {INT32_MAX, INT32_MAX}};
+  for (std::uint32_t j = 0; j < table_rows; ++j)
+    Insert(t, table[j], static_cast<std::int32_t>(prefix + j));
+  for (std::uint32_t i = 0; i < k; ++i)
+    Insert(t, resc[i], static_cast<std::int32_t>(ids[i]));
+  for (float& v : t.value)
+    v = std::isfinite(v) ? v : -INFINITY;
+  return t;
+}
+
+}  // namespace w3q2l2
+
+namespace gufo::models::qwen38_flash_next::rocm {
+// Launchers defined in kernels.hip.cpp's translation unit (w3q2l_top2_kernels.inc, inside this namespace), each pinned to
+// exactly this declaration there (address-of pins).
+/// One row: out_ids[0..1] / out_scores[0..1] = the best two of {(resc[i], ids[i]) : i < k} + {(table[j], prefix + j) :
+/// j < table_rows} in production's MtpTopCandidates<2> order (w3q2l2::MergeRef2); counters[0] += 1 (w3q2l merges),
+/// counters2[0] += 1, counters2[6] += a non-finite key among the two.
+void Q2lTop2(const std::uint32_t* ids, const float* resc, std::uint32_t k, const float* table, std::uint32_t table_rows,
+             std::uint32_t prefix, std::uint32_t* out_ids, float* out_scores, std::uint32_t* counters,
+             std::uint32_t* counters2, hipStream_t stream);
+/// Check mode, one row: compares the screened top-2 (mine_*) with production's MtpTopCandidates<2> result (prod_*, ids
+/// before the remap, scores) and the 64 rescored logits with production's GEMV logits (counters2[1..5], [7..9]), then
+/// COMMITS mine_* into prod_ids[0..1] / prod_scores[0..1] (the screened result is the one used, as in the X arm).
+void Q2lCheck2(std::uint32_t* prod_ids, float* prod_scores, const std::uint32_t* mine_ids, const float* mine_scores,
+               const float* logits, const std::uint32_t* ids, const float* resc, std::uint32_t k,
+               std::uint32_t screened_rows, std::uint32_t* counters2, hipStream_t stream);
+}  // namespace gufo::models::qwen38_flash_next::rocm
+
+#endif  // GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_W3Q2L_TOP2_HPP_
