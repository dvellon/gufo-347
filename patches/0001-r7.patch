+/// R3-23 wiring (promo-3cg): set by a static ChunkWiring object in the TU whose
+/// PrefillBudget calls ChunkFor / GridBudget (text_generation_scheduler.cpp).
+/// ConfigLine logs it as chunk_wired=0|1: a knob that is parsed and logged but
+/// never called cannot be mistaken for a working one.
+[[nodiscard]] inline std::atomic<bool>& ChunkWiredFlag() noexcept {
+  static std::atomic<bool> wired{false};
