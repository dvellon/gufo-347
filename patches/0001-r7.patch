+namespace gufo::models::qwen38_flash_next {
+namespace {
+bool PrefetchPreadPages(std::span<const std::uintptr_t> pages,
+                        std::size_t page) noexcept {
+  if (pages.empty())
+    return true;
+#if defined(_WIN32)
+  try {
+    std::vector<WIN32_MEMORY_RANGE_ENTRY> ranges;
+    ranges.reserve(pages.size());
+    for (const auto p : pages) {
+      if (!ranges.empty() &&
+          reinterpret_cast<std::uintptr_t>(ranges.back().VirtualAddress) +
+                  ranges.back().NumberOfBytes ==
+              p) {
+        ranges.back().NumberOfBytes += page;
+        continue;
+      }
+      ranges.push_back({reinterpret_cast<PVOID>(p), page});
+    }
+    return PrefetchVirtualMemory(GetCurrentProcess(), ranges.size(),
+                                 ranges.data(), 0) != FALSE;
+  } catch (...) {
+    return false;
+  }
+#else
+  bool ok = true;
+  for (const auto p : pages)
+    ok = ::posix_madvise(reinterpret_cast<void*>(p), page,
+                         POSIX_MADV_WILLNEED) == 0 &&
+         ok;
+  return ok;
+#endif
+}
+void LowerPreadThreadPriority() noexcept {
+#if defined(_WIN32)
+  (void)SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+#endif
+}
+}  // namespace
+}  // namespace gufo::models::qwen38_flash_next
+
 #endif  // ENGINE_ENABLE_HIP
diff --git a/src/models/qwen38_flash_next/w3a1aw_arm.hpp b/src/models/qwen38_flash_next/w3a1aw_arm.hpp
new file mode 100644
--- /dev/null
+++ b/src/models/qwen38_flash_next/w3a1aw_arm.hpp
@@ -0,0 +1,50 @@
+// a1aw (POST-PROFILE idea A1-ACTUAL-WIDTH, w3a1aw_server): GUFO_A1_ARM chooses the row
+// count the A1 verify-screen arming check reads (engine.cpp A1ArmActual):
+//   unset / "" / "planned"  the controller's PLANNED width, in PrepareDecode before the B5 / tool
+//                           stop shortens the chain (m1se; under KTc this is width 8 on every round)
+//   "actual"                the ACTUAL chain handed to verification: Session::DecodeStep re-checks
+//                           A1Usable(chain.size()) right before ArmA1; DecodeBatchImpl already checks
+//                           the summed actual rows of the cohort
+//   anything else           invalid: behaves as unset and is named in event=a1_arm_config
+// Arming is a speed gate only. The executor screens a pass only when A1Usable(n_logits) holds for the
+// rows it computes, and a screened pass is exact (executor.cpp Wave3 A1: production argmax per row,
+// candidate logits bitwise the production values, every other reader recomputes the full rows).
+// Pure constexpr functions (host unit test: a1aw/dell-check/a1aw_arm_test.cpp).
+#pragma once
+
+#include <cstdint>
+
+namespace w3a1aw {
+
+enum class ArmMode : std::uint8_t { kUnset = 0, kPlanned = 1, kActual = 2, kInvalid = 3 };
+
+[[nodiscard]] constexpr bool Same(const char* a, const char* b) noexcept {
+  for (; *a != '\0' && *a == *b; ++a, ++b) {
+  }
+  return *a == *b;
+}
+
+/// GUFO_A1_ARM: nullptr / "" -> kUnset; "planned" -> kPlanned; "actual" -> kActual; else kInvalid.
+[[nodiscard]] constexpr ArmMode ParseArmMode(const char* v) noexcept {
+  if (v == nullptr || v[0] == '\0')
+    return ArmMode::kUnset;
+  if (Same(v, "planned"))
+    return ArmMode::kPlanned;
+  if (Same(v, "actual"))
+    return ArmMode::kActual;
+  return ArmMode::kInvalid;
+}
+
+/// Only "actual" moves the check; unset, "planned" and invalid values keep the m1se rule.
+[[nodiscard]] constexpr bool ArmsOnActual(ArmMode m) noexcept {
+  return m == ArmMode::kActual;
+}
+
+[[nodiscard]] constexpr const char* Name(ArmMode m) noexcept {
+  return m == ArmMode::kUnset     ? "unset"
+         : m == ArmMode::kPlanned ? "planned"
+         : m == ArmMode::kActual  ? "actual"
+                                  : "invalid";
+}
+
+}  // namespace w3a1aw
diff --git a/src/models/qwen38_flash_next/w3a1t_tool.hpp b/src/models/qwen38_flash_next/w3a1t_tool.hpp
new file mode 100644
--- /dev/null
+++ b/src/models/qwen38_flash_next/w3a1t_tool.hpp
@@ -0,0 +1,197 @@
+// a1-tool (queue 171, dell-sims-022-r20 s1.6 A1-TOOL): the A1 verify-head screen on greedy TOOL-grammar requests.
+//
+// promo-3cg's A1 screens a pass's LM head (exact argmax by bounded screening) only when every consumer of its head
+// rows is a greedy argmax: A1Eligible requires temperature 0, no penalties and NO constraint. On a greedy, unpenalized
+// tool / prose-grammar request the consumers are:
+//   * GreedyMtpPredictions: the GPU argmax of each verified row, which FinishDecode checks with CanSelectArgmax; a
+//     forbidden argmax downloads the remaining rows (ReadVerificationRows calls A1FullRows first: production rows);
+//   * Rollback's frontier: the screened (index, value, head input) of the committed row (A1StagedFrontier);
+//   * SampleAnchor: the next anchor = SamplerState::Sample of the frontier row = SampleConstrainedGreedy (the
+//     lowest-index finite maximum among the grammar's allowed tokens) or SampleGreedy when the mask restricts nothing.
+// GUFO_A1_TOOL=1 arms those requests and takes the screened argmax t* as the anchor iff ScreenedPick passes:
+// CanSelectArgmax(t*) (tool grammars: ConstraintVocabulary::Allows; closed schemas: never). t* is the lowest-index
+// finite maximum of the WHOLE row, so when the grammar allows it, every allowed token before it is strictly smaller
+// (or non-finite) and none after it is larger: t* is SampleConstrainedGreedy's pick (and SampleGreedy's). Otherwise
+// the frontier is materialized with the production head GEMV and the production Sample runs (0.105 % of positions on
+// 159's agent traffic). README s1 has the proof and the cases where it could differ.
+//   unset / "" / "0"  off: w3m1sc statements (one a1tool_config mode=0 line at the first A1Eligible call)
+//   "1"               on (the candidate)
+//   "2"               check: armed, the anchor is ALWAYS the production selection; the screened pick is compared
+//                     (a1tool_check_mismatch line on a difference); speed is not the candidate's
+//   anything else     invalid: off, valid=0 (the queue's knob check refuses it)
+// Arming is a speed gate only (exactness never depends on it): a constraint arms iff it was bound for a tool request
+// (TokenConstraint::forced_head_elision_allowed == false; text_model_runner binds !has_tools) and its grammar is not in
+// the closed set (a grammar whose production anchor failed CanSelectArgmax: stop_only_when_complete_, i.e. a
+// response_format schema next to the tools).
+// Header-only; included by engine.cpp alone (render/overlay first on the include path).
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <optional>
+
+#include "src/core/sampling.hpp"
+
+namespace gufo::models::qwen38_flash_next::w3a1t {
+
+enum class Mode : int { kOff = 0, kOn = 1, kCheck = 2 };
+
+struct Knob {
+  Mode mode{Mode::kOff};
+  bool valid{true};
+  const char* requested{"unset"};
+};
+
+[[nodiscard]] inline Knob ParseKnob(const char* raw) noexcept {
+  Knob k;
+  if (raw == nullptr)
+    return k;
+  if (raw[0] == '\0') {
+    k.requested = "empty";
+  } else if (std::strcmp(raw, "0") == 0) {
+    k.requested = "0";
+  } else if (std::strcmp(raw, "1") == 0) {
+    k.mode = Mode::kOn;
+    k.requested = "1";
+  } else if (std::strcmp(raw, "2") == 0) {
+    k.mode = Mode::kCheck;
+    k.requested = "2";
+  } else {
+    k.valid = false;
+    k.requested = "invalid";
+  }
+  return k;
+}
+
+/// The process-wide knob (read once) and its one log line.
+inline const Knob& EnvKnob() {
+  static const Knob knob = [] {
+    const Knob k = ParseKnob(std::getenv("GUFO_A1_TOOL"));
+    std::fprintf(stderr, "[a1t] event=a1tool_config mode=%d valid=%d requested=%s\n",
+                 static_cast<int>(k.mode), k.valid ? 1 : 0, k.requested);
+    std::fflush(stderr);
+    return k;
+  }();
+  return knob;
+}
+
+[[nodiscard]] inline bool On() { return EnvKnob().mode != Mode::kOff; }
+
+/// Grammars found closed (speed only). Lock-free, 16 slots, oldest overwritten.
+struct ClosedSet {
+  std::array<std::atomic<const void*>, 16> slots{};
+  std::atomic<std::uint32_t> next{0};
+  [[nodiscard]] bool Contains(const void* grammar) const noexcept {
+    for (const auto& s : slots)
+      if (s.load(std::memory_order_relaxed) == grammar)
+        return true;
+    return false;
+  }
+  void Add(const void* grammar) noexcept {
+    if (grammar == nullptr || Contains(grammar))
+      return;
+    slots[next.fetch_add(1, std::memory_order_relaxed) % slots.size()].store(grammar, std::memory_order_relaxed);
+  }
+};
+
+inline ClosedSet& Closed() {
+  static ClosedSet set;
+  return set;
+}
+
+/// Whether a constraint may arm the screen (speed gate).
+[[nodiscard]] inline bool ArmableConstraint(const sampling::TokenConstraint* c, const ClosedSet& closed) noexcept {
+  return c != nullptr && c->grammar != nullptr && c->vocabulary != nullptr && !c->forced_head_elision_allowed &&
+         !closed.Contains(c->grammar.get());
+}
+
+/// A1Eligible's constraint clause: no constraint (= w3m1sc), or - knob on - an armable one.
+[[nodiscard]] inline bool ConstraintClause(const sampling::SamplingConfig& config, bool on,
+                                           const ClosedSet& closed) noexcept {
+  return !config.constraint || (on && ArmableConstraint(config.constraint.get(), closed));
+}
+
+/// The anchor from a screened frontier (index, value = its lowest-index finite maximum over a row of row_size
+/// logits): the token iff it is exactly Sample's selection, else nullopt (materialize the row).
+[[nodiscard]] inline std::optional<sampling::TokenId> ScreenedPick(const sampling::SamplerState& sampler,
+                                                                   std::int32_t index, float value,
+                                                                   std::size_t row_size) {
+  const auto& config = sampler.config();
+  if (config.temperature != 0.0F || config.penalties_enabled() || !config.constraint ||
+      config.constraint->vocabulary == nullptr)
+    return std::nullopt;
+  if (index < 0 || !std::isfinite(value) || static_cast<std::size_t>(index) >= row_size ||
+      config.constraint->vocabulary->size() != row_size)
+    return std::nullopt;
+  const auto token = static_cast<sampling::TokenId>(index);
+  if (!sampler.CanSelectArgmax(token, /*penalties_applied=*/true))
+    return std::nullopt;
+  return token;
+}
+
+/// After a materialized anchor: a tool grammar's production pick passes CanSelectArgmax (it is allowed and the
+/// grammar is open). A pick that fails it marks the grammar closed.
+[[nodiscard]] inline bool ProductionPickRefused(const sampling::SamplerState& sampler, sampling::TokenId pick) {
+  const auto& c = sampler.config().constraint;
+  if (!c || c->vocabulary == nullptr || pick >= c->vocabulary->size())
+    return false;
+  return !sampler.CanSelectArgmax(pick, /*penalties_applied=*/true);
+}
+
+struct Stats {
+  std::atomic<std::uint64_t> anchors{0}, screened{0}, materialized{0}, closed{0}, check_agree{0}, check_mismatch{0};
+};
+
+inline Stats& GetStats() {
+  static Stats stats;
+  return stats;
+}
+
+inline void LogSummary() {
+  auto& s = GetStats();
+  std::fprintf(stderr,
+               "[a1t] event=a1tool_summary anchors=%llu screened=%llu materialized=%llu closed=%llu "
+               "check_agree=%llu check_mismatch=%llu\n",
+               static_cast<unsigned long long>(s.anchors.load()), static_cast<unsigned long long>(s.screened.load()),
+               static_cast<unsigned long long>(s.materialized.load()), static_cast<unsigned long long>(s.closed.load()),
+               static_cast<unsigned long long>(s.check_agree.load()),
+               static_cast<unsigned long long>(s.check_mismatch.load()));
+  std::fflush(stderr);
+}
+
+/// One armed anchor decided (counter = screened / materialized / check_agree / check_mismatch).
+inline void Note(std::atomic<std::uint64_t>& counter) {
+  counter.fetch_add(1, std::memory_order_relaxed);
+  if ((GetStats().anchors.fetch_add(1, std::memory_order_relaxed) + 1) % 256 == 0)
+    LogSummary();
+}
+
+/// Check mode: the screened pick vs the production selection of the same anchor.
+inline void NoteCheck(std::int32_t screened, std::int32_t production) {
+  auto& s = GetStats();
+  if (screened == production) {
+    Note(s.check_agree);
+    return;
+  }
+  std::fprintf(stderr, "[a1t] event=a1tool_check_mismatch screened=%d production=%d\n", screened, production);
+  std::fflush(stderr);
+  Note(s.check_mismatch);
+}
+
+inline void MarkClosed(const void* grammar) {
+  if (Closed().Contains(grammar))
+    return;
+  Closed().Add(grammar);
+  GetStats().closed.fetch_add(1, std::memory_order_relaxed);
+  std::fprintf(stderr, "[a1t] event=a1tool_closed_grammar closed=%llu\n",
+               static_cast<unsigned long long>(GetStats().closed.load()));
+  std::fflush(stderr);
+}
+
+}  // namespace gufo::models::qwen38_flash_next::w3a1t
diff --git a/src/models/qwen38_flash_next/w3gc8_planned.hpp b/src/models/qwen38_flash_next/w3gc8_planned.hpp
new file mode 100644
--- /dev/null
+++ b/src/models/qwen38_flash_next/w3gc8_planned.hpp
@@ -0,0 +1,58 @@
+// geom-c8 (queue 166, Fable R19-24 GEOM-AT-C8): B5's chain stop on planned batches and occupied steps.
+//
+// promo-3c's B5 v2 applies the margin policy (floor / drop + hide) only on an unplanned cycle of a lone request
+// (engine.cpp B5Applies: !planned && occupancy <= 1). GUFO_B5_PLANNED=stop also lets a confidence-stop cycle that
+// the solo gate refused end its draft chain at B5's floor (and drop) - the STOP only. On those cycles the length
+// controller keeps production's evidence: no hide, so a rejection after a B5-stopped prefix is a failure exactly
+// as production records it, and an all-accepted stopped chain is censored exactly as production censors its own
+// confidence stops. Drafting only: verification is untouched, so every emitted token is the target's.
+//   unset / "0"   off: w3m1sc behaviour (solo gate only)
+//   "stop"        the stop-only admission above
+//   anything else invalid: off, reported as mode=invalid (the queue's knob check refuses it)
+// One stderr line at the first B5 policy load: event=b5_planned mode=off|stop|invalid.
+// Header-only; included by engine.cpp alone (render/overlay first on the include path).
+#pragma once
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace gufo::models::qwen38_flash_next::w3gc8 {
+
+enum class PlannedMode { kOff, kStop, kInvalid };
+
+[[nodiscard]] inline PlannedMode ParsePlannedMode(const char* raw) noexcept {
+  if (raw == nullptr || *raw == '\0' || std::strcmp(raw, "0") == 0)
+    return PlannedMode::kOff;
+  if (std::strcmp(raw, "stop") == 0)
+    return PlannedMode::kStop;
+  return PlannedMode::kInvalid;
+}
+
+[[nodiscard]] constexpr const char* PlannedModeName(PlannedMode m) noexcept {
+  return m == PlannedMode::kStop ? "stop" : m == PlannedMode::kOff ? "off" : "invalid";
+}
+
+/// The process-wide mode (read once) and its one log line.
+inline PlannedMode EnvPlannedMode() {
+  static const PlannedMode mode = [] {
+    const PlannedMode m = ParsePlannedMode(std::getenv("GUFO_B5_PLANNED"));
+    std::fprintf(stderr, "event=b5_planned mode=%s\n", PlannedModeName(m));
+    std::fflush(stderr);
+    return m;
+  }();
+  return mode;
+}
+
+/// A confidence-stop cycle that B5's solo gate refused (gated, and planned or occupied) takes B5's stop only.
+/// `enabled` / `gated` are B5Policy()'s; with the gate off (GUFO_B5_GATE=0) B5Applies already admits the cycle.
+[[nodiscard]] constexpr bool StopOnly(bool enabled, bool gated, bool planned, std::uint32_t occupancy,
+                                      PlannedMode mode) noexcept {
+  return enabled && gated && (planned || occupancy > 1) && mode == PlannedMode::kStop;
+}
+
+/// The hide (censored evidence) applies on a full B5 cycle only, never on a stop-only one.
+[[nodiscard]] constexpr bool HideApplies(bool b5, bool stop_only) noexcept { return b5 && !stop_only; }
+
+}  // namespace gufo::models::qwen38_flash_next::w3gc8
diff --git a/src/models/qwen38_flash_next/w3h1g_gate.hpp b/src/models/qwen38_flash_next/w3h1g_gate.hpp
new file mode 100644
--- /dev/null
+++ b/src/models/qwen38_flash_next/w3h1g_gate.hpp
@@ -0,0 +1,42 @@
+// m1se (queue 173d, w3m1se_server): the H1 one-session gate (owner decision 2026-10-31).
+// GUFO_H1_MAX_SESSIONS limits H1's STRICT admission (kXmStrictAdmitted.h1) to decode cycles whose
+// cohort has at most N sessions:
+//   unset / empty  no gate: every strict cycle as w3m1sd (ed1a78d1, queue 173b)
+//   "1".."8"       N: a strict cycle may use H1 iff 1 <= occupancy <= N and, for N == 1, the cycle is
+//                  not a jointly planned batch
+//   anything else  CLOSED: no strict cycle uses H1 (= the w3m1sc strict drafting rule)
+// `occupancy` = the sessions decoded together in THIS cycle (Session::DecodeStep: 1;
+// Session::DecodeBatchImpl: the cohort size), so the gate decides per cycle from the current batch and
+// remembers nothing. Relaxed / approximate cycles are never gated (engine.cpp H1SessionGate).
+// Pure constexpr functions (host unit test: m1se/dell-check/h1g_gate_test.cpp).
+#pragma once
+
+#include <cstdint>
+
+namespace w3h1g {
+
+inline constexpr std::uint32_t kUnset = 0;
+inline constexpr std::uint32_t kClosed = 0xFFFFFFFFu;
+
+/// GUFO_H1_MAX_SESSIONS: nullptr / "" -> kUnset; one digit "1".."8" -> N; anything else -> kClosed.
+[[nodiscard]] constexpr std::uint32_t ParseMaxSessions(const char* v) noexcept {
+  if (v == nullptr || v[0] == '\0')
+    return kUnset;
+  if (v[0] < '1' || v[0] > '8' || v[1] != '\0')
+    return kClosed;
+  return static_cast<std::uint32_t>(v[0] - '0');
+}
+
+/// Whether a STRICT cycle may use H1: `occupancy` sessions decode together in it and `planned` says
+/// whether the cohort was jointly planned (DecodeBatchImpl batch_drafts).
+[[nodiscard]] constexpr bool StrictCycleAdmits(std::uint32_t max_sessions,
+                                               std::uint32_t occupancy,
+                                               bool planned) noexcept {
+  if (max_sessions == kUnset)
+    return true;
+  if (max_sessions == kClosed || occupancy == 0 || occupancy > max_sessions)
+    return false;
+  return max_sessions > 1 || !planned;
+}
+
+}  // namespace w3h1g
diff --git a/src/models/qwen38_flash_next/w3perm_draft.hpp b/src/models/qwen38_flash_next/w3perm_draft.hpp
new file mode 100644
--- /dev/null
+++ b/src/models/qwen38_flash_next/w3perm_draft.hpp
@@ -0,0 +1,252 @@
+#ifndef GUFO_MODELS_QWEN38_FLASH_NEXT_W3PERM_DRAFT_HPP_
+#define GUFO_MODELS_QWEN38_FLASH_NEXT_W3PERM_DRAFT_HPP_
+
+// Wave3 OOV-PERM (oovperm-192, queue 192; dell-sims-026-oov variant c'):
+// a permuted draft-vocabulary prefix. GUFO_DRAFT_PERM=<file> lists pairs `<drop> <src>`: prefix row `drop`
+// (< kMtpDraftVocab) of the small draft head scores token `src` (>= kMtpDraftVocab, not special) instead, through a
+// resident copy of the 49,152 prefix rows with those rows replaced (Executor, at load). Index -> token id goes through
+// a 49,152-entry map that sits in front of every session's draft-table ids, so the production RemapDraftIds kernel maps
+// small-head indices with prefix 0. A dropped id becomes an ordinary rare token (the per-request table takes it on
+// first use); a src id counts as common (never a miss, never tabled). Unset or empty = nothing is read or printed and
+// every statement is production's. Refuses GUFO_DRAFT_STATIC (the two refuse each other at load).
+//
+// Only proposals change: the target verifies every drafted token over the full 248,320-row head, so greedy output is
+// unchanged (strict). The block is global and request-independent, so batched / restored sessions draft the same way.
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "src/families/qwen/draft_vocab/draft_vocab.hpp"  // rebase-272: moved upstream
+
+namespace gufo::models::qwen38_flash_next::w3perm {
+
+inline constexpr std::size_t kMaxPairs = 16384;
+
+struct Block {
+  bool set{false};                ///< GUFO_DRAFT_PERM was non-empty
+  std::vector<std::int32_t> drop;  ///< prefix ids that leave the prefix (file order)
+  std::vector<std::int32_t> src;   ///< the token each dropped row scores instead
+  std::vector<std::int32_t> map;   ///< kMtpDraftVocab entries: small-head index -> token id
+  std::vector<bool> in;            ///< in[id]: the permuted prefix scores token id
+  std::uint64_t fnv{0};            ///< FNV-1a 64 over (drop, src) as int32 LE pairs
+  std::string error;               ///< non-empty: the file was refused
+};
+
+/// The pairs in `text`: decimal numbers separated by whitespace, `#` starts a comment to the end of the line; the
+/// numbers pair up in order (drop, src). Refusals leave no pairs and set `error`.
+[[nodiscard]] inline Block Parse(std::string_view text) {
+  Block b;
+  b.set = true;
+  const auto refuse = [&b](const char* why) {
+    b.drop.clear();
+    b.src.clear();
+    b.map.clear();
+    b.in.clear();
+    b.fnv = 0;
+    b.error = why;
+    return b;
+  };
+  const auto space = [](char c) {
+    return c == ' ' || c == '\t' || c == '\r' || c == '\n';
+  };
+  std::vector<std::uint64_t> nums;
+  std::size_t i = 0;
+  while (i < text.size()) {
+    const char c = text[i];
+    if (c == '#') {
+      while (i < text.size() && text[i] != '\n')
+        ++i;
+      continue;
+    }
+    if (space(c)) {
+      ++i;
+      continue;
+    }
+    if (c < '0' || c > '9')
+      return refuse("not_a_number");
+    std::uint64_t v = 0;
+    for (; i < text.size() && text[i] >= '0' && text[i] <= '9'; ++i) {
+      v = v * 10 + static_cast<std::uint64_t>(text[i] - '0');
+      if (v > 0x7fffffffULL)
+        return refuse("id_range");
+    }
+    if (i < text.size() && !space(text[i]) && text[i] != '#')
+      return refuse("not_a_number");
+    if (nums.size() >= 2 * kMaxPairs)
+      return refuse("too_many");
+    nums.push_back(v);
+  }
+  if (nums.empty())
+    return refuse("empty");
+  if (nums.size() % 2 != 0)
+    return refuse("odd");
+  std::uint64_t top = kMtpDraftVocab;
+  for (std::size_t k = 0; k < nums.size(); k += 2) {
+    if (nums[k] >= kMtpDraftVocab)
+      return refuse("drop_range");
+    if (nums[k + 1] < kMtpDraftVocab)
+      return refuse("src_in_prefix");
+    if (nums[k + 1] + 1 > top)
+      top = nums[k + 1] + 1;
+  }
+  b.map.resize(kMtpDraftVocab);
+  for (std::uint32_t r = 0; r < kMtpDraftVocab; ++r)
+    b.map[r] = static_cast<std::int32_t>(r);
+  b.in.assign(static_cast<std::size_t>(top), false);
+  for (std::uint32_t r = 0; r < kMtpDraftVocab; ++r)
+    b.in[r] = true;
+  std::uint64_t h = 1469598103934665603ULL;
+  for (std::size_t k = 0; k < nums.size(); k += 2) {
+    const auto d = static_cast<std::size_t>(nums[k]);
+    const auto s = static_cast<std::size_t>(nums[k + 1]);
+    if (b.map[d] != static_cast<std::int32_t>(d))
+      return refuse("duplicate_drop");
+    if (b.in[s])
+      return refuse("duplicate_src");
+    b.map[d] = static_cast<std::int32_t>(s);
+    b.in[d] = false;
+    b.in[s] = true;
+    b.drop.push_back(static_cast<std::int32_t>(d));
+    b.src.push_back(static_cast<std::int32_t>(s));
+    for (const std::uint64_t u : {nums[k], nums[k + 1]})
+      for (int byte = 0; byte < 4; ++byte) {
+        h ^= (u >> (8 * byte)) & 0xffU;
+        h *= 1099511628211ULL;
+      }
+  }
+  b.fnv = h;
+  return b;
+}
+
+/// GUFO_DRAFT_PERM's block (`raw` = the variable's value).
+[[nodiscard]] inline Block Load(const char* raw) {
+  if (raw == nullptr || *raw == '\0')
+    return {};
+  Block b;
+  b.set = true;
+  std::ifstream f(raw, std::ios::binary);
+  if (!f) {
+    b.error = "unreadable";
+    return b;
+  }
+  const std::string text((std::istreambuf_iterator<char>(f)),
+                         std::istreambuf_iterator<char>());
+  if (text.size() > (std::size_t{1} << 20)) {
+    b.error = "too_large";
+    return b;
+  }
+  return Parse(text);
+}
+
+/// The process's block, read once.
+[[nodiscard]] inline const Block& Perm() {
+  static const Block block = Load(std::getenv("GUFO_DRAFT_PERM"));
+  return block;
+}
+
+/// Whether the (permuted) prefix scores `id`: `id < MtpDraftPrefix()` unless a valid block is loaded
+/// (rebase-272: the prefix is upstream's 98,304 rows unless ours is selected; a set GUFO_DRAFT_PERM selects 49,152).
+[[nodiscard]] inline bool InPrefix(const Block& b, std::int32_t id) {
+  if (id < 0)
+    return false;
+  if (!b.set || !b.error.empty())
+    return static_cast<std::uint32_t>(id) < MtpDraftPrefix();
+  return static_cast<std::size_t>(id) < b.in.size() &&
+         b.in[static_cast<std::size_t>(id)];
+}
+[[nodiscard]] inline bool InPrefix(std::int32_t id) { return InPrefix(Perm(), id); }
+
+/// Model::Load's check of a parsed block against the `rows`-row head and the tokenizer: "" or the refusal reason.
+template<typename IsSpecial>
+[[nodiscard]] inline std::string Validate(const Block& b, std::uint32_t rows,
+                                          IsSpecial is_special) {
+  if (!b.error.empty())
+    return b.error;
+  if (rows <= kMtpDraftVocab || b.map.size() != kMtpDraftVocab)
+    return "head_rows";
+  for (std::size_t k = 0; k < b.src.size(); ++k) {
+    if (static_cast<std::uint32_t>(b.src[k]) >= rows)
+      return "src_beyond_head";
+    if (is_special(b.src[k]))
+      return "src_special";
+    if (is_special(b.drop[k]))
+      return "drop_special";
+  }
+  return {};
+}
+
+/// One executor's permuted head on the device (Executor::Create fills a slot; ~Executor clears it). `head` holds
+/// kMtpDraftVocab output rows (row r = the head row of token map[r]); `map` the kMtpDraftVocab ids (device).
+struct Device {
+  const void* owner{nullptr};
+  void* head{nullptr};
+  const std::int32_t* map{nullptr};
+};
+
+inline std::array<Device, 4>& Devices() {
+  static std::array<Device, 4> d{};
+  return d;
+}
+
+[[nodiscard]] inline const Device* Find(const void* owner) {
+  if (owner == nullptr)
+    return nullptr;
+  for (const auto& d : Devices())
+    if (d.owner == owner)
+      return &d;
+  return nullptr;
+}
+
+[[nodiscard]] inline bool Claim(const Device& dev) {
+  for (auto& d : Devices())
+    if (d.owner == nullptr) {
+      d = dev;
+      return true;
+    }
+  return false;
+}
+
+inline void Release(const void* owner) {
+  for (auto& d : Devices())
+    if (d.owner == owner)
+      d = Device{};
+}
+
+/// The small head's prefix weight for `owner`: production's tensor, with its data swapped for the permuted copy when
+/// `owner` holds one (same rows / cols / type: the GEMV launch is production's).
+template<typename Tensor>
+[[nodiscard]] inline Tensor Prefix(Tensor t, const void* owner) {
+  if (const Device* d = Find(owner))
+    t.data = d->head;
+  return t;
+}
+
+/// RemapDraftIds arguments for `owner`: (prefix, table) = production's, or (0, the map in front of the table) when
+/// `owner` holds a permuted head (every index then maps: [0, prefix) through the map, the rest through the table).
+struct RemapArgs {
+  std::uint32_t prefix;
+  const std::int32_t* table;
+};
+[[nodiscard]] inline RemapArgs Remap(std::uint32_t prefix,
+                                     const std::int32_t* table,
+                                     const void* owner) {
+  if (Find(owner) != nullptr && prefix == kMtpDraftVocab && table != nullptr)
+    return {0, table - kMtpDraftVocab};
+  return {prefix, table};
+}
+
+/// Draft-id slots allocated in front of each session's table (the map copy): 0 unless `owner` holds a permuted head.
+[[nodiscard]] inline std::uint32_t MapRows(const void* owner) {
+  return Find(owner) != nullptr ? kMtpDraftVocab : 0;
+}
+
+}  // namespace gufo::models::qwen38_flash_next::w3perm
+
+#endif
