+#ifndef GUFO_MODELS_QWEN38_FLASH_NEXT_MTP_SPEC_SAMPLING_HPP_
+#define GUFO_MODELS_QWEN38_FLASH_NEXT_MTP_SPEC_SAMPLING_HPP_
+
+// cloud spec-sampling (lab-notes/cloud/spec-sampling.md): shaped MTP
+// proposals for sampled requests. Verification is unchanged
+// (VerifyMtpProposal), which is exact for any proposal whose masses are the
+// ones used for the draw. Default shape = production SampleMtpProposal.
+//
+// Windows port (queue 206): src/core/sampling.{hpp,cpp} are outside the
+// overlay, so SamplerState::ConstraintAllows does not exist here and the
+// grammar mask (GUFO_SPEC_Q_MASK=1) is refused at Model::Load
+// (SpecSamplingKnobsCheck). The draft sampler is always unconstrained, as in
+// production; q temperature / q top-k still shape constrained requests'
+// (unconstrained) q, which is exact for any q.
+//
+// combo-c4 member b2-af (QT only): GUFO_SPEC_UNSEEDED_SPRICE is not in this
+// build (an OCC / CH-1 pricing knob, not part of q shaping).
+//
+// Logs (stderr): one `event=spec_config ...` line at the first load
+// (NoteSpecSamplingConfig) and, once a shaped draft is drawn,
+// `event=spec_q_stats cycles= strict_cycles= drafts=` (first shaped draft
+// and every 1024th).
+
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
