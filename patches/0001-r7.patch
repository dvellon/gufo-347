+                  " chunk=" + std::to_string(c.chunk) +
+                  " chunk_wired=" +
+                  std::to_string(ChunkWiredFlag().load(std::memory_order_relaxed) ? 1 : 0) +
+                  " grid=" + (c.chunk_absolute ? "absolute" : "relative") +
+                  " scope=" + (c.scope_all ? "all" : "strict") +
+                  " cache_bytes=" + std::to_string(c.cache_bytes) +
