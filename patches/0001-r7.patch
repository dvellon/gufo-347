+      for (std::uint32_t j = 0; j < K; ++j) {
+        pid[j] = 1000 + j;
+        pres[j] = 0.5F - static_cast<float>(j) / 1024.0F;  // < 1
+      }
+      for (std::uint32_t j = 0; j < kT; ++j)
