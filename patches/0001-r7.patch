+#ifndef GUFO_CORE_W3AS_EARLY_HPP_
+#define GUFO_CORE_W3AS_EARLY_HPP_
+
+// async-snap (queue 126, R9-07 TTFT half): early first-token publication.
+// New header of the w3as overlay only; included by four overlay TUs (executor.cpp, text_generation_scheduler.cpp,
+// text_model_runner.cpp, inference_backend.cpp) that link into one binary. Production gufo has no such header.
+//
+// The scheduler arms a hook (thread-local, the serving thread) around one solo prefill step when GUFO_AS_EARLY=1.
+// Executor::Forward fires it at most once: in the prefill pass whose end position is the armed prompt end, after the
+// pass's logits were copied to the host and after that pass's MTP kv-only catch-up was ENQUEUED on the executor
+// stream, before that stream is synchronized. The hook runs host code only (first-token preview over the host logits
+// + the scheduler's publication of that token); the executor then synchronizes the stream before Forward returns, as
+// production does inside the catch-up's Run. Every GPU command, its order and its stream are production's; only the
+// host's wait for the catch-up moves after the hook.
+
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+
+namespace gufo::w3as {
+
+struct EarlyHook {
+  std::uint32_t end_position{0};          // prompt tokens: the executor position after the final pass
+  void (*fire)(void*) noexcept {nullptr};  // host only; must not touch the executor or the GPU
+  void* context{nullptr};
+  bool fired{false};
+};
+
+// Armed by the scheduler for one Prefill call on its own thread; null otherwise.
+inline thread_local EarlyHook* armed = nullptr;
+// True only while the hook previews the first token (lets the runner preview before decode_ready is set).
+inline thread_local bool in_hook = false;
+// Set by Executor::Forward for the one kv-only catch-up whose Run must not synchronize; consumed by MtpForward.
+inline thread_local bool defer_mtp_sync = false;
+// The host logits of the armed final pass (Forward's `logits`, already copied), valid only while the hook runs:
+// Session::Logits() is empty during Feed (SyncImpl clears valid_ until Feed returns).
+inline thread_local const float* early_logits = nullptr;
+inline thread_local std::size_t early_logits_count = 0;
+
+struct InHookScope {
+  InHookScope() noexcept { in_hook = true; }
+  ~InHookScope() { in_hook = false; }
+  InHookScope(const InHookScope&) = delete;
+  InHookScope& operator=(const InHookScope&) = delete;
+};
+
+}  // namespace gufo::w3as
+
+#endif  // GUFO_CORE_W3AS_EARLY_HPP_
diff --git a/src/core/w3gmask.hpp b/src/core/w3gmask.hpp
new file mode 100644
--- /dev/null
+++ b/src/core/w3gmask.hpp
@@ -0,0 +1,141 @@
+// gmask (combo-c4 member, combo-c4/members/gmask): the grammar-mask stall fix.
+//
+// Agent (tool-grammar) requests stall 18-25 ms about 2.7 times per turn (g3a LEVERS-RB-STALLS.md "Lever 2"): every
+// constrained greedy SamplerState::Sample goes Distribution -> NeedsConstraintMask -> TokenConstraint::Allowed, and a
+// mask-cache miss walks the whole 248,320-token trie (ConstraintVocabulary::Allowed). This header holds the knobs and
+// counters shared by the two gufo_core translation units that include it (src/core/sampling.cpp,
+// src/core/json_constraint.cpp; nothing else includes it). Header-only, no layout change to any existing header.
+//
+//   GUFO_GMASK        unset / "" / "0": c3 statements (Sample builds the full mask). "1": constrained-greedy fast path
+//                     in SamplerState::Sample (temperature 0, no penalties, open tool/prose grammar, i.e. exactly the
+//                     grammars CanSelectArgmax admits): take the row's lowest-index finite maximum if Allows() accepts
+//                     it, else walk the top-K candidates in (logit desc, token id asc) order and take the first one
+//                     Allows() accepts, else (K rejections) the c3 full-mask path. Picks exactly SampleConstrainedGreedy's
+//                     / SampleGreedy's token (proof in MEMBER.md). Anything else: off, valid=0.
+//   GUFO_GMASK_K      walk depth 1..4096 (default 64). Only read with GUFO_GMASK=1. Invalid: 64, valid=0.
+//   GUFO_GMASK_CACHE  TokenConstraint mask-cache entries 16..4096. unset = 16 = c3. Invalid: 16, valid=0.
+//                     Same eviction rule as c3 (smallest canonical state, never the initial state).
+//   GUFO_GMASK_STATS  "1": count and time (relaxed atomics, one steady_clock pair per full-mask build) and print
+//                     [gmask] event=gmask_build after every full-mask build and event=gmask_stats every 4096
+//                     constrained-greedy Sample calls. unset / "0": no counting, no lines.
+// One [gmask] event=gmask_config line is printed when sampling.cpp's objects are initialised (process load).
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace gufo::sampling::w3gmask {
+
+struct Config {
+  bool fast{false};
+  std::uint32_t k{64};
+  std::size_t cache{16};
+  bool stats{false};
+  bool valid{true};
+};
+
+/// Unset -> keeps *out; "" / digits within [lo, hi] -> sets *out; anything else -> false (invalid).
+[[nodiscard]] inline bool ParseBounded(const char* raw, unsigned long lo, unsigned long hi,
+                                       unsigned long* out) noexcept {
+  if (raw == nullptr || raw[0] == '\0')
+    return true;
+  unsigned long value = 0;
+  std::size_t digits = 0;
+  for (const char* p = raw; *p != '\0'; ++p, ++digits) {
+    if (*p < '0' || *p > '9' || digits >= 7)
+      return false;
+    value = value * 10 + static_cast<unsigned long>(*p - '0');
+  }
+  if (value < lo || value > hi)
+    return false;
+  *out = value;
+  return true;
+}
+
+[[nodiscard]] inline Config ParseConfig(const char* fast, const char* k, const char* cache,
+                                        const char* stats) noexcept {
+  Config c;
+  if (fast != nullptr && std::strcmp(fast, "1") == 0)
+    c.fast = true;
+  else if (fast != nullptr && fast[0] != '\0' && std::strcmp(fast, "0") != 0)
+    c.valid = false;
+  unsigned long value = 64;
+  if (!ParseBounded(k, 1, 4096, &value)) {
+    value = 64;
+    c.valid = false;
+  }
+  c.k = static_cast<std::uint32_t>(value);
+  value = 16;
+  if (!ParseBounded(cache, 16, 4096, &value)) {
+    value = 16;
+    c.valid = false;
+  }
+  c.cache = static_cast<std::size_t>(value);
+  if (stats != nullptr && std::strcmp(stats, "1") == 0)
+    c.stats = true;
+  else if (stats != nullptr && stats[0] != '\0' && std::strcmp(stats, "0") != 0)
+    c.valid = false;
+  return c;
+}
+
+/// The process-wide knobs, read once; prints the one config line.
+inline const Config& Get() {
+  static const Config config = [] {
+    const Config c = ParseConfig(std::getenv("GUFO_GMASK"), std::getenv("GUFO_GMASK_K"),
+                                 std::getenv("GUFO_GMASK_CACHE"), std::getenv("GUFO_GMASK_STATS"));
+    std::fprintf(stderr, "[gmask] event=gmask_config fast=%d k=%u cache=%zu stats=%d valid=%d\n", c.fast ? 1 : 0,
+                 static_cast<unsigned>(c.k), c.cache, c.stats ? 1 : 0, c.valid ? 1 : 0);
+    std::fflush(stderr);
+    return c;
+  }();
+  return config;
+}
+
+/// Test hook (Dell differential test only; production never calls it): -1 = the environment knob, 0 = off, 1 = on.
+inline std::atomic<int>& FastOverride() {
+  static std::atomic<int> value{-1};
+  return value;
+}
+
+[[nodiscard]] inline bool FastOn() {
+  const int forced = FastOverride().load(std::memory_order_relaxed);
+  return forced < 0 ? Get().fast : forced != 0;
+}
+
+struct Stats {
+  std::atomic<std::uint64_t> greedy{0};    // constrained greedy Sample calls that took the fast path
+  std::atomic<std::uint64_t> argmax{0};    // ... answered by the row argmax (one Allows walk)
+  std::atomic<std::uint64_t> walk{0};      // ... answered by the top-K walk
+  std::atomic<std::uint64_t> rejects{0};   // Allows rejections in those walks
+  std::atomic<std::uint64_t> fallback{0};  // ... K rejections: the c3 full-mask path
+  std::atomic<std::uint64_t> builds{0};    // full-mask builds (TokenConstraint::Allowed cache misses)
+  std::atomic<std::uint64_t> build_us{0};  // their total wall time, microseconds
+  std::atomic<std::uint64_t> hits{0};      // TokenConstraint::Allowed cache hits
+};
+
+inline Stats& GetStats() {
+  static Stats stats;
+  return stats;
+}
+
+inline void Log(const char* event, double last_ms) {
+  auto& s = GetStats();
+  std::fprintf(stderr,
+               "[gmask] event=%s last_ms=%.3f builds=%llu build_ms=%.3f hits=%llu greedy=%llu argmax=%llu walk=%llu "
+               "rejects=%llu fallback=%llu\n",
+               event, last_ms, static_cast<unsigned long long>(s.builds.load(std::memory_order_relaxed)),
+               static_cast<double>(s.build_us.load(std::memory_order_relaxed)) / 1000.0,
+               static_cast<unsigned long long>(s.hits.load(std::memory_order_relaxed)),
+               static_cast<unsigned long long>(s.greedy.load(std::memory_order_relaxed)),
+               static_cast<unsigned long long>(s.argmax.load(std::memory_order_relaxed)),
+               static_cast<unsigned long long>(s.walk.load(std::memory_order_relaxed)),
+               static_cast<unsigned long long>(s.rejects.load(std::memory_order_relaxed)),
+               static_cast<unsigned long long>(s.fallback.load(std::memory_order_relaxed)));
+  std::fflush(stderr);
+}
+
+}  // namespace gufo::sampling::w3gmask
