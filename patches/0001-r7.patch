+      hist[threadIdx.x] = 0;
+    __syncthreads();
+    const auto count_digit = [&](std::uint32_t v) {
+      if ((v & prefix_mask) == prefix)
+        atomicAdd(&hist[(v >> bits) & radix_mask], 1u);
+    };
