+#include "src/models/qwen38_flash_next/mtp_policy.hpp"
+#include "src/models/qwen38_flash_next/mtp_sampling.hpp"
+
+namespace gufo::models::qwen38_flash_next {
+
+/// The penalty arithmetic of sampling.cpp's Penalize (repetition, then
+/// frequency and presence), applied to one raw MTP logit.
+[[nodiscard]] inline double ChatPenalizedLogit(const sampling::SamplingConfig& config,
+                                               std::span<const sampling::TokenPenalty> penalties,
+                                               sampling::TokenId token, float logit) noexcept {
+  const auto found = std::ranges::lower_bound(penalties, token, {}, &sampling::TokenPenalty::token);
+  double value = static_cast<double>(logit);
+  if (found == penalties.end() || found->token != token)
+    return value;
+  if (found->repeated && config.repeat_penalty != 1.0F)
+    value = value <= 0 ? value * config.repeat_penalty : value / config.repeat_penalty;
+  value -= static_cast<double>(config.frequency_penalty) * found->generated_count;
+  if (found->generated_count != 0)
+    value -= config.presence_penalty;
+  return value;
+}
+
+/// R3-11: re-ranks the MTP candidates by the request's penalized logits
+/// (stable: equal values keep the raw order). The draft is ids[0]; the
+/// confidence stop and B5 then see penalized gaps. Returns whether the top
+/// candidate changed.
+inline bool ChatPenaltyRerank(MtpCandidateLogits& candidates,
+                              const sampling::SamplerState& sampler) {
+  const std::size_t n = std::min(candidates.size, kMtpCandidates);
+  if (n < 2)
+    return false;
+  const auto& config = sampler.config();
+  const auto penalties = sampler.penalties();
+  std::array<std::size_t, kMtpCandidates> order{};
+  std::array<double, kMtpCandidates> value{};
+  for (std::size_t i = 0; i < n; ++i) {
+    order[i] = i;
+    value[i] = std::isfinite(candidates.logits[i])
+                   ? ChatPenalizedLogit(config, penalties, candidates.ids[i], candidates.logits[i])
+                   : -std::numeric_limits<double>::infinity();
+  }
+  std::stable_sort(order.begin(), order.begin() + static_cast<std::ptrdiff_t>(n),
+                   [&](std::size_t a, std::size_t b) { return value[a] > value[b]; });
+  MtpCandidateLogits sorted;
+  sorted.size = n;
+  for (std::size_t i = 0; i < n; ++i) {
+    sorted.ids[i] = candidates.ids[order[i]];
+    sorted.logits[i] = static_cast<float>(value[order[i]]);
+  }
+  const bool changed = order[0] != 0;
+  candidates = sorted;
+  return changed;
+}
+
+/// R3-12: the largest proposal probability q would assign to the candidates
+/// (the draft sampler's own distribution; no RNG is consumed).
+[[nodiscard]] inline float ChatQTop(const MtpCandidateLogits& candidates,
+                                    const sampling::SamplerState& draft_sampler) {
+  if (candidates.size == 0 || candidates.size > kMtpCandidates)
+    return 1.0F;
+  const auto distribution = draft_sampler.Distribution(
+      std::span(candidates.logits).first(candidates.size),
+      std::span(candidates.ids).first(candidates.size));
+  double top = 0.0;
+  for (const auto& entry : distribution.entries())
+    top = std::max(top, entry.value);
+  return static_cast<float>(top);
+}
+
+/// R3-12 drop rule, BEFORE the draft at chain position `chain_size` is drawn:
+/// a function of q only (never of the draw). Never the first draft.
+[[nodiscard]] inline bool ChatSStopDrop(const chat_path::Config& config,
+                                        const MtpCandidateLogits& candidates,
+                                        const sampling::SamplerState& draft_sampler,
+                                        std::size_t chain_size) {
+  if (chain_size < 2 || chain_size > chat_path::kDepths)
+    return false;
+  const float drop = config.sstop_drop[chain_size - 1];
+  if (!(drop > 0.0F))
+    return false;
+  return ChatQTop(candidates, draft_sampler) <= drop;
+}
+
+/// The stop signal of a drawn proposal: q of the drawn token (qdraw) or the
+/// largest q of its distribution (qtop).
+[[nodiscard]] inline float ChatSampledConfidence(const MtpProposal& proposal, bool qdraw) noexcept {
+  if (qdraw)
+    return proposal.probability;
+  float top = 0.0F;
+  for (std::size_t i = 0; i < proposal.size && i < kMtpCandidates; ++i)
+    top = std::max(top, proposal.probabilities[i]);
+  return top;
+}
+
+/// Chat-path features STRICT requests may use (exactness-mode's admission
+/// rule, xm_relaxed_policy.hpp: admitted after its strict gate, used only
+/// while xm::PositionOnlySparseRows() holds). Under the owner's Q9 a sampled
+/// request's strict target is the identical output distribution, which CH-1,
+/// R3-12 and R3-13 meet by proof; they stay unadmitted until the GPU gates
+/// (dist4 + the seeded-replay implementation check) have run.
+struct ChatStrictAdmission {
+  bool pen;     ///< R3-11 (greedy: geometry, needs the nospec gate)
+  bool sstop;   ///< R3-12
+  bool splan;   ///< R3-13
+  bool sprice;  ///< CH-1
+};
+inline constexpr ChatStrictAdmission kChatStrictAdmitted{
+    .pen = false, .sstop = false, .splan = false, .sprice = false};
+
+inline constexpr std::array<float, kMaxMtpDraftTokens + 1> kChatNoConf{2.0F, 2.0F, 2.0F, 2.0F,
+                                                                         2.0F, 2.0F, 2.0F, 2.0F};
+
+/// R3-12 stop rule, AFTER the draft at chain position chain_size - 1 was
+/// drawn and appended (it stays in the chain and is verified): records its
+/// confidence and returns true when no further draft is drawn.
+inline bool ChatSStopAfterDraft(const chat_path::Config& config, const MtpProposal& proposal,
+                                std::size_t chain_size,
+                                std::array<float, kMaxMtpDraftTokens + 1>* conf) {
+  const std::size_t position = chain_size - 1;
+  if (position == 0 || position > chat_path::kDepths)
+    return false;
+  const float signal = ChatSampledConfidence(proposal, config.sstop_qdraw);
+  (*conf)[position] = signal;
+  return signal <= config.sstop_floor[position - 1];
+}
+
+}  // namespace gufo::models::qwen38_flash_next
+
+#endif  // GUFO_MODELS_QWEN38_FLASH_NEXT_CHAT_DRAFTING_HPP_
