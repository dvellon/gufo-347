+/// Batch draft policy of a relaxed/approximate cohort: one controller per
+/// (model, level), so non-strict cohorts never train the strict (production)
+/// Model::batch_policy_, and strict cohorts never train theirs.
+MtpBatchController& XmClassPolicy(const void* model, xm::ExactnessLevel level) {
+  static std::mutex mu;
+  static std::map<std::pair<const void*, int>, MtpBatchController> policies;
+  const std::lock_guard<std::mutex> lock(mu);
+  return policies[{model, static_cast<int>(level)}];
+}
