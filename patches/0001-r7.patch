+#ifndef GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_W3RB_GDN_HPP_
+#define GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_W3RB_GDN_HPP_
+
+// rb-lazy (G3a lever 1): lazy GDN rollback, a re-base of queue 205's M2 onto c3 (no M3 log mode, no M6).
+// GUFO_GDN_DEFER (read once; default off = production):
+//   unset / ""   production: a rejected verify replays its kept update rows into the state at once
+//                (Executor::Rollback -> RestoreGdnState: read the input state, write the state)
+//   lazy         a rejected verify returns to its input state and keeps its kept update rows pending (second update-row
+//                bank); the NEXT ping-pong verify replays them in its GdnKernel prologue (RestoreGdnStateKernel's
+//                per-element step statement for statement) and writes the replayed input back in place
+//   lazy-check   lazy + a device shadow check: every deferral also runs the production restore into a per-session
+//                shadow buffer, and every replayed input (prologue write-back or settle) is compared bitwise with it
+//                (event=w3rb_check lines; mismatches must stay 0)
+//   other        invalid: off (event=w3rb_gdn_defer ... invalid=1)
+// Every other reader of a session's recurrent state settles first (Session::GdnSettle: the production restore kernel,
+// in place). Pure C++ (no HIP): host-test/rb_gdn_test.cpp exercises these functions.
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <utility>
+
+namespace gufo::models::qwen38_flash_next::rocm::w3rb {
+
+enum : std::uint8_t { kGdnProd = 0, kGdnLazy = 1 };
+#if defined(_WIN32)
+inline constexpr bool kDecodeGraphs = false;  // == executor.cpp kUseDecodeGraphs (static_assert there)
+#else
+inline constexpr bool kDecodeGraphs = true;
+#endif
+
+struct GdnKnob {
+  std::uint8_t mode{kGdnProd};
+  bool check{false};
+  bool invalid{false};
+};
+
+/// Captured decode graphs bake every kernel argument, so deferral is refused where they are on.
+[[nodiscard]] inline GdnKnob GdnKnobFrom(const char* text, bool graphs) noexcept {
+  GdnKnob k;
+  if (text == nullptr || *text == '\0')
+    return k;
+  if (std::strcmp(text, "lazy") == 0) {
+    k.mode = kGdnLazy;
+  } else if (std::strcmp(text, "lazy-check") == 0) {
+    k.mode = kGdnLazy;
+    k.check = true;
+  } else {
+    k.invalid = true;
+    return k;
+  }
+  if (graphs) {
+    k = GdnKnob{};
+    k.invalid = true;
+  }
+  return k;
+}
+
+/// One line when the knob is set (production prints nothing).
+[[nodiscard]] inline const GdnKnob& Knob() noexcept {
+  static const GdnKnob knob = [] {
+    const char* text = std::getenv("GUFO_GDN_DEFER");
+    const GdnKnob k = GdnKnobFrom(text, kDecodeGraphs);
+    if (k.mode != kGdnProd || k.invalid) {
+      std::fprintf(stderr, "event=w3rb_gdn_defer mode=%s check=%d invalid=%d graphs=%d port=w3rb\n",
+                   k.mode == kGdnLazy ? "lazy" : "off", k.check ? 1 : 0, k.invalid ? 1 : 0,
+                   kDecodeGraphs ? 1 : 0);
+      std::fflush(stderr);
+    }
+    return k;
+  }();
+  return knob;
+}
+
+/// The plan of one forward of `n` rows of a session; ping_pong = a speculative batch of n > 1 rows (the only kind that
+/// writes the partner and update rows).
+struct GdnPass {
+  std::uint8_t kind{kGdnProd};
+  std::uint32_t rows{0};        ///< update rows EnsureRollback must hold (n - 1, as production)
+  bool base_in_place{false};    ///< pending rows: the replayed input is written back in place
+};
+
+[[nodiscard]] inline GdnPass PlanPass(std::uint8_t mode, bool ping_pong, std::uint32_t n,
+                                      std::uint32_t pending) noexcept {
+  GdnPass p;
+  p.rows = n > 0 ? n - 1 : 0;
+  if (mode == kGdnProd || !ping_pong)
+    return p;
+  p.kind = kGdnLazy;
+  p.base_in_place = pending != 0;
+  return p;
+}
+
+/// What Rollback(keep) of a batch of `n` rows planned as `kind` does with the recurrent state.
+struct GdnRollback {
+  bool restore{false};  ///< production: replay the kept rows into the state now
+  bool unflip{false};   ///< lazy rejected: back to the (replayed) input state
+  bool defer{false};    ///< swap the update-row banks; the kept rows are pending
+};
+
+[[nodiscard]] inline GdnRollback RollbackAct(std::uint8_t kind, std::uint32_t keep, std::uint32_t n) noexcept {
+  GdnRollback r;
+  if (kind == kGdnLazy) {
+    r.unflip = keep < n;
+    r.defer = keep < n;
+  } else {
+    r.restore = keep < n;
+  }
+  return r;
+}
+
+struct GdnStats {
+  std::atomic<std::uint64_t> lazy_passes{0};
+  std::atomic<std::uint64_t> replays{0};
+  std::atomic<std::uint64_t> deferred{0};
+  std::atomic<std::uint64_t> settles{0};
+};
+
+[[nodiscard]] inline GdnStats& Stats() noexcept {
+  static GdnStats s;
+  return s;
+}
+
+inline void PrintStats() noexcept {
+  auto& s = Stats();
+  std::fprintf(stderr, "event=w3rb_gdn_defer_stats deferred=%llu lazy_passes=%llu replays=%llu settles=%llu port=w3rb\n",
+               static_cast<unsigned long long>(s.deferred.load(std::memory_order_relaxed)),
+               static_cast<unsigned long long>(s.lazy_passes.load(std::memory_order_relaxed)),
+               static_cast<unsigned long long>(s.replays.load(std::memory_order_relaxed)),
+               static_cast<unsigned long long>(s.settles.load(std::memory_order_relaxed)));
+  std::fflush(stderr);
+}
+
+inline void NotePass(std::uint8_t kind, std::uint32_t replayed) noexcept {
+  if (kind != kGdnLazy)
+    return;
+  Stats().lazy_passes.fetch_add(1, std::memory_order_relaxed);
+  if (replayed != 0)
+    Stats().replays.fetch_add(1, std::memory_order_relaxed);
+}
+
+/// True on the deferrals whose stats line is printed (the 1st and every 1024th).
+inline bool NoteDeferred() noexcept {
+  const auto n = Stats().deferred.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (n == 1 || n % 1024 == 0) {
+    PrintStats();
+    return true;
+  }
+  return false;
+}
+
+inline void NoteSettle() noexcept { Stats().settles.fetch_add(1, std::memory_order_relaxed); }
+
+/// lazy-check: one line from the device counters {compares, elements, mismatches}.
+inline void PrintCheck(const unsigned long long* c) noexcept {
+  std::fprintf(stderr, "event=w3rb_check compares=%llu elements=%llu mismatches=%llu port=w3rb\n", c[0], c[1], c[2]);
+  std::fflush(stderr);
+}
+
+}  // namespace gufo::models::qwen38_flash_next::rocm::w3rb
+
+#endif  // GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_W3RB_GDN_HPP_
