+// ---- Wave3 gdn-scan-retile (make_gscan.py, queue 176): GUFO_GDN_SCAN retiles of the wide-prefill GDN
+// recurrence (GdnRowSplitKernel) + the optional fused epilogue (GdnEpilogueKernel arithmetic on the rows in LDS).
+// Inserted in kernels.hip.cpp right before GatedDeltaNet, inside the same anonymous namespace as the production
+// kernels it reuses (GdnRowReduce, WaveSum, SigmoidF, kGdnDim, GdnRowSplitKernel, GdnEpilogueKernel). Maps and the
+// variant table: w3gscan_map.h (shared with the CPU reference src-gscan/gscan_ref_test.cpp). GUFO_GDN_SCAN unset /
+// "0": GatedDeltaNet runs its production statements and nothing here is called (W3GscanMode() reads the variable once
+// and prints nothing). See the README s2 for the per-element operation sequence every variant keeps.
+namespace {
+
+struct W3GscanEpi {
+  const float* z = nullptr;
+  std::uint32_t z_stride = 0;
+  const float* norm_w = nullptr;
+  __half* out_half = nullptr;
+  std::uint32_t out_half_stride = 0;
+  float eps = 0.0f;
+};
+
+// Named window registers (an array of window vectors stayed in scratch in production; see GdnRowSplitKernel).
+struct W3GscanF4 {
+  float4 v0, v1, v2, v3, v4, v5, v6, v7;
+};
+struct W3GscanF1 {
+  float v0, v1, v2, v3, v4, v5, v6, v7;
+};
+__device__ __forceinline__ float4& W3GscanAt(W3GscanF4& s, int i) {
+  switch (i) {
+    case 0: return s.v0;
+    case 1: return s.v1;
+    case 2: return s.v2;
+    case 3: return s.v3;
+    case 4: return s.v4;
+    case 5: return s.v5;
+    case 6: return s.v6;
+    default: return s.v7;
+  }
+}
+__device__ __forceinline__ float& W3GscanAt(W3GscanF1& s, int i) {
+  switch (i) {
+    case 0: return s.v0;
+    case 1: return s.v1;
+    case 2: return s.v2;
+    case 3: return s.v3;
+    case 4: return s.v4;
+    case 5: return s.v5;
+    case 6: return s.v6;
+    default: return s.v7;
+  }
+}
+
+/// Production GdnEpilogueKernel<false>'s F16-output arithmetic for one (token, head) row whose 128 raw values are in
+/// `src` (LDS): the same lane map (lane holds src[r * warpSize + lane]), the same sum, WaveSum, scale and product
+/// order, the same F16 store. Run by one whole wave.
+__device__ __forceinline__ void W3GscanEpilogueRow(const float* src, std::size_t t, std::uint32_t h,
+                                                   std::uint32_t v_heads, std::uint32_t lane,
+                                                   const W3GscanEpi& epi) {
+  constexpr std::uint32_t d = kGdnDim;
+  const float* zrow = epi.z + t * epi.z_stride + static_cast<std::size_t>(h) * d;
+  const std::uint32_t per_lane = d / warpSize;
+  float v[d / 32];
+  float ss = 0.0f;
+#pragma unroll
+  for (std::uint32_t r = 0; r < per_lane; ++r) {
+    v[r] = src[r * warpSize + lane];
+    ss += v[r] * v[r];
+  }
+  const float scale = rsqrtf(WaveSum(ss) / static_cast<float>(d) + epi.eps);
+  const auto offset = static_cast<std::size_t>(w3gscan::EpiOffset(t, h, v_heads, epi.out_half_stride));
+#pragma unroll
+  for (std::uint32_t r = 0; r < per_lane; ++r) {
+    const std::uint32_t i = r * warpSize + lane;
+    const float value = v[r] * scale * epi.norm_w[i] * SigmoidF(zrow[i]);
+    epi.out_half[offset + i] = __float2half_rn(value);
+  }
+}
+
+/// The tile retile: GdnRowSplitKernel with kRows rows per lane, kWaves waves per block, kW-token windows and kAhead
+/// windows of loads in flight. <2, 4, 4, 3, false> is production's shape. Every row keeps production's per-lane
+/// summation order and DPP reduction (GdnRowReduce); only the row -> lane / block map and the staging change.
+template <int kRows, int kWaves, int kW, int kAhead, bool kFuse>
+__launch_bounds__(kWaves * 32) __global__
+    void W3GscanTileKernel(const float* conv_out, const float* scales, const float* ab, float* state, float* raw,
+                           std::uint32_t n_tokens, std::uint32_t k_heads, std::uint32_t v_heads,
+                           GdnCheckpoint checkpoint, W3GscanEpi epi) {
+  using S = w3gscan::Shape<kRows, kWaves, kW>;
+  constexpr int d = kGdnDim;
+  static_assert(d == w3gscan::kD, "head dim");
+  constexpr int kThreadsPerBlock = S::kThreads;
+  constexpr int kVec = w3gscan::kVec;
+  constexpr int kLanesPerRow = w3gscan::kLanesPerRow;
+  constexpr int kRowsPerWave = S::kRowsPerWave;
+  constexpr int kRowsPerBlock = S::kRowsPerBlock;
+  constexpr int kQkPerThread = S::kQkPerThread;
+  constexpr int kVPerThread = S::kVPerThread;
+  static_assert(!kFuse || kRowsPerBlock == d, "the fused epilogue needs a whole head per block");
+  static_assert(kAhead >= 1 && kAhead <= 3, "windows in flight");
+  const int h = blockIdx.y;
+  const int tid = threadIdx.x;
+  const int lane = tid & 31;
+  const int wave = tid >> 5;
+  const int segment = lane % kLanesPerRow;
+  const int row_group = lane / kLanesPerRow;
+  const int kh = h % k_heads;
+  const int vec0 = segment * kVec;
+  const int channels = 2 * k_heads * d + v_heads * d;
+  const auto row_local = [&](int rr) { return w3gscan::RowLocal(kRowsPerWave, wave, rr, row_group); };
+
+  __shared__ float4 s_qk[2][2][kW][d / 4];
+  __shared__ float s_v[2][kW][kRowsPerBlock];
+  __shared__ float s_misc[2][kW][5];
+  __shared__ float s_out[kFuse ? 2 : 1][kFuse ? kW : 1][kFuse ? d : 1];
+
+  float4 s[kRows][kVec];
+#pragma unroll
+  for (int rr = 0; rr < kRows; ++rr) {
+    const int row = blockIdx.x * kRowsPerBlock + row_local(rr);
+    const auto* state4 = reinterpret_cast<const float4*>(state + (static_cast<std::size_t>(h) * d + row) * d);
+#pragma unroll
+    for (int i = 0; i < kVec; ++i) {
+      s[rr][i] = state4[vec0 + i];
+    }
+  }
+
+  const float* qk_src[kQkPerThread];
+  int qk_tok[kQkPerThread];
+  int qk_which[kQkPerThread];
+  int qk_slot[kQkPerThread];
+#pragma unroll
+  for (int j = 0; j < kQkPerThread; ++j) {
+    const int c = tid + j * kThreadsPerBlock;
+    qk_which[j] = w3gscan::QkWhich(c, kW);
+    qk_tok[j] = w3gscan::QkTokW(c, kW);
+    const int qk_vec = w3gscan::QkVecOf(c);
+    qk_src[j] = conv_out + (qk_which[j] == 0 ? kh : k_heads + kh) * d + (qk_vec * 4);
+    qk_slot[j] = w3gscan::QkSlot(qk_vec);
+  }
+  const float* v_src[kVPerThread];
+  int v_tok[kVPerThread];
+  int v_row[kVPerThread];
+#pragma unroll
+  for (int j = 0; j < kVPerThread; ++j) {
+    const int e = tid + j * kThreadsPerBlock;
+    v_tok[j] = w3gscan::VTok(e, kRowsPerBlock);
+    v_row[j] = w3gscan::VRow(e, kRowsPerBlock);
+    v_src[j] = conv_out + 2 * k_heads * d + h * d + blockIdx.x * kRowsPerBlock + v_row[j];
+  }
+  const int m_tok = w3gscan::MTok(tid);
+  const int m_idx = w3gscan::MIdx(tid);
+  const float* m_src = m_idx < 3 ? scales + kh * 3 + m_idx : ab + h * 2 + (m_idx - 3);
+  const std::size_t m_stride = m_idx < 3 ? k_heads * 3 : v_heads * 2;
+
+  struct Window {
+    W3GscanF4 qk;
+    W3GscanF1 v;
+    float m;
+  };
+  Window r0;
+  Window r1;
+  Window r2;
+  const auto load_window = [&](int w, Window& r) {
+    const int last = static_cast<int>(n_tokens) - 1;
+#pragma unroll
+    for (int j = 0; j < kQkPerThread; ++j) {
+      const int t_qk = min((w * kW) + qk_tok[j], last);
+      W3GscanAt(r.qk, j) = *reinterpret_cast<const float4*>(qk_src[j] + static_cast<std::size_t>(t_qk) * channels);
+    }
+#pragma unroll
+    for (int j = 0; j < kVPerThread; ++j) {
+      const int t_v = min((w * kW) + v_tok[j], last);
+      W3GscanAt(r.v, j) = v_src[j][static_cast<std::size_t>(t_v) * channels];
+    }
+    if (tid < 5 * kW) {
+      const int t_m = min((w * kW) + m_tok, last);
+      r.m = m_src[static_cast<std::size_t>(t_m) * m_stride];
+    }
+  };
+  const auto commit_window = [&](Window& r, int lds) {
+#pragma unroll
+    for (int j = 0; j < kQkPerThread; ++j) {
+      s_qk[lds][qk_which[j]][qk_tok[j]][qk_slot[j]] = W3GscanAt(r.qk, j);
+    }
+#pragma unroll
+    for (int j = 0; j < kVPerThread; ++j) {
+      s_v[lds][v_tok[j]][v_row[j]] = W3GscanAt(r.v, j);
+    }
+    if (tid < 5 * kW) {
+      s_misc[lds][m_tok][m_idx] = r.m;
+    }
+  };
+
+  const int n_windows = (static_cast<int>(n_tokens) + kW - 1) / kW;
+  load_window(0, r0);
+  if (kAhead > 1 && n_windows > 1) {
+    load_window(1, r1);
+  }
+  if (kAhead > 2 && n_windows > 2) {
+    load_window(2, r2);
+  }
+  commit_window(r0, 0);
+  __syncthreads();
+  float* out_base = raw + h * d;
+  const auto window = [&](int w, Window& cur, Window& next) {
+    if (w >= n_windows) {
+      return;
+    }
+    const int lds = w & 1;
+    if (w + kAhead < n_windows) {
+      load_window(w + kAhead, cur);
+    }
+    const int t_end = min(kW, static_cast<int>(n_tokens) - (w * kW));
+    for (int tl = 0; tl < t_end; ++tl) {
+      const float4* q4 = s_qk[lds][0][tl];
+      const float4* k4 = s_qk[lds][1][tl];
+      const float decay = s_misc[lds][tl][3];
+      float u[kRows];
+      float p[kRows];
+      float4 kc[kVec];
+#pragma unroll
+      for (int i = 0; i < kVec; ++i) {
+        const float4 qv = q4[(i * kLanesPerRow) + segment];
+        kc[i] = k4[(i * kLanesPerRow) + segment];
+#pragma unroll
+        for (int rr = 0; rr < kRows; ++rr) {
+          s[rr][i].x *= decay;
+          s[rr][i].y *= decay;
+          s[rr][i].z *= decay;
+          s[rr][i].w *= decay;
+          if (i == 0) {
+            u[rr] = s[rr][i].x * kc[i].x;
+            p[rr] = s[rr][i].x * qv.x;
+          } else {
+            u[rr] = __builtin_fmaf(s[rr][i].x, kc[i].x, u[rr]);
+            p[rr] = __builtin_fmaf(s[rr][i].x, qv.x, p[rr]);
+          }
+          u[rr] = __builtin_fmaf(s[rr][i].y, kc[i].y, u[rr]);
+          p[rr] = __builtin_fmaf(s[rr][i].y, qv.y, p[rr]);
+          u[rr] = __builtin_fmaf(s[rr][i].z, kc[i].z, u[rr]);
+          p[rr] = __builtin_fmaf(s[rr][i].z, qv.z, p[rr]);
+          u[rr] = __builtin_fmaf(s[rr][i].w, kc[i].w, u[rr]);
+          p[rr] = __builtin_fmaf(s[rr][i].w, qv.w, p[rr]);
+        }
+      }
+      const float inv_k = s_misc[lds][tl][0];
+      const float q_scale = s_misc[lds][tl][1];
+      const float kq = s_misc[lds][tl][2];
+      const float beta = s_misc[lds][tl][4];
+#pragma unroll
+      for (int rr = 0; rr < kRows; ++rr) {
+        GdnRowReduce(u[rr], p[rr]);
+        float delta = __builtin_fmaf(-u[rr], inv_k, s_v[lds][tl][row_local(rr)]) * beta;
+        asm volatile("" : "+v"(delta));
+        const float update = delta * inv_k;
+        if (segment == 0) {
+          if constexpr (kFuse) {
+            s_out[lds][tl][row_local(rr)] = __builtin_fmaf(kq, update, p[rr]) * q_scale;
+          } else {
+            out_base[blockIdx.x * kRowsPerBlock + row_local(rr)] = __builtin_fmaf(kq, update, p[rr]) * q_scale;
+          }
+        }
+#pragma unroll
+        for (int i = 0; i < kVec; ++i) {
+          s[rr][i].x = __builtin_fmaf(update, kc[i].x, s[rr][i].x);
+          s[rr][i].y = __builtin_fmaf(update, kc[i].y, s[rr][i].y);
+          s[rr][i].z = __builtin_fmaf(update, kc[i].z, s[rr][i].z);
+          s[rr][i].w = __builtin_fmaf(update, kc[i].w, s[rr][i].w);
+        }
+        if (checkpoint.state != nullptr && w * kW + tl + 1 == checkpoint.tokens) {
+          const int row = blockIdx.x * kRowsPerBlock + row_local(rr);
+          auto* target = reinterpret_cast<float4*>(checkpoint.state + (static_cast<std::size_t>(h) * d + row) * d);
+#pragma unroll
+          for (int i = 0; i < kVec; ++i)
+            target[vec0 + i] = s[rr][i];
+        }
+        if (checkpoint.state2 != nullptr && w * kW + tl + 1 == checkpoint.tokens2) {
+          const int row = blockIdx.x * kRowsPerBlock + row_local(rr);
+          auto* target = reinterpret_cast<float4*>(checkpoint.state2 + (static_cast<std::size_t>(h) * d + row) * d);
+#pragma unroll
+          for (int i = 0; i < kVec; ++i)
+            target[vec0 + i] = s[rr][i];
+        }
+      }
+      out_base += v_heads * d;
+    }
+    if (w + 1 < n_windows) {
+      commit_window(next, lds ^ 1);
+    }
+    __syncthreads();
+    if constexpr (kFuse) {
+      // Window w's 128 output rows per token are complete: one wave per token runs production's epilogue arithmetic.
+      // The slot is rewritten two windows later, after the next barrier, which every wave reaches after this loop.
+      for (int tl = wave; tl < t_end; tl += kWaves) {
+        W3GscanEpilogueRow(s_out[lds][tl], static_cast<std::size_t>(w) * kW + tl, h, v_heads, lane, epi);
+      }
+    }
+  };
+  if constexpr (kAhead == 1) {
+    for (int w = 0; w < n_windows; ++w) {
+      window(w, r0, r0);
+    }
+  } else if constexpr (kAhead == 2) {
+    for (int w = 0; w < n_windows; w += 2) {
+      window(w, r0, r1);
+      window(w + 1, r1, r0);
+    }
+  } else {
+    for (int w = 0; w < n_windows; w += 3) {
+      window(w, r0, r1);
+      window(w + 1, r1, r2);
+      window(w + 2, r2, r0);
+    }
+  }
+#pragma unroll
+  for (int rr = 0; rr < kRows; ++rr) {
+    const int row = blockIdx.x * kRowsPerBlock + row_local(rr);
+    auto* state4 = reinterpret_cast<float4*>(state + (static_cast<std::size_t>(h) * d + row) * d);
+#pragma unroll
+    for (int i = 0; i < kVec; ++i) {
+      state4[vec0 + i] = s[rr][i];
+    }
+  }
+}
+
+/// The lane-row retile: one lane owns one whole state row (128 keys in registers) and computes its 4 segment chains
+/// itself, in production's key order, combined by production's tree (c0 + c1) + (c2 + c3); q, k, the 3 scales and
+/// the 2 decays are wave-uniform and read through the constant address space (scalar loads, no LDS). kWaves == 4
+/// with kFuse: one block per head, the fused epilogue per 4-token window.
+template <int kWaves, bool kFuse>
+__launch_bounds__(kWaves * 32) __global__
+    void W3GscanLaneRowKernel(const float* conv_out, const float* scales, const float* ab, float* state, float* raw,
+                              std::uint32_t n_tokens, std::uint32_t k_heads, std::uint32_t v_heads,
+                              GdnCheckpoint checkpoint, W3GscanEpi epi) {
+  using S = w3gscan::LaneRowShape<kWaves>;
+  constexpr int d = kGdnDim;
+  constexpr int kW = 4;
+  constexpr int kSeg = w3gscan::kLanesPerRow;
+  constexpr int kKeys = w3gscan::kKeysPerLane;
+  static_assert(!kFuse || S::kRowsPerBlock == d, "the fused epilogue needs a whole head per block");
+  using CF = const __attribute__((address_space(4))) float;
+  const int h = blockIdx.y;
+  const int tid = threadIdx.x;
+  const int lane = tid & 31;
+  const int wave = tid >> 5;
+  const int row = blockIdx.x * S::kRowsPerBlock + tid;
+  const int kh = h % k_heads;
+  const std::size_t channels = 2 * k_heads * d + v_heads * d;
+  CF* q_src = (CF*)(conv_out + kh * d);
+  CF* k_src = (CF*)(conv_out + (k_heads + kh) * d);
+  CF* sc_src = (CF*)(scales + kh * 3);
+  CF* ab_src = (CF*)(ab + h * 2);
+  const float* v_src = conv_out + 2 * k_heads * d + h * d + row;
+  __shared__ float s_out[kFuse ? 2 : 1][kFuse ? kW : 1][kFuse ? d : 1];
+
+  float s[d];
+  {
+    const auto* state4 = reinterpret_cast<const float4*>(state + (static_cast<std::size_t>(h) * d + row) * d);
+#pragma unroll
+    for (int i = 0; i < d / 4; ++i) {
+      const float4 x = state4[i];
+      s[4 * i] = x.x;
+      s[4 * i + 1] = x.y;
+      s[4 * i + 2] = x.z;
+      s[4 * i + 3] = x.w;
+    }
+  }
+  const auto store_row = [&](float* dst) {
+    auto* t4 = reinterpret_cast<float4*>(dst + (static_cast<std::size_t>(h) * d + row) * d);
+#pragma unroll
+    for (int i = 0; i < d / 4; ++i)
+      t4[i] = make_float4(s[4 * i], s[4 * i + 1], s[4 * i + 2], s[4 * i + 3]);
+  };
+  for (int t = 0; t < static_cast<int>(n_tokens); ++t) {
+    const std::size_t tq = static_cast<std::size_t>(t) * channels;
+    const std::size_t tab = static_cast<std::size_t>(t) * v_heads * 2;
+    const std::size_t tsc = static_cast<std::size_t>(t) * k_heads * 3;
+    const float decay = ab_src[tab];
+    const float v = v_src[tq];
+    float c[kSeg];
+    float pp[kSeg];
+    // Production's lane of segment g runs keys 32 g .. 32 g + 31 in ascending order, the first a plain product.
+#pragma unroll
+    for (int j = 0; j < kKeys; ++j) {
+#pragma unroll
+      for (int g = 0; g < kSeg; ++g) {
+        const int key = g * kKeys + j;
+        const float kk = k_src[tq + key];
+        const float qq = q_src[tq + key];
+        s[key] *= decay;
+        if (j == 0) {
+          c[g] = s[key] * kk;
+          pp[g] = s[key] * qq;
+        } else {
+          c[g] = __builtin_fmaf(s[key], kk, c[g]);
+          pp[g] = __builtin_fmaf(s[key], qq, pp[g]);
+        }
+      }
+    }
+    // GdnRowReduce: xor-1 then xor-2 within the 4 segment lanes = (c0 + c1) + (c2 + c3) (commutative per add).
+    float u01 = c[0] + c[1];
+    asm volatile("" : "+v"(u01));
+    float u23 = c[2] + c[3];
+    asm volatile("" : "+v"(u23));
+    float p01 = pp[0] + pp[1];
+    asm volatile("" : "+v"(p01));
+    float p23 = pp[2] + pp[3];
+    asm volatile("" : "+v"(p23));
+    const float u = u01 + u23;
+    const float p = p01 + p23;
+    const float inv_k = sc_src[tsc];
+    const float q_scale = sc_src[tsc + 1];
+    const float kq = sc_src[tsc + 2];
+    const float beta = ab_src[tab + 1];
+    float delta = __builtin_fmaf(-u, inv_k, v) * beta;
+    asm volatile("" : "+v"(delta));
+    const float update = delta * inv_k;
+    const float value = __builtin_fmaf(kq, update, p) * q_scale;
+    if constexpr (kFuse) {
+      s_out[(t / kW) & 1][t % kW][row] = value;
+    } else {
+      raw[(static_cast<std::size_t>(t) * v_heads + h) * d + row] = value;
+    }
+#pragma unroll
+    for (int key = 0; key < d; ++key)
+      s[key] = __builtin_fmaf(update, k_src[tq + key], s[key]);
+    if (checkpoint.state != nullptr && t + 1 == static_cast<int>(checkpoint.tokens))
+      store_row(checkpoint.state);
+    if (checkpoint.state2 != nullptr && t + 1 == static_cast<int>(checkpoint.tokens2))
+      store_row(checkpoint.state2);
+    if constexpr (kFuse) {
+      if (t % kW == kW - 1 || t + 1 == static_cast<int>(n_tokens)) {
+        __syncthreads();
+        const int w = t / kW;
+        const int t_end = t % kW + 1;
+        for (int tl = wave; tl < t_end; tl += kWaves)
+          W3GscanEpilogueRow(s_out[w & 1][tl], static_cast<std::size_t>(w) * kW + tl, h, v_heads, lane, epi);
+      }
+    }
+  }
+  store_row(state);
+}
+
+// ---- host side --------------------------------------------------------------------------------------------------------
+template <int R, int Wv, int Ww, int A, bool F>
+void W3GscanLaunchTile(const float* conv, const float* scales, const float* ab, float* state, float* raw,
+                       std::uint32_t n, std::uint32_t k_heads, std::uint32_t v_heads, GdnCheckpoint ck,
+                       const W3GscanEpi& epi, hipStream_t stream) {
+  using S = w3gscan::Shape<R, Wv, Ww>;
+  hipLaunchKernelGGL((W3GscanTileKernel<R, Wv, Ww, A, F>), dim3(S::kBlocksPerHead, v_heads), dim3(S::kThreads), 0,
+                     stream, conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi);
+}
+template <int Wv, bool F>
+void W3GscanLaunchLaneRow(const float* conv, const float* scales, const float* ab, float* state, float* raw,
+                          std::uint32_t n, std::uint32_t k_heads, std::uint32_t v_heads, GdnCheckpoint ck,
+                          const W3GscanEpi& epi, hipStream_t stream) {
+  using S = w3gscan::LaneRowShape<Wv>;
+  hipLaunchKernelGGL((W3GscanLaneRowKernel<Wv, F>), dim3(S::kBlocksPerHead, v_heads), dim3(S::kThreads), 0, stream,
+                     conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi);
+}
+/// Launch variant v (w3gscan::kTable index). `fused` = run its fused epilogue (only when the call's epilogue is the
+/// F16-output route and the variant fuses); otherwise its unfused twin writes raw rows for production's epilogue.
+void W3GscanLaunch(int v, bool fused, const float* conv, const float* scales, const float* ab, float* state,
+                   float* raw, std::uint32_t n, std::uint32_t k_heads, std::uint32_t v_heads, GdnCheckpoint ck,
+                   const W3GscanEpi& epi, hipStream_t stream) {
+  switch (v) {
+    case 1: W3GscanLaunchTile<2, 4, 4, 3, false>(conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi, stream); break;
+    case 2: W3GscanLaunchTile<2, 2, 4, 3, false>(conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi, stream); break;
+    case 3: W3GscanLaunchTile<2, 4, 8, 2, false>(conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi, stream); break;
+    case 4: W3GscanLaunchTile<4, 2, 4, 2, false>(conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi, stream); break;
+    case 5: W3GscanLaunchTile<4, 4, 4, 2, false>(conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi, stream); break;
+    case 6: W3GscanLaunchTile<4, 1, 2, 2, false>(conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi, stream); break;
+    case 7:
+      if (fused) W3GscanLaunchTile<4, 4, 4, 2, true>(conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi, stream);
+      else W3GscanLaunchTile<4, 4, 4, 2, false>(conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi, stream);
+      break;
+    case 8:
+      if (fused) W3GscanLaunchTile<2, 8, 4, 3, true>(conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi, stream);
+      else W3GscanLaunchTile<2, 8, 4, 3, false>(conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi, stream);
+      break;
+    case 9: W3GscanLaunchLaneRow<1, false>(conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi, stream); break;
+    case 10:
+      if (fused) W3GscanLaunchLaneRow<4, true>(conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi, stream);
+      else W3GscanLaunchLaneRow<4, false>(conv, scales, ab, state, raw, n, k_heads, v_heads, ck, epi, stream);
+      break;
+    default: break;
+  }
+}
+
+/// Word compare of two row sets (rows x cols elements of T, row strides in elements): count of differing elements and
+/// the first differing flat index (row * cols + col).
+template <typename T>
+__global__ void W3GscanCmpKernel(const T* a, const T* b, std::size_t rows, std::size_t cols, std::size_t stride_a,
+                                 std::size_t stride_b, unsigned long long* out) {
+  const std::size_t total = rows * cols;
+  for (std::size_t i = blockIdx.x * static_cast<std::size_t>(blockDim.x) + threadIdx.x; i < total;
+       i += static_cast<std::size_t>(gridDim.x) * blockDim.x) {
+    const std::size_t r = i / cols;
+    const std::size_t c = i % cols;
+    if (a[r * stride_a + c] != b[r * stride_b + c]) {
+      atomicAdd(&out[0], 1ULL);
+      atomicMin(&out[1], static_cast<unsigned long long>(i));
+    }
+  }
+}
