+struct SfxShared {
+  std::mutex mu;  ///< the session table and the global caches
+  std::unordered_map<const void*, std::unique_ptr<SfxSession>> sessions;
+  std::vector<std::unique_ptr<SfxGlobalCache>> caches;
+  std::uint64_t clock{0};
+};
+SfxShared& Sfx() {
+  static SfxShared* shared = new SfxShared();  // outlives static sessions
+  return *shared;
+}
+
+std::atomic<std::uint64_t> g_sfx_cycles{0}, g_sfx_first{0}, g_sfx_after{0},
+    g_sfx_copied{0}, g_sfx_global_first{0}, g_sfx_rebuilds{0}, g_sfx_flushed{0};
+
+bool SfxStatsOn() {
+  static const bool on = [] {
+    const bool stats = std::getenv("GUFO_SFX_STATS") != nullptr;
+    if (stats)
+      std::fprintf(stderr,
+                   "event=sfx_config enabled=%d global=%d batch=%d "
+                   "global_tokens=%llu\n",
+                   SfxEnabled() ? 1 : 0, SfxGlobalEnabled() ? 1 : 0,
+                   SfxBatch() ? 1 : 0,
+                   static_cast<unsigned long long>(SfxGlobalTokens()));
+    return stats;
+  }();
+  return on;
+}
+
+void SfxStats() {
+  if (SfxStatsOn())
+    std::fprintf(stderr,
+                 "event=sfx_stats cycles=%llu copy_first=%llu copy_after=%llu "
+                 "copied=%llu global_first=%llu rebuilds=%llu flushed=%llu\n",
+                 static_cast<unsigned long long>(g_sfx_cycles.load()),
+                 static_cast<unsigned long long>(g_sfx_first.load()),
+                 static_cast<unsigned long long>(g_sfx_after.load()),
+                 static_cast<unsigned long long>(g_sfx_copied.load()),
+                 static_cast<unsigned long long>(g_sfx_global_first.load()),
+                 static_cast<unsigned long long>(g_sfx_rebuilds.load()),
+                 static_cast<unsigned long long>(g_sfx_flushed.load()));
+}
+
+void SfxRecordCopy(bool first, std::size_t count, bool global_first) {
+  (first ? g_sfx_first : g_sfx_after).fetch_add(1);
+  g_sfx_copied.fetch_add(count);
+  g_sfx_global_first.fetch_add(global_first ? 1 : 0);
+  if ((g_sfx_first.load() + g_sfx_after.load()) % 256 == 0)
+    SfxStats();
+}
+
+std::uint64_t SfxHarnessKey(std::span<const std::int32_t> tokens) {
+  std::uint64_t h = 0xCBF29CE484222325ULL;  // FNV-1a over the first tokens
+  for (std::size_t i = 0; i < std::min(tokens.size(), kSfxKeyPrefix); ++i) {
+    h ^= static_cast<std::uint32_t>(tokens[i]);
+    h *= 0x100000001B3ULL;
+  }
+  return h;
+}
+
+/// Global cache of `key` (caller holds Sfx().mu), created when `create`.
+SfxGlobalCache* SfxCacheLocked(std::uint64_t key, bool create) {
+  auto& s = Sfx();
+  for (auto& c : s.caches)
+    if (c->key == key) {
+      c->stamp = ++s.clock;
+      return c.get();
+    }
+  if (!create)
+    return nullptr;
+  if (s.caches.size() >= kSfxMaxKeys) {
+    auto oldest = std::min_element(s.caches.begin(), s.caches.end(),
+                                   [](const auto& a, const auto& b) { return a->stamp < b->stamp; });
+    s.caches.erase(oldest);
+  }
+  s.caches.push_back(std::make_unique<SfxGlobalCache>());
+  s.caches.back()->key = key;
+  s.caches.back()->stamp = ++s.clock;
+  return s.caches.back().get();
+}
+
+void SfxFlushLocked(SfxSession& session) {
+  if (SfxGlobalEnabled() && !session.output.empty()) {
+    SfxCacheLocked(session.key, true)->Add(session.output, SfxGlobalTokens());
+    g_sfx_flushed.fetch_add(1);
+  }
+  session.output.clear();
+}
+
+/// The session's drafter state, synced to its committed `tokens`. A new
+/// request (no speculative step yet) flushes the previous request's output
+/// to its harness cache and starts recording this one.
+SfxSession* SfxSessionFor(const void* owner, std::span<const std::int32_t> tokens,
+                          bool new_request) {
+  (void)SfxStatsOn();  // prints the configuration once
+  SfxSession* session;
+  {
+    auto& s = Sfx();
+    std::lock_guard<std::mutex> lock(s.mu);
+    auto& slot = s.sessions[owner];
+    if (!slot)
+      slot = std::make_unique<SfxSession>();
+    session = slot.get();
+    if (new_request) {
+      SfxFlushLocked(*session);
+      session->key = SfxHarnessKey(tokens);
+      session->recorded = tokens.size();
+    } else if (SfxGlobalEnabled()) {
+      if (tokens.size() < session->recorded) {
+        session->recorded = tokens.size();
+      } else {
+        for (std::size_t i = session->recorded;
+             i < tokens.size() && session->output.size() < kSfxMaxOutput; ++i)
+          session->output.push_back(tokens[i]);
+        session->recorded = tokens.size();
+      }
+    }
+  }
+  if (session->local.Sync(tokens))
+    g_sfx_rebuilds.fetch_add(1);
+  g_sfx_cycles.fetch_add(1);
+  return session;
+}
+
+void SfxRelease(const void* owner) {
+  if (!SfxEnabled())
+    return;
+  auto& s = Sfx();
+  std::lock_guard<std::mutex> lock(s.mu);
+  const auto it = s.sessions.find(owner);
+  if (it == s.sessions.end())
+    return;
+  SfxFlushLocked(*it->second);
+  s.sessions.erase(it);
+}
