+DraftGuardStatus DraftGuardSnapshot() noexcept {
+  auto& g = GuardGlobals();
+  return {g.disabled.load(), g.checks.load(), g.mismatches.load(),
+          g.collapses.load(), g.self_test_failures.load()};
+}
