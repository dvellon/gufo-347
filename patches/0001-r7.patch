+// The probe: Start() after the caller queued SignalDone(flag, want); Finish() right after the sync returned.
+class Watch {
+ public:
+  Watch() = default;
+  Watch(const Watch&) = delete;
+  Watch& operator=(const Watch&) = delete;
+  ~Watch() {
+    if (thread_.joinable())
+      thread_.join();
+  }
+  void Start(const std::uint32_t* flag, std::uint32_t want, std::uint32_t rows) {
+    rows_ = rows;
+    seen_ns_.store(0, std::memory_order_relaxed);
+    thread_ = std::thread([this, flag, want] {
+      const volatile std::uint32_t* f = flag;
+      const std::int64_t give_up = NowNs() + 5'000'000'000LL;
+      while (*f != want) {
+        if (NowNs() > give_up)
+          return;
+        std::this_thread::yield();
+      }
+      seen_ns_.store(NowNs(), std::memory_order_release);
+    });
+    call_ns_ = NowNs();
+    active_ = true;
+  }
+  void Finish() {
+    if (!active_)
+      return;
+    const std::int64_t ret = NowNs();
+    thread_.join();
+    active_ = false;
+    static std::atomic<std::uint64_t> rounds{0};
+    const std::uint64_t n = rounds.fetch_add(1, std::memory_order_relaxed) + 1;
+    const std::int64_t seen = seen_ns_.load(std::memory_order_acquire);
+    std::fprintf(stderr,
+                 "event=w3vf_wake round=%llu rows=%u sync_us=%.1f wake_us=%.1f "
+                 "seen=%d\n",
+                 static_cast<unsigned long long>(n), rows_,
+                 static_cast<double>(ret - call_ns_) / 1e3,
+                 seen != 0 ? static_cast<double>(ret - seen) / 1e3 : -1.0,
+                 seen != 0 ? 1 : 0);
+    std::fflush(stderr);
+  }
+
+ private:
+  std::thread thread_;
+  std::atomic<std::int64_t> seen_ns_{0};
+  std::int64_t call_ns_ = 0;
+  std::uint32_t rows_ = 0;
+  bool active_ = false;
+};
