+// Wave3 A1: Session side of the lazy frontier (see the codec above).
+void Session::A1SetFrontier(std::int32_t index, float value,
+                            std::span<const std::uint8_t> x) {
+  if (!A1Encode(logits_, index, value, x))
+    throw std::logic_error("A1 frontier does not fit the logits row");
+}
+
+bool Session::A1MaterializeFrontier(std::string* error_msg) {
+  A1Encoded encoded;
+  if (!A1Decode(logits_, &encoded))
+    return true;
+  const std::vector<std::uint8_t> x(encoded.x.begin(), encoded.x.end());
+  auto& exec = *model_->executor_;
+  if (!exec.A1MaterializeRow(x, logits_.data(), error_msg))
+    return false;
+  // The materialized row is the production frontier; the screened argmax that
+  // earlier selections may have used must be its argmax, bit for bit.
+  const auto row = HostArgmax(logits_);
+  if (w3af::AnyArgmax() && (row.index != encoded.index ||
+                            A1Bits(row.value) != A1Bits(encoded.value))) {
+    // Engine-audit follow-ups #5/#6 share the encoding: stop staging too
+    // (knobs unset: not reached, the production statements below).
+    exec.AfDisable("frontier_mismatch");
+  }
+  if (row.index != encoded.index || A1Bits(row.value) != A1Bits(encoded.value))
+    exec.DisableA1("frontier_mismatch screened=" +
+                   std::to_string(encoded.index) + "/" +
+                   GuardFloat(encoded.value) +
+                   " row=" + std::to_string(row.index) + "/" +
+                   GuardFloat(row.value));
+  return true;
+}
+
+void Session::A1EnsureLogits() const {
+  std::string error;
+  if (!const_cast<Session*>(this)->A1MaterializeFrontier(&error))
+    throw std::runtime_error("A1 frontier materialization failed: " + error);
+}
+
+bool Session::SampleAnchor(sampling::SamplerState& sampler,
+                           std::int32_t* anchor, std::string* error_msg) {
+  A1Encoded encoded;
+  if (A1Decode(logits_, &encoded)) {
+    const auto selection = A1Select(sampler);
+    if (selection == A1Selection::kArgmax && encoded.index >= 0 &&
+        std::isfinite(encoded.value)) {
+      sampler.config().Validate();
+      // SampleGreedy over the full row: its lowest-index finite maximum.
+      *anchor = encoded.index;
+      return true;
+    }
+    // a1-tool (GUFO_A1_TOOL): an armed tool-grammar frontier. The screened
+    // argmax is the anchor iff ScreenedPick passes (CanSelectArgmax: then it
+    // is exactly the masked greedy selection); otherwise the production row
+    // and the production Sample. Check mode (2) always takes the latter.
+    if (selection == A1Selection::kNeedsRow && w3a1t::On() &&
+        w3a1t::ArmableConstraint(sampler.config().constraint.get(),
+                                 w3a1t::Closed())) {
+      auto& a1t = w3a1t::GetStats();
+      sampler.config().Validate();
+      const auto pick = w3a1t::ScreenedPick(sampler, encoded.index,
+                                            encoded.value, logits_.size());
+      if (pick && w3a1t::EnvKnob().mode == w3a1t::Mode::kOn) {
+        w3a1t::Note(a1t.screened);
+        *anchor = static_cast<std::int32_t>(*pick);
+        return true;
+      }
+      if (!A1MaterializeFrontier(error_msg))
+        return false;
+      *anchor = static_cast<std::int32_t>(sampler.Sample(logits_));
+      if (pick) {
+        w3a1t::NoteCheck(static_cast<std::int32_t>(*pick), *anchor);
+      } else {
+        w3a1t::Note(a1t.materialized);
+        if (w3a1t::ProductionPickRefused(
+                sampler, static_cast<sampling::TokenId>(*anchor)))
+          w3a1t::MarkClosed(sampler.config().constraint->grammar.get());
+      }
+      return true;
+    }
+    if (selection != A1Selection::kContentFree &&
+        !A1MaterializeFrontier(error_msg))
+      return false;
+  }
+  *anchor = static_cast<std::int32_t>(sampler.Sample(logits_));
+  return true;
+}
+
+// Engine-audit follow-ups #5/#6, check mode: production statements decided
+// this cycle; compare what the staged pass would have supplied.
+void Session::AfCheckPredictions(
+    std::span<const rocm::ArgmaxCandidate> production) const {
+  auto& exec = *model_->executor_;
+  std::array<rocm::ArgmaxCandidate, kMaxMtpDraftTokens> staged{};
+  const auto rows = production.size();
+  // A pass that staged nothing (AfUsable/AfEnsureStaging refused it, or its
+  // head had no Q8_1 rows) is counted in fallbacks only: there is nothing to
+  // compare. A staged pass whose rows are missing is a mismatch.
+  const bool staged_pass = exec.AfPass();
+  const bool taken = rows <= staged.size() &&
+                     exec.AfTakePredictions(0, std::span(staged).first(rows));
+  if (!staged_pass)
+    return;
+  bool match = taken;
+  std::size_t first_bad = 0;
+  for (std::size_t i = 0; match && i < rows; ++i)
+    if (staged[i].index != production[i].index ||
+        A1Bits(staged[i].value) != A1Bits(production[i].value)) {
+      match = false;
+      first_bad = i;
+    }
+  exec.AfNoteCheck(
+      "predictions", match,
+      "rows=" + std::to_string(rows) +
+          (match ? std::string()
+           : !taken
+               ? std::string(" undelivered=1")
+               : " row=" + std::to_string(first_bad) +
+                     " staged=" + std::to_string(staged[first_bad].index) +
+                     "/" + GuardFloat(staged[first_bad].value) +
+                     " production=" +
+                     std::to_string(production[first_bad].index) + "/" +
+                     GuardFloat(production[first_bad].value)));
+}
+
+void Session::AfCheckFrontier(std::uint32_t row) const {
+  auto& exec = *model_->executor_;
+  if (!exec.AfPass())
+    return;  // nothing staged this cycle (see AfCheckPredictions)
+  rocm::Executor::A1Frontier staged;
+  if (!exec.AfStagedFrontier(row, &staged)) {
+    exec.AfNoteCheck("frontier_staged", false, "row=" + std::to_string(row));
+    return;
+  }
+  A1Encoded encoded;
+  if (A1Decode(logits_, &encoded))
+    return;  // an A1-encoded production frontier: nothing to compare
+  const auto pick = HostArgmax(logits_);
+  const bool pick_ok =
+      pick.index == staged.index && A1Bits(pick.value) == A1Bits(staged.value);
+  std::vector<float> materialized(logits_.size());
+  std::string error;
+  const bool built =
+      exec.AfMaterializeRow(staged.x, materialized.data(), &error);
+  const bool row_ok = built && std::memcmp(materialized.data(), logits_.data(),
+                                           logits_.size() * sizeof(float)) == 0;
+  exec.AfNoteCheck("frontier", pick_ok && row_ok,
+                   "row=" + std::to_string(row) +
+                       " pick_ok=" + std::to_string(pick_ok ? 1 : 0) +
+                       " row_bitwise=" + std::to_string(row_ok ? 1 : 0) +
+                       (built ? std::string() : " error=" + error));
+}
+
+std::optional<std::int32_t> Session::A1GreedyToken(
+    const sampling::SamplerState& sampler) const {
+  A1Encoded encoded;
+  if (!valid_ || !A1Decode(logits_, &encoded) ||
+      A1Select(sampler) != A1Selection::kArgmax || encoded.index < 0 ||
+      !std::isfinite(encoded.value))
+    return std::nullopt;
+  sampler.config().Validate();
+  return encoded.index;
+}
+
 struct Session::PendingDecode {
   std::vector<std::int32_t> chain;
   std::vector<MtpProposal> proposals;
   std::uint32_t base{0};
   bool speculative{false};
+  /// A known forced reasoning suffix executed as a bounded target batch.
+  bool forced_sequence{false};
+  /// The forced batch exhausts the known suffix, so its last target row must
