+                 "prefix=%u q2_bytes=%zu q2_mb=%.2f build_ms=%.1f state=%s%s%s port=q2live-226\n",
+                 w3q2l::ModeName(cfg.mode), cfg.requested.c_str(), cfg.check ? 1 : 0, cfg.check_requested.c_str(),
+                 cfg.valid && cfg.check_valid ? 1 : 0, w3q2l::kK, static_cast<unsigned>(w.rows),
+                 static_cast<unsigned>(draft.rows), d.q2_bytes, static_cast<double>(d.q2_bytes) / 1.0e6, d.build_ms,
+                 state, why.empty() ? "" : " error=", why.c_str());
