+// ---------------------------------------------------------------------------
+// Wave3 draft-collapse guard (draft-collapse).
+// Greedy verification accepts drafts against the GPU argmax predictions that
+// Executor::GreedyMtpPredictions reads back, while the committed frontier row
+// reaches the host through Rollback's mapped copy and is sampled there as the
+// next anchor. For a cycle that ended on a draft mismatch, the prediction for
+// the frontier row and that anchor are the same function (lowest-index finite
+// maximum) of the same bits, unless penalties, a constraint, or a forced or
+// deferred token change the host selection; those cases are never compared.
+// A disagreement therefore means the prediction readback was wrong. Three in
+// a row switch the process to plain (non-speculative) decode until restart.
+namespace {
+
+struct DraftGuardGlobals {
+  std::atomic<bool> disabled{false};
+  std::atomic<std::uint32_t> consecutive{0};
+  std::atomic<std::uint64_t> checks{0};
+  std::atomic<std::uint64_t> mismatches{0};
+  std::atomic<std::uint64_t> collapses{0};
+  std::atomic<std::uint64_t> self_test_failures{0};
+  std::atomic<std::uint64_t> requests{0};
+  std::atomic<DraftGuardLog> log{nullptr};
+};
+
+DraftGuardGlobals& GuardGlobals() {
+  static DraftGuardGlobals globals;
+  return globals;
+}
+
+void GuardLog(int level, const std::string& message) {
+  if (const auto log = GuardGlobals().log.load(std::memory_order_acquire)) {
+    log(level, message);
+    return;
+  }
+  std::fprintf(stderr, "%s [mtp] %s\n",
+               level >= 2   ? "[ERROR]"
+               : level == 1 ? "[WARN]"
+                            : "[INFO]",
+               message.c_str());
+  std::fflush(stderr);
+}
+
+std::string GuardFloat(float value) {
+  char text[32];
+  std::snprintf(text, sizeof(text), "%.9g", static_cast<double>(value));
+  return text;
+}
+
+bool SpeculationDisabled() {
+  return GuardGlobals().disabled.load(std::memory_order_relaxed);
+}
+
+void DisableSpeculation(std::string_view reason, const std::string& detail) {
+  auto& g = GuardGlobals();
+  if (g.disabled.exchange(true))
+    return;
+  GuardLog(2, "event=draft_verification_disabled reason=" +
+                  std::string(reason) + " remedy=restart mode=plain_decode " +
+                  detail + " checks=" + std::to_string(g.checks.load()) +
+                  " mismatches=" + std::to_string(g.mismatches.load()));
+}
+
+struct PredictionFault {
+  bool zero{false};
+  std::uint64_t after{0};
+};
+
+/// Test hook (a simulated H1): GUFO_W3_FAULT_PREDICTIONS=zero zeroes the
+/// greedy predictions after their readback for every request after the first
+/// GUFO_W3_FAULT_AFTER (default 0) requests that reached decode.
+const PredictionFault& Fault() {
+  static const PredictionFault fault = [] {
+    PredictionFault f;
+    const char* mode = std::getenv("GUFO_W3_FAULT_PREDICTIONS");
+    if (mode == nullptr || std::string_view(mode) != "zero")
+      return f;
+    f.zero = true;
+    if (const char* after = std::getenv("GUFO_W3_FAULT_AFTER"))
+      f.after = std::strtoull(after, nullptr, 10);
+    GuardLog(1, "event=fault_injection predictions=zero after_requests=" +
+                    std::to_string(f.after));
+    return f;
+  }();
+  return fault;
+}
+
+/// Four fixed elements' bits: a different frontier row (restore, re-sync)
+/// is never compared with a stale prediction.
+std::array<std::uint32_t, 4> LogitsFingerprint(std::span<const float> logits) {
+  std::array<std::uint32_t, 4> bits{};
+  if (logits.empty())
+    return bits;
+  // Wave3 A1: a screened frontier is identified by its encoding.
+  A1Encoded a1;
+  if (A1Decode(logits, &a1))
+    return {kA1Signature[0], static_cast<std::uint32_t>(a1.index),
+            A1Bits(a1.value), a1.serial};
+  const std::size_t n = logits.size();
+  const std::array<std::size_t, 4> at{0, n / 3, 2 * n / 3, n - 1};
+  for (std::size_t i = 0; i < at.size(); ++i)
+    std::memcpy(&bits[i], &logits[at[i]], sizeof(float));
+  return bits;
+}
+
+struct HostArgmaxResult {
+  std::int32_t index{-1};
+  float value{0.0F};
+};
+
+/// Lowest-index finite maximum: the GPU argmax's and SampleGreedy's rule.
+HostArgmaxResult HostArgmax(std::span<const float> row) {
+  HostArgmaxResult best;
+  for (std::size_t i = 0; i < row.size(); ++i)
+    if (std::isfinite(row[i]) && (best.index < 0 || row[i] > best.value))
+      best = {static_cast<std::int32_t>(i), row[i]};
+  return best;
+}
