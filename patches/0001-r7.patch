+  std::fprintf(stderr,
+               "event=xm_stats why=%s requests=%llu split_steps=%llu "
+               "split_groups=%llu units_strict=%llu units_relaxed=%llu "
+               "units_approximate=%llu approx_active_units=%llu "
+               "stub_units=%llu\n",
+               why, static_cast<unsigned long long>(g_xm_requests.load()),
