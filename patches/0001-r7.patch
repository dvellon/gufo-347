+/// next anchor SampleAnchor takes as the frontier's argmax (A1Select
+/// kArgmax): greedy, no penalties, no constraint.
+bool AfArgmaxRequest(const sampling::SamplerState& sampler) {
+  const auto& config = sampler.config();
+  return config.temperature == 0.0F && !config.penalties_enabled() &&
+         !config.constraint && !config.logprobs;  // rebase-272: #814
+}
