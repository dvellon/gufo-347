+#ifndef GUFO_MODELS_QWEN38_FLASH_NEXT_XM_RELAXED_POLICY_HPP_
+#define GUFO_MODELS_QWEN38_FLASH_NEXT_XM_RELAXED_POLICY_HPP_
+
+// Wave3 XM (exactness-mode): the drafting
+// policy by exactness level. These two tables are the ONE place it lives.
+//   kXmRelaxedDefaults  what a drafting feature is configured to when its knob
+//                       is unset. Knobs still override for tests ("0" forces
+//                       off, any other non-empty value forces on;
+//                       GUFO_DRAFT_VOCAB_WINDOW=N sets the window).
+//   kXmStrictAdmitted   which features STRICT requests may use: a feature is
+//                       admitted after it passed the strict gate (outputs ==
+//                       the no-speculation reference) on a build where row
+//                       bits do not depend on draft geometry (R3-20). Strict
+//                       uses an admitted feature only while
+//                       xm::PositionOnlySparseRows() is true; otherwise strict
+//                       = production's drafting policy.
+// RELAXED and APPROXIMATE requests use every configured feature.
+#include <cstddef>
+
+namespace gufo::models::qwen38_flash_next {
+
+struct XmRelaxedDefaults {
+  bool h1;                   ///< GUFO_H1: small head + confidence stop, greedy constrained requests
+  bool b5;                   ///< GUFO_B5: B5 v2 margin stop (floor 1.25, hide inf, solo gate)
+  std::size_t vocab_window;  ///< GUFO_DRAFT_VOCAB_WINDOW: PA8 window; 0 = production (32)
+  bool sfx;                  ///< GUFO_SFX: suffix drafter, local (session) index
+  bool sfx_batch;            ///< GUFO_SFX_BATCH: suffix drafter in planned batched rounds
+  bool sfx_global;           ///< GUFO_SFX_GLOBAL: per-harness global output cache
+};
+
+inline constexpr XmRelaxedDefaults kXmRelaxedDefaults{
+    .h1 = true,           // h1-002 constrained stage PASS (exact)
+    .b5 = true,           // b5v2 ab-001 PASS (exact all stages)
+    .vocab_window = 0,    // TODO-from-008 (PA8): 8 if run_stack2 --decide says default ON
+    .sfx = false,         // TODO-from-008 (sfx local): true if KEEP
+    .sfx_batch = false,   // TODO-from-008 (sfxb): true if KEEP
+    .sfx_global = false,  // TODO-from-008 (sfxg): never on canonical traffic
+};
+
+/// Strict admission per feature (same fields; vocab_window = PA8 admitted).
+struct XmStrictAdmission {
+  bool h1;
+  bool b5;
+  bool vocab_window;
+  bool sfx;
+  bool sfx_batch;
+  bool sfx_global;
+};
+
+inline constexpr XmStrictAdmission kXmStrictAdmitted{
+    .h1 = true,             // queue 130 strict gate (h1b5st-cg); GUFO_H1=0 = off
+    .b5 = true,             // queue 130 strict gate (h1b5st-cg); GUFO_B5=0 = off
+    .vocab_window = false,  // TODO-from-gate (PA8)
+    .sfx = false,           // TODO-from-gate
+    .sfx_batch = false,     // TODO-from-gate
+    .sfx_global = false,    // TODO-from-gate (never canonical traffic)
+};
+
+/// Whether a drafting feature configured `on` applies to a request: relaxed
+/// and approximate as configured; strict only if admitted and R3-20 holds.
+[[nodiscard]] constexpr bool XmDraftingOn(bool strict, bool on, bool admitted,
+                                          bool position_only_sparse) noexcept {
+  return on && (!strict || (admitted && position_only_sparse));
+}
+
+/// A relaxed on/off knob: unset or empty = `fallback` (the table), "0" = off,
+/// any other value = on.
+[[nodiscard]] constexpr bool XmRelaxedKnob(const char* value,
+                                           bool fallback) noexcept {
+  if (value == nullptr || *value == '\0')
+    return fallback;
+  return !(value[0] == '0' && value[1] == '\0');
+}
+
+}  // namespace gufo::models::qwen38_flash_next
+
+#endif  // GUFO_MODELS_QWEN38_FLASH_NEXT_XM_RELAXED_POLICY_HPP_
