--- /dev/null
+++ b/src/models/qwen38_flash_next/kernels/rocm/w3af_followups.h
@@ -0,0 +1,146 @@
+// Engine-audit follow-ups #5 / #6 (lab-notes/cloud/audit-followups.md; audit
+// items of lab-notes/cloud/engine-audit.md), combo-c4 member b2-af: the #5/#6
+// part of cloud2-206's header (#4 tile map and #7 snapshot batching are not in
+// this build). Shared by executor.cpp, batch.cpp, engine.cpp and the CPU test
+// (combo-c4/members/b2-af/dell-check/w3af_b2af_test.cpp). Host-only.
+//
+// Knobs (read once per process, at Model::Load; unset, "" and "0" keep every
+// production statement):
+//   GUFO_AF_VERIFY_ARGMAX=1|2  #5: a greedy C1 verify pass argmaxes all k rows
+//                              and stages each row's Q8_1 head input before
+//                              its done flag. FinishDecode reads the staged
+//                              predictions (no GreedyMtpPredictions launch /
+//                              wait). The frontier stays lazy (A1 encoding)
+//                              and Rollback skips its 993 KB download.
+//                              2 = check: production statements decide; the
+//                              staged predictions and a materialized frontier
+//                              are compared with them (logged).
+//   GUFO_AF_BATCH_ARGMAX=1|2   #6: the same for C8: one batched argmax over
+//                              every row of ForwardBatch; rollbacks of the
+//                              batch's lazy-frontier sessions defer their wait
+//                              to one Wait at the end of DecodeBatchImpl.
+//                              2 = check, as above.
+// One line per knob: event=w3af_knob name=<NAME> value=<N>.
+#ifndef W3AF_FOLLOWUPS_H_
+#define W3AF_FOLLOWUPS_H_
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+namespace w3af {
+
+// ---- knobs
+// -------------------------------------------------------------------------------------------------
+constexpr int kKnobInvalid = -1;
+
+/// Unset / "" / "0" = 0; "1".."max_value" (one digit) = that value; anything
+/// else is invalid.
+constexpr int ParseKnob(const char* v, int max_value) {
+  if (v == nullptr || v[0] == '\0')
+    return 0;
+  if (v[1] != '\0' || v[0] < '0' || v[0] > '9')
+    return kKnobInvalid;
+  const int value = v[0] - '0';
+  return value <= max_value ? value : kKnobInvalid;
+}
+
+inline int ReadKnob(const char* name, int max_value) {
+  const char* raw = std::getenv(name);
+  int value = ParseKnob(raw, max_value);
+  if (value == kKnobInvalid) {
+    std::fprintf(stderr, "event=w3af_knob_invalid name=%s value=%s using=0\n",
+                 name, raw);
+    value = 0;
+  }
+  std::fprintf(stderr, "event=w3af_knob name=%s value=%d\n", name, value);
+  std::fflush(stderr);
+  return value;
+}
+
+/// 0 off, 1 on, 2 check.
+inline int VerifyArgmax() {
+  static const int mode = ReadKnob("GUFO_AF_VERIFY_ARGMAX", 2);
+  return mode;
+}
+/// 0 off, 1 on, 2 check.
+inline int BatchArgmax() {
+  static const int mode = ReadKnob("GUFO_AF_BATCH_ARGMAX", 2);
+  return mode;
+}
+/// #5 or #6 set (either mode): staged encodings may exist in this process.
+inline bool AnyArgmax() { return VerifyArgmax() != 0 || BatchArgmax() != 0; }
+constexpr int kModeOn = 1;
+constexpr int kModeCheck = 2;
+
+// ---- #5 / #6 staged greedy predictions
+// -----------------------------------------------------------------------
+/// The host writes this index into every staged prediction slot before arming a
+/// pass; the pass's mapped copy overwrites it. A slot that still holds it (or
+/// holds anything outside the vocabulary, or a non-finite value) was not
+/// delivered, and the round takes the production statements.
+constexpr std::int32_t kStagedSentinel = -0x5AF;
+template<typename Candidate>
+constexpr void ArmStaged(Candidate* staged, std::uint32_t rows) {
+  for (std::uint32_t r = 0; r < rows; ++r) {
+    staged[r].value = 0.0F;
+    staged[r].index = kStagedSentinel;
+  }
+}
+template<typename Candidate>
+inline bool StagedValid(const Candidate* staged, std::uint32_t rows,
+                        std::uint32_t vocab) {
+  for (std::uint32_t r = 0; r < rows; ++r)
+    if (staged[r].index < 0 ||
+        static_cast<std::uint32_t>(staged[r].index) >= vocab ||
+        !std::isfinite(staged[r].value))
+      return false;
+  return true;
+}
+/// A session's rows [offset, offset + rows) inside a staged batch of `total`
+/// rows.
+constexpr bool SliceInside(std::uint32_t offset, std::uint32_t rows,
+                           std::uint32_t total) {
+  return rows != 0 && offset <= total && rows <= total - offset;
+}
+
+/// SampleGreedy's and the GPU argmax's rule: the lowest index of the finite
+/// maximum (-1 if none is finite).
+struct HostPick {
+  std::int32_t index;
+  float value;
+};
+inline HostPick LowestFiniteMax(const float* row, std::size_t n) {
+  HostPick best{-1, 0.0F};
+  for (std::size_t i = 0; i < n; ++i)
+    if (std::isfinite(row[i]) && (best.index < 0 || row[i] > best.value))
+      best = {static_cast<std::int32_t>(i), row[i]};
+  return best;
+}
+
+// ---- #6 deferred rollback waits
+// ------------------------------------------------------------------------------
+/// One batch's deferred rollback completions: Rollback calls Defer() instead of
+/// waiting; the batch end calls Take() and waits once when it returns true.
+/// Nothing is left pending past the batch.
+struct DeferredWaits {
+  std::uint32_t pending{0};
+  std::uint64_t deferred_total{0};
+  std::uint64_t batch_waits{0};
+  void Defer() {
+    ++pending;
+    ++deferred_total;
+  }
+  bool Take() {
+    const bool any = pending != 0;
+    pending = 0;
+    batch_waits += any ? 1 : 0;
+    return any;
+  }
+};
+
+}  // namespace w3af
+
+#endif  // W3AF_FOLLOWUPS_H_
diff --git a/src/models/qwen38_flash_next/kernels/rocm/w3cq_perm.hpp b/src/models/qwen38_flash_next/kernels/rocm/w3cq_perm.hpp
new file mode 100644
--- /dev/null
+++ b/src/models/qwen38_flash_next/kernels/rocm/w3cq_perm.hpp
@@ -0,0 +1,84 @@
+// Wave3 COMBO-C1 (combo-c1): the composition of queue 192's permuted draft
+// prefix (GUFO_DRAFT_PERM, w3perm_draft.hpp) with queue 226c's Q2 screen of the small-head readout (GUFO_Q2_SCREEN,
+// w3q2l.hpp / w3q2l_top2.hpp). Each knob keeps its own meaning; this header only decides WHICH ROWS a screened call
+// screens and rescores when both are on.
+//
+// With GUFO_DRAFT_PERM the small head is a resident permuted Q8 copy (row r = the head row of token map[r]; 192's
+// DraftLogits / DenseBatch read it, RemapDraftIds maps through (0, map + table)). 226c alone screens the head's own
+// leading 49,152 rows and rescores against the head itself, which under the perm would (a) screen and rescore the
+// UNPERMUTED rows (row r = token r), (b) remap with (prefix, table), i.e. propose dropped tokens 192 removed from the
+// prefix (a dropped token may also sit in the session table: a duplicate id in a top-2 list) and never propose the
+// 13,063 src tokens, and (c) make GUFO_Q2_CHECK compare screened head-row indices with 192's permuted-index production
+// logits (bit / id differences on every swapped row). Composed (this header), a small-head screened call reads:
+//   the PERMUTED Q2 copy (Perm2: row r = the 226 full Q2 copy's row map[r], built by D2D row copies at load, bitwise),
+//   the PERMUTED Q8 copy for the exact rescore (w3perm::Find(owner)->head = the rows 192's DraftLogits GEMV reads),
+// and the callers remap with w3perm::Remap (unchanged 192 helper). Full-head calls keep 226's statements (the full Q2
+// copy, the head; 192 never permutes the full head). Unset knobs: Use() == w3q2l::Use() and Rows() == 226's rows.
+#ifndef GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_W3CQ_PERM_HPP_
+#define GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_W3CQ_PERM_HPP_
+
+#include <cstddef>
+#include <cstdint>
+
+#include "src/models/qwen38_flash_next/kernels/rocm/w3q2l.hpp"
+#include "src/models/qwen38_flash_next/w3perm_draft.hpp"
+
+namespace w3cq {
+
+/// The permuted Q2 copy of one executor's permuted small head (Executor::Create, after W3q2lSetup; the memory belongs to
+/// w3q2l::Dev().owned, so w3q2l::Teardown frees it and ~Executor calls Forget).
+struct PermQ2 {
+  const void* owner = nullptr;      ///< the executor whose w3perm head this copy mirrors
+  std::uint8_t* codes = nullptr;    ///< [kMtpDraftVocab][640] Q2 codes, row r = the full copy's row map[r]
+  std::uint16_t* scales = nullptr;  ///< [kMtpDraftVocab][40] f16 scales, same rows
+  std::size_t bytes = 0;            ///< codes + scales
+  double build_ms = 0.0;
+};
+
+inline PermQ2& Perm2() {
+  static PermQ2 p;
+  return p;
+}
+
+/// A screened call of `width` rows for executor `owner`: 226's rule (knob covers the width, the Q2 copy is resident)
+/// AND, when `owner` holds a 192 permuted head, the permuted Q2 copy is resident for it (else production statements:
+/// never a screen over the unpermuted prefix under the perm). Process-constant after load (captured graphs stay valid).
+inline bool Use(std::uint32_t width, const void* owner) {
+  if (!w3q2l::Use(width))
+    return false;
+  if (gufo::models::qwen38_flash_next::w3perm::Find(owner) == nullptr)
+    return true;
+  const PermQ2& p = Perm2();
+  return p.owner == owner && p.codes != nullptr && p.scales != nullptr;
+}
+
+/// The rows a screened call screens (Q2 codes / scales) and rescores exactly (Q8_0 rows; ids index them).
+struct Source {
+  const std::uint8_t* codes;
+  const std::uint16_t* scales;
+  const void* q8;
+};
+
+/// small = the call reads the small head (draft subset: the 49,152 prefix rows + the session table). With a permuted
+/// head for `owner`: the permuted Q2 copy + the permuted Q8 copy. Otherwise 226's: the Q2 copy of the head's rows + the
+/// head (`head_q8` = model output().data).
+inline Source Rows(bool small, const void* head_q8, const void* owner) {
