+#ifndef GUFO_CORE_EXACTNESS_HPP_
+#define GUFO_CORE_EXACTNESS_HPP_
+
+// Wave3 XM (exactness-mode): exactness levels.
+//
+//   strict       exactly the model's own output: what it produces with
+//                drafting OFF (the --speculative off reference), on the same
+//                cache path. Drafting changes are admitted to strict only
+//                when verified-row bits no longer depend on draft geometry
+//                (PositionOnlySparseRows(), set by R3-20) and the feature
+//                passed its strict gate (xm_relaxed_policy.hpp
+//                kXmStrictAdmitted); otherwise strict runs production's
+//                drafting policy. Sampled requests: drafting changes RNG
+//                consumption, so strict means the identical output
+//                DISTRIBUTION (as production already guarantees).
+//   relaxed      passes the near-tie test against the no-speculation
+//                reference (every divergence starts where its top-2 logit
+//                gap is a near-tie) but is not bit-exact: the drafting
+//                stack configured by its knobs, ulp-level kernel changes,
+//                approximate drafting decisions.
+//   approximate  relaxed + approximate-only numerics (decode-only features
+//                such as lower-precision weight copies) that may change
+//                outputs beyond near-ties, within a quality budget.
+//
+// Server policy: --exactness (default level of a request without the field)
+// and --exactness-max (highest level a request may get; also what the server
+// prepares: approximate-only allocations happen only when it is approximate).
+//
+// FEATURE CONTRACT (approximate-only features, e.g. approx-r2):
+//   * load time: allocate/prepare only if ApproximateAllowed() and the
+//     feature's own environment knob is set. SetServerPolicy() runs before the
+//     model loads; anything else (bench, prompt, tests) leaves it strict.
+//   * dispatch time: use the approximate path for a forward only if
+//     ApproximateActive() is true on the calling thread. The engine opens a
+//     ForwardLevelScope around every decode/advance work unit (Session::
+//     DecodeStep, DecodeBatch sub-steps, Evaluate, EvaluateBatch sub-steps)
+//     with the level of ALL its sessions: one work unit never mixes levels,
+//     so a batch-wide switch is allowed. Prefill (Sync*, PrefillBatch) and
+//     DecodeDraftStep always run at kStrict. Worker threads do not inherit
+//     the level: capture it on the dispatching thread.
+//   * strict and relaxed requests never see ApproximateActive() == true.
+//   * prefill-side features use ApproximatePrefillActive() instead: the
+//     backend opens a PrefillLevelScope around every prefill work unit (Sync,
+//     SyncThrough*, each level-homogeneous PrefillBatch sub-batch) with the
+//     request's level, set per request, never per chunk.
+//   * register the feature's tag at load (RegisterApproximateFeature, e.g.
+//     "r2v1"): approximate-produced cache state is keyed by the feature set.
+//
+// CACHE ISOLATION: every prefix-cache entry, checkpoint and live frontier of a
+// request is keyed with NumericsTag(level) (appended to the prompt context's
+// cache identities by the model runner). Strict's tag is empty, so strict
+// keys are production's keys; levels never reuse each other's state.
+#include <atomic>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace gufo::xm {
+
+enum class ExactnessLevel : std::uint8_t {
+  kStrict = 0,
+  kRelaxed = 1,
+  kApproximate = 2,
+};
+
+[[nodiscard]] constexpr std::string_view ExactnessName(
+    ExactnessLevel level) noexcept {
+  switch (level) {
+    case ExactnessLevel::kStrict:
+      return "strict";
+    case ExactnessLevel::kRelaxed:
+      return "relaxed";
+    case ExactnessLevel::kApproximate:
+      return "approximate";
+  }
+  return "strict";
+}
+
+/// HTTP header alternative to the body field (clients that cannot add body
+/// fields, e.g. Claude Code via ANTHROPIC_BASE_URL); the body field wins.
+inline constexpr std::string_view kExactnessHeader = "x-gufo-exactness";
+
+[[nodiscard]] constexpr std::optional<ExactnessLevel> ParseExactnessLevel(
+    std::string_view text) noexcept {
+  if (text == "strict")
+    return ExactnessLevel::kStrict;
+  if (text == "relaxed")
+    return ExactnessLevel::kRelaxed;
+  if (text == "approximate")
+    return ExactnessLevel::kApproximate;
+  return std::nullopt;
+}
