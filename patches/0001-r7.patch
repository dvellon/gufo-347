+    b.set = true;
+    b.error = "unreadable";
+    return b;
+  }
+  const std::string text((std::istreambuf_iterator<char>(f)),
+                         std::istreambuf_iterator<char>());
+  if (text.size() > (std::size_t{1} << 20)) {
+    MtpDraftStaticBlock b;
+    b.set = true;
+    b.error = "too_large";
+    return b;
+  }
+  return ParseMtpDraftStatic(text);
