+template <class T, std::size_t N>
+std::size_t SfxBucket(const T (&edges)[N], T x) {
+  // bisect_right(edges, x) - 1
+  std::size_t i = 0;
+  while (i < N && edges[i] <= x)
+    ++i;
+  return i == 0 ? 0 : i - 1;
+}
+
+double SfxProbability(int src, std::size_t length, double frac, std::size_t support) {
+  const std::size_t l = SfxBucket(kSfxL, length), f = SfxBucket(kSfxF, frac),
+                    s = SfxBucket(kSfxS, support);
+  return kSfxP[((static_cast<std::size_t>(src) * kSfxNL + l) * kSfxNF + f) * kSfxNS + s];
+}
+
+std::uint64_t SfxKey(std::int32_t a, std::int32_t b, std::int32_t c) {
+  const auto u = [](std::int32_t t) {
+    return static_cast<std::uint64_t>(static_cast<std::uint32_t>(t)) & 0x1FFFFFULL;
+  };
+  return (u(a) << 42) | (u(b) << 21) | u(c);
+}
+
+/// 3-gram key -> newest end, plus prev[end] chaining older ends of the same
+/// key (newest-first walk, as prompt lookup). Open addressing, half full.
+class SfxIndex {
+ public:
+  void Clear() {
+    std::fill(keys_.begin(), keys_.end(), kEmpty);
+    size_ = 0;
+    prev_.clear();
+    buf_.clear();
+  }
+  void Push(std::int32_t token) {
+    const auto end = static_cast<std::uint32_t>(buf_.size());
+    buf_.push_back(token);
+    prev_.push_back(end >= 3 ? Exchange(SfxKey(buf_[end - 3], buf_[end - 2],
+                                               buf_[end - 1]),
+                                        end)
+                             : kSfxNone);
+  }
+  /// Follows a token history: extends it, or rebuilds when `tokens` is not
+  /// an extension of what was indexed (reset/restored sessions).
+  bool Sync(std::span<const std::int32_t> tokens) {
+    const std::size_t n = buf_.size();
+    bool rebuilt = false;
+    if (tokens.size() < n ||
+        (n != 0 && (tokens[n - 1] != buf_[n - 1] || tokens[n / 2] != buf_[n / 2] ||
+                    tokens[0] != buf_[0]))) {
+      Clear();
+      rebuilt = true;
+    }
+    buf_.reserve(tokens.size());
+    for (std::size_t i = buf_.size(); i < tokens.size(); ++i)
+      Push(tokens[i]);
+    return rebuilt;
+  }
+  [[nodiscard]] std::uint32_t Head(std::uint64_t key) const {
+    if (size_ == 0)
+      return kSfxNone;
+    for (std::size_t i = Slot(key);; i = (i + 1) & (keys_.size() - 1)) {
+      if (keys_[i] == key)
+        return values_[i];
+      if (keys_[i] == kEmpty)
+        return kSfxNone;
+    }
+  }
+  [[nodiscard]] std::uint32_t Prev(std::uint32_t end) const { return prev_[end]; }
+  [[nodiscard]] const std::vector<std::int32_t>& Tokens() const { return buf_; }
+
+ private:
+  static constexpr std::uint64_t kEmpty = ~std::uint64_t{0};
+  [[nodiscard]] std::size_t Slot(std::uint64_t key) const {
+    return static_cast<std::size_t>((key * 0x9E3779B97F4A7C15ULL) >> shift_);
+  }
+  std::uint32_t Exchange(std::uint64_t key, std::uint32_t value) {
+    if (2 * (size_ + 1) > keys_.size())
+      Grow();
+    std::size_t i = Slot(key);
+    while (keys_[i] != kEmpty && keys_[i] != key)
+      i = (i + 1) & (keys_.size() - 1);
+    if (keys_[i] == kEmpty) {
+      keys_[i] = key;
+      values_[i] = value;
+      ++size_;
+      return kSfxNone;
+    }
+    const std::uint32_t previous = values_[i];
+    values_[i] = value;
+    return previous;
+  }
+  void Grow() {
+    const std::size_t capacity = keys_.empty() ? 1024 : 2 * keys_.size();
+    std::vector<std::uint64_t> keys(capacity, kEmpty);
+    std::vector<std::uint32_t> values(capacity);
+    keys.swap(keys_);
+    values.swap(values_);
+    shift_ = 64;
+    for (std::size_t c = capacity; c > 1; c >>= 1)
+      --shift_;
+    size_ = 0;
+    for (std::size_t i = 0; i < keys.size(); ++i) {
+      if (keys[i] == kEmpty)
+        continue;
+      std::size_t j = Slot(keys[i]);
+      while (keys_[j] != kEmpty)
+        j = (j + 1) & (keys_.size() - 1);
+      keys_[j] = keys[i];
+      values_[j] = values[i];
+      ++size_;
+    }
+  }
+  std::vector<std::uint64_t> keys_;
+  std::vector<std::uint32_t> values_;
+  std::size_t size_{0};
+  unsigned shift_{64};
+  std::vector<std::uint32_t> prev_;
+  std::vector<std::int32_t> buf_;
+};
