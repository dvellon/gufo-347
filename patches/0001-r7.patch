+  static const std::size_t window = [] {
+    const char* v = std::getenv("GUFO_DRAFT_VOCAB_WINDOW");
+    if (v != nullptr && *v != '\0')
+      return MtpDraftVocabWindow();
+    return kXmRelaxedDefaults.vocab_window != 0
+               ? kXmRelaxedDefaults.vocab_window
+               : kMtpDraftVocabWindow;
+  }();
+  return window;
+}
