+void Session::BeginGuardRequest() noexcept {
+  guard_ = {};
+}
+
+bool Session::GuardReady(const sampling::SamplerState& sampler) {
+  if (guard_.new_request) {
+    guard_.new_request = false;
+    guard_.request = GuardGlobals().requests.fetch_add(1) + 1;
+  }
+  if (!guard_.armed)
+    return false;
+  guard_.armed = false;
+  const auto& config = sampler.config();
+  return guard_.position == tokens_.size() &&
+         guard_.fingerprint == LogitsFingerprint(logits_) &&
+         config.temperature == 0.0F && !config.penalties_enabled() &&
+         !config.constraint && !sampler.ForcedToken() &&
+         !sampler.SaveDrawState().pending;
+}
+
+void Session::GuardAnchor(bool ready, std::int32_t anchor) {
+  if (!ready)
+    return;
+  auto& g = GuardGlobals();
+  g.checks.fetch_add(1, std::memory_order_relaxed);
+  if (anchor == guard_.predicted) {
+    g.consecutive.store(0, std::memory_order_relaxed);
+    return;
+  }
+  const auto consecutive = g.consecutive.fetch_add(1) + 1;
+  g.mismatches.fetch_add(1);
+  A1Encoded a1;
+  const bool screened = A1Decode(logits_, &a1);
+  const auto value_at = [&](std::int32_t token) {
+    if (screened)  // Wave3 A1: only the frontier's argmax value is known
+      return token == a1.index ? GuardFloat(a1.value) : std::string("a1");
+    return token >= 0 && static_cast<std::size_t>(token) < logits_.size()
+               ? GuardFloat(logits_[static_cast<std::size_t>(token)])
+               : std::string("na");
+  };
+  GuardLog(1, "event=verify_mismatch predicted=" +
+                  std::to_string(guard_.predicted) +
+                  " predicted_value=" + GuardFloat(guard_.predicted_value) +
+                  " committed=" + std::to_string(anchor) +
+                  " committed_value=" + value_at(anchor) +
+                  " row_value_at_predicted=" + value_at(guard_.predicted) +
+                  " draft=" + std::to_string(guard_.draft) +
+                  " keep=" + std::to_string(guard_.keep) +
+                  " chain=" + std::to_string(guard_.chain) +
+                  " lookup=" + std::to_string(guard_.lookup) +
+                  " consecutive=" + std::to_string(consecutive) +
+                  " request=" + std::to_string(guard_.request));
+  if (consecutive >= 3)
+    DisableSpeculation("prediction_readback_mismatch",
+                       "consecutive=" + std::to_string(consecutive));
+}
+
+void Session::GuardCollapse(bool predicted, std::uint32_t row,
+                            std::int32_t predicted_index,
+                            float predicted_value) {
+  auto& g = GuardGlobals();
+  g.collapses.fetch_add(1);
+  const std::string line =
+      "event=draft_collapse request=" + std::to_string(guard_.request) +
+      " cycles=" + std::to_string(guard_.cycles) +
+      " proposed=" + std::to_string(guard_.proposed) +
+      " lookup_proposed=" + std::to_string(guard_.lookup_proposed) +
+      " accepted=" + std::to_string(guard_.accepted);
+  if (!predicted) {
+    GuardLog(1, line + " self_test=skipped");
+    return;
+  }
+  // Wave3 A1: the self-test compares complete production rows.
+  {
+    std::string a1_error;
+    if (!A1MaterializeFrontier(&a1_error)) {
+      GuardLog(1, line + " self_test=skipped a1_error=" + a1_error);
+      return;
+    }
+  }
+  // One-off: the GPU prediction against the host argmax of the mapped
+  // frontier row (Rollback) and of a fresh download of the same row.
+  const auto mapped = HostArgmax(logits_);
+  std::vector<float> downloaded(logits_.size());
+  std::string error;
+  const bool read =
+      model_->executor_->ReadVerificationRows(row, downloaded, &error);
+  const auto fresh = read ? HostArgmax(downloaded) : HostArgmaxResult{};
+  const bool rows_equal =
+      read && std::memcmp(downloaded.data(), logits_.data(),
+                          logits_.size() * sizeof(float)) == 0;
+  const bool pass = read && rows_equal && mapped.index == predicted_index &&
+                    fresh.index == predicted_index;
+  GuardLog(pass ? 1 : 2,
+           line + " self_test=" + (pass ? "pass" : "fail") +
+               " gpu=" + std::to_string(predicted_index) + "/" +
+               GuardFloat(predicted_value) +
+               " host_mapped=" + std::to_string(mapped.index) + "/" +
+               GuardFloat(mapped.value) +
+               " host_row=" + std::to_string(fresh.index) + "/" +
+               GuardFloat(fresh.value) +
+               " rows_equal=" + (rows_equal ? "1" : "0") +
+               (read ? std::string() : " error=" + error));
+  if (!pass) {
+    g.self_test_failures.fetch_add(1);
+    DisableSpeculation("self_test_mismatch",
+                       "request=" + std::to_string(guard_.request));
+  }
+}
