--- /dev/null
+++ b/src/core/speculative/spec_sampling.hpp
@@ -0,0 +1,233 @@
+#ifndef GUFO_CORE_SPECULATIVE_SPEC_SAMPLING_HPP_
+#define GUFO_CORE_SPECULATIVE_SPEC_SAMPLING_HPP_
+
+// cloud spec-sampling (lab-notes/cloud/spec-sampling.md): exact speculative
+// sampling primitives, independent of any model.
+//
+// Speculative sampling emits exactly the target distribution p for ANY
+// proposal distribution q, provided that (a) the draft token x is drawn from
+// the very q passed to verification, (b) the acceptance uniform is
+// independent of the draw, (c) x is accepted with probability min(1, p/q) and
+// (d) a rejection draws from norm(max(0, p - q)). The proposal is therefore a
+// free acceptance lever: only the overlap sum_x min(p(x), q(x)) changes.
+//
+// ProposalShape changes q only, never p:
+//   mask_constraint      zero q on tokens the request grammar forbids (p is
+//                        zero there, so that mass could never be accepted);
+//   q_temperature_scale  q_i ~ base_i^(1/s) over the base support (base =
+//                        the draft row after the target's own filters at the
+//                        request temperature T; equivalent to softmax at T*s);
+//   q_top_k              keep the q_top_k most likely base tokens.
+// The identity shape is production's proposal, bit for bit.
+//
+// Knobs (default = identity = production; an invalid value fails the load):
+//   GUFO_SPEC_Q_MASK=0|1, GUFO_SPEC_Q_TEMP=<s in [0.25, 4]>,
+//   GUFO_SPEC_Q_TOPK=<0..64>.
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <span>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "src/core/sampling.hpp"
+
+namespace gufo::speculative::spec_sampling {
+
+using sampling::Probability;
+using sampling::TokenId;
+
+/// Proposal masses are integers summing to 2^24, so the F32 copy handed to
+/// verification is exactly the distribution used for the draw.
+inline constexpr std::uint32_t kProposalUnits = 1U << 24;
+
+struct ProposalShape {
+  bool mask_constraint{false};
+  double q_temperature_scale{1.0};
+  std::uint32_t q_top_k{0};
+
+  [[nodiscard]] bool identity() const noexcept {
+    return !mask_constraint && q_temperature_scale == 1.0 && q_top_k == 0;
+  }
+  /// Shapes that reweight or cut q (the mask only removes p-zero mass).
+  [[nodiscard]] bool reweights() const noexcept {
+    return q_temperature_scale != 1.0 || q_top_k != 0;
+  }
+};
+
+/// Parses the knob values; nullptr or "" keeps the default.
+[[nodiscard]] inline ProposalShape ParseShape(const char* mask,
+                                              const char* temperature,
+                                              const char* top_k) {
+  ProposalShape shape;
+  const auto set = [](const char* value) {
+    return value != nullptr && *value != '\0';
+  };
+  if (set(mask)) {
+    const std::string text(mask);
+    if (text == "1")
+      shape.mask_constraint = true;
+    else if (text != "0")
+      throw std::invalid_argument("GUFO_SPEC_Q_MASK must be 0 or 1");
+  }
+  if (set(temperature)) {
+    char* end = nullptr;
+    const double value = std::strtod(temperature, &end);
+    if (end == temperature || *end != '\0' || !std::isfinite(value) ||
+        value < 0.25 || value > 4.0)
+      throw std::invalid_argument("GUFO_SPEC_Q_TEMP must be in [0.25, 4]");
+    shape.q_temperature_scale = value;
+  }
+  if (set(top_k)) {
+    char* end = nullptr;
+    const long value = std::strtol(top_k, &end, 10);
+    if (end == top_k || *end != '\0' || value < 0 || value > 64)
+      throw std::invalid_argument("GUFO_SPEC_Q_TOPK must be in [0, 64]");
+    shape.q_top_k = static_cast<std::uint32_t>(value);
+  }
+  return shape;
+}
+
+/// The process-wide shape, read once.
+[[nodiscard]] inline const ProposalShape& EnvShape() {
+  static const ProposalShape shape = ParseShape(
+      std::getenv("GUFO_SPEC_Q_MASK"), std::getenv("GUFO_SPEC_Q_TEMP"),
+      std::getenv("GUFO_SPEC_Q_TOPK"));
+  return shape;
+}
+
+/// Reweights a normalized base distribution. Entries keep their tokens; the
+/// result is normalized and ordered by probability (ties by token).
+[[nodiscard]] inline std::vector<Probability> Shape(
+    std::span<const Probability> base, double temperature_scale,
+    std::uint32_t top_k) {
+  if (base.empty())
+    throw std::invalid_argument("cannot shape an empty proposal");
+  if (!(temperature_scale > 0) || !std::isfinite(temperature_scale))
+    throw std::invalid_argument("invalid proposal temperature scale");
+  std::vector<Probability> out(base.begin(), base.end());
+  std::ranges::sort(out, [](const Probability& a, const Probability& b) {
+    return a.value == b.value ? a.token < b.token : a.value > b.value;
+  });
+  std::erase_if(out, [](const Probability& e) { return !(e.value > 0); });
+  if (out.empty())
+    throw std::invalid_argument("proposal has no probability");
+  if (top_k != 0 && out.size() > top_k)
+    out.resize(top_k);
+  if (temperature_scale != 1.0) {
+    // base_i^(1/s) relative to the mode keeps every weight in (0, 1].
+    const double mode = std::log(out.front().value);
+    for (auto& e : out)
+      e.value = std::exp((std::log(e.value) - mode) / temperature_scale);
+  }
+  double total = 0;
+  for (const auto& e : out)
+    total += e.value;
+  for (auto& e : out)
+    e.value /= total;
+  std::erase_if(out, [](const Probability& e) { return !(e.value > 0); });
+  return out;
+}
+
+struct QuantizedProposal {
+  std::vector<TokenId> ids;
+  std::vector<std::uint32_t> mass;  ///< sums to kProposalUnits
+};
+
+/// floor(p * 2^24) per entry and the remainder to the first entry: the same
+/// rule as production's SampleMtpProposal.
+[[nodiscard]] inline QuantizedProposal Quantize(
+    std::span<const Probability> entries) {
+  if (entries.empty())
+    throw std::invalid_argument("cannot quantize an empty proposal");
+  QuantizedProposal q;
+  q.ids.reserve(entries.size());
+  q.mass.reserve(entries.size());
+  std::uint32_t total = 0;
+  for (const auto& e : entries) {
+    q.ids.push_back(e.token);
+    q.mass.push_back(
+        static_cast<std::uint32_t>(std::floor(e.value * kProposalUnits)));
+    total += q.mass.back();
+  }
+  if (total > kProposalUnits)
+    throw std::invalid_argument("proposal masses exceed one");
+  q.mass[0] += kProposalUnits - total;
+  return q;
+}
+
+/// Index drawn by `uniform` in [0, 1), as in SampleMtpProposal.
+[[nodiscard]] inline std::size_t DrawIndex(const QuantizedProposal& q,
+                                           double uniform) {
+  const auto draw = static_cast<std::uint32_t>(uniform * kProposalUnits);
+  std::uint32_t cumulative = 0;
+  for (std::size_t i = 0; i < q.mass.size(); ++i) {
+    cumulative += q.mass[i];
+    if (draw < cumulative)
+      return i;
+  }
+  throw std::logic_error("proposal draw outside its masses");
+}
+
+/// sum_x min(p(x), q(x)): the probability that one draft is accepted.
+[[nodiscard]] inline double Overlap(const sampling::SamplingDistribution& p,
+                                    std::span<const TokenId> ids,
+                                    std::span<const float> q) {
+  std::unordered_map<TokenId, double> draft;
+  for (std::size_t i = 0; i < ids.size(); ++i)
+    draft[ids[i]] += q[i];
+  double overlap = 0;
+  for (const auto& [token, mass] : draft)
+    overlap += std::min(mass, p.probability(token));
+  return overlap;
+}
+
+/// norm(max(0, p - q)); empty when p <= q everywhere.
+[[nodiscard]] inline std::vector<Probability> Residual(
+    const sampling::SamplingDistribution& p, std::span<const TokenId> ids,
+    std::span<const float> q) {
+  std::unordered_map<TokenId, double> draft;
+  for (std::size_t i = 0; i < ids.size(); ++i)
+    draft[ids[i]] += q[i];
+  std::vector<Probability> out;
+  double total = 0;
+  for (const auto& e : p.entries()) {
+    const auto found = draft.find(e.token);
+    const double value =
+        std::max(e.value - (found == draft.end() ? 0.0 : found->second), 0.0);
+    if (value > 0) {
+      out.push_back({e.token, value});
+      total += value;
+    }
+  }
+  for (auto& e : out)
+    e.value /= total;
+  return out;
+}
+
+struct Verdict {
+  TokenId token;
+  bool accepted;
+};
+
+/// Reference token verification with production's arithmetic: accept when
+/// U * q(x) < p(x) (U in [0, 1) from the target stream), else one residual
+/// draw from the same stream.
+[[nodiscard]] inline Verdict Verify(const sampling::SamplingDistribution& p,
+                                    std::span<const TokenId> ids,
+                                    std::span<const float> q, TokenId draft,
+                                    double q_draft, std::uint64_t* rng) {
+  if (!(q_draft > 0) || q_draft > 1)
+    throw std::invalid_argument("draft probability outside (0, 1]");
+  if (sampling::Uniform(rng) * q_draft < p.probability(draft))
+    return {draft, true};
+  return {p.SampleResidual(ids, q, rng), false};
+}
+
+}  // namespace gufo::speculative::spec_sampling
+
+#endif  // GUFO_CORE_SPECULATIVE_SPEC_SAMPLING_HPP_
