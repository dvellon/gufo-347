+++ b/src/cli/serve/cap_capture.hpp
@@ -0,0 +1,104 @@
+#ifndef GUFO_CLI_SERVE_CAP_CAPTURE_HPP_
+#define GUFO_CLI_SERVE_CAP_CAPTURE_HPP_
+
+// combo-c4 member `cap` (cacheblk RESULTS s5 (a)-(c), combo-c2 README s6). New header, cli_objects only.
+// Three default-OFF cache-capture fixes; every knob unset/0 leaves c3's statements in effect (callers test the knob
+// before touching any boundary):
+//   GUFO_LEARNED_BACKOFF=k (1..64): a learned (shared-prefix) checkpoint is placed k tokens before the token common
+//     prefix, so a request whose BPE merges the divergence token differently (1,098 vs 1,099) can still restore it.
+//   GUFO_CAP_HEADER=1: a cold prompt (nothing restored, > 1,152 tokens) with no learned point captures one optional
+//     history checkpoint at min(1,024, start of the 2nd message), when that is >= 512 tokens.
+//   GUFO_CAP_TAIL=1: a scoring / one-token request whose final message + assistant framing is <= 64 tokens shares a
+//     checkpoint at the start of that final message, so later questions on the same context restore it.
+// Boundaries are message starts found in token space: the stable prefix (Prepare's stable_prefix_tokens) starts with
+// <|im_start|> exactly as token 0 does, so no tokenizer or special-token id is needed here.
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <span>
+
+namespace gufo::server::cap {
+
+inline std::size_t ReadKnob(const char* name, std::size_t max) noexcept {
+  const char* v = std::getenv(name);
+  if (v == nullptr || *v == '\0')
+    return 0;
+  char* end = nullptr;
+  const unsigned long long n = std::strtoull(v, &end, 10);
+  if (end == v || *end != '\0')
+    return 0;
+  return n > max ? max : static_cast<std::size_t>(n);
+}
+inline std::size_t LearnedBackoff() noexcept {
+  static const std::size_t k = ReadKnob("GUFO_LEARNED_BACKOFF", 64);
+  return k;
+}
+inline bool HeaderOn() noexcept {
+  static const bool on = ReadKnob("GUFO_CAP_HEADER", 1) != 0;
+  return on;
+}
+inline bool TailOn() noexcept {
+  static const bool on = ReadKnob("GUFO_CAP_TAIL", 1) != 0;
+  return on;
+}
+inline bool AnyOn() noexcept {
+  return LearnedBackoff() != 0 || HeaderOn() || TailOn();
+}
+
+inline constexpr std::size_t kHeaderMax = 1024;       // header point cap
+inline constexpr std::size_t kHeaderMin = 512;        // shorter headers re-prefill cheaply
+inline constexpr std::size_t kHeaderPromptMin = 1152; // kHeaderMax + the 128-token grid tail rule
+inline constexpr std::size_t kTailMax = 64;           // == kSharedCheckpointSlack
+inline constexpr std::size_t kFramingMax = 16;        // stable -> prompt end = assistant framing only
+
+// (a) A divergence inside the prompt backs off by k; a full match (common == prompt size) has no divergence token.
+inline std::size_t BackOff(std::size_t common, std::size_t prompt_size, std::size_t k) noexcept {
+  if (k == 0 || common >= prompt_size)
+    return common;
+  return common > k ? common - k : 0;
+}
+
+// The <|im_start|> id, read from the prompt itself: token 0 and the stable boundary both start a message.
+template <typename Token>
+inline bool MessageStartId(std::span<const Token> prompt, std::size_t stable, Token* id) noexcept {
+  if (stable == 0 || stable >= prompt.size() || prompt[0] != prompt[stable])
+    return false;
+  *id = prompt[stable];
+  return true;
+}
+
+// (b) Zero = no header point.
+template <typename Token>
+inline std::size_t HeaderPoint(std::span<const Token> prompt, std::size_t stable, std::size_t reused) noexcept {
+  Token im{};
+  if (reused != 0 || prompt.size() <= kHeaderPromptMin || !MessageStartId(prompt, stable, &im))
+    return 0;
+  std::size_t h = kHeaderMax;
+  for (std::size_t i = 1; i < kHeaderMax; ++i)
+    if (prompt[i] == im) {
+      h = i;
+      break;
+    }
+  if (h < kHeaderMin || h >= stable)
+    return 0;
+  return h;
+}
+
+// (c) Zero = no tail point. Only when the prompt ends in a short final message plus assistant framing.
+template <typename Token>
+inline std::size_t TailPoint(std::span<const Token> prompt, std::size_t stable, std::size_t reused) noexcept {
+  Token im{};
+  if (!MessageStartId(prompt, stable, &im) || prompt.size() - stable > kFramingMax)
+    return 0;
+  const std::size_t lowest = prompt.size() > kTailMax ? prompt.size() - kTailMax : 1;
+  for (std::size_t i = stable; i-- > std::max<std::size_t>(lowest, 1);)
+    if (prompt[i] == im)
+      return i >= reused + kTailMax ? i : 0;
+  return 0;
+}
+
+}  // namespace gufo::server::cap
+
+#endif  // GUFO_CLI_SERVE_CAP_CAPTURE_HPP_
