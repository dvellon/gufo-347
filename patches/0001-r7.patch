+++ b/src/core/w3sb_knobs.hpp
@@ -0,0 +1,75 @@
+#ifndef GUFO_CORE_W3SB_KNOBS_HPP_
+#define GUFO_CORE_W3SB_KNOBS_HPP_
+
+// Wave3 subline-sweep (make_m1s.py): the new env knobs of the M1 / M1+S
+// single binary w3m1s_server. Each knob is read once per process (function-local
+// static) and is ON only when set to exactly "1"; unset, "", "0", "true", "1 " ...
+// keep the promo-3cg statement. One stderr line per knob at its first use:
+//   event=w3sb_knob name=<NAME> value=<0|1|N>
+//   GUFO_SB_B5_STRICT  engine.cpp: STRICT requests may use B5 v2
+//                      (kXmStrictAdmitted.b5 || B5Strict()); floor / hide from
+//                      GUFO_B5_FLOOR / GUFO_B5_HIDE, else the relaxed table's
+//                      defaults (floor 1.25, hide inf)
+//   GUFO_SB_P6V2       kernels.hip.cpp: P6 v2 row-group launches from
+//                      kP6RowGroupMinTokens rows (5 sites)
+//   GUFO_SB_D1M        executor.cpp MoeExperts: D1m 128 x 128 down blocks from
+//                      kD1mDownMinTokens rows
+// Off, a gated threshold is its type's maximum, so `rows >= threshold` is false
+// for every pass (a pass has at most max_chunk rows): the production launch.
