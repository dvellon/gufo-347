+// Queue 225 (q2screen-225): the NEW kernels of the 2-bit screening readout (q2s_plan.h has the layout and the CPU
+// references). Compiled with the production kernels.hip.cpp object's flags (build-225.ps1), like the kernels a production
+// change would add there. No production header is needed.
+//   Q2BuildKernel     the Q2_0 copy of the Q8_0 head rows (054 P2 rule; once, untimed)
+//   Q2ScreenKernel    keys[t][v] = Key(sum_j d2 (dx (C - S) + dx' (C' - S'))): 8 lanes per head row, one 16-byte code load
+//                     per Q2 block (lane l: blocks l, l + 8, .., l + 32), the n <= 8 Q8_1 inputs staged in LDS once per
+//                     block; grid-stride over rows (512 blocks of 32 rows)
+//   Q2Sel1Kernel      exact top-k of each 4,096-row chunk (radix select on the key, ties by lowest id)
+//   Q2Sel2Kernel      exact top-k over the chunks' winners, sorted (key desc, id asc); optionally copies the k Q8_0 rows
+//   Q2FinalCopyKernel the copy path's argmax over the k rescored values (verbatim launch_q8 on the copied rows)
+//   Q2CheckBitsKernel, Q2FillerKernel, Q2SpinKernel
+#include <hip/hip_fp16.h>
+#include <hip/hip_runtime.h>
+
+#include <cmath>
+#include <cstdint>
+
+#include "q2s_launch.h"
+#include "q2s_plan.h"
+
+namespace {
+
+using q2s::kChunk;
+using q2s::kEqCap;
+using q2s::kMaxK;
+
+__device__ __forceinline__ int Dot4(int a, int b, int c) { return __builtin_amdgcn_sudot4(true, a, true, b, c, false); }
+
+__device__ __forceinline__ float HalfBits(std::uint16_t h) { return __half2float(__ushort_as_half(h)); }
+
+// ---- Q2 build: one thread per 64-value block ------------------------------------------------------------------------
+__global__ __launch_bounds__(256) void Q2BuildKernel(const std::uint8_t* __restrict__ q8, std::uint32_t rows,
+                                                     std::uint32_t* __restrict__ codes,
+                                                     std::uint16_t* __restrict__ scales,
+                                                     std::uint16_t* __restrict__ rbound) {
+  const std::uint64_t gid = static_cast<std::uint64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (gid >= static_cast<std::uint64_t>(rows) * q2s::kQ2Blocks) return;
+  const std::uint64_t row = gid / q2s::kQ2Blocks;
+  const std::uint32_t j = static_cast<std::uint32_t>(gid % q2s::kQ2Blocks);
+  float x[64];
+  float amax = 0.0f;
+#pragma unroll
+  for (int h = 0; h < 2; ++h) {
+    const std::uint8_t* b = q8 + row * q2s::kQ8RowBytes + static_cast<std::uint64_t>(2 * j + h) * 34;
+    const float d = HalfBits(static_cast<std::uint16_t>(b[0] | (b[1] << 8)));
+#pragma unroll
+    for (int e = 0; e < 32; ++e) {
+      x[32 * h + e] = __fmul_rn(d, static_cast<float>(static_cast<std::int8_t>(b[2 + e])));
+      amax = fmaxf(amax, fabsf(x[32 * h + e]));
+    }
+  }
+  float best_err = 0.0f, best_d = 0.0f;
+  for (std::uint32_t i = 0; i < q2s::kQ2Candidates; ++i) {
+    const float d = __fmul_rn(amax, __fadd_rn(0.5f, __fmul_rn(static_cast<float>(i), 1.0f / 32.0f)));
+    const float inv = d > 0.0f ? __fdiv_rn(1.0f, d) : 0.0f;
+    float err = 0.0f;
+#pragma unroll
+    for (int e = 0; e < 64; ++e) {
+      const float q = fminf(fmaxf(rintf(__fmul_rn(x[e], inv)), -1.0f), 2.0f);
+      const float r = __fsub_rn(__fmul_rn(q, d), x[e]);
+      err = __fadd_rn(err, __fmul_rn(r, r));
+    }
+    if (i == 0 || err < best_err) {
+      best_err = err;
+      best_d = d;
+    }
+  }
+  const __half dh = __float2half_rn(best_d);
+  const float df = __half2float(dh);
+  const float inv = df > 0.0f ? __fdiv_rn(1.0f, df) : 0.0f;
+  std::uint32_t w[4] = {0u, 0u, 0u, 0u};
+  double ss = 0.0;   // the block error norm ||w8 - w2||_2 (statistical-stop sigma), in double (x[e], q * df exact)
+#pragma unroll
+  for (std::uint32_t e = 0; e < 64; ++e) {
+    const float q = fminf(fmaxf(rintf(__fmul_rn(x[e], inv)), -1.0f), 2.0f);
+    const std::uint32_t c = static_cast<std::uint32_t>(static_cast<int>(q) + 1);
+    w[q2s::CodeWord(e)] |= c << q2s::CodeShift(e);
+    const double r = static_cast<double>(x[e]) - static_cast<double>(q) * static_cast<double>(df);
+    ss += r * r;
+  }
+  // stored rounded UP: double -> float (nextafter if below) -> f16 (next half if below); 1e-9 covers the double sum
+  const double rb = sqrt(ss) * (1.0 + 1e-9);
+  float rf = static_cast<float>(rb);
+  if (static_cast<double>(rf) < rb) rf = nextafterf(rf, INFINITY);
+  std::uint16_t rh = __half_as_ushort(__float2half_rn(rf));
+  if (HalfBits(rh) < rf) rh = static_cast<std::uint16_t>(rh + 1u);   // non-negative finite: next f16 up
+  rbound[row * q2s::kQ2Blocks + j] = rh;
+  std::uint32_t* out = codes + row * (q2s::kQ2CodeBytes / 4) + 4 * j;
+  out[0] = w[0];
+  out[1] = w[1];
+  out[2] = w[2];
+  out[3] = w[3];
+  scales[row * q2s::kQ2Blocks + j] = __half_as_ushort(dh);
+}
+
+// ---- screen GEMV ------------------------------------------------------------------------------------------------------
+// Twin = the geometry-identical copy control (a second symbol; the only difference is a branch no launch takes).
+template <int N, int Twin>
+__global__ __launch_bounds__(256) void Q2ScreenKernel(const uint4* __restrict__ codes,
+                                                      const std::uint16_t* __restrict__ scales,
+                                                      const std::uint8_t* __restrict__ xq, std::uint32_t rows,
+                                                      std::uint32_t* __restrict__ keys) {
+  __shared__ int xs[N][q2s::kQ8Blocks * 8];   // packed int8 words of the N inputs
+  __shared__ float dxs[N][q2s::kQ8Blocks];
+  __shared__ int sqs[N][q2s::kQ8Blocks];      // integer code sums per Q8_1 block
+  for (std::uint32_t i = threadIdx.x; i < N * q2s::kQ8Blocks; i += blockDim.x) {
+    const std::uint32_t t = i / q2s::kQ8Blocks, g = i % q2s::kQ8Blocks;
+    const std::uint8_t* b = xq + static_cast<std::size_t>(t) * q2s::kQ8_1RowBytes + 36u * g;
+    const int* qi = reinterpret_cast<const int*>(b + 4);
+    int sq = 0;
+#pragma unroll
+    for (int m = 0; m < 8; ++m) {
+      const int v = qi[m];
+      xs[t][8 * g + m] = v;
+      sq = Dot4(v, 0x01010101, sq);
+    }
+    sqs[t][g] = sq;
+    dxs[t][g] = HalfBits(*reinterpret_cast<const std::uint16_t*>(b));
+  }
+  __syncthreads();
+  if (Twin != 0 && rows == 0xFFFFFFFFu) keys[0] = 0u;   // never taken
+  const std::uint32_t part = threadIdx.x & 7u;
+  const std::uint32_t group = threadIdx.x >> 3;
+  for (std::uint32_t base = blockIdx.x * 32u; base < rows; base += gridDim.x * 32u) {
+    const std::uint32_t v = base + group;   // rows % 32 == 0
+    uint4 c[5];
+    float d2[5];
+#pragma unroll
+    for (int it = 0; it < 5; ++it) {
+      const std::uint32_t j = part + 8u * it;
+      c[it] = codes[static_cast<std::size_t>(v) * q2s::kQ2Blocks + j];
+      d2[it] = HalfBits(scales[static_cast<std::size_t>(v) * q2s::kQ2Blocks + j]);
+    }
+    float acc[N];
+#pragma unroll
+    for (int t = 0; t < N; ++t) acc[t] = 0.0f;
+#pragma unroll
+    for (int it = 0; it < 5; ++it) {
+      const std::uint32_t j = part + 8u * it;
+      const std::uint32_t wd0 = c[it].x, wd1 = c[it].y, wd2 = c[it].z, wd3 = c[it].w;
+#pragma unroll
+      for (int t = 0; t < N; ++t) {
+        const int* xr = &xs[t][16 * j];
+        int d0 = 0, d1 = 0;
+#pragma unroll
+        for (int s = 0; s < 4; ++s) {
+          d0 = Dot4(static_cast<int>((wd0 >> (2 * s)) & 0x03030303u), xr[s], d0);
+          d0 = Dot4(static_cast<int>((wd1 >> (2 * s)) & 0x03030303u), xr[4 + s], d0);
+          d1 = Dot4(static_cast<int>((wd2 >> (2 * s)) & 0x03030303u), xr[8 + s], d1);
+          d1 = Dot4(static_cast<int>((wd3 >> (2 * s)) & 0x03030303u), xr[12 + s], d1);
+        }
+        const std::uint32_t g0 = 2u * j;
+        const float p = dxs[t][g0] * static_cast<float>(d0 - sqs[t][g0]) +
+                        dxs[t][g0 + 1] * static_cast<float>(d1 - sqs[t][g0 + 1]);
+        acc[t] += d2[it] * p;
+      }
+    }
+#pragma unroll
+    for (int t = 0; t < N; ++t) {
+      acc[t] += __shfl_xor(acc[t], 4, 32);
+      acc[t] += __shfl_xor(acc[t], 2, 32);
+      acc[t] += __shfl_xor(acc[t], 1, 32);
+    }
+    if (part == 0) {
+#pragma unroll
+      for (int t = 0; t < N; ++t)
+        keys[static_cast<std::size_t>(t) * rows + v] = q2s::KeyBits(__float_as_uint(acc[t]));
+    }
+  }
+}
+
+// ---- statistical stop (EXPLORATORY; coordinator 2026-11-06 after dell-sims-056: NOT a proof) -------------------------
+// 056 showed every rigorous bound (Cauchy-Schwarz, PCA + remainder, Q2 + per-row / per-block error norms) needs ~all
+// rows; the Q2 error is ~43 % of a row's norm. Instead: model the Q2 error e_v . x as Gaussian with
+//   sigma_v^2 = sum_j (R_vj^2 / 64) X_j^2   (R_vj = ||w8 - w2||_2 per 64-block, X_j = ||dequantized input block||_2)
+// and rescore rows in descending upper estimate u_v = s_v + z sigma_v until the best exact score >= the next u
+// (056's ordered scan). GPU form: pass 1 rescores the top-8 rows by u (B1 = their best exact logit); pass 2 rescores
+// every row with u > B1 (cap kStatCap, else FALLBACK to the full Q8 pass); the result is the best of both, which is the
+// ordered scan's decision whenever the model holds (Dell T4). lo_key = Key(s - z sigma) is written for the coverage
+// diagnostic only.
+__device__ __forceinline__ float KeyFloat(std::uint32_t key) {
+  return __uint_as_float((key & 0x80000000u) != 0u ? (key & 0x7FFFFFFFu) : ~key);
+}
+
+template <int N>
+__global__ __launch_bounds__(256) void Q2StatScreenKernel(const uint4* __restrict__ codes,
+                                                          const std::uint16_t* __restrict__ scales,
+                                                          const std::uint16_t* __restrict__ rnorm,
+                                                          const std::uint8_t* __restrict__ xq, std::uint32_t rows,
+                                                          float z, std::uint32_t* __restrict__ u_key,
+                                                          std::uint32_t* __restrict__ lo_key) {
+  __shared__ int xs[N][q2s::kQ8Blocks * 8];
+  __shared__ float dxs[N][q2s::kQ8Blocks];
+  __shared__ int sqs[N][q2s::kQ8Blocks];
+  __shared__ float xn2[N][q2s::kQ2Blocks];   // X_j^2 / 64
+  for (std::uint32_t i = threadIdx.x; i < N * q2s::kQ8Blocks; i += blockDim.x) {
+    const std::uint32_t t = i / q2s::kQ8Blocks, g = i % q2s::kQ8Blocks;
+    const std::uint8_t* b = xq + static_cast<std::size_t>(t) * q2s::kQ8_1RowBytes + 36u * g;
+    const int* qi = reinterpret_cast<const int*>(b + 4);
+    int sq = 0;
+#pragma unroll
+    for (int m = 0; m < 8; ++m) {
+      const int v = qi[m];
+      xs[t][8 * g + m] = v;
+      sq = Dot4(v, 0x01010101, sq);
+    }
+    sqs[t][g] = sq;
+    dxs[t][g] = HalfBits(*reinterpret_cast<const std::uint16_t*>(b));
+  }
+  __syncthreads();
+  for (std::uint32_t i = threadIdx.x; i < N * q2s::kQ2Blocks; i += blockDim.x) {
+    const std::uint32_t t = i / q2s::kQ2Blocks, j = i % q2s::kQ2Blocks;
+    float ss = 0.0f;
+    for (std::uint32_t m = 0; m < 16; ++m) {
+      const int word = xs[t][16 * j + m];
+      const float dx = dxs[t][2 * j + m / 8];
+#pragma unroll
+      for (int b = 0; b < 4; ++b) {
+        const float v = dx * static_cast<float>(static_cast<std::int8_t>((word >> (8 * b)) & 0xFF));
+        ss += v * v;
+      }
+    }
+    xn2[t][j] = ss * (1.0f / 64.0f);
+  }
+  __syncthreads();
+  const std::uint32_t part = threadIdx.x & 7u;
+  const std::uint32_t group = threadIdx.x >> 3;
+  for (std::uint32_t base = blockIdx.x * 32u; base < rows; base += gridDim.x * 32u) {
+    const std::uint32_t v = base + group;
+    uint4 c[5];
+    float d2[5], rr[5];
+#pragma unroll
+    for (int it = 0; it < 5; ++it) {
+      const std::uint32_t j = part + 8u * it;
+      c[it] = codes[static_cast<std::size_t>(v) * q2s::kQ2Blocks + j];
+      d2[it] = HalfBits(scales[static_cast<std::size_t>(v) * q2s::kQ2Blocks + j]);
+      rr[it] = HalfBits(rnorm[static_cast<std::size_t>(v) * q2s::kQ2Blocks + j]);
+    }
+    float acc[N], va[N];
+#pragma unroll
+    for (int t = 0; t < N; ++t) acc[t] = va[t] = 0.0f;
+#pragma unroll
+    for (int it = 0; it < 5; ++it) {
+      const std::uint32_t j = part + 8u * it;
+      const std::uint32_t wd0 = c[it].x, wd1 = c[it].y, wd2 = c[it].z, wd3 = c[it].w;
+#pragma unroll
+      for (int t = 0; t < N; ++t) {
+        const int* xr = &xs[t][16 * j];
+        int d0 = 0, d1 = 0;
+#pragma unroll
+        for (int s = 0; s < 4; ++s) {
+          d0 = Dot4(static_cast<int>((wd0 >> (2 * s)) & 0x03030303u), xr[s], d0);
+          d0 = Dot4(static_cast<int>((wd1 >> (2 * s)) & 0x03030303u), xr[4 + s], d0);
+          d1 = Dot4(static_cast<int>((wd2 >> (2 * s)) & 0x03030303u), xr[8 + s], d1);
+          d1 = Dot4(static_cast<int>((wd3 >> (2 * s)) & 0x03030303u), xr[12 + s], d1);
+        }
+        const std::uint32_t g0 = 2u * j;
+        const float p = dxs[t][g0] * static_cast<float>(d0 - sqs[t][g0]) +
+                        dxs[t][g0 + 1] * static_cast<float>(d1 - sqs[t][g0 + 1]);
+        acc[t] += d2[it] * p;
+        va[t] += rr[it] * rr[it] * xn2[t][j];
+      }
+    }
+#pragma unroll
+    for (int t = 0; t < N; ++t) {
+#pragma unroll
+      for (int o = 4; o > 0; o >>= 1) {
+        acc[t] += __shfl_xor(acc[t], o, 32);
+        va[t] += __shfl_xor(va[t], o, 32);
+      }
+    }
+    if (part == 0) {
+#pragma unroll
+      for (int t = 0; t < N; ++t) {
+        const float e = z * sqrtf(va[t]);
+        u_key[static_cast<std::size_t>(t) * rows + v] = q2s::KeyBits(__float_as_uint(acc[t] + e));
+        lo_key[static_cast<std::size_t>(t) * rows + v] = q2s::KeyBits(__float_as_uint(acc[t] - e));
+      }
+    }
+  }
+}
+
+// thr[t] = Key(best[t]) + 1: "u > best" as "u_key >= thr" (the candidate kernel's test).
+__global__ void Q2ThrKernel(const float* __restrict__ best, std::uint32_t n, std::uint32_t* __restrict__ thr) {
+  const std::uint32_t t = threadIdx.x;
+  if (t >= n) return;
+  const std::uint32_t k = q2s::KeyBits(__float_as_uint(best[t]));
+  thr[t] = k == 0xFFFFFFFFu ? k : k + 1u;
+}
+
+// Candidates: rows with u_key >= thr[t]; at most `cap` ids kept per token (count > cap = the fallback case).
+__global__ __launch_bounds__(256) void Q2StatCandKernel(const std::uint32_t* __restrict__ u_key, std::uint32_t rows,
+                                                        const std::uint32_t* __restrict__ thr, std::uint32_t cap,
+                                                        std::uint32_t* __restrict__ cand,
+                                                        std::uint32_t* __restrict__ cnt) {
+  const std::uint32_t t = blockIdx.y;
+  const std::uint32_t l = thr[t];
+  for (std::uint32_t v = blockIdx.x * blockDim.x + threadIdx.x; v < rows; v += gridDim.x * blockDim.x) {
+    if (u_key[static_cast<std::size_t>(t) * rows + v] >= l) {
+      const std::uint32_t i = atomicAdd(&cnt[t], 1u);
+      if (i < cap) cand[static_cast<std::size_t>(t) * cap + i] = v;
+    }
+  }
+}
+
+// Coverage of the error model on real states (diagnostic): counters[0] += rows with the production logit above u,
+// [1] += below lo, [2] += non-finite logits, [3] = atomicMax of |p - mid| / half-width (f32 bits).
+__global__ __launch_bounds__(256) void Q2CoverageKernel(const float* __restrict__ prod,
+                                                        const std::uint32_t* __restrict__ lo_key,
+                                                        const std::uint32_t* __restrict__ u_key, std::size_t total,
+                                                        std::uint32_t* __restrict__ counters) {
+  float worst = 0.0f;
+  std::uint32_t above = 0, below = 0, bad = 0;
+  for (std::size_t i = static_cast<std::size_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
+       i += static_cast<std::size_t>(gridDim.x) * blockDim.x) {
+    const float p = prod[i], lo = KeyFloat(lo_key[i]), hi = KeyFloat(u_key[i]);
+    if (!(p == p) || fabsf(p) == INFINITY) {
+      ++bad;
+      continue;
+    }
+    above += p > hi ? 1u : 0u;
+    below += p < lo ? 1u : 0u;
+    const float half = 0.5f * (hi - lo);
+    if (half > 0.0f) worst = fmaxf(worst, fabsf(p - 0.5f * (hi + lo)) / half);
+  }
+  if (above) atomicAdd(&counters[0], above);
+  if (below) atomicAdd(&counters[1], below);
+  if (bad) atomicAdd(&counters[2], bad);
+  atomicMax(&counters[3], __float_as_uint(worst));
+}
+
+// counters[0] += tokens whose PRODUCTION argmax logit lies above its own u (the model's miss risk for the draft).
+__global__ void Q2ArgCoverKernel(const float* __restrict__ prod, std::uint32_t vocab,
+                                 const std::int32_t* __restrict__ prod_id, const std::uint32_t* __restrict__ u_key,
+                                 std::uint32_t n, std::uint32_t* __restrict__ counters) {
+  const std::uint32_t t = threadIdx.x;
+  if (t >= n) return;
+  const std::size_t i = static_cast<std::size_t>(t) * vocab + static_cast<std::uint32_t>(prod_id[t]);
+  if (prod[i] > KeyFloat(u_key[i])) atomicAdd(&counters[0], 1u);
+}
+
+// counts[t] += rows with u_key >= thr[t].
+__global__ __launch_bounds__(256) void Q2CountGeKernel(const std::uint32_t* __restrict__ u_key, std::uint32_t rows,
+                                                       const std::uint32_t* __restrict__ thr,
+                                                       std::uint32_t* __restrict__ counts) {
+  const std::uint32_t t = blockIdx.y;
+  const std::uint32_t l = thr[t];
+  std::uint32_t n = 0;
+  for (std::uint32_t v = blockIdx.x * blockDim.x + threadIdx.x; v < rows; v += gridDim.x * blockDim.x)
+    n += u_key[static_cast<std::size_t>(t) * rows + v] >= l ? 1u : 0u;
+  if (n) atomicAdd(&counts[t], n);
+}
+
+// Top-1 check: counters[0] += id mismatches, [1] += top-1 logit bit mismatches, [2] += fallback tokens (best_id ~0u).
+__global__ void Q2CheckTopKernel(const float* __restrict__ prod, std::uint32_t vocab,
+                                 const std::int32_t* __restrict__ prod_id, const std::uint32_t* __restrict__ best_id,
+                                 const float* __restrict__ best_val, std::uint32_t n,
+                                 std::uint32_t* __restrict__ counters) {
+  const std::uint32_t t = threadIdx.x;
+  if (t >= n) return;
+  if (best_id[t] == 0xFFFFFFFFu) {
+    atomicAdd(&counters[2], 1u);
+    return;
+  }
+  const std::uint32_t p = static_cast<std::uint32_t>(prod_id[t]);
+  if (best_id[t] != p) {
+    atomicAdd(&counters[0], 1u);
+    return;
+  }
+  if (__float_as_uint(best_val[t]) != __float_as_uint(prod[static_cast<std::size_t>(t) * vocab + p]))
+    atomicAdd(&counters[1], 1u);
+}
+
+// ---- block top-k ------------------------------------------------------------------------------------------------------
+// Bitonic sort of buf[0..n) DESCENDING (n a power of two), by the whole block.
+template <typename T>
+__device__ void BitonicDesc(T* buf, std::uint32_t n) {
+  for (std::uint32_t size = 2; size <= n; size <<= 1) {
+    for (std::uint32_t stride = size >> 1; stride > 0; stride >>= 1) {
+      for (std::uint32_t i = threadIdx.x; i < n / 2; i += blockDim.x) {
+        const std::uint32_t lo = 2 * i - (i & (stride - 1));
+        const std::uint32_t hi = lo + stride;
+        const bool desc = (lo & size) == 0;
+        const T a = buf[lo], b = buf[hi];
+        if ((a < b) == desc) {
+          buf[lo] = b;
+          buf[hi] = a;
+        }
+      }
+      __syncthreads();
+    }
+  }
+}
+
+struct SelShared {
+  std::uint32_t hist[256];
+  std::uint32_t ctl[8];   // 0 prefix, 1 mask, 2 need, 3 gt count, 4 eq count
+  std::uint32_t eq[kEqCap];
+};
+
+// The k largest composites (hi << 32 | lo) of the block's NT x PER items, written UNSORTED to out[0..k): every hi above
+// the k-th largest hi T, plus the `need` largest lo among hi == T (lo = ~id: lowest ids). Radix select on hi, 4 x 8 bits
+// (the w3sl RadixThreshold idea at byte digits). Requires >= k items (padding items are hi = lo = 0, never above a real
+// key). err[0] tie overflow (> kEqCap items equal to T), err[1] count mismatch.
+template <int NT, int PER>
+__device__ void BlockSelect(const std::uint32_t (&hi)[PER], const std::uint32_t (&lo)[PER], std::uint32_t k,
+                            SelShared& sh, std::uint64_t* out, std::uint32_t* err) {
+  if (threadIdx.x == 0) {
+    sh.ctl[0] = 0u;
+    sh.ctl[1] = 0u;
+    sh.ctl[2] = k;
+    sh.ctl[3] = 0u;
+    sh.ctl[4] = 0u;
+  }
+  for (int pass = 0; pass < 4; ++pass) {
+    const std::uint32_t shift = 24u - 8u * pass;
+    for (std::uint32_t i = threadIdx.x; i < 256; i += NT) sh.hist[i] = 0u;
+    __syncthreads();
+    const std::uint32_t prefix = sh.ctl[0], mask = sh.ctl[1];
+#pragma unroll
+    for (int j = 0; j < PER; ++j)
+      if ((hi[j] & mask) == prefix) atomicAdd(&sh.hist[(hi[j] >> shift) & 255u], 1u);
+    __syncthreads();
+    if (threadIdx.x < 32) {
+      const std::uint32_t lane = threadIdx.x;
+      const std::uint32_t need = sh.ctl[2];
+      std::uint32_t local = 0;
+#pragma unroll
+      for (int j = 0; j < 8; ++j) local += sh.hist[255u - 8u * lane - j];
+      std::uint32_t inc = local;
+#pragma unroll
+      for (int o = 1; o < 32; o <<= 1) {
+        const std::uint32_t v = __shfl_up(inc, o, 32);
+        if (lane >= static_cast<std::uint32_t>(o)) inc += v;
+      }
+      const std::uint32_t exc = inc - local;
+      if (exc < need && need <= inc) {
+        std::uint32_t cum = exc;
+        for (int j = 0; j < 8; ++j) {
+          const std::uint32_t d = 255u - 8u * lane - j;
+          const std::uint32_t h = sh.hist[d];
+          if (cum + h >= need) {
+            sh.ctl[0] = prefix | (d << shift);
+            sh.ctl[1] = mask | (255u << shift);
+            sh.ctl[2] = need - cum;
+            break;
+          }
+          cum += h;
+        }
+      }
+    }
+    __syncthreads();
+  }
+  const std::uint32_t thr = sh.ctl[0];
+#pragma unroll
+  for (int j = 0; j < PER; ++j) {
+    if (hi[j] > thr) {
+      const std::uint32_t idx = atomicAdd(&sh.ctl[3], 1u);
+      if (idx < k) out[idx] = (static_cast<std::uint64_t>(hi[j]) << 32) | lo[j];
+    } else if (hi[j] == thr) {
+      const std::uint32_t e = atomicAdd(&sh.ctl[4], 1u);
+      if (e < kEqCap) sh.eq[e] = lo[j];
+    }
+  }
+  __syncthreads();
+  const std::uint32_t need = sh.ctl[2], ngt = sh.ctl[3];
+  std::uint32_t neq = sh.ctl[4];
+  if (threadIdx.x == 0) {
+    if (neq > kEqCap) atomicAdd(&err[0], 1u);
+    if (ngt + need != k || neq < need) atomicAdd(&err[1], 1u);
+  }
+  if (neq > kEqCap) neq = kEqCap;
+  if (neq > need) {   // ties at the threshold: the `need` largest lo (lowest ids)
+    std::uint32_t p = 1;
+    while (p < neq) p <<= 1;
+    for (std::uint32_t i = neq + threadIdx.x; i < p; i += NT) sh.eq[i] = 0u;
+    __syncthreads();
+    BitonicDesc(sh.eq, p);
+  }
+  for (std::uint32_t i = threadIdx.x; i < need && ngt + i < k; i += NT)
+    out[ngt + i] = (static_cast<std::uint64_t>(thr) << 32) | sh.eq[i];
+  __syncthreads();
+}
+
+template <int K>
+__global__ __launch_bounds__(256) void Q2Sel1Kernel(const std::uint32_t* __restrict__ keys, std::uint32_t rows,
+                                                    std::uint64_t* __restrict__ cand1, std::uint32_t* __restrict__ err) {
+  __shared__ SelShared sh;
+  const std::uint32_t c = blockIdx.x, t = blockIdx.y, chunks = gridDim.x;
+  std::uint32_t hi[q2s::kSel1Per], lo[q2s::kSel1Per];
+#pragma unroll
+  for (int i = 0; i < static_cast<int>(q2s::kSel1Per); ++i) {
+    const std::uint32_t id = c * kChunk + threadIdx.x + q2s::kSel1Threads * i;
+    const bool ok = id < rows;
+    hi[i] = ok ? keys[static_cast<std::size_t>(t) * rows + id] : 0u;
+    lo[i] = ok ? ~id : 0u;
+  }
+  BlockSelect<q2s::kSel1Threads, q2s::kSel1Per>(hi, lo, K, sh, cand1 + (static_cast<std::size_t>(t) * chunks + c) * K,
+                                               err);
+}
+
+template <int K, bool Copy>
+__global__ __launch_bounds__(1024) void Q2Sel2Kernel(const std::uint64_t* __restrict__ cand1, std::uint32_t chunks,
+                                                     std::uint32_t rows, std::uint32_t* __restrict__ ids,
+                                                     std::uint32_t* __restrict__ sel_keys,
+                                                     const uint4* __restrict__ head, uint4* __restrict__ compact,
+                                                     std::uint32_t* __restrict__ err) {
+  __shared__ SelShared sh;
+  __shared__ std::uint64_t buf[K];
+  const std::uint32_t t = blockIdx.x;
+  const std::uint32_t m = chunks * K;
+  const std::uint64_t* src = cand1 + static_cast<std::size_t>(t) * m;
+  std::uint32_t hi[q2s::kSel2Per], lo[q2s::kSel2Per];
+#pragma unroll
+  for (int i = 0; i < static_cast<int>(q2s::kSel2Per); ++i) {
+    const std::uint32_t j = threadIdx.x + q2s::kSel2Threads * i;
+    const std::uint64_t v = j < m ? src[j] : 0ull;
+    hi[i] = static_cast<std::uint32_t>(v >> 32);
+    lo[i] = static_cast<std::uint32_t>(v);
+  }
+  BlockSelect<q2s::kSel2Threads, q2s::kSel2Per>(hi, lo, K, sh, buf, err);
+  BitonicDesc(buf, K);
+  for (std::uint32_t i = threadIdx.x; i < K; i += blockDim.x) {
+    const std::uint32_t id = q2s::CompositeId(buf[i]);
+    if (id >= rows) atomicAdd(&err[2], 1u);
+    ids[static_cast<std::size_t>(t) * kMaxK + i] = id;
+    sel_keys[static_cast<std::size_t>(t) * kMaxK + i] = q2s::CompositeKey(buf[i]);
+  }
+  if constexpr (Copy) {
+    constexpr std::uint32_t words = q2s::kQ8RowBytes / 16;   // 170
+    for (std::uint32_t q = threadIdx.x; q < K * words; q += blockDim.x) {
+      const std::uint32_t i = q / words, w = q % words;
+      std::uint32_t id = q2s::CompositeId(buf[i]);
+      if (id >= rows) id = 0;
+      compact[(static_cast<std::size_t>(t) * K + i) * words + w] = head[static_cast<std::size_t>(id) * words + w];
+    }
+  }
+}
+
+// The copy path: outc[t * (n k) + t k + i] = production's GEMV value of compacted row (t, i) for input t.
+__global__ __launch_bounds__(256) void Q2FinalCopyKernel(const float* __restrict__ outc,
+                                                         const std::uint32_t* __restrict__ ids, std::uint32_t k,
+                                                         std::uint32_t n, float* __restrict__ resc,
+                                                         std::uint32_t* __restrict__ best_id,
+                                                         float* __restrict__ best_val) {
+  __shared__ float vs[kMaxK];
+  __shared__ std::uint32_t is[kMaxK];
+  const std::uint32_t t = blockIdx.x;
+  for (std::uint32_t i = threadIdx.x; i < k; i += blockDim.x) {
+    const float v = outc[static_cast<std::size_t>(t) * n * k + static_cast<std::size_t>(t) * k + i];
+    vs[i] = v;
+    is[i] = ids[static_cast<std::size_t>(t) * kMaxK + i];
+    resc[static_cast<std::size_t>(t) * kMaxK + i] = v;
+  }
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    float bv = vs[0];
+    std::uint32_t bi = is[0];
+    for (std::uint32_t i = 1; i < k; ++i)
+      if (vs[i] > bv || (vs[i] == bv && is[i] < bi)) {
+        bv = vs[i];
+        bi = is[i];
+      }
+    best_id[t] = bi;
+    best_val[t] = bv;
+  }
+}
+
+__global__ void Q2CheckBitsKernel(const float* __restrict__ prod, std::uint32_t vocab,
+                                  const std::uint32_t* __restrict__ ids, const float* __restrict__ resc,
+                                  std::uint32_t k, std::uint32_t stride, const std::uint32_t* __restrict__ counts,
+                                  std::uint32_t* __restrict__ mismatch) {
+  const std::uint32_t t = blockIdx.x;
+  const std::uint32_t kk = counts != nullptr ? min(counts[t], k) : k;
+  for (std::uint32_t i = threadIdx.x; i < kk; i += blockDim.x) {
+    const std::uint32_t id = ids[static_cast<std::size_t>(t) * stride + i];
+    const std::uint32_t a = __float_as_uint(resc[static_cast<std::size_t>(t) * stride + i]);
+    const std::uint32_t b = id < vocab ? __float_as_uint(prod[static_cast<std::size_t>(t) * vocab + id]) : ~a;
+    if (a != b) atomicAdd(mismatch, 1u);
+  }
+}
+
+__global__ __launch_bounds__(256) void Q2FillerKernel(const uint4* __restrict__ src, uint4* __restrict__ dst,
+                                                      std::size_t n) {
+  for (std::size_t i = static_cast<std::size_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < n;
+       i += static_cast<std::size_t>(gridDim.x) * blockDim.x)
+    dst[i] = src[i];
+}
+
+__global__ void Q2SpinKernel(std::uint64_t ticks) {
+  const std::uint64_t t0 = wall_clock64();
+  while (wall_clock64() - t0 < ticks) __builtin_amdgcn_s_sleep(1);
+}
+
+template <int N>
+void ScreenN(const std::uint8_t* codes, const std::uint16_t* scales, const void* xq, std::uint32_t rows,
+             std::uint32_t* keys, bool twin, hipStream_t s) {
+  const std::uint32_t grid = rows / 32 < q2s::kScreenGrid ? rows / 32 : q2s::kScreenGrid;
+  const auto* c = reinterpret_cast<const uint4*>(codes);
+  const auto* x = static_cast<const std::uint8_t*>(xq);
+  if (twin)
+    hipLaunchKernelGGL((Q2ScreenKernel<N, 1>), dim3(grid), dim3(q2s::kScreenThreads), 0, s, c, scales, x, rows, keys);
+  else
+    hipLaunchKernelGGL((Q2ScreenKernel<N, 0>), dim3(grid), dim3(q2s::kScreenThreads), 0, s, c, scales, x, rows, keys);
+}
+
+template <int K>
+void SelectK(const std::uint32_t* keys, std::uint32_t rows, std::uint32_t n, std::uint64_t* cand1, std::uint32_t* ids,
+             std::uint32_t* sel_keys, const void* head, void* compact, std::uint32_t* err, hipStream_t s) {
+  const std::uint32_t chunks = q2s::Chunks(rows);
+  hipLaunchKernelGGL((Q2Sel1Kernel<K>), dim3(chunks, n), dim3(q2s::kSel1Threads), 0, s, keys, rows, cand1, err);
+  const auto* h = static_cast<const uint4*>(head);
+  auto* cp = static_cast<uint4*>(compact);
+  if (compact != nullptr)
+    hipLaunchKernelGGL((Q2Sel2Kernel<K, true>), dim3(n), dim3(q2s::kSel2Threads), 0, s, cand1, chunks, rows, ids,
+                       sel_keys, h, cp, err);
+  else
+    hipLaunchKernelGGL((Q2Sel2Kernel<K, false>), dim3(n), dim3(q2s::kSel2Threads), 0, s, cand1, chunks, rows, ids,
+                       sel_keys, h, cp, err);
+}
+
+}  // namespace
+
+namespace q2l {
+
+void Q2Build(const void* q8, std::uint32_t rows, std::uint8_t* codes, std::uint16_t* scales, std::uint16_t* rbound,
+             hipStream_t s) {
+  const std::uint64_t blocks = static_cast<std::uint64_t>(rows) * q2s::kQ2Blocks;
+  hipLaunchKernelGGL(Q2BuildKernel, dim3(static_cast<unsigned>((blocks + 255) / 256)), dim3(256), 0, s,
+                     static_cast<const std::uint8_t*>(q8), rows, reinterpret_cast<std::uint32_t*>(codes), scales,
+                     rbound);
+}
+
+void StatScreen(const std::uint8_t* codes, const std::uint16_t* scales, const std::uint16_t* rnorm, const void* xq,
+                std::uint32_t rows, std::uint32_t n, float z, std::uint32_t* u_key, std::uint32_t* lo_key,
+                hipStream_t s) {
+  const std::uint32_t grid = rows / 32 < q2s::kScreenGrid ? rows / 32 : q2s::kScreenGrid;
+  const auto* c = reinterpret_cast<const uint4*>(codes);
+  const auto* x = static_cast<const std::uint8_t*>(xq);
+#define Q2S_STAT(NN)                                                                                              \
+  hipLaunchKernelGGL((Q2StatScreenKernel<NN>), dim3(grid), dim3(q2s::kScreenThreads), 0, s, c, scales, rnorm, x, \
+                     rows, z, u_key, lo_key)
+  switch (n) {
+    case 1: Q2S_STAT(1); break;
+    case 2: Q2S_STAT(2); break;
+    case 3: Q2S_STAT(3); break;
+    case 4: Q2S_STAT(4); break;
+    case 8: Q2S_STAT(8); break;
+    default: break;
+  }
+#undef Q2S_STAT
+}
+
+void Thr(const float* best, std::uint32_t n, std::uint32_t* thr, hipStream_t s) {
+  hipLaunchKernelGGL(Q2ThrKernel, dim3(1), dim3(32), 0, s, best, n, thr);
+}
+
+void StatCand(const std::uint32_t* u_key, std::uint32_t rows, std::uint32_t n, const std::uint32_t* thr,
+              std::uint32_t cap, std::uint32_t* cand, std::uint32_t* cnt, hipStream_t s) {
+  const std::uint32_t grid = (rows + 256u * 8u - 1u) / (256u * 8u);
+  hipLaunchKernelGGL(Q2StatCandKernel, dim3(grid, n), dim3(256), 0, s, u_key, rows, thr, cap, cand, cnt);
+}
+
+void Coverage(const float* prod, const std::uint32_t* lo_key, const std::uint32_t* u_key, std::uint32_t rows,
+              std::uint32_t n, std::uint32_t* counters, hipStream_t s) {
+  hipLaunchKernelGGL(Q2CoverageKernel, dim3(512), dim3(256), 0, s, prod, lo_key, u_key,
+                     static_cast<std::size_t>(rows) * n, counters);
+}
+
+void ArgCover(const float* prod, std::uint32_t vocab, const std::int32_t* prod_id, const std::uint32_t* u_key,
+              std::uint32_t n, std::uint32_t* counters, hipStream_t s) {
+  hipLaunchKernelGGL(Q2ArgCoverKernel, dim3(1), dim3(32), 0, s, prod, vocab, prod_id, u_key, n, counters);
+}
+
+void CountGe(const std::uint32_t* u_key, std::uint32_t rows, std::uint32_t n, const std::uint32_t* thr,
+             std::uint32_t* counts, hipStream_t s) {
+  hipLaunchKernelGGL(Q2CountGeKernel, dim3(64, n), dim3(256), 0, s, u_key, rows, thr, counts);
+}
+
+void CheckTop(const float* prod, std::uint32_t vocab, const std::int32_t* prod_id, const std::uint32_t* best_id,
+              const float* best_val, std::uint32_t n, std::uint32_t* counters, hipStream_t s) {
+  hipLaunchKernelGGL(Q2CheckTopKernel, dim3(1), dim3(32), 0, s, prod, vocab, prod_id, best_id, best_val, n, counters);
+}
+
+void Screen(const std::uint8_t* codes, const std::uint16_t* scales, const void* xq, std::uint32_t rows, std::uint32_t n,
+            std::uint32_t* keys, bool twin, hipStream_t s) {
+  switch (n) {
+    case 1: return ScreenN<1>(codes, scales, xq, rows, keys, twin, s);
+    case 2: return ScreenN<2>(codes, scales, xq, rows, keys, twin, s);
+    case 3: return ScreenN<3>(codes, scales, xq, rows, keys, twin, s);
+    case 4: return ScreenN<4>(codes, scales, xq, rows, keys, twin, s);
+    case 8: return ScreenN<8>(codes, scales, xq, rows, keys, twin, s);
+    default: return;
+  }
+}
+
+void Select(const std::uint32_t* keys, std::uint32_t rows, std::uint32_t n, std::uint32_t k, std::uint64_t* cand1,
+            std::uint32_t* ids, std::uint32_t* sel_keys, const void* head, void* compact, std::uint32_t* err,
+            hipStream_t s) {
+  switch (k) {
+    case 8: return SelectK<8>(keys, rows, n, cand1, ids, sel_keys, head, compact, err, s);
+    case 32: return SelectK<32>(keys, rows, n, cand1, ids, sel_keys, head, compact, err, s);
+    case 64: return SelectK<64>(keys, rows, n, cand1, ids, sel_keys, head, compact, err, s);
+    case 128: return SelectK<128>(keys, rows, n, cand1, ids, sel_keys, head, compact, err, s);
+    default: return;
+  }
+}
+
+void FinalCopy(const float* outc, const std::uint32_t* ids, std::uint32_t k, std::uint32_t n, float* resc,
+               std::uint32_t* best_id, float* best_val, hipStream_t s) {
+  hipLaunchKernelGGL(Q2FinalCopyKernel, dim3(n), dim3(256), 0, s, outc, ids, k, n, resc, best_id, best_val);
+}
+
+void CheckBits(const float* prod, std::uint32_t vocab, const std::uint32_t* ids, const float* resc, std::uint32_t k,
+               std::uint32_t stride, const std::uint32_t* counts, std::uint32_t n, std::uint32_t* mismatch,
+               hipStream_t s) {
+  hipLaunchKernelGGL(Q2CheckBitsKernel, dim3(n), dim3(256), 0, s, prod, vocab, ids, resc, k, stride, counts, mismatch);
+}
+
+void Filler(const void* src, void* dst, std::size_t bytes, hipStream_t s) {
+  if (bytes == 0) return;
+  hipLaunchKernelGGL(Q2FillerKernel, dim3(1024), dim3(256), 0, s, static_cast<const uint4*>(src),
+                     static_cast<uint4*>(dst), bytes / 16);
+}
+
+void Spin(std::uint64_t ticks, hipStream_t s) { hipLaunchKernelGGL(Q2SpinKernel, dim3(1), dim3(1), 0, s, ticks); }
+
+}  // namespace q2l
