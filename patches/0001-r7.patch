+// ---------------------------------------------------------------------------
+// Wave3 A1 (a1-lmhead): exact LM-head argmax by
+// bounded screening. Kernels and launchers; README.md has the exactness proof.
+namespace {
+
+constexpr int kA1Blocks = static_cast<int>(kA1K / 32);  // Q8_0/Q8_1 blocks per row
+constexpr double kA1U = 0x1p-24;
+/// gamma_n = n u / (1 - n u) for n = 322: any association of a row's 320 lane
+/// products (each with <= 2 roundings), for both the production GEMV and the
+/// shadow GEMV, however fast-math orders their sums.
+constexpr double kA1Gamma = 322.0 * kA1U / (1.0 - 322.0 * kA1U);
+
+__device__ __forceinline__ float A1RoundUp(double x) {
+  float f = static_cast<float>(x);
+  if (static_cast<double>(f) < x)
+    f = nextafterf(f, INFINITY);
+  return f;
+}
+
+__device__ __forceinline__ double A1XorLane(double v, int offset) {
+  const auto bits = __builtin_bit_cast(unsigned long long, v);
+  const unsigned lo = XorLane(static_cast<unsigned>(bits), offset);
+  const unsigned hi = XorLane(static_cast<unsigned>(bits >> 32), offset);
+  return __builtin_bit_cast(double,
+                            (static_cast<unsigned long long>(hi) << 32) | lo);
+}
+
+__device__ __forceinline__ double A1WaveSum(double v) {
+  v += A1XorLane(v, 16);
+  v += A1XorLane(v, 8);
+  v += A1XorLane(v, 4);
+  v += A1XorLane(v, 2);
+  v += A1XorLane(v, 1);
+  return v;
+}
+
+/// mmq's get_int_b2 / get_int_b4 (2- and 4-byte aligned code words).
+__device__ __forceinline__ int A1Int2(const std::int8_t* qs, int i) {
+  const auto* h = reinterpret_cast<const std::uint16_t*>(qs);
+  return static_cast<int>(static_cast<std::uint32_t>(h[2 * i]) |
+                          (static_cast<std::uint32_t>(h[2 * i + 1]) << 16));
+}
+__device__ __forceinline__ int A1Int4(const std::int8_t* qs, int i) {
+  return reinterpret_cast<const int*>(qs)[i];
+}
+/// ggml_hip_dp4a on RDNA3 (exact integer arithmetic).
+__device__ __forceinline__ int A1Dot4(int a, int b, int c) {
+  return __builtin_amdgcn_sudot4(true, a, true, b, c, false);
+}
+
+/// One head row's logit with mul_mat_vec_q8's per-row arithmetic
+/// (mmq/mmvq.hip.cpp, VDR_Q8_0_Q8_1_MMVQ = 2): lane l takes blocks l/4,
+/// l/4 + 8, ... and the 8 codes at byte 8 (l % 4) of each; every product is
+/// d0 * sumi, rounded, then one fma with d1 into the lane sum (as the production
+/// kernels spell it: mul_mat_vec_q8_ahead, mul_mat_q8_decode_batch); the lanes
+/// reduce in warp_reduce_sum's butterfly order (16, 8, 4, 2, 1). Rows are
+/// independent, so the value equals the production GEMV's at any batch width.
+/// Every lane returns the logit; all 32 lanes must call it together.
+__device__ __forceinline__ float A1ExactDot(const Q8_0Block* __restrict__ w,
+                                            const Q8_1Block* __restrict__ x,
+                                            int lane) {
+  const int part = 2 * (lane & 3);
+  float sum = 0.0f;
+#pragma unroll
+  for (int kb = lane >> 2; kb < kA1Blocks; kb += 8) {
+    const int v0 = A1Int2(w[kb].qs, part);
+    const int v1 = A1Int2(w[kb].qs, part + 1);
+    const int u0 = A1Int4(x[kb].qs, part);
+    const int u1 = A1Int4(x[kb].qs, part + 1);
+    int sumi = A1Dot4(v0, u0, 0);
+    sumi = A1Dot4(v1, u1, sumi);
+    const float p =
+        Materialize(__half2float(w[kb].d) * static_cast<float>(sumi));
+    sum = Materialize(__builtin_fmaf(p, __low2float(x[kb].ds), sum));
+  }
+  sum += XorLane(sum, 16);
+  sum += XorLane(sum, 8);
+  sum += XorLane(sum, 4);
+  sum += XorLane(sum, 2);
+  sum += XorLane(sum, 1);
+  return sum;
+}
+
+/// (a_value, a_index) ranks before (b_value, b_index): larger, then lower index.
+__device__ __forceinline__ bool A1Before(float av, std::int32_t ai, float bv,
+                                         std::int32_t bi) {
+  return av > bv || (av == bv && ai < bi);
+}
+
+// Shadow build: one wave per head row; lane l quantizes blocks l, l + 32, ...
+// The shadow is ideation's q4_0 (a1_screen.py `shadow`): d = f16(m / -8) for the
+// block's first maximum-magnitude value m, codes clamp(rint(w / d), -8, 7). The
+// bound is computed from the stored shadow, so any shadow keeps it sound.
+__global__ __launch_bounds__(256) void A1BuildShadowKernel(
+    const Q8_0Block* __restrict__ weight, std::uint32_t vocab,
+    const float* __restrict__ invd, std::uint32_t* __restrict__ shadow_qs,
+    __half* __restrict__ shadow_d, float* __restrict__ bound,
+    std::uint32_t* __restrict__ stats) {
+  const int lane = static_cast<int>(threadIdx.x & 31u);
+  const std::uint32_t row = blockIdx.x * 8 + (threadIdx.x >> 5);
+  if (row >= vocab)
+    return;  // the whole wave
+  double r2 = 0.0, w2 = 0.0, s2 = 0.0;
+  for (int kb = lane; kb < kA1Blocks; kb += 32) {
+    const Q8_0Block& b = weight[static_cast<std::size_t>(row) * kA1Blocks + kb];
+    const float d8 = __half2float(b.d);
+    float vals[32];
+    float amax = 0.0f, mx = 0.0f;
+#pragma unroll
+    for (int j = 0; j < 32; ++j) {
+      vals[j] = __fmul_rn(d8, static_cast<float>(b.qs[j]));  // exact
+      if (fabsf(vals[j]) > amax) {
+        amax = fabsf(vals[j]);
+        mx = vals[j];
+      }
+    }
+    const __half dh = __float2half_rn(__fdiv_rn(mx, -8.0f));
+    const float df = __half2float(dh);
+    const float inv = df == 0.0f ? 0.0f : __fdiv_rn(1.0f, df);
+    std::uint32_t words[4] = {0, 0, 0, 0};
+#pragma unroll
+    for (int j = 0; j < 32; ++j) {
+      const float q = fminf(fmaxf(rintf(__fmul_rn(vals[j], inv)), -8.0f), 7.0f);
+      const int code = static_cast<int>(q);
+      // Word p holds values 8p..8p+7: byte b = value 8p+b (low nibble) and
+      // value 8p+4+b (high nibble), the order of the input's two code words.
+      words[j >> 3] |= static_cast<std::uint32_t>(code + 8)
+                       << (8 * (j & 3) + 4 * ((j >> 2) & 1));
+      const double s = static_cast<double>(df) * code;
+      const double r = (static_cast<double>(vals[j]) - s) /
+                       static_cast<double>(invd[kb * 32 + j]);
+      r2 += r * r;
+      w2 += static_cast<double>(vals[j]) * vals[j];
+      s2 += s * s;
+    }
+    const std::size_t at = static_cast<std::size_t>(row) * kA1Blocks + kb;
+#pragma unroll
+    for (int p = 0; p < 4; ++p)
+      shadow_qs[at * 4 + p] = words[p];
+    shadow_d[at] = dh;
+  }
+  r2 = A1WaveSum(r2);
+  w2 = A1WaveSum(w2);
+  s2 = A1WaveSum(s2);
+  if (lane == 0) {
+    // Double sums of 2,560 terms are within 1e-12 relative; 1e-7 covers them
+    // and an approximate sqrt.
+    const float nv = A1RoundUp(sqrt(r2) * (1.0 + 1e-7));
+    const float nw = A1RoundUp(sqrt(w2) * (1.0 + 1e-7));
+    const float ns = A1RoundUp(sqrt(s2) * (1.0 + 1e-7));
+    bound[row] = nv;
+    atomicMax(&stats[0], __float_as_uint(nw));
+    atomicMax(&stats[1], __float_as_uint(ns));
+    if (!isfinite(nv) || !isfinite(nw) || !isfinite(ns))
+      atomicOr(&stats[2], 1u);
+  }
+}
+
+/// ||x||_2 and ||x * invd||_2 of each input row (double sums, rounded up; the
+/// second carries the 1 + 2^-20 that keeps fl(bound * norm) >= the real bound).
+/// Also resets the row's candidate count and gather ticket.
+__global__ __launch_bounds__(256) void A1NormsKernel(
+    const Q8_1Block* __restrict__ x, std::uint32_t stride,
+    const float* __restrict__ invd, float* __restrict__ norms,
+    std::uint32_t* __restrict__ count, std::uint32_t* __restrict__ ticket) {
+  const std::uint32_t r = blockIdx.x;
+  double a = 0.0, b = 0.0;
+  for (std::uint32_t i = threadIdx.x; i < kA1K; i += 256) {
+    const Q8_1Block& blk = x[static_cast<std::size_t>(r) * stride + i / 32];
+    const double v = static_cast<double>(__low2float(blk.ds)) * blk.qs[i % 32];
+    const double s = v * static_cast<double>(invd[i]);  // exact (43 bits)
+    a += v * v;
+    b += s * s;
+  }
+  a = A1WaveSum(a);
+  b = A1WaveSum(b);
+  __shared__ double sa[8], sb[8];
+  if ((threadIdx.x & 31u) == 0) {
+    sa[threadIdx.x >> 5] = a;
+    sb[threadIdx.x >> 5] = b;
+  }
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    double ta = 0.0, tb = 0.0;
+    for (int w = 0; w < 8; ++w) {
+      ta += sa[w];
+      tb += sb[w];
+    }
+    norms[2 * r] = A1RoundUp(sqrt(ta) * (1.0 + 1e-7));
+    norms[2 * r + 1] = A1RoundUp(sqrt(tb) * (1.0 + 1e-7) * (1.0 + 0x1p-20));
+    count[r] = 0;
+    ticket[r] = 0;
+  }
+}
+
+/// One level of mmq's scatter_reduce_sum: the lane on the `kOff` side keeps
+/// the upper half of `kN` sums, its partner the lower half.
+template<int kOff, int kN>
+__device__ __forceinline__ void A1Level(float* s, int lane) {
+  const bool upper = (lane & kOff) != 0;
+#pragma unroll
+  for (int i = 0; i < kN / 2; ++i) {
+    const float keep = upper ? s[kN / 2 + i] : s[i];
+    const float send = upper ? s[i] : s[kN / 2 + i];
+    s[i] = keep + XorLane(send, kOff);
+  }
+}
+
+/// Reduce-scatter of kRows (1..32, a power of two) lane sums: the levels of
+/// scatter_reduce_sum, then the butterfly's remaining offsets. s[0] then holds
+/// the sum of row A1Owner<kRows>(lane).
+template<int kOff, int kN>
+__device__ __forceinline__ void A1ScatterFrom(float* s, int lane) {
+  if constexpr (kN > 1) {
+    A1Level<kOff, kN>(s, lane);
+    A1ScatterFrom<kOff / 2, kN / 2>(s, lane);
+  } else if constexpr (kOff >= 1) {
+    s[0] += XorLane(s[0], kOff);
+    A1ScatterFrom<kOff / 2, 1>(s, lane);
+  }
+}
+template<int kRows>
+__device__ __forceinline__ void A1Scatter(float* s, int lane) {
+  static_assert(kRows >= 1 && kRows <= 32 && (kRows & (kRows - 1)) == 0);
+  A1ScatterFrom<16, kRows>(s, lane);
+}
+
+template<int kRows>
+constexpr int A1Levels() {
+  return kRows >= 32 ? 5 : kRows >= 16 ? 4 : kRows >= 8 ? 3 : kRows >= 4 ? 2
+                                                     : kRows >= 2 ? 1 : 0;
+}
+
+template<int kRows>
+__device__ __forceinline__ int A1Owner(int lane) {
+  constexpr int levels = A1Levels<kRows>();
+  int owner = 0;
+#pragma unroll
+  for (int k = 0; k < levels; ++k)
+    owner |= ((lane >> (4 - k)) & 1) << (levels - 1 - k);
+  return owner;
+}
+
+/// Inserts (u, v) into a descending top-kA1TileWinners list; rows arrive in
+/// ascending order, so an equal ub never displaces an earlier (lower) row.
+__device__ __forceinline__ void A1Keep(float* best, std::int32_t* ids, float u,
+                                       std::int32_t v) {
+  if (!(u > best[kA1TileWinners - 1]))
+    return;
+#pragma unroll
+  for (int k = static_cast<int>(kA1TileWinners) - 1; k >= 0; --k) {
+    if (k > 0 && u > best[k - 1]) {
+      best[k] = best[k - 1];
+      ids[k] = ids[k - 1];
+    } else {
+      best[k] = u;
+      ids[k] = v;
+      return;
+    }
+  }
+}
+
+// Shadow GEMV and bounds. A block covers one tile of kA1BlockRows vocabulary
+// rows, each of its 8 waves kA1WaveRows consecutive rows. Per row the lanes take
+// the exact kernel's blocks; the shadow product of 8 codes is an exact integer:
+//   sum (n - 8) u = dot(n_lo, u0) + dot(n_hi, u1) - 8 (sum u0 + sum u1).
+// ub = fma(bound, m, s), lb = fma(-bound, m, s). Per input row, the tile reports
+// its kA1TileWinners best ub (ties: lowest index) and its largest lb.
+template<int kRows>
+__global__ __launch_bounds__(256) void A1ShadowKernel(
+    const std::uint32_t* __restrict__ shadow_qs,
+    const __half* __restrict__ shadow_d, const float* __restrict__ bound,
+    const Q8_1Block* __restrict__ x, std::uint32_t stride, std::uint32_t rows,
+    std::uint32_t vocab, const float* __restrict__ norms,
+    float* __restrict__ ub_out, float* __restrict__ win_ub,
+    std::int32_t* __restrict__ win_id, float* __restrict__ win_lb,
+    std::uint32_t tiles) {
+  constexpr int kW = static_cast<int>(kA1TileWinners);
+  const int lane = static_cast<int>(threadIdx.x & 31u);
+  const int wave = static_cast<int>(threadIdx.x >> 5);
+  const int part = lane & 3;
+  const int mine = A1Owner<kRows>(lane);
+  constexpr int levels = A1Levels<kRows>();
+  const bool writer = (lane & ((1 << (5 - levels)) - 1)) == 0;
+  const bool active = mine < static_cast<int>(rows);
+  const float m = active ? norms[2 * mine + 1] : 0.0f;
+  const std::uint32_t first = blockIdx.x * kA1BlockRows + wave * kA1WaveRows;
+  float best[kW];
+  std::int32_t best_id[kW];
+#pragma unroll
+  for (int k = 0; k < kW; ++k) {
+    best[k] = -INFINITY;
+    best_id[k] = INT32_MAX;
+  }
+  float lbmax = -INFINITY;
+  for (std::uint32_t i = 0; i < kA1WaveRows; ++i) {
+    const std::uint32_t v = first + i;
+    if (v >= vocab)
+      break;  // uniform across the wave
+    float acc[kRows];
+#pragma unroll
+    for (int r = 0; r < kRows; ++r)
+      acc[r] = 0.0f;
+#pragma unroll
+    for (int kb = lane >> 2; kb < kA1Blocks; kb += 8) {
+      const std::size_t at = static_cast<std::size_t>(v) * kA1Blocks + kb;
+      const std::uint32_t word = shadow_qs[at * 4 + part];
+      const float d4 = __half2float(shadow_d[at]);
+      const int lo = static_cast<int>(word & 0x0F0F0F0Fu);
+      const int hi = static_cast<int>((word >> 4) & 0x0F0F0F0Fu);
+#pragma unroll
+      for (int r = 0; r < kRows; ++r) {
+        const int rr =
+            r < static_cast<int>(rows) ? r : static_cast<int>(rows) - 1;
+        const Q8_1Block& y = x[static_cast<std::size_t>(rr) * stride + kb];
+        const int u0 = A1Int4(y.qs, 2 * part);
+        const int u1 = A1Int4(y.qs, 2 * part + 1);
+        int sumi = A1Dot4(lo, u0, 0);
+        sumi = A1Dot4(hi, u1, sumi);
+        const int sx = A1Dot4(0x01010101, u0, A1Dot4(0x01010101, u1, 0));
+        sumi -= 8 * sx;
+        acc[r] = __builtin_fmaf(d4 * static_cast<float>(sumi),
+                                __low2float(y.ds), acc[r]);
+      }
+    }
+    A1Scatter<kRows>(acc, lane);
+    if (active) {
+      const float nv = bound[v];
+      const float u = __builtin_fmaf(nv, m, acc[0]);
+      const float l = __builtin_fmaf(-nv, m, acc[0]);
+      if (writer)
+        ub_out[static_cast<std::size_t>(mine) * vocab + v] = u;
+      A1Keep(best, best_id, u, static_cast<std::int32_t>(v));
+      lbmax = fmaxf(lbmax, l);
+    }
+  }
+  __shared__ float s_ub[8][kRows][kW];
+  __shared__ std::int32_t s_id[8][kRows][kW];
+  __shared__ float s_lb[8][kRows];
+  if (writer && active) {
+#pragma unroll
+    for (int k = 0; k < kW; ++k) {
+      s_ub[wave][mine][k] = best[k];
+      s_id[wave][mine][k] = best_id[k];
+    }
+    s_lb[wave][mine] = lbmax;
+  }
+  __syncthreads();
+  if (threadIdx.x < rows) {
+    const int r = static_cast<int>(threadIdx.x);
+    float b[kW];
+    std::int32_t bi[kW];
+#pragma unroll
+    for (int k = 0; k < kW; ++k) {
+      b[k] = -INFINITY;
+      bi[k] = INT32_MAX;
+    }
+    float l = -INFINITY;
+    // Waves in row order: an equal ub from a later wave is a higher index.
+    for (int w = 0; w < 8; ++w) {
+      for (int k = 0; k < kW; ++k)
+        if (s_id[w][r][k] != INT32_MAX)
+          A1Keep(b, bi, s_ub[w][r][k], s_id[w][r][k]);
+      l = fmaxf(l, s_lb[w][r]);
+    }
+    const std::size_t at =
+        (static_cast<std::size_t>(r) * tiles + blockIdx.x) * kW;
+#pragma unroll
+    for (int k = 0; k < kW; ++k) {
+      win_ub[at + k] = b[k];
+      win_id[at + k] = bi[k];
+    }
+    win_lb[static_cast<std::size_t>(r) * tiles + blockIdx.x] = l;
+  }
+}
+
+// Threshold: one 1024-thread block per input row. The tile winners are sorted
+// by ub (bitonic, descending, ties to the lower index); the exact logits of the
+// best kA1Refine of them and the largest lb give
+//   T = max(lb_max - 2u|lb_max| - E, max exact - 2 E),
+//   E = gamma_322 (max||W|| + max||S||) ||x||_2 (1 + 1e-3).
+// T <= the production maximum (README). NaN T marks the row for the full head.
+__global__ __launch_bounds__(1024) void A1RefineKernel(
+    const Q8_0Block* __restrict__ weight, const Q8_1Block* __restrict__ x,
+    std::uint32_t stride, const float* __restrict__ norms,
+    const float* __restrict__ win_ub, const std::int32_t* __restrict__ win_id,
+    const float* __restrict__ win_lb, std::uint32_t tiles, float wmax,
+    float smax, double* __restrict__ threshold) {
+  const std::uint32_t winners = tiles * kA1TileWinners;
+  const std::uint32_t r = blockIdx.x;
+  const int tid = static_cast<int>(threadIdx.x);
+  const int lane = tid & 31, wave = tid >> 5;
+  __shared__ float key[kA1MaxWinners];
+  __shared__ std::int32_t ids[kA1MaxWinners];
+  __shared__ float lbm[32];
+  __shared__ float exact[kA1Refine];
+  float l = -INFINITY;
+  for (int i = tid; i < static_cast<int>(kA1MaxWinners); i += 1024) {
+    const bool in = i < static_cast<int>(winners);
+    const std::size_t at = static_cast<std::size_t>(r) * winners + i;
+    key[i] = in ? win_ub[at] : -INFINITY;
+    ids[i] = in ? win_id[at] : INT32_MAX;
+  }
+  for (int i = tid; i < static_cast<int>(tiles); i += 1024)
+    l = fmaxf(l, win_lb[static_cast<std::size_t>(r) * tiles + i]);
+  for (int o = 16; o > 0; o >>= 1)
+    l = fmaxf(l, XorLane(l, o));
+  if (lane == 0)
+    lbm[wave] = l;
+  __syncthreads();
+  for (int k = 2; k <= static_cast<int>(kA1MaxWinners); k <<= 1) {
+    for (int j = k >> 1; j > 0; j >>= 1) {
+      for (int i = tid; i < static_cast<int>(kA1MaxWinners); i += 1024) {
+        const int p = i ^ j;
+        if (p > i) {
+          const bool first = (i & k) == 0;
+          const bool swap = first ? A1Before(key[p], ids[p], key[i], ids[i])
+                                  : A1Before(key[i], ids[i], key[p], ids[p]);
+          if (swap) {
+            const float tk = key[i];
+            key[i] = key[p];
+            key[p] = tk;
+            const std::int32_t ti = ids[i];
+            ids[i] = ids[p];
+            ids[p] = ti;
+          }
+        }
+      }
+      __syncthreads();
+    }
+  }
+  // 32 waves, two refinement rows each.
+  for (int j = wave; j < static_cast<int>(kA1Refine); j += 32) {
+    const std::int32_t v = ids[j];
+    float value = NAN;
+    if (v != INT32_MAX && key[j] > -INFINITY)
+      value = A1ExactDot(weight + static_cast<std::size_t>(v) * kA1Blocks,
+                         x + static_cast<std::size_t>(r) * stride, lane);
+    if (lane == 0)
+      exact[j] = value;
+  }
+  __syncthreads();
+  if (tid == 0) {
+    float lb = -INFINITY;
+    for (int w = 0; w < 32; ++w)
+      lb = fmaxf(lb, lbm[w]);
+    float best = -INFINITY;
+    bool any = false;
+    for (int j = 0; j < static_cast<int>(kA1Refine); ++j)
+      if (isfinite(exact[j]) && (!any || exact[j] > best)) {
+        best = exact[j];
+        any = true;
+      }
+    const double xn = norms[2 * r];
+    const double E = kA1Gamma *
+                     (static_cast<double>(wmax) + static_cast<double>(smax)) *
+                     xn * (1.0 + 1e-3);
+    const double lbd = lb;
+    double T = lbd - 2.0 * kA1U * fabs(lbd) - E;
+    if (any)
+      T = fmax(T, static_cast<double>(best) - 2.0 * E);
+    const bool ok = isfinite(T) && isfinite(E) && isfinite(xn) &&
+                    isfinite(norms[2 * r + 1]);
+    threshold[2 * r] = ok ? T : NAN;
+    threshold[2 * r + 1] = E;
+  }
+}
+
+// Candidates: rows with ub + 2u|ub| + E (+ a 2^-40 (1 + |T|) slack for the
+// double arithmetic) not below T. A NaN ub is a candidate. Counts past kA1Cap
+// keep counting (the row then takes the full head).
+__global__ __launch_bounds__(256) void A1CompactKernel(
+    const float* __restrict__ ub, std::uint32_t vocab,
+    const double* __restrict__ threshold, std::uint32_t* __restrict__ count,
+    std::uint32_t* __restrict__ cand) {
+  const std::uint32_t r = blockIdx.y;
+  const double T = threshold[2 * r];
+  const double E = threshold[2 * r + 1];
+  if (!isfinite(T)) {  // uniform
+    if (blockIdx.x == 0 && threadIdx.x == 0)
+      atomicMax(&count[r], kA1Cap + 1);
+    return;
+  }
+  const double slack = 0x1p-40 * (1.0 + fabs(T));
+  const float* row = ub + static_cast<std::size_t>(r) * vocab;
+  const int lane = static_cast<int>(threadIdx.x & 31u);
+  for (std::uint32_t base = blockIdx.x * 1024; base < vocab;
+       base += gridDim.x * 1024) {
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+      const std::uint32_t v = base + j * 256 + threadIdx.x;
+      bool in = false;
+      if (v < vocab) {
+        const double u = row[v];
+        in = !(u + 2.0 * kA1U * fabs(u) + E + slack < T);
+      }
+      const auto mask = static_cast<std::uint32_t>(__ballot(in));
+      if (mask != 0) {
+        std::uint32_t at = 0;
+        if (lane == 0)
+          at = atomicAdd(&count[r], static_cast<std::uint32_t>(__popc(mask)));
+        at = __shfl(at, 0);
+        if (in) {
+          const std::uint32_t k =
+              at + static_cast<std::uint32_t>(__popc(mask & ((1u << lane) - 1u)));
+          if (k < kA1Cap)
+            cand[static_cast<std::size_t>(r) * kA1Cap + k] = v;
+        }
+      }
+    }
+  }
+}
+
+// Exact logits of the candidates (one wave per candidate) and the argmax,
+// lowest index among equal finite maxima. The last block of a row (ticket)
+// reduces the partials and writes the row's checked result.
+__global__ __launch_bounds__(256) void A1GatherKernel(
+    const Q8_0Block* __restrict__ weight, const Q8_1Block* __restrict__ x,
+    std::uint32_t stride, std::uint32_t vocab,
+    const std::uint32_t* __restrict__ count,
+    const std::uint32_t* __restrict__ cand, const double* __restrict__ threshold,
+    float* __restrict__ logits, A1Partial* partial,
+    std::uint32_t* __restrict__ ticket, A1Result* __restrict__ result,
+    const std::uint32_t* nonce) {
+  const std::uint32_t r = blockIdx.y;
+  const int lane = static_cast<int>(threadIdx.x & 31u);
+  const int wave = static_cast<int>(threadIdx.x >> 5);
+  const std::uint32_t n = count[r];
+  const bool overflow = n > kA1Cap;
+  float best = -INFINITY;
+  std::int32_t best_id = INT32_MAX;
+  if (!overflow) {
+    for (std::uint32_t j = blockIdx.x * 8 + wave; j < n;
+         j += kA1GatherBlocks * 8) {
+      const std::uint32_t v = cand[static_cast<std::size_t>(r) * kA1Cap + j];
+      const float value =
+          A1ExactDot(weight + static_cast<std::size_t>(v) * kA1Blocks,
+                     x + static_cast<std::size_t>(r) * stride, lane);
+      if (lane == 0)
+        logits[static_cast<std::size_t>(r) * vocab + v] = value;
+      if (isfinite(value) &&
+          (best_id == INT32_MAX ||
+           A1Before(value, static_cast<std::int32_t>(v), best, best_id))) {
+        best = value;
+        best_id = static_cast<std::int32_t>(v);
+      }
+    }
+  }
+  __shared__ A1Partial waves[8];
+  __shared__ bool last;
+  if (lane == 0)
+    waves[wave] = {best, best_id};
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    A1Partial b{-INFINITY, INT32_MAX};
+    for (int w = 0; w < 8; ++w)
+      if (waves[w].index != INT32_MAX &&
+          (b.index == INT32_MAX ||
+           A1Before(waves[w].value, waves[w].index, b.value, b.index)))
+        b = waves[w];
+    partial[r * kA1GatherBlocks + blockIdx.x] = b;
+    __threadfence();
+    last = atomicAdd(&ticket[r], 1u) == kA1GatherBlocks - 1;
+  }
+  __syncthreads();
+  if (!last || threadIdx.x != 0)
+    return;
+  __threadfence();
+  A1Partial f{-INFINITY, INT32_MAX};
+  for (std::uint32_t g = 0; g < kA1GatherBlocks; ++g) {
+    const volatile A1Partial& q = partial[r * kA1GatherBlocks + g];
+    const A1Partial p{q.value, q.index};
+    if (p.index != INT32_MAX &&
+        (f.index == INT32_MAX || A1Before(p.value, p.index, f.value, f.index)))
+      f = p;
+  }
+  A1Result out{};
+  out.count = n;
+  if (overflow || !isfinite(threshold[2 * r])) {
+    out.value = NAN;
+    out.index = -2;
+  } else if (f.index == INT32_MAX) {
+    out.value = NAN;
+    out.index = -1;
+  } else {
+    out.value = f.value;
+    out.index = f.index;
+  }
+  out.nonce = *static_cast<const volatile std::uint32_t*>(nonce);
+  out.check = A1Check(out.value, out.index, out.count, out.nonce, r);
+  result[r] = out;
+}
+
+struct A1ShadowArgs {
+  const A1Head& head;
+  const A1Scratch& s;
+  const Q8_1Block* in;
+  std::uint32_t stride, rows, tiles;
+  hipStream_t stream;
+};
+
+template<int kRows>
+void A1LaunchShadow(const A1ShadowArgs& a) {
+  hipLaunchKernelGGL(A1ShadowKernel<kRows>, dim3(a.tiles), dim3(256), 0,
+                     a.stream, a.head.shadow_qs, a.head.shadow_d, a.head.bound,
+                     a.in, a.stride, a.rows, a.head.vocab, a.s.norms, a.s.ub,
+                     a.s.win_ub, a.s.win_id, a.s.win_lb, a.tiles);
+}
+
+// Wave3 DH-TOP2 (dh-top2): the k = 2 threshold. A1RefineKernel's
+// sort and exact refinement of the best kA1Refine tile winners, verbatim, for
+// ONE input row (blockIdx.x = 0); the threshold is the SECOND largest finite
+// exact logit among those (distinct) rows minus 2E:
+//   T2 = exact_(2) - 2E <= the production second-largest logit
+// (two distinct rows each have a production logit >= exact - 2E >= T2).
+// Fewer than two finite refine values, or a non-finite T2 / E / norm, marks
+// the row for the full head (NaN T2).
+__global__ __launch_bounds__(1024) void A1T2RefineKernel(
+    const Q8_0Block* __restrict__ weight, const Q8_1Block* __restrict__ x,
+    std::uint32_t stride, const float* __restrict__ norms,
+    const float* __restrict__ win_ub, const std::int32_t* __restrict__ win_id,
+    std::uint32_t tiles, float wmax, float smax,
+    double* __restrict__ threshold) {
+  const std::uint32_t winners = tiles * kA1TileWinners;
+  const std::uint32_t r = blockIdx.x;
+  const int tid = static_cast<int>(threadIdx.x);
+  const int lane = tid & 31, wave = tid >> 5;
+  __shared__ float key[kA1MaxWinners];
+  __shared__ std::int32_t ids[kA1MaxWinners];
+  __shared__ float exact[kA1Refine];
+  for (int i = tid; i < static_cast<int>(kA1MaxWinners); i += 1024) {
+    const bool in = i < static_cast<int>(winners);
+    const std::size_t at = static_cast<std::size_t>(r) * winners + i;
+    key[i] = in ? win_ub[at] : -INFINITY;
+    ids[i] = in ? win_id[at] : INT32_MAX;
+  }
+  __syncthreads();
+  for (int k = 2; k <= static_cast<int>(kA1MaxWinners); k <<= 1) {
+    for (int j = k >> 1; j > 0; j >>= 1) {
+      for (int i = tid; i < static_cast<int>(kA1MaxWinners); i += 1024) {
+        const int p = i ^ j;
+        if (p > i) {
+          const bool first = (i & k) == 0;
+          const bool swap = first ? A1Before(key[p], ids[p], key[i], ids[i])
+                                  : A1Before(key[i], ids[i], key[p], ids[p]);
+          if (swap) {
+            const float tk = key[i];
+            key[i] = key[p];
+            key[p] = tk;
+            const std::int32_t ti = ids[i];
+            ids[i] = ids[p];
+            ids[p] = ti;
+          }
+        }
+      }
+      __syncthreads();
+    }
+  }
+  for (int j = wave; j < static_cast<int>(kA1Refine); j += 32) {
+    const std::int32_t v = ids[j];
+    float value = NAN;
+    if (v != INT32_MAX && key[j] > -INFINITY)
+      value = A1ExactDot(weight + static_cast<std::size_t>(v) * kA1Blocks,
+                         x + static_cast<std::size_t>(r) * stride, lane);
+    if (lane == 0)
+      exact[j] = value;
+  }
+  __syncthreads();
+  if (tid == 0) {
+    // b2: the second order statistic (with multiplicity) of the finite exact
+    // values of the distinct refine rows.
+    int finite = 0;
+    const float b2 = A1SecondFinite(exact, static_cast<int>(kA1Refine), &finite);
+    const double xn = norms[2 * r];
+    const double E = kA1Gamma *
+                     (static_cast<double>(wmax) + static_cast<double>(smax)) *
+                     xn * (1.0 + 1e-3);
+    const double T = static_cast<double>(b2) - 2.0 * E;
+    const bool ok = finite >= 2 && isfinite(T) && isfinite(E) &&
+                    isfinite(xn) && isfinite(norms[2 * r + 1]);
+    threshold[2 * r] = ok ? T : NAN;
+    threshold[2 * r + 1] = E;
+  }
+}
+
+// Wave3 DH-TOP2: exact logits of the candidates (one wave per candidate,
+// A1ExactDot = production's per-row arithmetic) and their best two in
+// production's MtpTopCandidates order (A1Top2Before). The last block (ticket)
+// merges the block lists and writes the checked A1Top2Result.
+__global__ __launch_bounds__(256) void A1T2GatherKernel(
+    const Q8_0Block* __restrict__ weight, const Q8_1Block* __restrict__ x,
+    const std::uint32_t* __restrict__ count,
+    const std::uint32_t* __restrict__ cand, const double* __restrict__ threshold,
+    float* __restrict__ logits, A1Top2Partial* partial,
+    std::uint32_t* __restrict__ ticket, A1Top2Result* __restrict__ result,
+    const std::uint32_t* nonce) {
+  const int lane = static_cast<int>(threadIdx.x & 31u);
+  const int wave = static_cast<int>(threadIdx.x >> 5);
+  const std::uint32_t n = count[0];
+  const bool overflow = n > kA1Cap;
+  A1Top2 best = A1Top2Empty();
+  bool bad = false;
+  if (!overflow) {
+    for (std::uint32_t j = blockIdx.x * 8 + wave; j < n; j += gridDim.x * 8) {
+      const std::uint32_t v = cand[j];
+      const float value = A1ExactDot(
+          weight + static_cast<std::size_t>(v) * kA1Blocks, x, lane);
+      if (lane == 0 && logits != nullptr)
+        logits[v] = value;
+      if (!isfinite(value))
+        bad = true;
+      else
+        A1Top2Insert(best, value, static_cast<std::int32_t>(v));
+    }
+  }
+  __shared__ A1Top2 waves[8];
+  __shared__ bool wbad[8];
+  __shared__ bool last;
+  if (lane == 0) {
+    waves[wave] = best;
+    wbad[wave] = bad;
+  }
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    A1Top2Partial b{A1Top2Empty(), 0u, 0u};
+    for (int w = 0; w < 8; ++w) {
+      for (int k = 0; k < 2; ++k)
+        if (waves[w].index[k] != INT32_MAX)
+          A1Top2Insert(b.best, waves[w].value[k], waves[w].index[k]);
+      b.bad |= wbad[w] ? 1u : 0u;
+    }
+    partial[blockIdx.x] = b;
+    __threadfence();
+    last = atomicAdd(ticket, 1u) == gridDim.x - 1;
+  }
+  __syncthreads();
+  if (!last || threadIdx.x != 0)
+    return;
+  __threadfence();
+  A1Top2 f = A1Top2Empty();
+  std::uint32_t anybad = 0;
+  for (std::uint32_t g = 0; g < gridDim.x; ++g) {
+    const volatile A1Top2Partial& q = partial[g];
+    for (int k = 0; k < 2; ++k) {
+      const std::int32_t i = q.best.index[k];
+      const float v = q.best.value[k];
+      if (i != INT32_MAX)
+        A1Top2Insert(f, v, i);
+    }
+    anybad |= q.bad;
+  }
+  A1Top2Result out{};
+  out.count = n;
+  if (overflow || !isfinite(threshold[0]) || anybad != 0 ||
+      f.index[1] == INT32_MAX) {
+    out.value[0] = NAN;
+    out.value[1] = NAN;
+    out.index[0] = -2;
+    out.index[1] = -2;
+    out.status = -2;
+  } else {
+    out.value[0] = f.value[0];
+    out.value[1] = f.value[1];
+    out.index[0] = f.index[0];
+    out.index[1] = f.index[1];
+    out.status = 0;
+  }
+  out.nonce = *static_cast<const volatile std::uint32_t*>(nonce);
+  out.check = A1Top2Check(out);
+  *result = out;
+}
+
+}  // namespace
+
+bool A1BuildShadow(const void* weight, std::uint32_t vocab, const float* invd,
+                   std::uint32_t* shadow_qs, __half* shadow_d, float* bound,
+                   std::uint32_t* stats, hipStream_t stream) {
+  hipLaunchKernelGGL(A1BuildShadowKernel, dim3((vocab + 7) / 8), dim3(256), 0,
+                     stream, static_cast<const Q8_0Block*>(weight), vocab, invd,
+                     shadow_qs, shadow_d, bound, stats);
+  return hipGetLastError() == hipSuccess;
 }
 
+void A1Screen(const A1Head& head, const A1Scratch& s, const void* x,
+              std::uint32_t stride, std::uint32_t rows, float* logits,
+              const std::uint32_t* nonce, hipStream_t stream) {
+  const auto* in = static_cast<const Q8_1Block*>(x);
+  const auto* weight = static_cast<const Q8_0Block*>(head.weight);
+  const std::uint32_t tiles = (head.vocab + kA1BlockRows - 1) / kA1BlockRows;
+  hipLaunchKernelGGL(A1NormsKernel, dim3(rows), dim3(256), 0, stream, in,
+                     stride, head.invd, s.norms, s.count, s.ticket);
+  const A1ShadowArgs a{head, s, in, stride, rows, tiles, stream};
+  if (rows <= 1)
+    A1LaunchShadow<1>(a);
+  else if (rows <= 2)
+    A1LaunchShadow<2>(a);
+  else if (rows <= 4)
+    A1LaunchShadow<4>(a);
+  else if (rows <= 8)
+    A1LaunchShadow<8>(a);
+  else if (rows <= 16)
+    A1LaunchShadow<16>(a);
+  else
+    A1LaunchShadow<32>(a);
+  hipLaunchKernelGGL(A1RefineKernel, dim3(rows), dim3(1024), 0, stream, weight,
+                     in, stride, s.norms, s.win_ub, s.win_id, s.win_lb, tiles,
+                     head.wmax, head.smax, s.threshold);
+  hipLaunchKernelGGL(A1CompactKernel, dim3((head.vocab + 1023) / 1024, rows),
+                     dim3(256), 0, stream, s.ub, head.vocab, s.threshold,
+                     s.count, s.cand);
+  hipLaunchKernelGGL(A1GatherKernel, dim3(kA1GatherBlocks, rows), dim3(256), 0,
+                     stream, weight, in, stride, head.vocab, s.count, s.cand,
+                     s.threshold, logits, s.partial, s.ticket, s.result, nonce);
+}
+
+// Wave3 DH-TOP2 (dh-top2): A1Screen's five launches for ONE row with
+// the k = 2 threshold and the top-2 gather (README.md section 3).
+void A1ScreenTop2(const A1Head& head, const A1Scratch& s, const void* x,
+                  A1Top2Partial* partial, A1Top2Result* result, float* logits,
+                  const std::uint32_t* nonce, hipStream_t stream) {
+  const auto* in = static_cast<const Q8_1Block*>(x);
+  const auto* weight = static_cast<const Q8_0Block*>(head.weight);
+  const std::uint32_t tiles = (head.vocab + kA1BlockRows - 1) / kA1BlockRows;
+  constexpr std::uint32_t stride = kA1K / 32;  // one row: never advanced
+  hipLaunchKernelGGL(A1NormsKernel, dim3(1), dim3(256), 0, stream, in, stride,
+                     head.invd, s.norms, s.count, s.ticket);
+  A1LaunchShadow<1>(A1ShadowArgs{head, s, in, stride, 1, tiles, stream});
+  hipLaunchKernelGGL(A1T2RefineKernel, dim3(1), dim3(1024), 0, stream, weight,
+                     in, stride, s.norms, s.win_ub, s.win_id, tiles, head.wmax,
+                     head.smax, s.threshold);
+  hipLaunchKernelGGL(A1CompactKernel, dim3((head.vocab + 1023) / 1024, 1),
+                     dim3(256), 0, stream, s.ub, head.vocab, s.threshold,
+                     s.count, s.cand);
+  hipLaunchKernelGGL(A1T2GatherKernel, dim3(kA1T2GatherBlocks), dim3(256), 0,
+                     stream, weight, in, s.count, s.cand, s.threshold, logits,
+                     partial, s.ticket, result, nonce);
+}
