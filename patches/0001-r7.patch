+#ifndef GUFO_CORE_CHAT_PATH_HPP_
+#define GUFO_CORE_CHAT_PATH_HPP_
+
+// Wave3 chat-path (chat-path/README.md).
+// Env-gated chat features; every one is OFF unless its variable is set.
+//
+//   GUFO_CHAT_PEN_DRAFT=1      R3-11 penalty-aware greedy drafting (relaxed)
+//   GUFO_CHAT_PEN_H1=0|1       R3-11 H1 head + confidence stop for penalized
+//                              greedy (default: = GUFO_CHAT_PEN_DRAFT)
+//   GUFO_CHAT_SSTOP=1          R3-12 sampled confidence stop (relaxed)
+//     _SIGNAL=qtop|qdraw       stop signal: max q, or q of the drawn draft
+//     _FLOOR=v|v1..v7          stop after a draft whose signal <= floor[d]
+//     _DROP=v|v1..v7           do not draw draft d when max q <= drop[d]
+//     _HIDE=floor|v            rejection after signal <= hide is censored
+//     _GATE=solo|all           solo: unplanned cycles of a lone request only
+//   GUFO_CHAT_SPLAN=1          R3-13 planned widths for sampled cohorts
+//   GUFO_CHAT_SPRICE=occupancy|measured  CH-1 price unplanned sampled cycles
+//                              at the live occupancy (as greedy) instead of
+//                              the configured --sessions row; `measured` uses
+//                              the measured C1 cycle costs when alone (relaxed)
+//   GUFO_CHAT_SXF=1|relaxed    R3-33 short-extension-first (1 = all levels)
+//     _ROWS=n                  extension size limit (default 256)
+//   GUFO_CHAT_PREWARM=strict|relaxed|1   R3-10/51/60 (1 = relaxed)
+//     _CHUNK=n                 rows per pre-prefill pass (multiple of 128)
+//     _MAX_ROWS=n              largest pre-prefill (r..L) span (default 1920)
+//     _RENDER=auto|strip|keep  reasoning in the predicted history
+//     _FIRST=strip|keep        auto's choice on a conversation's first turn
+//     _TTL_S=s                 registry lifetime (default 900)
+//     _REWARM=0|1              R3-60 soft pin (default 1)
+//     _CONVERSATIONS=n         registry size (default 8)
+//   GUFO_CHAT_TRACE=1          per-event log lines + periodic counters
+//
+// Modes: kRelaxed applies to requests granted relaxed or higher only; kStrict
+// applies to every request (claimed only once the GPU STRICT gate passed).
