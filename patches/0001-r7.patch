+    Note(s, "fused-b", n, b);
+    s.fused_seen[n] = true;
+  }
+  bool swept = false;
+  if (n >= w3hcd::kSweepMinRows && s.sweeps < w3hcd::kSweepMax && (s.wide_calls++ % w3hcd::kSweepEvery) == 0) {
