+  if (!built)
+    return refuse("q2_build");
+  d.q2_bytes = std::size_t{V} * q2s::kQ2RowBytes;
+  d.build_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+  d.mode = cfg.mode;
+  d.check = cfg.check;
