+// ---------------------------------------------------------------------------
+// Wave3 H1 (h1-grammar-drafting). A token
+// constraint changes which token FinishDecode selects from a verified row
+// (CanSelectArgmax / masked selection), never the row itself, so greedy
+// constrained requests may draft like plain greedy ones: small draft head
+// and confidence stop. GUFO_H1=0 restores the production gating;
+// GUFO_H1_MASK=1 also ends a constrained chain at a draft its grammar forbids.
+namespace {
+
+bool H1Enabled() {
+  // Wave3 XM: unset = the relaxed table's default (xm_relaxed_policy.hpp).
+  static const bool on =
+      XmRelaxedKnob(std::getenv("GUFO_H1"), kXmRelaxedDefaults.h1);
+  return on;
+}
+
+bool H1Mask() {
+  static const bool on = [] {
+    const char* v = std::getenv("GUFO_H1_MASK");
+    return v != nullptr && v[0] == '1' && v[1] == '\0';
+  }();
+  return on;
+}
+
+std::atomic<std::uint64_t> g_h1_cycles{0}, g_h1_small{0}, g_h1_mask_ends{0};
+
+void H1Stats() {
+  static const bool stats = std::getenv("GUFO_H1_STATS") != nullptr;
+  if (stats)
+    std::fprintf(stderr,
+                 "event=h1_stats cycles=%llu small_head=%llu "
+                 "mask_ends=%llu\n",
+                 static_cast<unsigned long long>(g_h1_cycles.load()),
+                 static_cast<unsigned long long>(g_h1_small.load()),
+                 static_cast<unsigned long long>(g_h1_mask_ends.load()));
+}
+
+/// One MTP-drafted cycle whose drafting H1 changed.
+void H1Record(bool small_head) {
+  g_h1_small.fetch_add(small_head ? 1 : 0);
+  if ((g_h1_cycles.fetch_add(1) + 1) % 256 == 0)
+    H1Stats();
+}
+
+// m1se H1 one-session gate (w3h1g_gate.hpp): GUFO_H1_MAX_SESSIONS is read once; H1SessionGate
+// decides per cycle from that cycle's occupancy and plan. Unset = no gate (w3m1sd).
+std::uint32_t H1MaxSessions() {
+  static const std::uint32_t max =
+      w3h1g::ParseMaxSessions(std::getenv("GUFO_H1_MAX_SESSIONS"));
+  return max;
+}
+
+std::atomic<std::uint64_t> g_h1_gated{0};
+
+/// One strict cycle H1 would have changed, refused by the session gate.
+void H1GateRecord() {
+  static const bool stats = std::getenv("GUFO_H1_STATS") != nullptr;
+  const std::uint64_t n = g_h1_gated.fetch_add(1) + 1;
+  if (stats && n % 256 == 0)
+    std::fprintf(stderr, "event=h1_gate refused=%llu\n",
+                 static_cast<unsigned long long>(n));
+}
+
+/// Whether this cycle may use H1: relaxed / approximate as configured; strict only within
+/// GUFO_H1_MAX_SESSIONS (unset = always, as w3m1sd).
+bool H1SessionGate(xm::ExactnessLevel level, std::uint32_t occupancy,
+                   bool planned) {
+  return level != xm::ExactnessLevel::kStrict ||
+         w3h1g::StrictCycleAdmits(H1MaxSessions(), occupancy, planned);
+}
+
+/// The gate as configured (printed once, right after event=xm_engine).
+void H1GateConfig() {
+  const std::uint32_t g = H1MaxSessions();
+  if (g == w3h1g::kUnset)
+    std::fprintf(stderr, "event=h1_gate_config max_sessions=unset scope=strict\n");
+  else if (g == w3h1g::kClosed)
+    std::fprintf(stderr, "event=h1_gate_config max_sessions=closed scope=strict\n");
+  else
+    std::fprintf(stderr, "event=h1_gate_config max_sessions=%u scope=strict\n",
+                 static_cast<unsigned>(g));
+}
+
+/// GUFO_H1_MASK: whether the chain ends at its newest (MTP) draft because the
+/// request's grammar cannot select it. `grammar` has accepted the anchor and
+/// every earlier draft. The forbidden draft is dropped unless it is the only
+/// one (verification needs a row); either way drafting stops. Proposals only:
+/// verification would reject the draft, and every row after it.
+bool H1GrammarEndsChain(sampling::SamplerState& grammar,
+                        std::vector<std::int32_t>& chain) {
+  const auto& constraint = grammar.config().constraint;
+  const std::int32_t draft = chain.back();
+  const bool in_range =
+      draft >= 0 && (constraint == nullptr ||
+                     static_cast<std::size_t>(draft) <
+                         constraint->vocabulary->size());
+  const auto token = static_cast<sampling::TokenId>(draft);
+  if (in_range && grammar.CanSelectArgmax(token, /*penalties_applied=*/true)) {
+    grammar.Accept(token);
+    return false;
+  }
+  if (chain.size() > 2)
+    chain.pop_back();
+  g_h1_mask_ends.fetch_add(1);
+  return true;
+}
