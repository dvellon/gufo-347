+}  // namespace segtab
+
+// ---- r2: the R26-06 log extension (reached only when Get().diag; README s4.3 of xseg-fix-r2) ----
+namespace r26 {
+struct Reg {
+  std::uintptr_t host{0};
+  std::size_t bytes{0};
+  std::size_t guard{0};
+  std::uintptr_t alias{0};  // 0: the alias query failed
+  unsigned long long id{0};
+};
+struct Buf {
+  std::uintptr_t base{0};
+  std::size_t bytes{0};
+  unsigned long long id{0};
+};
+struct Tables {
+  std::mutex mu;
+  std::vector<Reg> regs;  // live pool registrations, sorted by host VA
+  std::vector<Buf> bufs;  // device allocations seen on the device side of a cache copy
+  unsigned long long next_reg{0}, next_buf{0};
+};
+inline Tables& T() {
+  static Tables tables;
+  return tables;
+}
+struct Totals {
+  std::atomic<unsigned long long> copies{0};    // cache copies observed (= the cseq of the last one)
+  std::atomic<unsigned long long> cross{0};     // spans crossing a pool registration
+  std::atomic<unsigned long long> hashed{0};    // copies hashed at stream completion
+  std::atomic<unsigned long long> mismatch{0};  // hashed copies whose destination bytes differ from the source's
+};
+inline Totals& Tot() {
+  static Totals totals;
+  return totals;
+}
+inline unsigned ThreadId() {
+  static std::atomic<unsigned> next{0};
+  static thread_local const unsigned id = next.fetch_add(1, std::memory_order_relaxed) + 1;
+  return id;
+}
+inline unsigned long long U(std::uintptr_t v) {
+  return static_cast<unsigned long long>(v);
+}
+// FNV-1a 64 (R26-08's content hash).
+inline unsigned long long Fnv(const unsigned char* p, std::size_t n) {
+  unsigned long long h = 14695981039346656037ULL;
+  for (std::size_t i = 0; i < n; ++i) {
+    h ^= p[i];
+    h *= 1099511628211ULL;
+  }
+  return h;
+}
+
+// Pool segment registered (committed_backing.cpp CommitPages, after hipHostRegister succeeded).
+inline void AddRegistration(std::uintptr_t host, std::size_t bytes, std::size_t guard, std::uintptr_t alias) {
+  auto& t = T();
+  const std::lock_guard<std::mutex> lock(t.mu);
+  const Reg r{host, bytes, guard, alias, t.next_reg++};
+  t.regs.insert(std::lower_bound(t.regs.begin(), t.regs.end(), host,
+                                 [](const Reg& a, std::uintptr_t h) { return a.host < h; }),
+                r);
+  std::fprintf(stderr,
+               "[INFO] [cache] schema=component-cache-v1 event=w3segfix_reg seg=%llu host=0x%llx bytes=%zu "
+               "guard=%zu alias=0x%llx live=%zu\n",
+               r.id, U(host), bytes, guard, U(alias), t.regs.size());
+}
+// Pool segment about to be unregistered (ReleasePages).
+inline void DropRegistration(std::uintptr_t host) {
+  auto& t = T();
+  const std::lock_guard<std::mutex> lock(t.mu);
+  for (auto it = t.regs.begin(); it != t.regs.end(); ++it)
+    if (it->host == host) {
+      const Reg r = *it;
+      t.regs.erase(it);
+      std::fprintf(stderr,
+                   "[INFO] [cache] schema=component-cache-v1 event=w3segfix_unreg seg=%llu host=0x%llx bytes=%zu "
+                   "live=%zu\n",
+                   r.id, U(r.host), r.bytes, t.regs.size());
+      return;
+    }
+}
+
+// Where a host span sits in the pool table.
+struct Span {
+  bool pool{false};           // the first byte lies in a pool registration
+  Reg reg{};                  // that registration
+  std::size_t offset{0};      // first byte - reg.host
+  bool cross{false};          // the span continues past reg's end
+  std::size_t split_at{0};    // bytes of the span inside reg (cross only)
+  long long end_reg{-1};      // id of the pool registration holding the last byte, -1 none
+};
+inline const Reg* RegAt(const std::vector<Reg>& regs, std::uintptr_t p) {
+  auto it = std::upper_bound(regs.begin(), regs.end(), p, [](std::uintptr_t h, const Reg& a) { return h < a.host; });
+  if (it == regs.begin())
+    return nullptr;
+  --it;
+  return p - it->host < it->bytes ? &*it : nullptr;
+}
+inline Span Locate(std::uintptr_t host, std::size_t bytes) {
+  Span s;
+  if (bytes == 0)
+    return s;
+  auto& t = T();
+  const std::lock_guard<std::mutex> lock(t.mu);
+  const Reg* r = RegAt(t.regs, host);
+  if (r == nullptr)
+    return s;
+  s.pool = true;
+  s.reg = *r;
+  s.offset = host - r->host;
+  s.cross = bytes > r->bytes - s.offset;
+  if (s.cross) {
+    s.split_at = r->bytes - s.offset;
+    const Reg* e = RegAt(t.regs, host + bytes - 1);
+    s.end_reg = e ? static_cast<long long>(e->id) : -1;
+  }
+  return s;
+}
+
+// `range(va)` -> optional {allocation base, bytes} (hipMemGetAddressRange); nullopt: not a device allocation.
+template <class Range>
+std::optional<Buf> DeviceBuffer(std::uintptr_t device, unsigned long long cseq, Range& range) {
+  if (device == 0)
+    return std::nullopt;
+  auto& t = T();
+  const std::lock_guard<std::mutex> lock(t.mu);
+  for (const auto& b : t.bufs)
+    if (device - b.base < b.bytes)
+      return b;
+  const auto got = range(device);
+  if (!got.has_value() || device - got->first >= got->second)
+    return std::nullopt;
+  const Buf b{got->first, got->second, t.next_buf++};
+  t.bufs.push_back(b);
+  std::fprintf(stderr,
+               "[INFO] [cache] schema=component-cache-v1 event=w3segfix_devbuf id=%llu dva=0x%llx bytes=%zu "
+               "cseq=%llu\n",
+               b.id, U(b.base), b.bytes, cseq);
+  return b;
+}
+
+struct Target {
+  const char* cls{"unmapped"};  // reg / devbuf / mapped / unmapped
+  long long id{-1};             // pool registration id (reg) or device buffer id (devbuf)
+  std::uintptr_t base{0};       // allocation base (mapped)
+  std::size_t bytes{0};
+};
+// What lives at device VA `va` (the first byte the single kernel touches past registration k's alias).
+template <class Range>
+Target Classify(std::uintptr_t va, Range& range) {
+  Target out;
+  {
+    auto& t = T();
+    const std::lock_guard<std::mutex> lock(t.mu);
+    for (const auto& r : t.regs)
+      if (r.alias != 0 && va - r.alias < r.bytes) {
+        out.cls = "reg";
+        out.id = static_cast<long long>(r.id);
+        out.base = r.alias;
+        out.bytes = r.bytes;
+        return out;
+      }
+    for (const auto& b : t.bufs)
+      if (va - b.base < b.bytes) {
+        out.cls = "devbuf";
+        out.id = static_cast<long long>(b.id);
+        out.base = b.base;
+        out.bytes = b.bytes;
+        return out;
+      }
+  }
+  if (const auto got = range(va); got.has_value() && va - got->first < got->second) {
+    out.cls = "mapped";
+    out.base = got->first;
+    out.bytes = got->second;
+  }
+  return out;
+}
+
+// One observed cache copy (GUFO_CL_DIAG=1 only). `copy()` is the unchanged CopySnapshot; `path` is the route it
+// takes (kernel / split / memcpy / error), decided by the caller beforehand; `sync()` waits for the copy's
+// stream; `read_device(device, bytes, out)` copies device bytes to host memory and waits. `alias` / `range` as
+// above. Lines: cross (before submission), devbuf (first sight), copy (after enqueue), done (after the sync).
+template <class Status, class Alias, class Range, class Copy, class Sync, class ReadDevice>
+Status ObservedCopy(void* destination, const void* source, std::size_t bytes, bool download, const char* path,
+                    Alias& alias, Range& range, Copy&& copy, Sync&& sync, ReadDevice&& read_device, Status ok) {
+  const auto host = reinterpret_cast<std::uintptr_t>(download ? static_cast<const void*>(destination) : source);
+  const auto device = reinterpret_cast<std::uintptr_t>(download ? source : static_cast<const void*>(destination));
+  const int load = download ? 0 : 1;
+  auto& tot = Tot();
+  const auto cseq = tot.copies.fetch_add(1, std::memory_order_relaxed) + 1;
+  const auto span = Locate(host, bytes);
+  const auto buf = DeviceBuffer(device, cseq, range);
+  const long long buf_id = buf ? static_cast<long long>(buf->id) : -1;
+  const long long buf_off = buf ? static_cast<long long>(device - buf->base) : -1;
+  if (span.cross) {
+    const auto cross_total = tot.cross.fetch_add(1, std::memory_order_relaxed) + 1;
+    const auto first = alias(reinterpret_cast<const std::byte*>(host));
+    const auto past = alias(reinterpret_cast<const std::byte*>(host + span.split_at));
+    const bool linear = first.has_value() && past.has_value() && *past - *first == span.split_at;
+    const std::uintptr_t va = first.has_value() ? *first + span.split_at : 0;
+    const Target target = first.has_value() ? Classify(va, range) : Target{};
+    std::fprintf(stderr,
+                 "[INFO] [cache] schema=component-cache-v1 event=w3segfix_cross cseq=%llu load=%d bytes=%zu "
+                 "seg=%llu seg_off=%zu split_at=%zu seg_end=%lld linear=%d target=%s target_id=%lld "
+                 "target_va=0x%llx target_base=0x%llx target_bytes=%zu devbuf=%lld dev_off=%lld cross_total=%llu\n",
+                 cseq, load, bytes, span.reg.id, span.offset, span.split_at, span.end_reg, linear ? 1 : 0,
+                 target.cls, target.id, U(va), U(target.base), target.bytes, buf_id, buf_off, cross_total);
+  }
+  const Status status = copy();
+  std::fprintf(stderr,
+               "[INFO] [cache] schema=component-cache-v1 event=w3segfix_copy cseq=%llu tid=%u load=%d bytes=%zu "
+               "path=%s status=%d seg=%lld seg_off=%lld cross=%d devbuf=%lld dev_off=%lld copies=%llu "
+               "cross_total=%llu split_total=%llu\n",
+               cseq, ThreadId(), load, bytes, path, static_cast<int>(status),
+               span.pool ? static_cast<long long>(span.reg.id) : -1LL,
+               span.pool ? static_cast<long long>(span.offset) : -1LL, span.cross ? 1 : 0, buf_id, buf_off, cseq,
+               tot.cross.load(std::memory_order_relaxed),
+               static_cast<unsigned long long>(Count().spans.load(std::memory_order_relaxed)));
+  const int mode = Get().hash_mode;
+  if (status != ok || mode == 0 || (mode == 1 && !span.cross))
+    return status;
+  const Status synced = sync();
+  bool hashed = false;
+  unsigned long long src = 0, dst = 0;
+  if (synced == ok) {
+    std::vector<unsigned char> staged(bytes);
+    if (bytes == 0 || read_device(reinterpret_cast<const void*>(device), bytes, staged.data()) == ok) {
+      const auto host_hash = Fnv(reinterpret_cast<const unsigned char*>(host), bytes);
+      const auto device_hash = Fnv(staged.data(), bytes);
+      src = download ? device_hash : host_hash;
+      dst = download ? host_hash : device_hash;
+      hashed = true;
+    }
+  }
+  if (hashed) {
+    tot.hashed.fetch_add(1, std::memory_order_relaxed);
+    if (src != dst)
+      tot.mismatch.fetch_add(1, std::memory_order_relaxed);
+  }
+  std::fprintf(stderr,
+               "[INFO] [cache] schema=component-cache-v1 event=w3segfix_done cseq=%llu load=%d bytes=%zu sync=%d "
+               "hashed=%d src_fnv=%016llx dst_fnv=%016llx match=%d cross=%d mismatch_total=%llu\n",
+               cseq, load, bytes, static_cast<int>(synced), hashed ? 1 : 0, src, dst,
+               hashed ? (src == dst ? 1 : 0) : -1, span.cross ? 1 : 0, tot.mismatch.load(std::memory_order_relaxed));
+  return status;
+}
+}  // namespace r26
+}  // namespace gufo::hip::w3xseg
+
+#endif
