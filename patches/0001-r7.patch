+// w3rb (GUFO_GDN_DEFER=lazy): the GdnKernel arguments of one ping-pong batch (w3rb_gdn.hpp plan).
+GdnDefer Executor::RbDefer(const w3rb::GdnPass& p, std::uint32_t keep,
+                           const Session::LinearState& s) noexcept {
+  GdnDefer d{};
+  if (p.kind == w3rb::kGdnProd)
+    return d;
+  d.pend = s.gdn_pend;
+  d.keep = keep;
+  d.base_out = p.base_in_place ? s.state : nullptr;
+  return d;
+}
+
+bool Executor::RbLinearAttention(const w3rb::GdnPass& p, std::uint32_t keep,
+                                 const DeviceLayer& l, Session::LinearState& s,
+                                 const float* x, float* out,
+                                 std::uint32_t n_tokens, bool speculative,
+                                 std::string* error_msg) const {
+  struct Plan {
+    const Executor* e;
+    ~Plan() {
+      e->rb_pass_ = {};
+      e->rb_keep_ = 0;
+    }
+  } plan{this};
+  rb_pass_ = p;
+  rb_keep_ = keep;
+  return LinearAttention(l, s, x, out, n_tokens, speculative, error_msg, true,
+                         false);
+}
+
+bool Executor::RbShadow(Session& session, Session::LinearState& l) const {
+  if (l.rb_shadow != nullptr)
+    return true;
+  const auto& c = config();
+  const std::size_t bytes = std::size_t{c.ssm_num_v_heads} * c.ssm_head_dim *
+                            c.ssm_head_dim * sizeof(float);
+  float* shadow = nullptr;
+  if (hip::AllocateDevice(&shadow, bytes) != hipSuccess || shadow == nullptr)
+    return false;
+  session.allocations_.push_back(shadow);
+  l.rb_shadow = shadow;
   return true;
 }
 
+void Executor::RbCompare(const float* a, const float* b,
+                         std::size_t count) const {
+  if (rb_counts_ == nullptr) {
+    if (hipMalloc(&rb_counts_, 4 * sizeof(unsigned long long)) != hipSuccess) {
+      rb_counts_ = nullptr;
+      return;
+    }
+    (void)hipMemsetAsync(rb_counts_, 0, 4 * sizeof(unsigned long long), stream_);
+  }
+  W3rbCompare(a, b, count, rb_counts_, stream_);
+}
+
+void Executor::RbPrintCheck() const {
+  unsigned long long counts[4] = {0, 0, 0, 0};
+  if (rb_counts_ != nullptr &&
+      (hipMemcpyAsync(counts, rb_counts_, sizeof(counts), hipMemcpyDeviceToHost,
+                      stream_) != hipSuccess ||
+       hipStreamSynchronize(stream_) != hipSuccess))
+    counts[3] = 1;
+  w3rb::PrintCheck(counts);
+}
