+                 "event=w3heapres_config value=%s reserve_mb=%llu valid=%d default_mb=%llu port=port-v034-270\n", v,
+                 static_cast<unsigned long long>(r >> 20), valid ? 1 : 0,
+                 static_cast<unsigned long long>(kDispatchReserve >> 20));
+    return r;
+  }();
+  return bytes;
+}
+/// hip::HeapFitsAboveReserve with the knob's reserve.
+inline bool Fits(std::uint64_t free_bytes, std::uint64_t bytes) {
+  return bytes <= free_bytes && free_bytes - bytes >= ReserveBytes();
+}
+/// hip::RegistrationKeepsReserve (#903) with the knob's reserve.
+inline bool KeepsReserve(std::uint64_t free_before, std::uint64_t free_after) {
+  const auto reserve = ReserveBytes();
+  return free_after >= (free_before < reserve ? free_before : reserve);
+}
