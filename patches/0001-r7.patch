+inline bool ProbeSmall(const void* w, const void* x, const float* prod, std::uint32_t n, hipStream_t stream) {
+  State& s = Get();
+  if (!Buffers(s) ||
+      w3hcd_down_small_launch(w3hcd::kRouteA1, w, x, static_cast<float*>(s.dev[1]), n, w3hcd::kRows, w3hcd::kK,
+                              stream) != 0 ||
+      w3hcd_down_small_launch(w3hcd::kRouteA2, w, x, static_cast<float*>(s.dev[2]), n, w3hcd::kRows, w3hcd::kK,
+                              stream) != 0)
+    return false;
+  const std::size_t row = std::size_t{w3hcd::kRows} * sizeof(float);
+  const void* src[3] = {prod, s.dev[1], s.dev[2]};
