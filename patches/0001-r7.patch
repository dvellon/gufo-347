+  if (!has_mtp || w.data == nullptr || w.type != GgmlType::kQ8_0 || C != q2s::kHidden || V == 0 || V % 32 != 0 ||
+      prefix % 32 != 0 || prefix > V || (prefix != 0 && draft.data != w.data) ||
+      q2s::Chunks(V) * w3q2l::kK > q2s::kSel2Threads * q2s::kSel2Per ||
+      qfn_mmq_q8_1_bytes(1, static_cast<int>(C)) != q2s::kQ8_1RowBytes ||
+      qfn_mmq_q8_1_bytes(2, static_cast<int>(C)) != 2 * q2s::kQ8_1RowBytes)
+    return refuse("unsupported_head");
+  const auto t0 = std::chrono::steady_clock::now();
+  bool ok = true;
+  const auto dev = [&](auto** out, std::size_t bytes) {
+    if (!ok)
+      return;
+    void* q = nullptr;
+    if (!W3q2lAlloc(&q, bytes)) {
+      ok = false;
+      return;
+    }
+    *out = static_cast<std::remove_reference_t<decltype(*out)>>(q);
+  };
+  const std::size_t R = w3q2l::kMaxRows, MK = q2s::kMaxK;
+  dev(&d.codes, std::size_t{V} * q2s::kQ2CodeBytes);
+  dev(&d.scales, std::size_t{V} * q2s::kQ2Blocks * sizeof(std::uint16_t));
+  dev(&d.keys, R * V * sizeof(std::uint32_t));
+  dev(&d.cand1, R * q2s::Chunks(V) * MK * sizeof(std::uint64_t));
+  dev(&d.ids, R * MK * sizeof(std::uint32_t));
+  dev(&d.sel_keys, R * MK * sizeof(std::uint32_t));
+  dev(&d.resc, R * MK * sizeof(float));
+  dev(&d.best_id, R * sizeof(std::uint32_t));
+  dev(&d.best_val, R * sizeof(float));
+  dev(&d.merged, R * sizeof(std::int32_t) * 2);
+  dev(&d.chk_tok, R * sizeof(std::int32_t));
+  dev(&d.err, w3q2l::kErrWords * sizeof(std::uint32_t));
+  dev(&d.counters, w3q2l::kCounters * sizeof(std::uint32_t));
+  dev(&d.xq, qfn_mmq_q8_1_bytes(static_cast<int>(R), static_cast<int>(C)));
+  auto& t2 = w3q2l2::Dev2();  // 226c: the top-2 counters and the screened top-2 per row
+  dev(&t2.counters, w3q2l2::kT2Counters * sizeof(std::uint32_t));
+  dev(&t2.ids, R * 2 * sizeof(std::uint32_t));
+  dev(&t2.scores, R * 2 * sizeof(float));
+  std::uint16_t* rbound = nullptr;  // the build's per-block error norms (225's statistical stop): not kept
+  if (!ok || hipMalloc(reinterpret_cast<void**>(&rbound), std::size_t{V} * q2s::kQ2Blocks * 2) != hipSuccess)
+    return refuse("device_allocation");
+  const bool built =
+      hipMemsetAsync(d.err, 0, w3q2l::kErrWords * sizeof(std::uint32_t), stream) == hipSuccess &&
+      hipMemsetAsync(d.counters, 0, w3q2l::kCounters * sizeof(std::uint32_t), stream) == hipSuccess &&
+      hipMemsetAsync(t2.counters, 0, w3q2l2::kT2Counters * sizeof(std::uint32_t), stream) == hipSuccess &&
+      (q2l::Q2Build(w.data, V, d.codes, d.scales, rbound, stream), hipGetLastError() == hipSuccess) &&
+      hipStreamSynchronize(stream) == hipSuccess;
