+++ b/src/models/qwen38_flash_next/kernels/rocm/w3q2l.hpp
@@ -0,0 +1,263 @@
+// Wave3 Q2L (q2live-226, queue 226; TEST build w3q2l_server only, never production): the queue-225 2-bit
+// screening readout of the MTP draft head, live at width <= 2.
+//
+// A token-only draft call (no candidate list, no A1 screen) at a width the knob covers does
+//   Q8_1 input (production's Quantize) -> Q2 screen GEMV over the head rows it would read (the 49,152-row prefix or the
+//   248,320-row full head) -> exact top-64 (q2l::Select) -> production's A1ExactDot over those 64 rows + argmax by
+//   A1Before (Q2lRescore = 225's Q2RescoreA1Kernel verbatim) -> the production draft-table logits (Dense + MaskDraftLogits,
+//   small head only) merged by production's BetterCandidate (Q2lMerge) -> RemapDraftIds as production.
+// It replaces the head GEMV + Argmax. A draft differs from production's only when the true argmax lies outside the 64
+// screened rows (225c: 0.061 % of rows); the strict verifier commits the target's tokens either way.
+//
+// Knobs (read once, at Executor::Create):
+//   GUFO_Q2_SCREEN  unset / "" = production (nothing read, allocated or printed); off = production + one config line;
+//                   w1 = width-1 calls (MtpHead: every C1 draft); w2 = also 2-row MtpHeads batches; anything else =
+//                   invalid: production + a config line with valid=0.
+//   GUFO_Q2_CHECK   unset / "" / 0 = off; 1 = also run production's head GEMV + Argmax on every screened call and count
+//                   (device) id differences and rescored-logit bit differences (diagnostic arms only); else invalid.
+// With w1 / w2 the Q2 copy (codes + f16 scales of every head row) is built on the GPU at Create and a load-time self-test
+// must pass, else the model load is refused (no silent fallback).
+#ifndef GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_W3Q2L_HPP_
+#define GUFO_MODELS_QWEN38_FLASH_NEXT_KERNELS_ROCM_W3Q2L_HPP_
+
+#include <hip/hip_runtime_api.h>
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "src/models/qwen38_flash_next/kernels/rocm/q2s_launch.h"
+#include "src/models/qwen38_flash_next/kernels/rocm/q2s_plan.h"
+
+namespace w3q2l {
+
+enum class Mode : int { kOff = 0, kW1 = 1, kW2 = 2 };
+
+struct Config {
+  bool set = false;          // GUFO_Q2_SCREEN present and non-empty
+  bool valid = true;         // GUFO_Q2_SCREEN is off / w1 / w2
+  Mode mode = Mode::kOff;
+  bool check = false;        // GUFO_Q2_CHECK=1
+  bool check_valid = true;   // GUFO_Q2_CHECK is unset / "" / 0 / 1
+  std::string requested;     // the GUFO_Q2_SCREEN text ("-" when unset)
+  std::string check_requested;
+};
+
+inline Config Parse(const char* screen, const char* check) {
+  Config c;
+  c.requested = screen != nullptr && screen[0] != '\0' ? screen : "-";
+  c.check_requested = check != nullptr && check[0] != '\0' ? check : "-";
+  if (check != nullptr && check[0] != '\0') {
+    if (std::strcmp(check, "1") == 0) {
+      c.check = true;
+    } else if (std::strcmp(check, "0") != 0) {
+      c.check_valid = false;
+    }
+  }
+  if (screen == nullptr || screen[0] == '\0') {
+    c.check = false;  // the check only exists on a screened run
+    return c;
+  }
+  c.set = true;
+  if (std::strcmp(screen, "off") == 0) {
+    c.mode = Mode::kOff;
+  } else if (std::strcmp(screen, "w1") == 0) {
+    c.mode = Mode::kW1;
+  } else if (std::strcmp(screen, "w2") == 0) {
+    c.mode = Mode::kW2;
+  } else {
+    c.valid = false;
+    c.mode = Mode::kOff;
+  }
+  if (c.mode == Mode::kOff)
+    c.check = false;
+  return c;
+}
+
+inline const Config& Get() {
+  static const Config c = Parse(std::getenv("GUFO_Q2_SCREEN"), std::getenv("GUFO_Q2_CHECK"));
+  return c;
+}
+
+inline const char* ModeName(Mode m) {
+  return m == Mode::kW1 ? "w1" : m == Mode::kW2 ? "w2" : "off";
+}
+
+inline std::uint32_t MaxWidth(Mode m) { return m == Mode::kW1 ? 1U : m == Mode::kW2 ? 2U : 0U; }
+
+constexpr std::uint32_t kK = 64;        // screened rows rescored exactly (225c verdict arm q2a_64)
+constexpr std::uint32_t kMaxRows = 2;   // widest screened call (w2)
+static_assert(kK <= q2s::kMaxK, "the selection buffers hold q2s::kMaxK ids per row");
+// device counters (u32): 0 merges run (one per screened row), 1 NaN best (row 0 emitted, as production's Argmax for an
+// all-NaN row), 2 checked rows, 3 checked rows whose id != production's Argmax, 4 rescored logits whose bits != the
+// production GEMV's, 5 checked rows whose production argmax is among the 64 screened rows, 6..7 spare
+constexpr int kCounters = 8;
+constexpr int kErrWords = q2s::kErrWords;
+
+struct Stats {
+  std::uint64_t w1_small = 0;   // host-counted width-1 screened calls over the prefix (small head)
+  std::uint64_t w1_full = 0;    // ... over the full head
+  std::uint64_t b2_calls = 0;   // screened 2-row MtpHeads batches (w2)
+  std::uint64_t b2_rows = 0;
+  std::uint64_t skip_cand = 0;  // draft calls with a candidate list (production path)
+  std::uint64_t skip_a1 = 0;    // A1-screened full-head calls (A1 keeps precedence)
+  std::uint64_t skip_wide = 0;  // batched calls wider than the knob's width, or with a candidate row
+  std::uint64_t Calls() const { return w1_small + w1_full + b2_rows; }
+};
+
+struct Device {
+  bool ready = false;
+  Mode mode = Mode::kOff;
+  bool check = false;
+  std::uint32_t vocab = 0, prefix = 0, cols = 0;
+  std::uint8_t* codes = nullptr;      // [vocab][640] Q2 codes (q2s_plan.h layout)
+  std::uint16_t* scales = nullptr;    // [vocab][40] f16 scales
+  std::uint32_t* keys = nullptr;      // [kMaxRows][vocab]
+  std::uint64_t* cand1 = nullptr;     // [kMaxRows][chunks][q2s::kMaxK]
+  std::uint32_t* ids = nullptr;       // [kMaxRows][q2s::kMaxK]
+  std::uint32_t* sel_keys = nullptr;  // [kMaxRows][q2s::kMaxK]
+  float* resc = nullptr;              // [kMaxRows][q2s::kMaxK]
+  std::uint32_t* best_id = nullptr;   // [kMaxRows]
+  float* best_val = nullptr;          // [kMaxRows]
+  std::int32_t* merged = nullptr;     // [kMaxRows] the screened draft index before RemapDraftIds
+  std::int32_t* chk_tok = nullptr;    // [kMaxRows] production's Argmax index (check mode)
+  std::uint32_t* err = nullptr;       // [kErrWords] q2l::Select error words (never reset after the self-test)
+  std::uint32_t* counters = nullptr;  // [kCounters]
+  void* xq = nullptr;                 // Q8_1 rows of the self-test inputs
+  std::vector<void*> owned;
+  std::size_t q2_bytes = 0;           // the resident Q2 copy (codes + scales)
+  double build_ms = 0.0;
+  Stats stats;
+  std::uint64_t last_logged = 0;
+};
+
+inline Device& Dev() {
+  static Device d;
+  return d;
+}
+
+/// A screened call of `width` rows: the knob covers the width and the copy is resident.
+inline bool Use(std::uint32_t width) {
+  const Device& d = Dev();
+  return d.ready && width >= 1 && width <= MaxWidth(d.mode);
+}
+
+/// Stats lines: every power of two up to 4096 calls, every 256 up to 4096, then every 4096.
+inline bool Due(std::uint64_t n) {
+  if (n == 0)
+    return false;
+  if (n <= 4096)
+    return (n & (n - 1)) == 0 || n % 256 == 0;
+  return n % 4096 == 0;
+}
+
+/// Reads the device counters (outside any capture: the caller's stream is synchronized) and prints one stats line.
+inline void LogStats(hipStream_t stream, const char* why) {
+  Device& d = Dev();
+  if (!d.ready)
+    return;
+  std::uint32_t c[kCounters] = {};
+  std::uint32_t e[kErrWords] = {};
+  const bool read = stream != nullptr &&
+                    hipMemcpyAsync(c, d.counters, sizeof(c), hipMemcpyDeviceToHost, stream) == hipSuccess &&
+                    hipMemcpyAsync(e, d.err, sizeof(e), hipMemcpyDeviceToHost, stream) == hipSuccess &&
+                    hipStreamSynchronize(stream) == hipSuccess;
+  const Stats& s = d.stats;
+  std::fprintf(stderr,
+               "gufo: event=q2l_stats mode=%s check=%d calls=%llu w1_small=%llu w1_full=%llu b2_calls=%llu "
+               "b2_rows=%llu skip_cand=%llu skip_a1=%llu skip_wide=%llu dev_read=%d merges=%u nan=%u chk=%u "
+               "chk_id_diff=%u chk_bit_diff=%u chk_in_topk=%u sel_err=%u/%u/%u why=%s port=q2live-226\n",
+               ModeName(d.mode), d.check ? 1 : 0, static_cast<unsigned long long>(s.Calls()),
+               static_cast<unsigned long long>(s.w1_small), static_cast<unsigned long long>(s.w1_full),
+               static_cast<unsigned long long>(s.b2_calls), static_cast<unsigned long long>(s.b2_rows),
+               static_cast<unsigned long long>(s.skip_cand), static_cast<unsigned long long>(s.skip_a1),
+               static_cast<unsigned long long>(s.skip_wide), read ? 1 : 0, c[0], c[1], c[2], c[3], c[4], c[5], e[0],
+               e[1], e[2], why);
+  std::fflush(stderr);
+  d.last_logged = s.Calls();
+}
+
+/// Host counters, recorded OUTSIDE captured bodies (MtpForward before Run, MtpHeads): a replayed graph runs the screen
+/// without the host code inside the body, so the body itself counts nothing on the host.
+enum class Call : int { kW1Small, kW1Full, kB2, kSkipCand, kSkipA1, kSkipWide };
+inline void Note(Call k, std::uint32_t rows, hipStream_t stream) {
+  Device& d = Dev();
+  if (!d.ready)
+    return;
+  Stats& s = d.stats;
+  const std::uint64_t before = s.Calls();
+  switch (k) {
+    case Call::kW1Small: ++s.w1_small; break;
+    case Call::kW1Full: ++s.w1_full; break;
+    case Call::kB2: ++s.b2_calls; s.b2_rows += rows; break;
+    case Call::kSkipCand: ++s.skip_cand; break;
+    case Call::kSkipA1: ++s.skip_a1; break;
+    case Call::kSkipWide: ++s.skip_wide; break;
+  }
+  const std::uint64_t after = s.Calls();
+  for (std::uint64_t n = before + 1; n <= after; ++n) {
+    if (Due(n)) {
+      // the previous screened calls' counters: drain the stream first (outside any capture)
+      LogStats(stream, "interval");
+      break;
+    }
+  }
+}
+
+inline void Teardown() {
+  Device& d = Dev();
+  for (void* p : d.owned)
+    (void)hipFree(p);
+  d.owned.clear();
+  d.ready = false;
+}
+
+/// Host mirror of Q2lMerge (the Dell test checks it against production's Argmax rule; the load-time self-test checks the
+/// device kernel against it): the screened prefix best (value, id) competes with the table rows prefix + j by
+/// BetterCandidate (larger value, then lower index; NaN never wins), starting from {-inf, INT32_MAX}. An all-NaN screened
+/// best emits index 0, as production's ArgmaxFinishKernel does for a NaN row 0 (the only realistic NaN case: a NaN input
+/// makes every logit NaN).
+inline std::int32_t MergeRef(float best_val, std::uint32_t best_id, const float* table, std::uint32_t table_rows,
+                             std::uint32_t prefix) {
+  if (std::isnan(best_val))
+    return 0;
+  float bv = -INFINITY;
+  std::int32_t bi = INT32_MAX;
+  const auto better = [&](float v, std::int32_t i) {
+    if (v > bv || (v == bv && i < bi)) {
+      bv = v;
+      bi = i;
+    }
+  };
+  for (std::uint32_t j = 0; j < table_rows; ++j)
+    better(table[j], static_cast<std::int32_t>(prefix + j));
+  better(best_val, static_cast<std::int32_t>(best_id));
+  return bi;
+}
+
+}  // namespace w3q2l
+
+namespace gufo::models::qwen38_flash_next::rocm {
+// Launchers defined in kernels.hip.cpp's translation unit (w3q2l_kernels.inc, inside this namespace). Each is pinned to
+// exactly this declaration there (an address-of check refuses an overload at compile time).
+/// 225's Q2RescoreA1Kernel (verbatim): resc[t][i] = production A1ExactDot of head row ids[t][i] (i < k) on Q8_1 row t of
+/// xq; best_id[t] / best_val[t] = their argmax by A1Before. One block per row.
+void Q2lRescore(const void* head, const void* xq, const std::uint32_t* ids, std::uint32_t k, std::uint32_t n,
+                float* resc, std::uint32_t* best_id, float* best_val, hipStream_t stream);
+/// One row: out[0] = merged[0] = the production-rule argmax of {(best_val[0], best_id[0])} + {(table[j], prefix + j)}
+/// (w3q2l::MergeRef); counters[0] += 1, counters[1] += a NaN best.
+void Q2lMerge(const std::uint32_t* best_id, const float* best_val, const float* table, std::uint32_t table_rows,
+              std::uint32_t prefix, std::int32_t* out, std::int32_t* merged, std::uint32_t* counters,
+              hipStream_t stream);
+/// Check mode, one row: counters[2] += 1; [3] += merged[0] != prod[0]; [4] += #i < k with resc[i] bits != logits[ids[i]];
+/// [5] += prod[0] is one of ids[0..k) (a prefix / full-head row index).
+void Q2lCheck(const std::int32_t* prod, const std::int32_t* merged, const float* logits, const std::uint32_t* ids,
+              const float* resc, std::uint32_t k, std::uint32_t* counters, hipStream_t stream);
+}  // namespace gufo::models::qwen38_flash_next::rocm
