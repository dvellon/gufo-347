@@ -0,0 +1,45 @@
+// combo-c4 member b7-idx (FU-R429, GUFO_IDX_BATCH): in a multi-session trunk decode round
+// (Executor::ForwardBatch, attention layers) project indexer_k / indexer_q ONCE over all rows with
+// DenseBatch (the same call c3 already uses for attn_qkv across sessions), then let each session's
+// Attention() skip its own per-session indexer_k DenseBatch / indexer_q Dense. RowScratch already
+// offsets s.ik / s.iq per row, so every session reads exactly its own rows.
+//   unset / anything but "1": off -> c3's statements (ReadyK()/ReadyQ() are false: both guards
+//   short-circuit to c3's calls).  Single-session rounds (C1) never take the path.
+// Exactness tier: strict-lineage (C8): the projection row count changes from n (<= 8) to the round's
+// rows, so the BF16 kernel may switch Dense -> SmallGemm (the same class of batch-dependent rounding c3
+// already has for attn_qkv in C8 rounds). C1 is bit-identical (path never taken).
+#pragma once
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+namespace w3idxb {
+inline bool On() {
+  static const bool on = [] {
+    const char* v = std::getenv("GUFO_IDX_BATCH");
+    const bool r = v != nullptr && std::strcmp(v, "1") == 0;
+    std::fprintf(stderr, "gufo: event=idx_batch_config on=%d requested=%s port=c4b7\n", r ? 1 : 0,
+                 v == nullptr ? "unset" : (r ? "1" : "invalid"));
+    std::fflush(stderr);
+    return r;
+  }();
+  return on;
+}
+inline thread_local bool ready_k = false;
+inline thread_local bool ready_q = false;
+inline thread_local unsigned long long rounds = 0;
+inline bool ReadyK() { return ready_k; }
+inline bool ReadyQ() { return ready_q; }
+inline void Clear() { ready_k = false; ready_q = false; }
+struct Scope {
+  Scope() = default;
+  Scope(const Scope&) = delete;
+  Scope& operator=(const Scope&) = delete;
+  ~Scope() { Clear(); }
+};
+inline void Note(unsigned rows, unsigned sessions, bool k, bool q) {
+  ++rounds;
+  if (rounds == 1 || (rounds & 0xFFFF) == 0)
+    std::fprintf(stderr, "gufo: event=idx_batch rounds=%llu rows=%u sessions=%u k=%d q=%d port=c4b7\n",
+                 rounds, rows, sessions, k ? 1 : 0, q ? 1 : 0);
+}
+}  // namespace w3idxb
diff --git a/src/models/qwen38_flash_next/kernels/rocm/w3q2l.hpp b/src/models/qwen38_flash_next/kernels/rocm/w3q2l.hpp
