+inline constexpr std::uint64_t kDefaultCacheBytes = 9000000000ULL;
+inline constexpr std::uint64_t kDefaultBackingBytes = 17 * (std::uint64_t{128} << 20);
+inline constexpr std::uint64_t kDefaultCommitReserveGiB = 8;
