+std::atomic<std::uint64_t> g_xm_split_steps{0}, g_xm_split_groups{0},
+    g_xm_strict_units{0}, g_xm_relaxed_units{0}, g_xm_approximate_units{0},
+    g_xm_active_units{0}, g_xm_stub_units{0}, g_xm_requests{0};
+
+bool XmStatsOn() {
+  static const bool on = std::getenv("GUFO_XM_STATS") != nullptr;
