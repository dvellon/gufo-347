+__device__ __forceinline__ Dim3 D(std::uint32_t x, std::uint32_t y = 0, std::uint32_t z = 0) { return Dim3{x, y, z}; }
+
+struct GemvArgs {   // S4 / S5: one Q8_0 GEMV + up to two SmallGemms reading the same token rows
+  fz::Map map;
+  const void* w_q8;
+  const mm::block_q8_1* xq;
+  float* out_q8;
+  std::uint32_t k, rows_q8, xstride;
+  const void* w_a;
+  float* out_a;
+  std::uint32_t rows_a;
+  const void* w_b;
+  float* out_b;
+  std::uint32_t rows_b;
+  const float* x;
+};
+
+// ---- S2: RouterTopK<512> || quantize_q8_1 (the shared SwiGLU rows, K 640 padded to 1024) ---------------------------
+struct S2Args {
+  fz::Map map;
+  const float* logits;
+  std::uint32_t stride, n_experts, k_used;
+  std::int32_t* ids;
+  float* weights;
+  const float* act;
+  void* act_q8;
+  std::int64_t act_k, padded;
+  std::uint32_t n;
+};
+template <unsigned n>
+__launch_bounds__(256, 1) __global__ void W3fzS2Kernel(const S2Args a, const uint3 ne2) {
+  const fz::Task t = fz::Locate(a.map, blockIdx.x, threadIdx.x);
+  if (t.seg < 0) return;
+  if (t.role == fz::kTopK) {
+    W3fzBody_RouterTopKKernel<512>(D(t.pbx), D(t.ptid), D(256, 1, 1), a.logits, a.stride, a.ids, a.weights,
+                                   a.n_experts, a.k_used);
+  } else {
+    const int64_t K = a.act_k;
+    mm::W3fzBody_quantize_q8_1(D(t.pbx, t.pby, 0), D(t.ptid), D(256, 1, 1), a.act, a.act_q8, K, K, K * n, K * n,
+                               a.padded, n, ne2);
+  }
+}
+
+// ---- S4: ssm_in mul_mat_vec_q8<n, false, 1, false, n > 1> || alpha/beta SmallGemm<F16, n, false, kWhole> ----------
+template <unsigned n>
+__launch_bounds__(128, 1) __global__ void W3fzS4Kernel(const GemvArgs a) {
+  const fz::Task t = fz::Locate(a.map, blockIdx.x, threadIdx.x);
+  if (t.seg < 0) return;
+  if (t.role == fz::kAlphaBeta) {
+    W3fzBody_SmallGemmKernel<WeightType::kF16, n, false, true>(D(t.pbx, t.pby), D(t.ptid), D(128, 1, 1), a.w_a, a.x,
+                                                               a.out_a, a.rows_a, a.k);
+  } else {
+    mm::W3fzBody_mul_mat_vec_q8<n, false, 1, false, (n > 1)>(D(t.pbx), D(t.ptid), D(32, 1, 1), a.w_q8, nullptr, a.xq,
+                                                            a.out_q8, a.k, a.rows_q8, a.xstride);
+  }
+}
+
+// ---- S5: qkv mul_mat_vec_q8 || indexer_k SmallGemm<BF16> || indexer_q SmallGemm<BF16> -----------------------------
+template <unsigned n>
+__launch_bounds__(128, 1) __global__ void W3fzS5Kernel(const GemvArgs a) {
+  const fz::Task t = fz::Locate(a.map, blockIdx.x, threadIdx.x);
+  if (t.seg < 0) return;
+  if (t.role == fz::kIdxK) {
+    W3fzBody_SmallGemmKernel<WeightType::kBF16, n, false, true>(D(t.pbx, t.pby), D(t.ptid), D(128, 1, 1), a.w_a, a.x,
+                                                                a.out_a, a.rows_a, a.k);
+  } else if (t.role == fz::kIdxQ) {
+    W3fzBody_SmallGemmKernel<WeightType::kBF16, n, false, true>(D(t.pbx, t.pby), D(t.ptid), D(128, 1, 1), a.w_b, a.x,
+                                                                a.out_b, a.rows_b, a.k);
+  } else {
+    mm::W3fzBody_mul_mat_vec_q8<n, false, 1, false, (n > 1)>(D(t.pbx), D(t.ptid), D(32, 1, 1), a.w_q8, nullptr, a.xq,
+                                                            a.out_q8, a.k, a.rows_q8, a.xstride);
+  }
+}
+
+// ---- S6a: PrepareAttention<1> || StoreRows(ik) || [RmsNorm(iq) rows t*4 .. t*4+3, then Rope(iq) token t] ----------
+struct S6aKArgs {
+  fz::Map map;
+  w3fz::S6aArgs a;
+};
+__launch_bounds__(256) __global__ void W3fzS6aKernel(const S6aKArgs k) {
+  const fz::Task t = fz::Locate(k.map, blockIdx.x, threadIdx.x);
+  if (t.seg < 0) return;
+  const w3fz::S6aArgs& b = k.a;
+  if (t.role == fz::kPrep) {
+    W3fzBody_PrepareAttentionKernel<1>(D(t.pbx, t.pby), D(t.ptid), D(256, 1, 1), b.packed, b.stride, b.q_gamma,
+                                       b.k_gamma, b.q, b.gate, b.k_cache, b.v_cache, b.heads, b.kv_heads, b.d,
+                                       b.rotary_dim, b.start_pos, b.theta, b.eps, nullptr);
+  } else if (t.role == fz::kStore) {
+    W3fzBody_StoreRowsKernel(D(t.pbx), D(t.ptid), D(256, 1, 1), b.ik, b.index_k, b.idx_dim, b.start_pos, b.capacity);
+  } else {
+    // RmsNormRows' blocks of token t are rows t * idx_heads + h (one 256-thread block each): run them in order here.
+    for (std::uint32_t h = 0; h < b.idx_heads; ++h)
+      W3fzBody_RmsNormKernel(D(t.pbx * b.idx_heads + h), D(t.ptid), D(256, 1, 1), b.iq, b.iq_gamma, b.iq, b.idx_dim,
+                             1u, b.eps);
+    __syncthreads();
+    W3fzBody_RopeKernel(D(t.pbx), D(t.ptid), D(256, 1, 1), b.iq, b.idx_heads, b.idx_dim, b.rotary_dim, b.start_pos,
+                        b.theta, nullptr);
+  }
+}
+
+// ---- S6c: SelectMark<kBlock> then CompactSelection (on threads 0..255) in token t's workgroup ---------------------
+struct S6cArgs {
+  std::uint32_t* mask;
+  const float* scores;
+  const std::uint32_t* start_pos;
+  std::uint32_t ratio, budget, mask_words, max_blocks;
+  std::uint32_t* lists;
+  std::uint32_t* counts;
+  std::uint32_t capacity;
+};
+template <std::uint32_t kBlock>
+__launch_bounds__(kBlock) __global__ void W3fzS6cKernel(const S6cArgs b) {
+  const std::uint32_t t = blockIdx.x;
+  W3fzBody_SelectMarkKernel<kBlock>(D(t), D(threadIdx.x), D(kBlock, 1, 1), b.mask, b.scores, b.start_pos, 0u, b.ratio,
+                                    b.budget, b.mask_words, b.max_blocks);
+  __syncthreads();
+  if (threadIdx.x >= 256) return;   // whole waves 8 .. 31 retire; Compact's barriers then count waves 0 .. 7
+  W3fzBody_CompactSelectionKernel(D(t), D(threadIdx.x), D(256, 1, 1), b.mask, b.mask_words, b.start_pos, b.ratio,
+                                  b.lists, b.counts, b.capacity);
+}
+
+// ---- S6d: AttentionMerge (h, t) then SigmoidMulQ8 block t * heads + h (the same 256 elements, the same threads) ----
+struct S6dArgs {
+  const float* partials;
+  float* ctx;
+  std::uint32_t heads, d, splits;
+  const float* gate;
+  void* ctx_q8;
+  std::size_t count;
+};
+__launch_bounds__(256) __global__ void W3fzS6dKernel(const S6dArgs b) {
+  const std::uint32_t h = blockIdx.x, t = blockIdx.y;
+  W3fzBody_AttentionMergeKernel(D(h, t), D(threadIdx.x), D(256, 1, 1), b.partials, b.ctx, b.heads, b.d, b.splits);
+  __syncthreads();
+  W3fzBody_SigmoidMulQ8Kernel(D(t * b.heads + h), D(threadIdx.x), D(256, 1, 1), b.ctx, b.gate, b.count, b.ctx_q8);
+}
+
+template <unsigned n>
+void LaunchS2(const S2Args& a, hipStream_t s) {
+  const uint3 ne2 = mm::init_fastdiv_values(1);   // quantize_row_q8_1_hip: ne2 = 1
+  hipLaunchKernelGGL(W3fzS2Kernel<n>, dim3(fz::MapBlocks(a.map)), dim3(256), 0, s, a, ne2);
+}
+template <unsigned n>
+void LaunchS4(const GemvArgs& a, hipStream_t s) {
+  hipLaunchKernelGGL(W3fzS4Kernel<n>, dim3(fz::MapBlocks(a.map)), dim3(128), 0, s, a);
+}
+template <unsigned n>
+void LaunchS5(const GemvArgs& a, hipStream_t s) {
+  hipLaunchKernelGGL(W3fzS5Kernel<n>, dim3(fz::MapBlocks(a.map)), dim3(128), 0, s, a);
+}
+#define W3FZ_BY_WIDTH(fn, a, s, n) \
+  ((n) == 1 ? (fn<1>(a, s), true) : (n) == 2 ? (fn<2>(a, s), true) : (n) == 3 ? (fn<3>(a, s), true) : \
+   (n) == 4 ? (fn<4>(a, s), true) : (n) == 8 ? (fn<8>(a, s), true) : false)
+
+}  // namespace
+}  // namespace w3fz_mk
+
+namespace w3fz {
+namespace mk = w3fz_mk;
+
+bool S2(const float* logits, std::uint32_t stride, std::int32_t* ids, float* weights, std::uint32_t n_experts,
+        std::uint32_t k_used, const float* act, void* act_q8, std::uint32_t act_k, std::uint32_t n, hipStream_t s) {
+  if (!Width(n) || fz::Refuse(fz::kS2, n) || stride != kRouterStride || n_experts != kExperts || k_used != kUsed ||
+      act_k != kShexpFf)
+    return false;
+  mk::S2Args a{};
+  a.map = fz::SiteMap(fz::kS2, n, 0, 3u);
+  a.logits = logits;
+  a.stride = stride;
+  a.n_experts = n_experts;
+  a.k_used = k_used;
+  a.ids = ids;
+  a.weights = weights;
+  a.act = act;
+  a.act_q8 = act_q8;
+  a.act_k = act_k;
+  a.padded = GGML_PAD(static_cast<int64_t>(act_k), MATRIX_ROW_PADDING);   // qfn_mmq_quantize_q8_1's ne10_padded
+  a.n = n;
+  if (a.padded != int64_t{fz::kShexpXStride} * 32) return false;           // the map's 4 quantize blocks per row
+  if (!W3FZ_BY_WIDTH(mk::LaunchS2, a, s, n)) return false;
+  Fired(kS2, n);
+  return true;
+}
+
+bool S4(const void* w_in, std::uint32_t in_rows, std::uint32_t k, const void* xq, float* out_in, const void* w_ab,
+        std::uint32_t ab_rows, std::uint32_t ab_cols, bool ab_f16, const float* x, float* out_ab, std::uint32_t n,
+        hipStream_t s) {
+  // LaunchSmallGemm takes the kWhole instance for 16-byte aligned w / x and k % 512 == 0: the merged body is that one.
+  if (!Width(n) || fz::Refuse(fz::kS4, n) || in_rows != kSsmInRows || k != kHidden || ab_rows != kAlphaBetaRows ||
+      ab_cols != k || !ab_f16 || !Aligned16(w_ab, x) || k % (32 * 4 * 4) != 0 || xq == nullptr)
+    return false;
+  mk::GemvArgs a{};
+  a.map = fz::SiteMap(fz::kS4, n, 0, 3u);
+  a.w_q8 = w_in;
+  a.xq = static_cast<const ::w3fzmm::block_q8_1*>(xq);
+  a.out_q8 = out_in;
+  a.k = k;
+  a.rows_q8 = in_rows;
+  a.xstride = static_cast<std::uint32_t>(GGML_PAD(static_cast<int>(k), MATRIX_ROW_PADDING) / QK8_1);
+  a.w_a = w_ab;
+  a.out_a = out_ab;
+  a.rows_a = ab_rows;
+  a.x = x;
+  if (!W3FZ_BY_WIDTH(mk::LaunchS4, a, s, n)) return false;
+  Fired(kS4, n);
+  return true;
+}
+
+bool S5(const void* w_qkv, std::uint32_t qkv_rows, std::uint32_t k, const void* xq, float* qg, const void* w_ik,
+        std::uint32_t ik_rows, const void* w_iq, std::uint32_t iq_rows, std::uint32_t idx_cols, bool idx_bf16,
+        const float* x, float* ik, float* iq, std::uint32_t n, hipStream_t s) {
+  if (!Width(n) || fz::Refuse(fz::kS5, n) || qkv_rows != kQkvRows || k != kHidden || ik_rows != kIdxKRows ||
+      iq_rows != kIdxQRows || idx_cols != k || !idx_bf16 || !Aligned16(w_ik, x) || !Aligned16(w_iq, x) ||
+      k % (32 * 4 * 4) != 0 || xq == nullptr)
+    return false;
+  mk::GemvArgs a{};
+  a.map = fz::SiteMap(fz::kS5, n, 0, 7u);
+  a.w_q8 = w_qkv;
+  a.xq = static_cast<const ::w3fzmm::block_q8_1*>(xq);
+  a.out_q8 = qg;
+  a.k = k;
+  a.rows_q8 = qkv_rows;
+  a.xstride = static_cast<std::uint32_t>(GGML_PAD(static_cast<int>(k), MATRIX_ROW_PADDING) / QK8_1);
+  a.w_a = w_ik;
+  a.out_a = ik;
+  a.rows_a = ik_rows;
+  a.w_b = w_iq;
+  a.out_b = iq;
+  a.rows_b = iq_rows;
+  a.x = x;
+  if (!W3FZ_BY_WIDTH(mk::LaunchS5, a, s, n)) return false;
+  Fired(kS5, n);
+  return true;
+}
+
+bool S6a(const S6aArgs& a, std::uint32_t n, hipStream_t s) {
+  if (!Width(n) || fz::Refuse(fz::kS6a, n) || a.stride != kQkvRows || a.heads != kHeads || a.kv_heads != kKvHeads ||
+      a.d != kHeadDim || a.rotary_dim != kRotary || a.idx_dim != kIdxDim || a.idx_heads != kIdxHeads)
+    return false;
+  mk::S6aKArgs k{};
+  k.map = fz::SiteMap(fz::kS6a, n, 0, 7u);
+  k.a = a;
+  hipLaunchKernelGGL(mk::W3fzS6aKernel, dim3(fz::MapBlocks(k.map)), dim3(256), 0, s, k);
+  Fired(kS6a, n);
+  return true;
+}
+
+bool S6cOk(std::uint32_t heads, std::uint32_t dim, std::uint32_t ratio, std::uint32_t first_token, bool lists_ok,
+           std::uint32_t n) {
+  return Width(n) && !fz::Refuse(fz::kS6c, n) && heads == kSelectHeads && dim == kSelectDim && ratio == kRatio &&
+         first_token == 0 && lists_ok;
+}
+
+bool S6dOk(std::uint32_t heads, std::uint32_t kv_heads, std::uint32_t d, std::uint32_t splits, bool partials,
+           std::size_t count, std::uint32_t n) {
+  return Width(n) && !fz::Refuse(fz::kS6d, n) && heads == kHeads && kv_heads == kKvHeads && d == kHeadDim &&
+         (heads / kv_heads) % 4 == 0 && partials && std::max(splits, 1u) > 1 && count != 0 && count % 32 == 0 &&
+         count == std::size_t{n} * heads * d;
+}
+
+// = SelectBlocks (kernels.hip.cpp) with the SelectMark launch replaced by the merged SelectMark + CompactSelection.
+void SelectMarkCompact(const float* q, const __half* blocks, std::uint32_t* mask, float* scores, std::uint32_t n_tokens,
+                       const std::uint32_t* start_pos, std::uint32_t heads, std::uint32_t dim, std::uint32_t ratio,
+                       std::uint32_t budget, std::uint32_t mask_words, std::uint32_t max_blocks, std::uint32_t* lists,
+                       std::uint32_t* counts, std::uint32_t list_capacity, hipStream_t stream,
+                       std::uint32_t live_blocks) {
+  const std::uint32_t first_token = 0;
+  const std::uint32_t grid_blocks =
+      live_blocks != 0 ? std::min(live_blocks, max_blocks) : max_blocks;
+  const dim3 grid(n_tokens, (grid_blocks + kThreads - 1) / kThreads);
+  hipLaunchKernelGGL(SelectScoreKernel, grid, dim3(kThreads), 0, stream, q,
+                     blocks, scores, n_tokens, start_pos, first_token, ratio,
+                     budget, max_blocks);
+  (void)heads;
+  (void)dim;
+  mk::S6cArgs b{mask, scores, start_pos, ratio, budget, mask_words, max_blocks, lists, counts, list_capacity};
+  if (n_tokens <= 4)
+    hipLaunchKernelGGL(mk::W3fzS6cKernel<1024>, dim3(n_tokens), dim3(1024), 0, stream, b);
+  else
+    hipLaunchKernelGGL(mk::W3fzS6cKernel<kThreads>, dim3(n_tokens), dim3(kThreads), 0, stream, b);
+  Fired(kS6c, n_tokens);
+}
+
+// = rocm::Attention (kernels.hip.cpp) with the Compact launch dropped (plan.compact_merged: it ran inside S6c) and the
+// AttentionMerge launch replaced by the merged AttentionMerge + SigmoidMulQ8 (plan.merge_sigmoid).
+void Attention(const AttnPlan& plan, const float* q, const __half* k_cache, const __half* v_cache,
+               const std::uint32_t* mask, std::uint32_t mask_words, float* out, float* partials, std::uint32_t splits,
+               std::uint32_t n_tokens, const std::uint32_t* start_pos, std::uint32_t heads, std::uint32_t kv_heads,
+               std::uint32_t d, std::uint32_t ratio, hipStream_t stream, std::uint32_t* lists, std::uint32_t* counts,
+               std::uint32_t list_capacity, const float* gate, void* ctx_q8) {
+  if (d != 256) {
+    return;  // the kernel is written for the model's 256-wide heads
+  }
+  const std::uint32_t z = partials != nullptr ? std::max(splits, 1u) : 1u;
+  if (ratio != 4 || mask == nullptr || lists == nullptr || counts == nullptr ||
+      list_capacity == 0) {
+    lists = nullptr;
+    counts = nullptr;
+    list_capacity = 0;
+  }
+  if (lists != nullptr && !plan.compact_merged) {
+    hipLaunchKernelGGL(CompactSelectionKernel, dim3(n_tokens), dim3(kThreads),
+                       0, stream, mask, mask_words, start_pos, ratio, lists,
+                       counts, list_capacity);
+  }
+  if ((heads / kv_heads) % 4 != 0) {
+    return;
+  }
+  const auto launch = [&](auto kernel, std::uint32_t group) {
+    hipLaunchKernelGGL(kernel, dim3(heads / group, n_tokens, z), dim3(kThreads),
+                       0, stream, q, k_cache, v_cache, mask, mask_words, out,
+                       partials, start_pos, heads, kv_heads, d, ratio, lists,
+                       counts, list_capacity);
+  };
+  if (n_tokens <= 2) {
+    launch(AttentionKernel<2>, 2);
+  } else {
+    launch(AttentionKernel<4>, 4);
+  }
+  if (z > 1) {
+    if (plan.merge_sigmoid) {
+      mk::S6dArgs b{partials, out, heads, d, z, gate, ctx_q8, std::size_t{n_tokens} * heads * d};
+      hipLaunchKernelGGL(mk::W3fzS6dKernel, dim3(heads, n_tokens), dim3(kThreads), 0, stream, b);
+      Fired(kS6d, n_tokens);
+    } else {
+      hipLaunchKernelGGL(AttentionMergeKernel, dim3(heads, n_tokens),
+                         dim3(kThreads), 0, stream, partials, out, heads, d, z);
+    }
+  }
+}
