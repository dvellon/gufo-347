+               "gufo: event=q2l_selftest cases=%u select=%d exact=%d merge=%d argmax_agree=%u/%u "
+               "err=%u/%u/%u batch2=%d pass=%d port=q2live-226\n",
+               cases, select_ok ? 1 : 0, exact_ok ? 1 : 0, merge_ok ? 1 : 0, agree, cases, err[0], err[1], err[2],
+               batch_ok ? 1 : 0, pass ? 1 : 0);
+  std::fflush(stderr);
+  const bool top2_pass = top2_merge_ok && top2_exact_ok && top2_planted_ok && hipGetLastError() == hipSuccess;
+  std::fprintf(stderr,
+               "gufo: event=q2l_top2_selftest cases=%u agree=%u both_in=%u merge=%d exact=%d planted=%d pass=%d "
+               "port=q2live-226\n",
