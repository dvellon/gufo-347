+        v0 = 2.0F;
+        w1 = kP + 300;
+        v1 = 1.75F;
+      }
+      if (pattern == 3) {  // a NaN table row never wins
+        ptab[5] = std::nanf("");
+        ptab[300] = 3.0F;
+        w0 = kP + 300;
+        v0 = 3.0F;
+        w1 = 1005;
+        v1 = 1.5F;
+      }
