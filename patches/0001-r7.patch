diff --git a/src/models/qwen38_flash_next/forced_head_elision.hpp b/src/models/qwen38_flash_next/forced_head_elision.hpp
new file mode 100644
--- /dev/null
+++ b/src/models/qwen38_flash_next/forced_head_elision.hpp
@@ -0,0 +1,38 @@
+#ifndef GUFO_MODELS_QWEN38_FLASH_NEXT_FORCED_HEAD_ELISION_HPP_
+#define GUFO_MODELS_QWEN38_FLASH_NEXT_FORCED_HEAD_ELISION_HPP_
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+#include "src/core/sampling.hpp"
+
+namespace gufo::models::qwen38_flash_next {
+
+/// Whether a known forced suffix may use the target-only output-head-elision
+/// path. Sampled stock MTP cycles consume independent draft-stream seeds, so
+/// batching several forced tokens would change later sampling state even
+/// though the forced tokens themselves are point masses.
+[[nodiscard]] inline bool ForcedHeadElisionAllowed(
+    const sampling::SamplingConfig& config,
+    std::span<const sampling::TokenId> forced_tokens,
+    sampling::TokenId anchor) noexcept {
+  // Keep every operation that depends on optional request state inside this
+  // helper. Callers must not inspect the span or reasoning budget while
+  // forming arguments: C++ evaluates arguments before entering the helper.
+  if (forced_tokens.size() <= 1)
+    return false;
+  if (!config.reasoning_budget)
+    return false;
+  if (config.uses_random_sampling())
+    return false;
+  if (config.constraint && !config.constraint->forced_head_elision_allowed)
+    return false;
+  if (!config.reasoning_budget->elide_forced_heads)
+    return false;
+  return forced_tokens.front() == anchor;
+}
+
+}  // namespace gufo::models::qwen38_flash_next
+
+#endif  // GUFO_MODELS_QWEN38_FLASH_NEXT_FORCED_HEAD_ELISION_HPP_
