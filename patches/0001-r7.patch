+#ifndef GUFO_CORE_UP219_KNOBS_HPP_
+#define GUFO_CORE_UP219_KNOBS_HPP_
+
+// combo-c4 member b3-up (re-base of upstream-pulls-219 onto c3): the knobs of the upstream performance pulls.
+// Each knob is read once per process (function-local static of an inline function: one instance per program) and is ON
+// only when set to exactly "1"; unset, "", "0", "true", "1 " ... keep c3's statement. One stderr line per knob at its
+// first use (inference_backend.cpp reads all three when the RAM-cache backing is committed, at model load):
+//   event=up219_knob name=<NAME> value=<0|1> port=c4b3
+//   GUFO_UP_IDLE_BACKOFF    src/cache/slot.cpp RunIdle: a deferred idle spill re-polls after 1, 2, 4 ... 32 ms instead
+//                           of every 1 ms (upstream #881, 31c3b3a0)
+//   GUFO_UP_HEAP_MEASURE    inference_backend.cpp + committed_backing.cpp: refuse a RAM-cache segment only when its
+//                           hipHostRegister measurably cut the device heap below kDispatchReserve (upstream #903,
+//                           8ab834a5)
+//   GUFO_UP_SELECT_UNROLL1  kernels.hip.cpp SelectBlocks: launch SelectScoreKernelU742 (head loop `#pragma unroll 1`,
+//                           upstream #742 d4eaaad4 kernel hunk) instead of SelectScoreKernel; same FMA / reduction order
+// (219's GUFO_UP_API pulls #827 / #915 / #1012 are not in c4: not performance.)
+#include <cstdio>
+#include <cstdlib>
+
+namespace gufo::up219 {
+
+/// Exactly "1" enables; anything else (unset included) is off.
+[[nodiscard]] constexpr bool FlagValue(const char* value) noexcept {
+  return value != nullptr && value[0] == '1' && value[1] == '\0';
+}
+
+inline bool ReadFlag(const char* name) {
+  const bool on = FlagValue(std::getenv(name));
+  std::fprintf(stderr, "event=up219_knob name=%s value=%d port=c4b3\n", name, on ? 1 : 0);
+  std::fflush(stderr);
+  return on;
+}
+
+inline bool IdleBackoff() {
+  static const bool on = ReadFlag("GUFO_UP_IDLE_BACKOFF");
+  return on;
+}
+
+inline bool HeapMeasure() {
+  static const bool on = ReadFlag("GUFO_UP_HEAP_MEASURE");
+  return on;
+}
+
+inline bool SelectUnroll1() {
+  static const bool on = ReadFlag("GUFO_UP_SELECT_UNROLL1");
+  return on;
+}
+
+}  // namespace gufo::up219
+
+#endif  // GUFO_CORE_UP219_KNOBS_HPP_
